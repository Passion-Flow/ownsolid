diff --git a/services/control/internal/modules/sso/saml_completion.go b/services/control/internal/modules/sso/saml_completion.go
new file mode 100644
index 0000000000000000000000000000000000000000..2e9627474dbd64866babafd4afd1babf45507300
--- /dev/null
+++ b/services/control/internal/modules/sso/saml_completion.go
@@ -0,0 +1,164 @@
+package sso
+
+import (
+	"context"
+	"crypto/hmac"
+	"database/sql"
+	"errors"
+	"time"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/audit"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity/security"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/config"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/database/transaction"
+)
+
+// Complete consumes one verified Portal result, explicitly links its exact
+// identity and issues one source-bound session in the same transaction.
+// The HTTP owner must enforce its entrance, ordinary Origin/CSRF and cookie rules.
+func (p *SAMLCompletion) Complete(ctx context.Context, input SAMLCompleteInput, requestID string) (identity.IssuedSession, error) {
+	connector, audience, flow, continuation, previous := input.ConnectorID, input.Audience, input.FlowID, input.Continuation, input.PreviousSession
+	if ctx == nil {
+		return identity.IssuedSession{}, fail("SSO_SAML_CONFIGURATION_REQUIRED")
+	}
+	if audience != "portal" {
+		return identity.IssuedSession{}, fail("SSO_SAML_ENTRANCE_UNAVAILABLE")
+	}
+	if e := p.ready(); e != nil {
+		return identity.IssuedSession{}, e
+	}
+	if !canonicalID(flow) || !canonicalID(requestID) || !security.ValidToken(continuation) || !security.ValidToken(previous) {
+		return identity.IssuedSession{}, fail("SSO_FLOW_INVALID")
+	}
+	callback, e := p.callback(connector, audience)
+	if e != nil {
+		return identity.IssuedSession{}, e
+	}
+	ctx, cancel := context.WithTimeout(ctx, config.Seconds(p.service.policy.OperationSeconds))
+	defer cancel()
+	store, e := p.service.catalogRepository()
+	if e != nil {
+		return identity.IssuedSession{}, e
+	}
+	tenant, e := connectorTenant(ctx, store, connectorPeek)
+	if e != nil {
+		return identity.IssuedSession{}, e
+	}
+	initial, e := scanSAMLCompletionRequest(store.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT `+samlCompletionRequestColumns+` FROM sso_saml_requests WHERE tenant_id=$1 AND connector_id=$2 AND id=$3 AND audience=$4`, tenant, connector, flow, audience)))
+	if errors.Is(e, sql.ErrNoRows) {
+		return identity.IssuedSession{}, fail("SSO_FLOW_INVALID")
+	}
+	if e != nil {
+		return identity.IssuedSession{}, sourceOutcome(e)
+	}
+	if initial.callback != callback || !hmac.Equal(initial.previous, security.Digest(previous)) {
+		return identity.IssuedSession{}, fail("SSO_BROWSER_CHANGED")
+	}
+	actor, e := p.service.Identity.Authenticate(identity.WithoutSessionTouch(ctx), previous, audience)
+	if e != nil {
+		return identity.IssuedSession{}, e
+	}
+	if actor.Me.User.ID != initial.user || actor.SessionID != initial.session || actor.Epoch != initial.epoch || !hmac.Equal(actor.TokenHash, initial.previous) {
+		return identity.IssuedSession{}, fail("SSO_BROWSER_CHANGED")
+	}
+	var issued identity.IssuedSession
+	e = p.service.actorTransaction(ctx, actor, connectorReadFence, connectorShared, func(_ context.Context, _ transaction.Executor, current string) ([]connectorLock, error) {
+		return []connectorLock{{current, connector}}, nil
+	}, func(ctx context.Context, q transaction.Executor, current string) error {
+		if current != tenant {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		c, e := selectSAMLCompletionConnector(ctx, q, tenant, connector)
+		if e != nil {
+			return e
+		}
+		if !c.Enabled || c.Revision != initial.revision || c.AuthVersion != initial.version {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		authority, e := loadSAMLCompletionProfile(ctx, q, tenant, connector)
+		if e != nil {
+			return e
+		}
+		if authority.contextID != initial.contextID || authority.revision != initial.contextRevision || !hmac.Equal(authority.digest[:], initial.metadataDigest) {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		if e = p.service.Identity.RecheckCredentialVersionWithin(ctx, q, actor, initial.credential); e != nil {
+			return e
+		}
+		locked, e := scanSAMLCompletionRequest(q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT `+samlCompletionRequestColumns+` FROM sso_saml_requests WHERE tenant_id=$1 AND connector_id=$2 AND id=$3 FOR UPDATE`, tenant, connector, flow)))
+		if e != nil {
+			return e
+		}
+		if locked.state != "verified" || locked.request != initial.request || locked.callback != callback || locked.user != actor.Me.User.ID || locked.session != actor.SessionID || locked.epoch != actor.Epoch || locked.credential != initial.credential || locked.contextID != authority.contextID || locked.contextRevision != authority.revision || !hmac.Equal(locked.metadataDigest, authority.digest[:]) || !hmac.Equal(locked.previous, actor.TokenHash) {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		var external, contextID, verifiedRequest string
+		var sourceUntil, resultUntil time.Time
+		e = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT identity_id::text,context_id::text,request_id,source_until,expires_at FROM sso_saml_results WHERE tenant_id=$1 AND flow_id=$2 AND continuation_hash=$3 AND expires_at>clock_timestamp() AND source_until>clock_timestamp() AND completed_binding_version IS NULL FOR UPDATE`, tenant, flow, security.Digest(continuation))).Scan(&external, &contextID, &verifiedRequest, &sourceUntil, &resultUntil)
+		if errors.Is(e, sql.ErrNoRows) {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		if e != nil {
+			return e
+		}
+		sourceUntil, resultUntil = sourceUntil.UTC(), resultUntil.UTC()
+		if contextID != authority.contextID || verifiedRequest != locked.request {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		var bound sql.NullString
+		var active bool
+		var bindingVersion int64
+		e = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT bound_user_id::text,active,binding_version FROM sso_saml_identities WHERE tenant_id=$1 AND context_id=$2 AND id=$3 FOR UPDATE`, tenant, contextID, external)).Scan(&bound, &active, &bindingVersion)
+		if e != nil {
+			return e
+		}
+		var fresh bool
+		if e = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT clock_timestamp()<LEAST($1::timestamptz,$2::timestamptz,$3::timestamptz)`, resultUntil, sourceUntil, locked.expires)).Scan(&fresh); e != nil {
+			return e
+		}
+		if !fresh {
+			return fail("SSO_FLOW_EXPIRED")
+		}
+		if bound.Valid && bound.String != actor.Me.User.ID {
+			return fail("SSO_BINDING_CONFLICT")
+		}
+		if !active {
+			if bindingVersion >= identity.MaximumAuthVersion {
+				return fail("SSO_FLOW_UNUSABLE")
+			}
+			n, e := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, `UPDATE sso_saml_identities SET bound_user_id=$1,active=true,binding_version=binding_version+1 WHERE tenant_id=$2 AND context_id=$3 AND id=$4 AND binding_version=$5 AND NOT active`, actor.Me.User.ID, tenant, contextID, external, bindingVersion))
+			if e != nil {
+				return e
+			}
+			if n != 1 {
+				return fail("SSO_FLOW_UNUSABLE")
+			}
+			bindingVersion++
+			if e = audit.WriteWithin(ctx, q, actor.Me.User.ID, actor.Me.User.ID, audience, "sso.saml_binding_linked", "success", "sso_binding", external, locked.reason, requestID); e != nil {
+				return e
+			}
+		}
+		n, e := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, `UPDATE sso_saml_results SET completed_binding_version=$1 WHERE tenant_id=$2 AND flow_id=$3 AND completed_binding_version IS NULL`, bindingVersion, tenant, flow))
+		if e != nil {
+			return e
+		}
+		if n != 1 {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		n, e = q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, `UPDATE sso_saml_requests SET state='succeeded',authenticated_user_id=$1,finished_at=clock_timestamp() WHERE tenant_id=$2 AND id=$3 AND state='verified'`, actor.Me.User.ID, tenant, flow))
+		if e != nil {
+			return e
+		}
+		if n != 1 {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		source := identity.SessionSource{TenantID: tenant, ConnectorID: connector, BindingID: external, FlowID: flow, AuthVersion: locked.version}
+		issued, e = p.service.Identity.IssueSessionUntilWithin(ctx, q, actor.Me.User.ID, actor.Epoch, audience, previous, requestID, source, sourceUntil)
+		return e
+	})
+	if e != nil {
+		return identity.IssuedSession{}, e
+	}
+	return issued, nil
+}
diff --git a/services/control/internal/modules/sso/saml_completion_owner.go b/services/control/internal/modules/sso/saml_completion_owner.go
new file mode 100644
index 0000000000000000000000000000000000000000..74011908d87b2d95a549fdd6591cbe959abf76d2
--- /dev/null
+++ b/services/control/internal/modules/sso/saml_completion_owner.go
@@ -0,0 +1,157 @@
+package sso
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"errors"
+	"net/url"
+	"time"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/config"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/database/transaction"
+)
+
+// SAMLCompleteInput contains server-resolved entrance and protected browser
+// cookie values. It is not an HTTP request body or a provider claim envelope.
+type SAMLCompleteInput struct {
+	ConnectorID     string `json:"-"`
+	Audience        string `json:"-"`
+	FlowID          string `json:"-"`
+	Continuation    string `json:"-"`
+	PreviousSession string `json:"-"`
+}
+
+// String redacts protected browser values in ordinary diagnostics.
+func (SAMLCompleteInput) String() string { return "SAML_COMPLETION_INPUT_REDACTED" }
+
+// GoString redacts protected browser values in detailed diagnostics.
+func (SAMLCompleteInput) GoString() string { return "SAML_COMPLETION_INPUT_REDACTED" }
+
+// NewSAMLCompletion validates the selected PostgreSQL projection without
+// changing source composition, registering routes or opening a provider socket.
+// The startup owner must select its returned SourceGuard exactly once after
+// admitting the SAML source constraints, producer and protocol dependencies.
+func NewSAMLCompletion(ctx context.Context, base *Service) (*SAMLCompletion, error) {
+	owner := &SAMLCompletion{service: base, legacy: base}
+	if ctx == nil {
+		return nil, fail("SSO_SAML_CONFIGURATION_REQUIRED")
+	}
+	if e := owner.ready(); e != nil {
+		return nil, e
+	}
+	ctx, cancel := context.WithTimeout(ctx, config.Seconds(base.policy.OperationSeconds))
+	defer cancel()
+	store, e := base.catalogRepository()
+	if e != nil {
+		return nil, e
+	}
+	for _, statement := range []string{
+		`SELECT id,tenant_id,connector_id,revision,metadata_digest,enabled,trust_until,maximum_session_seconds FROM sso_saml_profiles LIMIT 0`,
+		`SELECT tenant_id,context_id,id,name_id_value,bound_user_id,binding_version,active FROM sso_saml_identities LIMIT 0`,
+		`SELECT ` + samlCompletionRequestColumns + `,authenticated_user_id,issued_session_id,finished_at FROM sso_saml_requests LIMIT 0`,
+		`SELECT tenant_id,flow_id,context_id,identity_id,request_id,continuation_hash,expires_at,source_until,completed_binding_version FROM sso_saml_results LIMIT 0`,
+	} {
+		rows, e := store.Query(ctx, transaction.SQL(transaction.PostgreSQL, statement))
+		if e != nil {
+			return nil, fail("SSO_SAML_SCHEMA_REQUIRED")
+		}
+		rows.Close()
+		if e := rows.Err(); e != nil {
+			return nil, fail("SSO_SAML_SCHEMA_REQUIRED")
+		}
+	}
+	return owner, nil
+}
+func (p *SAMLCompletion) ready() error {
+	if p == nil || p.service == nil || p.service.Identity == nil {
+		return fail("SSO_SAML_CONFIGURATION_REQUIRED")
+	}
+	if e := p.service.policy.Validate(); e != nil {
+		return e
+	}
+	store, e := p.service.catalogRepository()
+	if e != nil {
+		return e
+	}
+	if store.Dialect() != transaction.PostgreSQL {
+		return fail("SSO_TRANSACTION_STORAGE_MISMATCH")
+	}
+	return nil
+}
+func (p *SAMLCompletion) callback(connector, audience string) (string, error) {
+	if !canonicalID(connector) || (audience != "portal" && audience != "admin") {
+		return "", fail("SSO_FLOW_INVALID")
+	}
+	origin := p.service.Identity.Config.Server.PortalOrigin
+	if audience == "admin" {
+		origin = p.service.Identity.Config.Server.AdminOrigin
+	}
+	if !config.SSOOrigin(origin) {
+		return "", fail("SSO_SAML_CONFIGURATION_REQUIRED")
+	}
+	return origin + "/api/v1/sso/saml/connectors/" + url.PathEscape(connector) + "/acs", nil
+}
+
+type samlCompletionRequest struct {
+	id, tenant, connector, audience, callback, request, user, session, state, reason string
+	previous, metadataDigest                                                         []byte
+	epoch, credential, revision, version, contextRevision                            int64
+	contextID                                                                        string
+	expires                                                                          time.Time
+}
+
+const samlCompletionRequestColumns = `id::text,tenant_id::text,connector_id::text,audience,callback,request_id,user_id::text,session_id::text,state,previous_hash,epoch,credential_version,connector_revision,auth_version,expires_at,context_id::text,context_revision,metadata_digest,reason`
+
+func scanSAMLCompletionRequest(row transaction.Row) (samlCompletionRequest, error) {
+	var r samlCompletionRequest
+	e := row.Scan(&r.id, &r.tenant, &r.connector, &r.audience, &r.callback, &r.request, &r.user, &r.session, &r.state, &r.previous, &r.epoch, &r.credential, &r.revision, &r.version, &r.expires, &r.contextID, &r.contextRevision, &r.metadataDigest, &r.reason)
+	if e != nil {
+		return samlCompletionRequest{}, e
+	}
+	r.expires = r.expires.UTC()
+	if !canonicalID(r.id) || !canonicalID(r.tenant) || !canonicalID(r.connector) || !canonicalID(r.user) || !canonicalID(r.session) || !canonicalID(r.contextID) || len(r.previous) != sha256.Size || len(r.metadataDigest) != sha256.Size || !validReason(r.reason) || !samlCompletionVersion(r.epoch) || !samlCompletionVersion(r.credential) || !samlCompletionVersion(r.revision) || !samlCompletionVersion(r.version) || !samlCompletionVersion(r.contextRevision) {
+		return samlCompletionRequest{}, fail("STORAGE_UNAVAILABLE")
+	}
+	return r, nil
+}
+
+type samlCompletionProfile struct {
+	contextID string
+	revision  int64
+	digest    []byte
+}
+
+func loadSAMLCompletionProfile(ctx context.Context, q transaction.Executor, tenant, connector string) (samlCompletionProfile, error) {
+	var p samlCompletionProfile
+	e := q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT id::text,revision,metadata_digest FROM sso_saml_profiles WHERE tenant_id=$1 AND connector_id=$2 AND enabled AND trust_until>clock_timestamp() FOR SHARE`, tenant, connector)).Scan(&p.contextID, &p.revision, &p.digest)
+	if errors.Is(e, sql.ErrNoRows) {
+		return samlCompletionProfile{}, fail("SSO_FLOW_UNUSABLE")
+	}
+	if e != nil {
+		return samlCompletionProfile{}, e
+	}
+	if !canonicalID(p.contextID) || !samlCompletionVersion(p.revision) || len(p.digest) != sha256.Size {
+		return samlCompletionProfile{}, fail("STORAGE_UNAVAILABLE")
+	}
+	return p, nil
+}
+func selectSAMLCompletionConnector(ctx context.Context, q transaction.Executor, tenant, id string) (Connector, error) {
+	var c Connector
+	e := q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT id::text,provider,origin,enabled,revision,auth_version FROM sso_connectors WHERE tenant_id=$1 AND id=$2 AND provider='saml'`, tenant, id)).Scan(&c.ID, &c.Provider, &c.Origin, &c.Enabled, &c.Revision, &c.AuthVersion)
+	if errors.Is(e, sql.ErrNoRows) {
+		return Connector{}, fail("SSO_FLOW_UNUSABLE")
+	}
+	if e != nil {
+		return Connector{}, e
+	}
+	if !canonicalID(c.ID) || !samlCompletionVersion(c.Revision) || !samlCompletionVersion(c.AuthVersion) {
+		return Connector{}, fail("STORAGE_UNAVAILABLE")
+	}
+	return c, nil
+}
+
+func samlCompletionVersion(value int64) bool {
+	return value >= 1 && value <= identity.MaximumAuthVersion
+}
