{
  "name": "ownsolid-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm --filter ./apps/console --filter ./apps/portal run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint --config packages/config/eslint.config.js --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run test",
    "test:browser": "pnpm --filter ./apps/console --filter ./apps/portal run test:browser"
  },
  "prettier": "@ownsolid/config/prettier",
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@ownsolid/config": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y-x": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
