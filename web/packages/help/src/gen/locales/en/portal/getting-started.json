           "value": "Published to you"
          }
         ]
        },
        {
         "type": "text",
         "value": " lists the applications an administrator published to the workspace."
        }
       ]
      }
     ]
    },
    {
     "type": "listItem",
     "spread": false,
     "children": [
      {
       "type": "paragraph",
       "children": [
        {
         "type": "strong",
         "children": [
          {
           "type": "text",
           "value": "Usage"
          }
         ]
        },
        {
         "type": "text",
         "value": " will show the tokens, calls and GPU hours you use; this release does not measure them\nyet."
        }
       ]
      }
     ]
    }
