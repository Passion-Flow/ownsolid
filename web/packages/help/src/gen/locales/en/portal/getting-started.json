  },
  {
   "type": "paragraph",
   "children": [
    {
     "type": "text",
     "value": "If one part cannot be read, it says so and offers "
    },
    {
     "type": "strong",
     "children": [
      {
       "type": "text",
       "value": "Try again"
      }
     ]
    },
    {
     "type": "text",
     "value": "; the rest of the page still shows."
    }
   ]
  },
  {
   "type": "heading",
   "depth": 2,
   "children": [
    {
     "type": "text",
     "value": "Notifications"
