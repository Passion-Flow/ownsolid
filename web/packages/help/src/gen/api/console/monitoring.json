{
 "title": "ownsolid Admin operational monitoring",
 "operations": [
  {
   "id": "adminMonitoring",
   "method": "get",
   "path": "/api/v1/sites/{site_id}/cells/{cell_id}/admin/monitoring",
   "parameters": [
    {
     "name": "site_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    },
    {
     "name": "cell_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    },
    {
     "name": "workspace_id",
     "in": "query",
     "required": true,
     "schema": {
      "type": "string",
      "format": "uuid"
     }
    },
    {
     "name": "node_cursor",
     "in": "query",
     "required": false,
     "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     }
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "SnapshotResponse"
     }
    }
   ],
   "errors": {}
  }
 ],
 "schemas": {
  "ComponentMetrics": {
   "type": "object",
   "required": [
    "cpu_seconds_total",
    "cpu_idle_seconds_total",
    "memory_total_bytes",
    "memory_available_bytes",
    "filesystem_total_bytes",
    "filesystem_available_bytes"
   ],
   "properties": {
    "cpu_seconds_total": {
     "type": "number",
     "maximum": 9007199254740991
    },
    "cpu_idle_seconds_total": {
     "type": "number",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "memory_total_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "memory_available_bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "filesystem_total_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "filesystem_available_bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    }
   }
  },
  "Gateway": {
   "type": "object",
   "required": [
    "from",
    "until",
    "maximum",
    "sampled",
    "truncated",
    "oldest_admission",
    "newest_admission",
    "admitted",
    "reported",
    "reconciled",
    "held_in_sample",
    "usage_known",
    "usage_unknown",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "outcomes",
    "p50_milliseconds",
    "p95_milliseconds",
    "p99_milliseconds",
    "error_rate"
   ],
   "properties": {
    "from": {
     "type": "string",
     "format": "date-time"
    },
    "until": {
     "type": "string",
     "format": "date-time"
    },
    "maximum": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10000
    },
    "sampled": {
     "type": "integer",
     "minimum": 0,
     "maximum": 10000
    },
    "truncated": {
     "type": "boolean"
    },
    "oldest_admission": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "newest_admission": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "admitted": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "reported": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "reconciled": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "held_in_sample": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "usage_known": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "usage_unknown": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "prompt_tokens": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "completion_tokens": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "total_tokens": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "outcomes": {
     "type": "object",
     "required": [],
     "properties": {
      "succeeded": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "client_cancelled": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "upstream_timeout": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "upstream_error": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "invalid_response": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "gateway_shutdown": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "usage_storage_failed": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "incomplete": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     }
    },
    "p50_milliseconds": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 3600000
      },
      {
       "type": "null"
      }
     ]
    },
    "p95_milliseconds": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 3600000
      },
      {
       "type": "null"
      }
     ]
    },
    "p99_milliseconds": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 3600000
      },
      {
       "type": "null"
      }
     ]
    },
    "error_rate": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "HTTPSeries": {
   "type": "object",
   "required": [
    "method",
    "route",
    "outcome",
    "count",
    "response_bytes",
    "duration_microseconds",
    "buckets"
   ],
   "properties": {
    "method": {
     "type": "string",
     "enum": [
      "GET",
      "HEAD",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS",
      "CONNECT",
      "TRACE",
      "OTHER"
     ]
    },
    "route": {
     "type": "string",
     "enum": [
      "monitoring",
      "admin",
      "agent",
      "gateway",
      "workspace",
      "api",
      "health",
      "other"
     ]
    },
    "outcome": {
     "type": "string",
     "enum": [
      "succeeded",
      "panic",
      "client_cancelled",
      "write_error",
      "hijacked",
      "hijack_error",
      "http_error",
      "unobserved"
     ]
    },
    "count": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "response_bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "duration_microseconds": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "buckets": {
     "type": "array",
     "maxItems": 33,
     "items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    }
   }
  },
  "License": {
   "type": "object",
   "required": [
    "state",
    "new_business_allowed",
    "warning"
   ],
   "properties": {
    "state": {
     "type": "string",
     "enum": [
      "missing",
      "not_yet_valid",
      "active",
      "grace",
      "expired",
      "clock_suspect"
     ]
    },
    "new_business_allowed": {
     "type": "boolean"
    },
    "warning": {
     "type": "boolean"
    }
   }
  },
  "NodeObservation": {
   "type": "object",
   "required": [
    "node_id",
    "name",
    "status",
    "connectivity",
    "profile",
    "present",
    "stale",
    "received_at",
    "observed_at",
    "component_state",
    "version",
    "error_code",
    "metrics"
   ],
   "properties": {
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "status": {
     "type": "string",
     "enum": [
      "active",
      "disabled",
      "removed"
     ]
    },
    "connectivity": {
     "type": "string",
     "enum": [
      "online",
      "unknown",
      "offline"
     ]
    },
    "profile": {
     "type": "string",
     "enum": [
      "read_only",
      "systemd_components",
      "systemd_maintenance",
      "docker_inference",
      "docker_ai",
      "docker_model_lifecycle"
     ]
    },
    "present": {
     "type": "boolean"
    },
    "stale": {
     "type": "boolean"
    },
    "received_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "observed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "component_state": {
     "type": "string",
     "enum": [
      "",
      "running",
      "stopped",
      "not_installed",
      "unknown"
     ]
    },
    "version": {
     "type": "string",
     "minLength": 0,
     "maxLength": 64
    },
    "error_code": {
     "type": "string",
     "enum": [
      "",
      "COMPONENT_SYSTEMD_UNAVAILABLE",
      "COMPONENT_PRIVILEGE_REQUIRED",
      "COMPONENT_USER_INVALID",
      "COMPONENT_CONFLICT",
      "COMPONENT_PORT_CONFLICT",
      "COMPONENT_DISK_SPACE_LOW",
      "COMPONENT_ASSET_UNAVAILABLE",
      "COMPONENT_ASSET_INVALID",
      "COMPONENT_ARCHIVE_INVALID",
      "COMPONENT_ARCHITECTURE_MISMATCH",
      "COMPONENT_STATE_INVALID",
      "COMPONENT_IO_FAILED",
      "COMPONENT_SERVICE_FAILED",
      "COMPONENT_METRICS_UNAVAILABLE",
      "COMPONENT_METRICS_INVALID",
      "COMPONENT_CANCELLED",
      "COMPONENT_PROFILE_UNAVAILABLE"
     ]
    },
    "metrics": {
     "anyOf": [
      {
       "$ref": "ComponentMetrics"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "Process": {
   "type": "object",
   "required": [
    "epoch",
    "started_at",
    "observed_at",
    "inflight",
    "overflow",
    "skipped_logs",
    "latency_milliseconds",
    "series"
   ],
   "properties": {
    "epoch": {
     "type": "string",
     "format": "uuid"
    },
    "started_at": {
     "type": "string",
     "format": "date-time"
    },
    "observed_at": {
     "type": "string",
     "format": "date-time"
    },
    "inflight": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "overflow": {
     "type": "boolean"
    },
    "skipped_logs": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "latency_milliseconds": {
     "type": "array",
     "description": "Strictly increasing finite inclusive histogram upper bounds in milliseconds; runtime also validates order. Counts are exclusive per bin, not cumulative Prometheus exposition. Final bucket is overflow. Restart resets epoch/counters.",
     "maxItems": 32,
     "items": {
      "type": "number",
      "maximum": 3600000
     }
    },
    "series": {
     "type": "array",
     "maxItems": 640,
     "items": {
      "$ref": "HTTPSeries"
     }
    }
   }
  },
  "Runtime": {
   "type": "object",
   "required": [
    "observed_at",
    "goos",
    "goarch",
    "go_version",
    "values"
   ],
   "properties": {
    "observed_at": {
     "type": "string",
     "format": "date-time"
    },
    "goos": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "goarch": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "go_version": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "values": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "$ref": "RuntimeValue"
     }
    }
   }
  },
  "RuntimeValue": {
   "type": "object",
   "required": [
    "name",
    "unit",
    "available",
    "value"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "unit": {
     "type": "string",
     "minLength": 1,
     "maxLength": 20
    },
    "available": {
     "type": "boolean"
    },
    "value": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "Snapshot": {
   "type": "object",
   "required": [
    "format_version",
    "workspace_id",
    "observed_at",
    "license",
    "process",
    "runtime",
    "gateway",
    "nodes",
    "next_node_cursor"
   ],
   "properties": {
    "format_version": {
     "type": "integer",
     "const": 1
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "observed_at": {
     "type": "string",
     "format": "date-time"
    },
    "license": {
     "$ref": "License"
    },
    "process": {
     "$ref": "Process"
    },
    "runtime": {
     "$ref": "Runtime"
    },
    "gateway": {
     "$ref": "Gateway"
    },
    "nodes": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "NodeObservation"
     }
    },
    "next_node_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 256
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "SnapshotResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "Snapshot"
    }
   }
  }
 }
}
