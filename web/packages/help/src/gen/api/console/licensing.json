{
 "title": "ownsolid whole-platform License",
 "operations": [
  {
   "id": "GetPlatformLicense",
   "method": "get",
   "path": "/api/v1/admin/license",
   "parameters": [],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "LicenseStateResponse"
     }
    }
   ],
   "errors": {
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED"
    ],
    "421": [
     "MISDIRECTED_REQUEST"
    ],
    "429": [
     "RATE_LIMITED"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY",
     "LICENSE_CONFIGURATION_REQUIRED",
     "LICENSE_STORED_STATE_INVALID"
    ]
   }
  },
  {
   "id": "ImportPlatformLicense",
   "method": "post",
   "path": "/api/v1/admin/license",
   "parameters": [],
   "body": {
    "$ref": "ImportLicense"
   },
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "LicenseImportResultResponse"
     }
    }
   ],
   "errors": {
    "400": [
     "VALIDATION_FAILED"
    ],
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED",
     "CSRF_INVALID",
     "ORIGIN_REJECTED"
    ],
    "409": [
     "LICENSE_DEPLOYMENT_MISMATCH",
     "LICENSE_ID_CONFLICT",
     "LICENSE_CURRENT_CHANGED",
     "LICENSE_IMPORT_CAPACITY_REQUIRED",
     "LICENSE_PREDECESSOR_REQUIRED",
     "LICENSE_PENDING_SUCCESSOR_EXISTS",
     "LICENSE_RENEWAL_WINDOW_INVALID",
     "STORAGE_COMMIT_OUTCOME_UNKNOWN"
    ],
    "413": [
     "PAYLOAD_TOO_LARGE"
    ],
    "415": [
     "UNSUPPORTED_MEDIA_TYPE"
    ],
    "421": [
     "MISDIRECTED_REQUEST"
    ],
    "422": [
     "LICENSE_ARTIFACT_INVALID"
    ],
    "429": [
     "RATE_LIMITED"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY",
     "LICENSE_CONFIGURATION_REQUIRED",
     "LICENSE_STORED_STATE_INVALID"
    ]
   }
  },
  {
   "id": "InspectLicenseFile",
   "method": "post",
   "path": "/api/v1/admin/license/inspections",
   "parameters": [],
   "body": {
    "$ref": "InspectLicense"
   },
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "LicenseInspectionResponse"
     }
    }
   ],
   "errors": {
    "400": [
     "VALIDATION_FAILED"
    ],
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED",
     "CSRF_INVALID",
     "ORIGIN_REJECTED"
    ],
    "413": [
     "PAYLOAD_TOO_LARGE"
    ],
    "415": [
     "UNSUPPORTED_MEDIA_TYPE"
    ],
    "421": [
     "MISDIRECTED_REQUEST"
    ],
    "429": [
     "RATE_LIMITED"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY",
     "LICENSE_CONFIGURATION_REQUIRED",
     "LICENSE_STORED_STATE_INVALID"
    ]
   }
  },
  {
   "id": "DownloadLicenseDiagnostics",
   "method": "get",
   "path": "/api/v1/admin/license/diagnostics",
   "parameters": [],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "LicenseDiagnostics"
     }
    }
   ],
   "errors": {
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED"
    ],
    "421": [
     "MISDIRECTED_REQUEST"
    ],
    "429": [
     "RATE_LIMITED"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY",
     "LICENSE_CONFIGURATION_REQUIRED",
     "LICENSE_STORED_STATE_INVALID"
    ]
   }
  },
  {
   "id": "GetPortalLicenseStatus",
   "method": "get",
   "path": "/api/v1/license/status",
   "parameters": [],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "PortalLicenseStateResponse"
     }
    }
   ],
   "errors": {
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED"
    ],
    "421": [
     "MISDIRECTED_REQUEST"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY",
     "LICENSE_CONFIGURATION_REQUIRED",
     "LICENSE_STORED_STATE_INVALID"
    ]
   }
  }
 ],
 "schemas": {
  "ImportLicense": {
   "type": "object",
   "required": [
    "artifact",
    "reason",
    "expected_current_license_id"
   ],
   "properties": {
    "artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 65536
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    },
    "expected_current_license_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "const": ""
      }
     ]
    }
   }
  },
  "InspectLicense": {
   "type": "object",
   "required": [
    "artifact"
   ],
   "properties": {
    "artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 65536
    }
   }
  },
  "LicenseCheck": {
   "type": "object",
   "required": [
    "name",
    "result"
   ],
   "properties": {
    "name": {
     "type": "string",
     "enum": [
      "format",
      "key",
      "signature",
      "terms",
      "deployment",
      "identity",
      "capacity",
      "renewal"
     ]
    },
    "result": {
     "type": "string",
     "enum": [
      "passed",
      "failed",
      "not_checked"
     ]
    }
   }
  },
  "LicenseDiagnostics": {
   "type": "object",
   "required": [
    "format_version",
    "state"
   ],
   "properties": {
    "format_version": {
     "type": "integer",
     "const": 1
    },
    "state": {
     "$ref": "LicenseState"
    }
   }
  },
  "LicenseFileTerms": {
   "type": "object",
   "required": [
    "license_id",
    "artifact_sha256",
    "customer_reference",
    "not_before",
    "expires_at",
    "grace_until",
    "deployment_id",
    "issued_at",
    "replaces_license_id"
   ],
   "properties": {
    "license_id": {
     "type": "string",
     "format": "uuid"
    },
    "artifact_sha256": {
     "type": "string"
    },
    "customer_reference": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "not_before": {
     "type": "string",
     "format": "date-time"
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "grace_until": {
     "type": "string",
     "format": "date-time"
    },
    "deployment_id": {
     "type": "string",
     "format": "uuid"
    },
    "issued_at": {
     "type": "string",
     "format": "date-time"
    },
    "replaces_license_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "const": ""
      }
     ]
    }
   }
  },
  "LicenseImportResult": {
   "type": "object",
   "required": [
    "state",
    "imported_license_id",
    "repeated"
   ],
   "properties": {
    "state": {
     "$ref": "LicenseState"
    },
    "imported_license_id": {
     "type": "string",
     "format": "uuid"
    },
    "repeated": {
     "type": "boolean"
    }
   }
  },
  "LicenseImportResultResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "LicenseImportResult"
    }
   }
  },
  "LicenseInspection": {
   "type": "object",
   "required": [
    "outcome",
    "code",
    "detail",
    "checks",
    "key_id",
    "trusted_key_id",
    "file",
    "state"
   ],
   "properties": {
    "outcome": {
     "type": "string",
     "enum": [
      "importable",
      "installed",
      "refused"
     ]
    },
    "code": {
     "type": "string",
     "enum": [
      "",
      "LICENSE_ARTIFACT_INVALID",
      "LICENSE_DEPLOYMENT_MISMATCH",
      "LICENSE_ID_CONFLICT",
      "LICENSE_IMPORT_CAPACITY_REQUIRED",
      "LICENSE_PREDECESSOR_REQUIRED",
      "LICENSE_PENDING_SUCCESSOR_EXISTS",
      "LICENSE_RENEWAL_WINDOW_INVALID"
     ]
    },
    "detail": {
     "type": "string",
     "enum": [
      "",
      "wrong_predecessor",
      "wrong_deployment",
      "issued_before_current",
      "starts_before_current",
      "starts_after_grace",
      "expires_no_later"
     ]
    },
    "checks": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "$ref": "LicenseCheck"
     }
    },
    "key_id": {
     "type": "string",
     "description": "The key the file names. Unproven unless the signature check passed; empty when the file is unreadable.",
     "maxLength": 64
    },
    "trusted_key_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "file": {
     "description": "Present only once the signature is proven.",
     "anyOf": [
      {
       "$ref": "LicenseFileTerms"
      },
      {
       "type": "null"
      }
     ]
    },
    "state": {
     "$ref": "LicenseState"
    }
   }
  },
  "LicenseInspectionResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "LicenseInspection"
    }
   }
  },
  "LicenseState": {
   "type": "object",
   "required": [
    "state",
    "new_business_allowed",
    "warning",
    "deployment_id",
    "current",
    "pending",
    "accepted_licenses",
    "history_head_license_id",
    "maximum_imports",
    "observed_at",
    "public_key_fingerprint"
   ],
   "properties": {
    "state": {
     "type": "string",
     "enum": [
      "missing",
      "not_yet_valid",
      "active",
      "grace",
      "expired",
      "clock_suspect"
     ]
    },
    "new_business_allowed": {
     "type": "boolean"
    },
    "warning": {
     "type": "boolean"
    },
    "deployment_id": {
     "type": "string",
     "format": "uuid"
    },
    "current": {
     "anyOf": [
      {
       "$ref": "LicenseSummary"
      },
      {
       "type": "null"
      }
     ]
    },
    "pending": {
     "anyOf": [
      {
       "$ref": "LicenseSummary"
      },
      {
       "type": "null"
      }
     ]
    },
    "accepted_licenses": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1024
    },
    "history_head_license_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "const": ""
      }
     ]
    },
    "maximum_imports": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1024
    },
    "observed_at": {
     "type": "string",
     "format": "date-time"
    },
    "public_key_fingerprint": {
     "type": "string"
    }
   }
  },
  "LicenseStateResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "LicenseState"
    }
   }
  },
  "LicenseSummary": {
   "type": "object",
   "required": [
    "license_id",
    "artifact_sha256",
    "customer_reference",
    "not_before",
    "expires_at",
    "grace_until"
   ],
   "properties": {
    "license_id": {
     "type": "string",
     "format": "uuid"
    },
    "artifact_sha256": {
     "type": "string"
    },
    "customer_reference": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "not_before": {
     "type": "string",
     "format": "date-time"
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "grace_until": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "PortalLicenseState": {
   "type": "object",
   "required": [
    "state",
    "new_business_allowed",
    "warning"
   ],
   "properties": {
    "state": {
     "type": "string",
     "enum": [
      "missing",
      "not_yet_valid",
      "active",
      "grace",
      "expired",
      "clock_suspect"
     ]
    },
    "new_business_allowed": {
     "type": "boolean"
    },
    "warning": {
     "type": "boolean"
    }
   }
  },
  "PortalLicenseStateResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "PortalLicenseState"
    }
   }
  }
 }
}
