 "schemas": {
  "BaseDeploymentObservation": {
   "type": "object",
   "required": [
    "deployment_id",
    "model_id",
    "catalog_digest",
    "gpu_uuid",
    "revision",
    "managed",
    "state",
    "ready"
   ],
   "properties": {
    "deployment_id": {
     "type": "string",
     "format": "uuid"
    },
    "model_id": {
     "type": "string",
     "format": "uuid"
    },
    "catalog_digest": {
     "type": "string",
     "const": "4d32aa5cd4b2d86f12beff791f0428f0813c2d3479041080d13b0be6bc6842bc"
    },
    "gpu_uuid": {
     "type": "string"
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "managed": {
     "type": "boolean"
    },
    "state": {
     "type": "string",
     "enum": [
      "running",
      "loading",
      "stopped",
      "not_installed",
      "unknown",
      "failed"
     ]
    },
    "ready": {
     "type": "boolean"
    },
    "container_id": {
     "type": "string"
    },
    "image_id": {
     "type": "string",
     "enum": [
      "sha256:a4a4c0437bf7240089da5f08aa370c4aee17ae5290f7a3b468825ee26c4c3a6b",
      "sha256:c76d0e2225a4b1cb1e2109ace39639f55e714abd1a7a427acc8b0bbd7f6a83b3"
     ]
    },
    "verification": {
     "$ref": "GenerationVerification"
    },
    "error_code": {
     "type": "string",
     "enum": [
      "",
      "INFERENCE_CANCELLED",
      "INFERENCE_CONFIGURATION_INVALID",
      "INFERENCE_CONTAINER_CONFLICT",
      "INFERENCE_DISK_SPACE_LOW",
      "INFERENCE_DOCKER_NOT_FOUND",
      "INFERENCE_DOCKER_REJECTED",
      "INFERENCE_DOCKER_SOCKET_INVALID",
      "INFERENCE_DOCKER_UNAVAILABLE",
      "INFERENCE_DRIVER_UNSUPPORTED",
      "INFERENCE_EGRESS_GUARD_UNAVAILABLE",
      "INFERENCE_GPU_BUSY",
      "INFERENCE_GPU_MEMORY_LOW",
      "INFERENCE_GPU_OOM",
      "INFERENCE_GPU_PROBE_INVALID",
      "INFERENCE_GPU_UNAVAILABLE",
      "INFERENCE_GPU_UNSUPPORTED",
      "INFERENCE_HOST_MEMORY_LOW",
      "INFERENCE_IMAGE_INVALID",
      "INFERENCE_IMAGE_MISSING",
      "INFERENCE_IMAGE_UNAVAILABLE",
      "INFERENCE_IO_FAILED",
      "INFERENCE_LOAD_TIMEOUT",
      "INFERENCE_MIG_UNSUPPORTED",
      "INFERENCE_MODEL_INVALID",
      "INFERENCE_NETWORK_CONFLICT",
      "INFERENCE_NOT_READY",
      "INFERENCE_NVIDIA_UNAVAILABLE",
      "INFERENCE_OOM",
      "INFERENCE_OPERATION_FAILED",
      "INFERENCE_OWNERSHIP_CONFLICT",
      "INFERENCE_PLATFORM_UNSUPPORTED",
      "INFERENCE_PORT_CONFLICT",
      "INFERENCE_RECOVERY_REQUIRED",
      "INFERENCE_RESOURCE_LIMITS_UNAVAILABLE",
      "INFERENCE_RESPONSE_INVALID",
      "INFERENCE_REVISION_CONFLICT",
      "INFERENCE_STATE_INVALID",
      "INFERENCE_TOOLKIT_UNAVAILABLE"
     ]
    }
   }
  },
  "CreateDeployment": {
   "type": "object",
   "required": [
    "node_id",
    "model_id",
    "gpu_uuid",
    "reason"
   ],
   "properties": {
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "model_id": {
     "type": "string",
     "format": "uuid"
    },
    "gpu_uuid": {
     "type": "string"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "Deployment": {
   "type": "object",
   "required": [
    "model_kind",
    "catalog_digest",
    "serving_recipe_sha256",
    "id",
    "workspace_id",
    "node_id",
    "model_id",
    "gpu_uuid",
    "desired_state",
    "observed_state",
    "revision",
    "observation",
    "observed_at",
    "last_task_id",
    "task_state",
    "task_error_code",
    "task_deadline_at",
    "resource_state",
    "stale",
    "created_at",
    "removed_at"
   ],
   "properties": {
    "model_kind": {
     "type": "string",
     "enum": [
      "approved_base",
      "merged_lora"
     ]
    },
    "catalog_digest": {
     "type": "string"
    },
    "serving_recipe_sha256": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "model_id": {
     "type": "string",
     "format": "uuid"
    },
    "gpu_uuid": {
     "type": "string"
    },
    "desired_state": {
     "type": "string",
     "enum": [
      "running",
      "stopped",
      "removed"
     ]
    },
    "observed_state": {
     "type": "string",
     "enum": [
      "running",
      "loading",
      "stopped",
      "not_installed",
      "unknown",
      "failed"
     ]
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "observation": {
     "anyOf": [
      {
       "$ref": "DeploymentObservation"
      },
      {
       "type": "null"
      }
     ]
    },
    "observed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "last_task_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "task_state": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "task_error_code": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "task_deadline_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "resource_state": {
     "type": "string",
     "enum": [
      "held",
      "released",
      "recovery_required"
     ]
    },
    "stale": {
     "type": "boolean"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "removed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "DeploymentAction": {
   "type": "object",
   "required": [
    "action",
    "revision",
    "reason"
   ],
   "properties": {
    "action": {
     "type": "string",
     "enum": [
      "deploy",
      "stop",
      "remove",
      "observe",
      "verify"
     ]
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
