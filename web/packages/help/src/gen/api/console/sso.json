 ],
 "schemas": {
  "CreateSSOConnector": {
   "type": "object",
   "required": [
    "id",
    "name",
    "provider",
    "origin",
    "client_id",
    "enabled",
    "client_secret",
    "reason"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "provider": {
     "type": "string",
     "enum": [
      "gitea"
     ]
    },
    "origin": {
     "type": "string",
     "format": "uri",
     "maxLength": 2048
    },
    "client_id": {
     "type": "string",
     "format": "uuid"
    },
    "enabled": {
     "type": "boolean"
    },
    "client_secret": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "PublicSSOConnector": {
   "type": "object",
   "required": [
    "id",
    "name",
    "provider"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "provider": {
     "type": "string",
     "enum": [
      "gitea"
     ]
    }
   }
  },
  "PublicSSOConnectorListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "items"
     ],
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 64,
       "items": {
        "$ref": "PublicSSOConnector"
       }
      }
     }
    }
   }
  },
  "SSOBinding": {
   "type": "object",
   "required": [
    "id",
    "connector_id",
    "name",
    "provider",
    "subject",
    "active",
    "revision",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "connector_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "provider": {
     "type": "string",
     "enum": [
      "gitea"
     ]
    },
    "subject": {
     "type": "string",
     "description": "Canonical positive signed int64, never a floating point number or an email address."
    },
    "active": {
     "type": "boolean"
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "SSOBindingListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "items"
     ],
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 256,
       "items": {
        "$ref": "SSOBinding"
       }
      }
     }
    }
   }
  },
  "SSOBindingResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SSOBinding"
    }
   }
  },
  "SSOConfiguration": {
   "type": "object",
   "required": [
    "enabled",
    "providers",
    "callback_origins"
   ],
   "properties": {
    "enabled": {
     "type": "boolean",
     "description": "Whether single sign-on is on. When off, connectors still list, and creating or enabling one is refused with SSO_DISABLED."
    },
    "providers": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "object",
      "required": [
       "provider",
       "origin"
      ],
      "properties": {
       "provider": {
        "type": "string",
        "enum": [
         "gitea"
        ]
       },
       "origin": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
       }
      }
     }
    },
    "callback_origins": {
     "type": "array",
     "description": "Entrance origins, portal first; a provider must accept {origin}/api/v1/auth/sso/{connector_id}/callback for each. Empty when an entrance is not HTTPS.",
     "maxItems": 2,
     "items": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
     }
    }
   }
  },
  "SSOConfigurationResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SSOConfiguration"
    }
   }
  },
  "SSOConnector": {
   "type": "object",
   "required": [
    "id",
    "name",
    "provider",
    "origin",
    "client_id",
    "enabled",
    "revision",
    "auth_version",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "provider": {
     "type": "string",
     "enum": [
      "gitea"
     ]
    },
    "origin": {
     "type": "string",
     "format": "uri",
     "maxLength": 2048
    },
    "client_id": {
     "type": "string",
     "format": "uuid"
    },
    "enabled": {
     "type": "boolean"
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "auth_version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "SSOConnectorCheck": {
   "type": "object",
   "required": [
    "connector_id",
    "outcome",
    "callback_url",
    "provider_error",
    "checked_at"
   ],
   "properties": {
    "connector_id": {
     "type": "string",
     "format": "uuid"
    },
    "outcome": {
     "type": "string",
     "description": "passed: credentials and every callback were accepted. not_configured: the origin is no longer approved, and nothing was sent. unreachable: no answer over the configured addresses. certificate_untrusted: the provider's certificate is not trusted by the configured CA. credentials_rejected: the client ID or secret was refused. callback_not_registered: the provider refused callback_url. unexpected_answer: an answer the check does not know.",
     "enum": [
      "passed",
      "not_configured",
      "unreachable",
      "certificate_untrusted",
      "credentials_rejected",
      "callback_not_registered",
      "unexpected_answer"
     ]
    },
    "callback_url": {
     "description": "The callback the provider refused, for callback_not_registered.",
     "anyOf": [
      {
       "type": "string",
       "format": "uri",
       "maxLength": 2048
      },
      {
       "type": "null"
      }
     ]
    },
    "provider_error": {
     "description": "The provider's OAuth error code, for unexpected_answer, when it is one.",
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "checked_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "SSOConnectorCheckResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SSOConnectorCheck"
    }
   }
  },
  "SSOConnectorPageResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "items",
      "next_cursor"
     ],
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 100,
       "items": {
        "$ref": "SSOConnector"
       }
      },
      "next_cursor": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 2048
        },
        {
         "type": "null"
        }
       ]
      }
     }
    }
   }
  },
  "SSOConnectorResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SSOConnector"
    }
   }
  },
  "SSOStart": {
   "type": "object",
   "required": [
    "authorization_url",
    "expires_at"
   ],
   "properties": {
    "authorization_url": {
     "type": "string",
     "format": "uri",
     "maxLength": 8192
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "SSOStartResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SSOStart"
    }
   }
  },
  "StartSSO": {
   "type": "object",
   "required": [
    "mode",
    "password",
    "reason"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "login",
      "link"
     ]
    },
    "password": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 4096
      },
      {
       "type": "null"
      }
     ]
    },
    "reason": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 500
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "allOf": [
    {},
    {}
   ]
  },
  "UnlinkSSOBinding": {
   "type": "object",
   "required": [
    "revision",
    "password",
    "reason"
   ],
   "properties": {
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "password": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "UpdateSSOConnector": {
   "type": "object",
   "required": [
    "revision",
    "name",
    "enabled",
    "client_id",
    "client_secret",
    "reason"
   ],
   "properties": {
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "enabled": {
     "type": "boolean"
    },
    "client_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "client_secret": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 4096
