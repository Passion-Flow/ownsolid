    "generation",
    "requested_at"
   ],
   "properties": {
    "event_id": {
     "type": "string",
     "format": "uuid"
    },
    "delivery_id": {
     "type": "string",
     "format": "uuid"
    },
    "generation": {
     "type": "integer",
     "minimum": 2
    },
    "requested_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "RetryRequest": {
   "type": "object",
   "required": [
    "generation",
    "reason"
   ],
   "properties": {
    "generation": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483646
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  }
