 "schemas": {
  "DeadLetter": {
   "type": "object",
   "required": [
    "id",
    "event_id",
    "generation",
    "kind",
    "outcome_unknown",
    "error_code",
    "created_at",
    "retried_at",
    "next_generation"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "event_id": {
     "type": "string",
     "format": "uuid"
    },
    "generation": {
     "type": "integer",
     "minimum": 1
    },
    "kind": {
     "enum": [
      "publish",
      "consume",
      "expiry"
     ]
    },
    "outcome_unknown": {
     "type": "boolean"
    },
    "error_code": {
     "type": "string"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "retried_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "next_generation": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 2
    }
   }
  },
  "DeadLetterPage": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "DeadLetter"
     }
    },
    "next_cursor": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "Delivery": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "node_id",
    "task_id",
    "operation",
    "task_state",
    "state",
    "outcome_unknown",
    "can_retry",
    "generation",
    "publish_attempts",
    "consume_attempts",
    "error_code",
    "created_at",
    "updated_at",
    "expires_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "task_id": {
     "type": "string",
     "format": "uuid"
    },
    "operation": {
     "type": "string"
    },
    "task_state": {
     "enum": [
      "pending",
      "running",
      "succeeded",
      "failed",
      "cancelled"
     ]
    },
    "state": {
     "enum": [
      "prepared",
      "sent",
      "published",
      "received",
      "obsolete",
      "dead"
     ]
    },
    "outcome_unknown": {
     "type": "boolean"
    },
    "can_retry": {
     "type": "boolean"
    },
    "generation": {
     "type": "integer",
     "minimum": 1
    },
    "publish_attempts": {
     "type": "integer",
     "minimum": 0
    },
    "consume_attempts": {
     "type": "integer",
     "minimum": 0
    },
    "error_code": {
     "type": [
      "string",
      "null"
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    }
   }
