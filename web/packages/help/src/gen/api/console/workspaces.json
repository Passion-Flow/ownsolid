  {
   "id": "listAdminWorkspaces",
   "method": "get",
   "path": "/api/v1/admin/workspaces",
   "parameters": [
    {
     "name": "limit",
     "in": "query",
     "required": false,
     "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     },
     "description": "Omitted limit uses the public runtime.ui.page_size policy (shipped default20). Explicit limits remain1-100."
    },
    {
     "name": "cursor",
     "in": "query",
     "required": false,
     "schema": {
      "type": "string",
      "maxLength": 512
     },
     "description": "Opaque strict seek cursor bound to list kind,current tenant,Workspace where applicable,audience and actor. Invalid or old scope cursors return INVALID_CURSOR;restart with First page."
    },
    {
     "name": "q",
     "in": "query",
     "required": false,
     "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "description": "Only workspaces with this text anywhere in the name, in any case."
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "WorkspaceListResponse"
     }
    }
   ],
   "errors": {
    "400": [
     "INVALID_CURSOR",
     "VALIDATION_FAILED"
    ],
    "401": [
     "AUTH_REQUIRED",
     "AUTH_SESSION_EXPIRED"
    ],
    "403": [
     "ACCESS_DENIED"
    ],
    "404": [
     "RESOURCE_NOT_FOUND"
    ],
    "503": [
     "STORAGE_UNAVAILABLE",
     "SERVICE_NOT_READY"
    ]
   }
  },
