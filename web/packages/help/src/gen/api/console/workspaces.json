   ],
   "properties": {
    "email": {
     "type": "string",
     "maxLength": 320
    },
    "role": {
     "type": "string",
     "enum": [
      "owner",
      "member",
      "viewer"
     ]
    }
   }
  },
  "CreateWorkspace": {
   "type": "object",
   "required": [
    "name",
    "owner_user_id"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 400
    },
    "owner_user_id": {
     "type": "string",
     "format": "uuid",
     "description": "Canonical lowercase nonzero UUID."
    }
   }
  },
  "Membership": {
   "type": "object",
   "required": [
    "user_id",
    "email",
    "display_name",
    "user_status",
    "role",
    "version",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "user_id": {
     "type": "string",
     "format": "uuid",
     "description": "Canonical lowercase nonzero UUID."
    },
    "email": {
     "type": "string",
     "maxLength": 254
    },
    "display_name": {
     "type": "string",
     "maxLength": 100
    },
    "user_status": {
     "type": "string",
     "enum": [
      "active",
      "disabled"
     ]
    },
    "role": {
     "type": "string",
     "enum": [
      "owner",
      "member",
      "viewer"
     ]
    },
    "version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "MembershipListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "items",
      "next_cursor"
     ],
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 100,
       "items": {
        "$ref": "Membership"
       }
      },
      "next_cursor": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 512
      }
     }
    }
   }
  },
  "MembershipResponse": {
   "type": "object",
   "required": [
    "data"
