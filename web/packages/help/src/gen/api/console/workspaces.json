     "description": "Canonical lowercase nonzero UUID."
    },
    "state": {
     "type": "string",
     "enum": [
      "committed",
      "unconfirmed"
     ]
    },
    "event": {
     "anyOf": [
      {
       "$ref": "OperationEvent"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "allOf": [
