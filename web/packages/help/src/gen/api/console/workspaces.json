    }
   }
  },
  "OperationEvent": {
   "type": "object",
   "required": [
    "action",
    "workspace_id",
    "target_type",
    "target_id"
   ],
   "properties": {
    "action": {
     "type": "string",
     "enum": [
      "workspace.created",
      "workspace.updated",
      "workspace.archived",
      "workspace.restored",
      "workspace.member_added",
      "workspace.member_updated",
      "workspace.member_removed",
      "workspace.note_created",
      "workspace.note_updated",
      "workspace.note_deleted"
     ]
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid",
     "description": "Canonical lowercase nonzero UUID."
    },
    "target_type": {
     "type": "string",
     "enum": [
      "workspace",
      "workspace_membership",
      "workspace_note"
     ]
    },
    "target_id": {
     "type": "string",
     "format": "uuid",
     "description": "Canonical lowercase nonzero UUID."
    }
   }
  },
