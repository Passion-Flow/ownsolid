{
 "title": "ownsolid offline localization",
 "operations": [
  {
   "id": "GetLocalizationCatalog",
   "method": "get",
   "path": "/api/v1/localization/catalog",
   "parameters": [],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "LocalizationCatalogResponse"
     }
    }
   ],
   "errors": {}
  },
  {
   "id": "GetLocalizationPackage",
   "method": "get",
   "path": "/api/v1/localization/packages/{sha256}",
   "parameters": [
    {
     "name": "sha256",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "type": "string",
      "format": "binary"
     }
    }
   ],
   "errors": {}
  },
  {
   "id": "GetLocalizationFont",
   "method": "get",
   "path": "/api/v1/localization/fonts/{sha256}",
   "parameters": [
    {
     "name": "sha256",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": null
    }
   ],
   "errors": {}
  },
  {
   "id": "GetLocalizationAsset",
   "method": "get",
   "path": "/api/v1/localization/assets/{sha256}",
   "parameters": [
    {
     "name": "sha256",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": null
    }
   ],
   "errors": {}
  }
 ],
 "schemas": {
  "LocalizationCatalogResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "source_sha256",
      "locales",
      "limits"
     ],
     "properties": {
      "source_sha256": {
       "type": "string"
      },
      "locales": {
       "type": "array",
       "maxItems": 256,
       "items": {
        "type": "object",
        "required": [
         "locale",
         "display_name",
         "english_name",
         "aliases",
         "direction",
         "package_sha256",
         "package_url",
         "translation_state",
         "review_state",
         "google_translated_complete",
         "fonts",
         "formatting"
        ],
        "properties": {
         "locale": {
          "type": "string",
          "minLength": 1
         },
         "display_name": {
          "type": "string",
          "minLength": 1
         },
         "english_name": {
          "type": "string",
          "minLength": 1
         },
         "aliases": {
          "type": "array",
          "maxItems": 4,
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "direction": {
          "enum": [
           "ltr",
           "rtl"
          ]
         },
         "package_sha256": {
          "type": "string"
         },
         "package_url": {
          "type": "string"
         },
         "translation_state": {
          "enum": [
           "canonical_English_source",
           "first_party_seed_pending_Google_review",
           "google_generated_human_reviewed"
          ]
         },
         "review_state": {
          "enum": [
           "pending",
           "approved"
          ]
         },
         "google_translated_complete": {
          "type": "boolean"
         },
         "fonts": {
          "type": "array",
          "maxItems": 256,
          "items": {
           "type": "object",
           "required": [
            "sha256",
            "license_sha256",
            "family",
            "format",
            "weight",
            "style"
           ],
           "properties": {
            "sha256": {
             "type": "string"
            },
            "license_sha256": {
             "type": "string"
            },
            "family": {
             "type": "string",
             "minLength": 1
            },
            "format": {
             "const": "truetype"
            },
            "weight": {
             "const": "100 900"
            },
            "style": {
             "const": "normal"
            }
           }
          }
         },
         "formatting": {
          "type": "object",
          "required": [
           "plural_categories",
           "plural_rules_supported",
           "number_format_supported",
           "date_format_supported"
          ],
          "properties": {
           "plural_categories": {
            "type": "array",
            "maxItems": 6,
            "items": {
             "type": "string",
             "enum": [
              "zero",
              "one",
              "two",
              "few",
              "many",
              "other"
             ]
            }
           },
           "plural_rules_supported": {
            "type": "boolean"
           },
           "number_format_supported": {
            "type": "boolean"
           },
           "date_format_supported": {
            "type": "boolean"
           },
           "google_code": {
            "type": "string",
            "minLength": 1
           },
           "locale": {
            "type": "string",
            "minLength": 1
           },
           "likely_script": {
            "type": "string",
            "minLength": 1
           },
           "direction": {
            "type": "string",
            "minLength": 1
           },
           "resolved_plural_locale": {
            "type": "string",
            "minLength": 1
           },
           "resolved_number_locale": {
            "type": "string",
            "minLength": 1
           },
           "resolved_date_locale": {
            "type": "string",
            "minLength": 1
           },
           "metadata_status": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        }
       }
      },
      "limits": {
       "type": "object",
       "required": [
        "package_bytes",
        "font_bytes",
        "aggregate_bytes",
        "maximum_messages",
        "maximum_fonts"
       ],
       "properties": {
        "package_bytes": {
         "type": "integer",
         "minimum": 65536,
         "maximum": 4194304
        },
        "font_bytes": {
         "type": "integer",
         "minimum": 1048576,
         "maximum": 134217728
        },
        "aggregate_bytes": {
         "type": "integer",
         "minimum": 4194304,
         "maximum": 268435456
        },
        "maximum_messages": {
         "type": "integer",
         "minimum": 2000,
         "maximum": 20000
        },
        "maximum_fonts": {
         "type": "integer",
         "minimum": 1,
         "maximum": 256
        }
       }
      }
     }
    }
   }
  }
 }
}
