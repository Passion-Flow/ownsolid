      "running",
      "stopped",
      "not_installed",
      "unknown"
     ]
    },
    "observed_at": {
     "type": "string",
     "format": "date-time"
    },
    "error_code": {
     "type": "string",
     "enum": [
      "",
      "COMPONENT_SYSTEMD_UNAVAILABLE",
