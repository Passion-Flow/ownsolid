      "COMPONENT_INTERRUPTED"
     ]
    },
    "metrics": {
     "$ref": "ComponentMetrics"
    },
    "config": {
     "$ref": "ComponentConfig"
    },
    "previous_version": {
     "type": "string",
     "enum": [
      "1.12.0",
      "1.12.1"
     ]
    },
    "maintenance_error": {
     "type": "string",
     "enum": [
      "",
      "COMPONENT_SYSTEMD_UNAVAILABLE",
      "COMPONENT_PRIVILEGE_REQUIRED",
      "COMPONENT_USER_INVALID",
      "COMPONENT_CONFLICT",
      "COMPONENT_PORT_CONFLICT",
      "COMPONENT_DISK_SPACE_LOW",
      "COMPONENT_ASSET_UNAVAILABLE",
      "COMPONENT_ASSET_INVALID",
      "COMPONENT_ARCHIVE_INVALID",
      "COMPONENT_ARCHITECTURE_MISMATCH",
      "COMPONENT_STATE_INVALID",
      "COMPONENT_IO_FAILED",
      "COMPONENT_SERVICE_FAILED",
      "COMPONENT_METRICS_UNAVAILABLE",
      "COMPONENT_METRICS_INVALID",
      "COMPONENT_CANCELLED",
      "COMPONENT_PROFILE_UNAVAILABLE",
      "COMPONENT_CONFIG_INVALID",
      "COMPONENT_VERSION_UNSUPPORTED",
      "COMPONENT_VERSION_CONFLICT",
      "COMPONENT_UPGRADE_NOT_FORWARD",
      "COMPONENT_ROLLBACK_UNAVAILABLE",
      "COMPONENT_ROLLBACK_FAILED",
      "COMPONENT_UPDATE_ROLLED_BACK",
      "COMPONENT_LOGS_UNAVAILABLE",
      "COMPONENT_LOGS_TOO_LARGE",
      "COMPONENT_LOGS_INVALID",
      "COMPONENT_MAINTENANCE_REQUIRED",
      "COMPONENT_INTERRUPTED"
     ]
    },
    "maintenance_cause": {
     "type": "string",
     "enum": [
      "",
      "COMPONENT_SYSTEMD_UNAVAILABLE",
      "COMPONENT_PRIVILEGE_REQUIRED",
      "COMPONENT_USER_INVALID",
      "COMPONENT_CONFLICT",
      "COMPONENT_PORT_CONFLICT",
      "COMPONENT_DISK_SPACE_LOW",
      "COMPONENT_ASSET_UNAVAILABLE",
      "COMPONENT_ASSET_INVALID",
      "COMPONENT_ARCHIVE_INVALID",
      "COMPONENT_ARCHITECTURE_MISMATCH",
      "COMPONENT_STATE_INVALID",
      "COMPONENT_IO_FAILED",
      "COMPONENT_SERVICE_FAILED",
      "COMPONENT_METRICS_UNAVAILABLE",
      "COMPONENT_METRICS_INVALID",
      "COMPONENT_CANCELLED",
      "COMPONENT_PROFILE_UNAVAILABLE",
      "COMPONENT_CONFIG_INVALID",
      "COMPONENT_VERSION_UNSUPPORTED",
      "COMPONENT_VERSION_CONFLICT",
      "COMPONENT_UPGRADE_NOT_FORWARD",
      "COMPONENT_ROLLBACK_UNAVAILABLE",
      "COMPONENT_ROLLBACK_FAILED",
      "COMPONENT_UPDATE_ROLLED_BACK",
      "COMPONENT_LOGS_UNAVAILABLE",
      "COMPONENT_LOGS_TOO_LARGE",
      "COMPONENT_LOGS_INVALID",
      "COMPONENT_MAINTENANCE_REQUIRED",
      "COMPONENT_INTERRUPTED"
     ]
    }
   }
  },
  "RecipeAvailability": {
   "type": "object",
   "required": [
    "version",
    "available",
    "forward_upgrade"
   ],
   "properties": {
    "version": {
     "type": "string",
     "enum": [
      "1.12.0",
      "1.12.1"
     ]
    },
    "available": {
     "type": "boolean"
    },
    "forward_upgrade": {
     "type": "boolean"
    }
   }
  },
  "Task": {
   "type": "object",
   "required": [
    "id",
    "tenant_id",
    "workspace_id",
    "node_id",
    "operation",
    "state",
    "attempt",
    "error_code",
    "created_at",
    "updated_at",
    "deadline_at",
    "completed_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "operation": {
     "type": "string",
     "enum": [
      "collect_facts.v1",
      "node_exporter.install.v1",
      "node_exporter.start.v1",
      "node_exporter.stop.v1",
      "node_exporter.remove.v1",
      "node_exporter.observe.v1",
      "node_exporter.configure.v1",
      "node_exporter.restart.v1",
      "node_exporter.upgrade.v1",
      "node_exporter.rollback.v1",
      "node_exporter.logs.v1",
      "inference.deploy.v1",
      "inference.stop.v1",
      "inference.remove.v1",
      "inference.observe.v1",
      "inference.verify.v1",
      "inference.deploy.v1",
      "inference.stop.v1",
      "inference.remove.v1",
      "inference.observe.v1",
      "inference.verify.v1",
      "inference.deploy.v1",
      "inference.stop.v1",
      "inference.remove.v1",
      "inference.observe.v1",
      "inference.verify.v1",
      "training.run.v1",
      "training.run.v1",
      "training.run.v1",
      "model.prepare.v1",
      "model.prepare.v1",
      "model.prepare.v1",
      "inference.derived.v1",
      "inference.derived.v1",
      "inference.derived.v1"
     ]
    },
    "state": {
     "type": "string",
     "enum": [
      "pending",
      "running",
      "succeeded",
      "failed",
      "cancelled"
     ]
    },
    "attempt": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "error_code": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    },
    "deadline_at": {
     "type": "string",
     "format": "date-time"
    },
    "completed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "TaskResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
