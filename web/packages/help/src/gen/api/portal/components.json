{
 "title": "Project-one Components",
 "operations": [
  {
   "id": "getPortalComponent",
   "method": "get",
   "path": "/api/v1/sites/{site_id}/cells/{cell_id}/workspaces/{workspace_id}/nodes/{node_id}/components/node-exporter",
   "parameters": [
    {
     "name": "site_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    },
    {
     "name": "cell_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string"
     }
    },
    {
     "name": "workspace_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string",
      "format": "uuid"
     }
    },
    {
     "name": "node_id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "string",
      "format": "uuid"
     }
    }
   ],
   "body": null,
   "responses": [
    {
     "status": "200",
     "schema": {
      "$ref": "ComponentStateResponse"
     }
    }
   ],
   "errors": {}
  }
 ],
 "schemas": {
  "ComponentConfig": {
   "type": "object",
   "required": [
    "log_level",
    "max_scrape_requests"
   ],
   "properties": {
    "log_level": {
     "type": "string",
     "enum": [
      "debug",
      "info",
      "warn",
      "error"
     ]
    },
    "max_scrape_requests": {
     "type": "integer",
     "minimum": 1,
     "maximum": 40
    }
   }
  },
  "ComponentMetrics": {
   "type": "object",
   "required": [
    "cpu_seconds_total",
    "cpu_idle_seconds_total",
    "memory_total_bytes",
    "memory_available_bytes",
    "filesystem_total_bytes",
    "filesystem_available_bytes"
   ],
   "properties": {
    "cpu_seconds_total": {
     "type": "number",
     "maximum": 9007199254740991
    },
    "cpu_idle_seconds_total": {
     "type": "number",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "memory_total_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "memory_available_bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "filesystem_total_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "filesystem_available_bytes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    }
   }
  },
  "ComponentState": {
   "type": "object",
   "required": [
    "node_id",
    "component",
    "version",
    "desired_state",
    "observation",
    "received_at",
    "stale",
    "management_available",
    "artifact_available",
    "last_task_id",
    "desired_version",
    "desired_config",
    "applied_config",
    "previous_version",
    "last_verified_at",
    "maintenance_available",
    "approved_versions",
    "removal_policy"
   ],
   "properties": {
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "component": {
     "type": "string",
     "const": "node_exporter"
    },
    "version": {
     "type": "string",
     "enum": [
      "1.12.0",
      "1.12.1"
     ]
    },
    "desired_state": {
     "type": "string",
     "enum": [
      "running",
      "stopped",
      "not_installed"
     ]
    },
    "observation": {
     "anyOf": [
      {
       "$ref": "MaintenanceObservation"
      },
      {
       "type": "null"
      }
     ]
    },
    "received_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "stale": {
     "type": "boolean"
    },
    "management_available": {
     "type": "boolean"
    },
    "artifact_available": {
     "type": "boolean"
    },
    "last_task_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "desired_version": {
     "type": "string",
     "enum": [
      "1.12.0",
      "1.12.1"
     ]
    },
    "desired_config": {
