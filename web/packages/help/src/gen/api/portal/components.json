      {
       "$ref": "ComponentConfig"
      },
      {
       "type": "null"
      }
     ]
    },
    "applied_config": {
     "anyOf": [
      {
       "$ref": "ComponentConfig"
      },
      {
       "type": "null"
      }
     ]
    },
    "previous_version": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "1.12.0",
        "1.12.1"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "last_verified_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "maintenance_available": {
     "type": "boolean"
    },
    "approved_versions": {
     "type": "array",
     "maxItems": 2,
     "items": {
      "$ref": "RecipeAvailability"
     }
    },
    "removal_policy": {
     "type": "string",
     "const": "owned_installation_only"
    }
   }
