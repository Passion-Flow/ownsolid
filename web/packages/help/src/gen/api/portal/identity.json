 "schemas": {
  "AcceptedResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "accepted"
     ],
     "properties": {
      "accepted": {
       "type": "boolean",
       "const": true
      }
     }
    }
   }
  },
  "BrowserSession": {
   "type": "object",
   "required": [
    "id",
    "current",
    "created_at",
    "last_seen_at",
    "absolute_expires_at",
    "authentication_method"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid",
     "maxLength": 36
    },
    "current": {
     "type": "boolean"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "last_seen_at": {
     "type": "string",
     "format": "date-time"
    },
    "absolute_expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "authentication_method": {
     "type": "string",
     "enum": [
      "password",
      "sso"
     ]
    }
   }
  },
  "BrowserSessionList": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "BrowserSession"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "BrowserSessionListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "BrowserSessionList"
    }
   }
  },
  "ChangePasswordRequest": {
   "type": "object",
   "required": [
    "current_password",
    "new_password"
   ],
   "properties": {
    "current_password": {
     "type": "string",
     "description": "The password the account signs in with now, as typed. Never trim or truncate.",
     "minLength": 1,
     "maxLength": 4096
    },
    "new_password": {
     "type": "string",
     "description": "NFC-normalize before semantic validation: 15-128 code points and <=512 UTF-8 bytes, local blocklist, different from the current password. Never trim or truncate.",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "CsrfResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "token",
      "expires_at"
     ],
     "properties": {
      "token": {
       "type": "string",
       "maxLength": 256
      },
      "expires_at": {
       "type": "string",
       "format": "date-time"
      }
     }
    }
   }
  },
  "HealthResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "type": "string",
       "enum": [
        "ok"
       ]
      }
     }
    }
   }
  },
  "InvitationValidationResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "email",
      "locale",
      "expires_at"
     ],
     "properties": {
      "email": {
       "type": "string",
       "maxLength": 254
      },
      "locale": {
       "type": "string",
       "minLength": 2,
       "maxLength": 35
      },
      "expires_at": {
       "type": "string",
       "format": "date-time"
      }
     }
    }
   }
  },
  "LoginRequest": {
   "type": "object",
   "required": [
    "email",
    "password"
   ],
   "properties": {
    "email": {
     "type": "string",
     "description": "Surrounding spaces are removed and the address takes its canonical ASCII form; at most 254 bytes.",
     "maxLength": 254
    },
    "password": {
     "type": "string",
     "description": "NFC-normalize before semantic validation. New password: 15-128 code points and <=512 UTF-8 bytes, local blocklist. Login verifies the bounded supplied value without exposing policy/account state. Never trim or truncate.",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "LoginResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "user",
      "workspace",
      "audience",
      "session"
     ],
     "properties": {
      "user": {
       "$ref": "User"
      },
      "workspace": {
       "oneOf": [
        {
         "$ref": "Workspace"
        },
        {
         "type": "null"
        }
       ]
      },
      "audience": {
       "type": "string",
       "enum": [
        "portal",
        "admin"
       ]
      },
      "session": {
       "type": "object",
       "required": [
        "absolute_expires_at",
        "idle_timeout_seconds"
       ],
       "properties": {
        "absolute_expires_at": {
         "type": "string",
         "format": "date-time"
        },
        "idle_timeout_seconds": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  },
  "MeData": {
   "type": "object",
   "required": [
    "user",
    "workspace",
    "audience"
   ],
   "properties": {
    "user": {
     "$ref": "User"
    },
    "workspace": {
     "oneOf": [
      {
       "$ref": "Workspace"
      },
      {
       "type": "null"
      }
     ]
    },
    "audience": {
     "type": "string",
     "enum": [
      "portal",
      "admin"
     ]
    }
   }
  },
  "MeResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "MeData"
    }
   }
  },
  "RecoveryRequest": {
   "type": "object",
   "required": [
    "email"
   ],
   "properties": {
    "email": {
     "type": "string",
     "description": "Surrounding spaces are removed and the address takes its canonical ASCII form; at most 254 bytes.",
     "maxLength": 254
    }
   }
  },
  "RegisterRequest": {
   "type": "object",
   "required": [
    "token",
    "display_name",
    "password"
   ],
   "properties": {
    "token": {
     "type": "string",
     "minLength": 43,
     "maxLength": 43
    },
    "display_name": {
     "type": "string",
     "description": "Trim and NFC-normalize; final 1-100 code points, at most 400 UTF-8 bytes; reject control characters.",
     "minLength": 1,
     "maxLength": 400
    },
    "password": {
     "type": "string",
     "description": "NFC-normalize before semantic validation. New password: 15-128 code points and <=512 UTF-8 bytes, local blocklist. Login verifies the bounded supplied value without exposing policy/account state. Never trim or truncate.",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "RegisterResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "registered"
     ],
     "properties": {
      "registered": {
       "type": "boolean",
       "const": true
      }
     }
    }
   }
  },
  "ResetRequest": {
   "type": "object",
   "required": [
    "token",
    "password"
   ],
   "properties": {
    "token": {
     "type": "string",
     "minLength": 43,
     "maxLength": 43
    },
    "password": {
     "type": "string",
     "description": "NFC-normalize before semantic validation. New password: 15-128 code points and <=512 UTF-8 bytes, local blocklist. Login verifies the bounded supplied value without exposing policy/account state. Never trim or truncate.",
     "minLength": 1,
     "maxLength": 4096
    }
   }
  },
  "ResetResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "type": "object",
     "required": [
      "reset"
     ],
     "properties": {
      "reset": {
       "type": "boolean",
       "const": true
      }
     }
    }
   }
  },
  "SessionStatus": {
   "type": "object",
   "required": [
    "idle_timeout_seconds",
    "idle_remaining_seconds",
    "absolute_remaining_seconds",
    "warning_seconds"
   ],
   "properties": {
    "idle_timeout_seconds": {
     "type": "integer",
     "description": "How long the session survives without activity.",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "idle_remaining_seconds": {
     "type": "integer",
     "description": "How long until it ends if nothing else happens.",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "absolute_remaining_seconds": {
     "type": "integer",
     "description": "How long until it ends regardless of activity.",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "warning_seconds": {
     "type": "integer",
     "description": "How long before the end to warn the person: the configured time, shortened to fit a short idle timeout.",
     "minimum": 1,
     "maximum": 9007199254740991
    }
   }
  },
  "SessionStatusResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "SessionStatus"
    }
   }
  },
  "TokenRequest": {
   "type": "object",
   "required": [
    "token"
   ],
   "properties": {
    "token": {
     "type": "string",
     "minLength": 43,
     "maxLength": 43
    }
   }
  },
  "UpdateMeRequest": {
   "type": "object",
   "required": [
    "display_name",
    "locale",
    "version"
   ],
   "properties": {
    "display_name": {
     "type": "string",
     "description": "Trim and NFC-normalize; final 1-100 code points, at most 400 UTF-8 bytes; reject control characters.",
     "minLength": 1,
     "maxLength": 400
    },
    "locale": {
     "type": "string",
     "minLength": 2,
     "maxLength": 35
    },
    "version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    }
   }
  },
  "User": {
   "type": "object",
   "required": [
    "id",
    "email",
    "display_name",
    "locale",
    "status",
    "is_platform_admin",
    "email_verified_at",
    "version",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "email": {
     "type": "string",
     "maxLength": 254
    },
    "display_name": {
     "type": "string",
     "maxLength": 100
    },
    "locale": {
     "type": "string",
     "minLength": 2,
     "maxLength": 35
    },
    "status": {
     "type": "string",
     "enum": [
      "active",
      "disabled"
     ]
    },
