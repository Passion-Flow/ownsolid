 "schemas": {
  "ActualUsage": {
   "type": "object",
   "required": [
    "prompt_tokens",
    "completion_tokens",
    "total_tokens"
   ],
   "properties": {
    "prompt_tokens": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65536
    },
    "completion_tokens": {
     "type": "integer",
     "minimum": 0,
     "maximum": 512
    },
    "total_tokens": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65536
    }
   }
  },
  "DistributionKey": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "alias_id",
    "alias_name",
    "label",
    "prefix",
    "created_by",
    "state",
    "created_at",
    "expires_at",
    "last_used_at",
    "revoked_at",
    "rotated_from",
    "replaced_by"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "alias_id": {
     "type": "string",
     "format": "uuid"
    },
    "alias_name": {
     "type": "string"
    },
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "prefix": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "created_by": {
     "type": "string",
     "format": "uuid"
    },
    "state": {
     "type": "string",
     "enum": [
      "active",
      "expired",
      "revoked",
      "invalidated",
      "unavailable"
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "last_used_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "revoked_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "rotated_from": {
     "description": "The key this one replaced, when it was issued by a rotation.",
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "replaced_by": {
     "description": "The key that replaced this one; until the overlap ends both work.",
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "DistributionKeyPage": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "DistributionKey"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "DistributionKeyPageResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "DistributionKeyPage"
    }
   }
  },
  "DistributionKeyResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "DistributionKey"
    }
   }
  },
  "GatewayOutcome": {
   "type": "object",
   "required": [
    "request_id",
    "status",
    "error_code",
    "usage",
    "elapsed_milliseconds",
    "output_started"
   ],
   "properties": {
    "request_id": {
     "type": "string",
     "format": "uuid"
    },
    "status": {
     "type": "string",
     "enum": [
      "succeeded",
      "client_cancelled",
      "upstream_timeout",
      "upstream_error",
      "invalid_response",
      "gateway_shutdown",
      "usage_storage_failed",
      "incomplete"
     ]
    },
    "error_code": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "client_cancelled",
        "context_length_exceeded",
        "upstream_unavailable",
        "upstream_timeout",
        "upstream_response_invalid",
        "gateway_unavailable",
        "gateway_shutdown",
        "usage_storage_unavailable",
        "gateway_interrupted"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "usage": {
     "anyOf": [
      {
       "$ref": "ActualUsage"
      },
      {
       "type": "null"
      }
     ]
    },
    "elapsed_milliseconds": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3600000
    },
    "output_started": {
     "type": "boolean"
    }
   }
  },
  "GatewayRequest": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "gateway_id",
