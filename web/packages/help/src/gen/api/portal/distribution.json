     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "gateway_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string"
    },
    "client_origin": {
     "type": "string",
     "format": "uri",
