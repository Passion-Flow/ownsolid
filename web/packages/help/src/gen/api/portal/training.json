 "schemas": {
  "CreateTrainingJob": {
   "type": "object",
   "required": [
    "workspace_id",
    "node_id",
    "model_id",
    "dataset_id",
    "dataset_version_id",
    "gpu_uuid",
    "configuration",
    "reason"
   ],
   "properties": {
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "model_id": {
     "type": "string",
     "format": "uuid"
    },
    "dataset_id": {
     "type": "string",
     "format": "uuid"
    },
    "dataset_version_id": {
     "type": "string",
     "format": "uuid"
    },
    "gpu_uuid": {
     "type": "string"
    },
    "configuration": {
     "$ref": "TrainingConfiguration"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "NVIDIAGPU": {
   "type": "object",
   "required": [
    "uuid",
    "name",
    "driver_version",
    "memory_total_mib",
    "memory_free_mib",
    "compute_capability",
    "mig_mode",
    "observed_at"
   ],
   "properties": {
    "uuid": {
     "type": "string"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "driver_version": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "memory_total_mib": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1048576
    },
    "memory_free_mib": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1048576
    },
    "compute_capability": {
     "type": "number",
     "minimum": 1,
     "maximum": 99
    },
    "mig_mode": {
     "type": "string",
     "enum": [
      "Disabled",
      "Enabled",
      "[N/A]",
      "N/A"
     ]
    },
    "observed_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "TrainingActionRequest": {
   "type": "object",
   "required": [
    "expected_revision",
    "reason"
   ],
   "properties": {
    "expected_revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "TrainingAttempt": {
   "type": "object",
   "required": [
    "id",
    "job_id",
    "node_id",
    "task_id",
    "attempt_number",
    "state",
    "resume_checkpoint_id",
    "last_event_sequence",
    "last_global_step",
    "error_code",
    "physical_stopped_at",
    "physical_stop_proof",
    "created_at",
    "started_at",
    "finished_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "job_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "task_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "attempt_number": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "state": {
     "type": "string",
     "enum": [
      "pending",
      "preparing",
      "running",
      "stopping",
      "succeeded",
      "cancelled",
      "failed",
      "recovery_required",
      "stopped"
     ]
    },
    "resume_checkpoint_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "last_event_sequence": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000
    },
    "last_global_step": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000
    },
    "error_code": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "physical_stopped_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "physical_stop_proof": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "control_never_delivered",
        "never_created",
        "owned_container_removed"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "started_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "finished_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "TrainingAttemptPage": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "TrainingAttempt"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 2048
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "TrainingAttemptPageResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "TrainingAttemptPage"
    }
   }
  },
  "TrainingCapabilities": {
   "type": "object",
   "required": [
    "enabled",
    "can_create",
    "configuration_defaults",
    "resources"
   ],
   "properties": {
    "enabled": {
     "type": "boolean"
    },
    "can_create": {
     "type": "boolean"
    },
    "configuration_defaults": {
     "$ref": "TrainingConfiguration"
    },
    "resources": {
     "$ref": "TrainingResources"
    }
   }
  },
  "TrainingCapabilitiesResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "TrainingCapabilities"
    }
   }
  },
  "TrainingCheckpoint": {
   "type": "object",
   "required": [
    "id",
    "job_id",
    "attempt_id",
    "global_step",
    "receipt_sha256",
    "created_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "job_id": {
     "type": "string",
     "format": "uuid"
    },
    "attempt_id": {
     "type": "string",
     "format": "uuid"
    },
    "global_step": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
