pnpm --dir apps/console exec vitest run --maxWorkers=1 src/activity-window.test.ts src/audit-read.test.tsx
pnpm --dir packages/i18n exec vitest run --maxWorkers=1 src/format.test.ts src/catalogs.test.ts
