#!/bin/bash
set -euo pipefail
run="$1"
cd "/Users/passion./Documents/Passion's WorkSpace/Development/lane-web/web/apps/console"
export npm_config_offline=true OWNSOLID_PLAYWRIGHT_PORT_OFFSET=24666
unset TMOUT PS1
export DEBUG=pw:webserver
if lsof -nP -iTCP:28976 -sTCP:LISTEN; then exit 1; fi
pnpm exec playwright test e2e/audit-read-recovery.spec.ts e2e/localization.spec.ts --grep 'finds explicit audit recovery in Help|audit (trail|activity) with (uncertain|partial) read recovery' --workers=2 --reporter=json --output="$run/discovery-localization-results" > "$run/discovery-localization.json" 2> "$run/discovery-localization.log"
