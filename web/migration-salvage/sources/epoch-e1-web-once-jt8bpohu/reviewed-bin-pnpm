#!/usr/bin/python3 -I
import json,os,sys,time
from pathlib import Path
args=sys.argv[1:];original=list(args);root=Path(os.environ['OWNSOLID_GATE_PACKET'])
if args and args[0]=='install':args.insert(1,'--offline')
if args and args[0] in ['--recursive','-r']:args.insert(1,'--workspace-concurrency=1')
if 'run' in args and '--workspace-concurrency=1' not in args:args.insert(0,'--workspace-concurrency=1')
if 'run' in args and 'test:browser' in args:args+=['--workers=1','--retries=0']
with (root/'pnpm-command-receipts.jsonl').open('a') as out:out.write(json.dumps({'cwd':os.getcwd(),'original':original,'effective':args,'pid':os.getpid()})+'\n')
os.execv('/Users/passion./.local/opt/node/bin/pnpm',['pnpm',*args])
