note=worktree/'docs/research/identity-audit-read-access.md'
old=note.read_text();assert '### Complete Web recovery gate' not in old
note.write_text(old+text)
assert git('diff','--name-only')=='docs/research/identity-audit-read-access.md'
(run/'evidence.diff').write_text(git('diff','--','docs/research/identity-audit-read-access.md')+'\n')
assert note.read_text().startswith(old)
subprocess.run(['git','diff','--check'],cwd=worktree,check=True)
subprocess.run(['git','add','docs/research/identity-audit-read-access.md'],cwd=worktree,check=True)
subprocess.run(['git','commit','-m','AUD-108: Record complete audit recovery gates','-m',f'Qualify exact source {source} with {console["expected"]} Console/{portal["expected"]} Portal Chromium passes and 38 existing conditional skips. Retain precise scripted/installed boundaries and reviewed screenshot inputs.'],cwd=worktree,check=True)
pub=Path(tempfile.mkdtemp(prefix='publication-',dir=root));(root/'publication-current-path').write_text(str(pub)+'\n')
(pub/'before').write_text(git('rev-parse','HEAD')+'\n')
invoke(['git','fetch','origin'],pub/'fetch.log')
invoke(['git','rebase','origin/main'],pub/'rebase.log')
(pub/'base').write_text(git('rev-parse','origin/main')+'\n')
(pub/'rebased-source').write_text(git('rev-parse','HEAD')+'\n')
diff=git('diff','--name-only',source,'HEAD','--',*browser_paths)
(pub/'browser-input-diff').write_text(diff+'\n' if diff else '')
if diff:raise SystemExit('Browser inputs changed after rebase; no push. A fresh complete gate is required.')
shutil.copy2(root/'workers.mk',pub/'workers.mk')
invoke(['bash',str(root/'publication-check.sh'),str(pub)],pub/'publication-check-output.log')
assert (pub/'stage').read_text().strip()=='complete' and (pub/'exit-status').read_text().strip()=='0'
assert not git('status','--porcelain')
(pub/'original-author-series').write_text(git('log','--reverse','--format=%H %an <%ae> %s','origin/main..HEAD')+'\n')
(pub/'original-author-series.patch').write_bytes(subprocess.check_output(['git','format-patch','--stdout','origin/main..HEAD'],cwd=worktree))
invoke(['git','push','origin','HEAD:main'],pub/'push.log')
(root/'published-source').write_text(git('rev-parse','HEAD')+'\n')
print('Fresh complete recovery gate and fast-forward publication completed.',flush=True)
