from pathlib import Path
import hashlib,json,re,shutil,subprocess,sys,tempfile
root=Path(sys.argv[1]);run=Path(sys.argv[2])
worktree=Path("/Users/passion./Documents/Passion's WorkSpace/Development/lane-web")
def git(*args):
 return subprocess.check_output(['git',*args],cwd=worktree,text=True).strip()
def invoke(args,log):
 with Path(log).open('w') as out:
  subprocess.run(args,cwd=worktree,stdout=out,stderr=subprocess.STDOUT,check=True)
def cases(suites):
 for suite in suites:
  for spec in suite.get('specs',[]):
   for test in spec.get('tests',[]):yield spec,test
  yield from cases(suite.get('suites',[]))
source=(run/'source').read_text().strip()
assert git('rev-parse','HEAD')==source
assert not git('status','--porcelain')
assert (run/'stage').read_text().strip()=='complete'
assert (run/'exit-status').read_text().strip()=='0'
reports={name:json.loads((run/(name+'-report.json')).read_text()) for name in ['console','portal']}
for name,report in reports.items():
 stats=report['stats']
 assert stats['unexpected']==0 and stats['flaky']==0 and stats['expected']>0,stats
 assert not report.get('errors'),report.get('errors')
 for spec,test in cases(report['suites']):
  assert len(test.get('results',[]))==1,(spec['title'],test.get('results'))
  assert all(result.get('retry',0)==0 for result in test['results'])
assert reports['console']['stats']['expected']==1191,reports['console']['stats']
assert reports['console']['stats']['skipped']==28,reports['console']['stats']
assert reports['portal']['stats']['expected']==410,reports['portal']['stats']
assert reports['portal']['stats']['skipped']==10,reports['portal']['stats']
new_cases=[(spec,test) for spec,test in cases(reports['console']['suites']) if spec.get('file','').endswith('audit-read-recovery.spec.ts')]
assert len(new_cases)==41,len(new_cases)
assert all(test['results'][0]['status']=='passed' for spec,test in new_cases)
browser_paths=['web','api','pkg/capabilities/declaration.json','tests/fixtures','tools/codegen/web-api.mjs','tools/codegen/web-help.mjs','Makefile']
focused_diff=git('diff','--name-only','7aa8b068',source,'--',*browser_paths)
allowed={'web/apps/console/e2e/audit-read-recovery.spec.ts','web/apps/console/e2e/node-page.spec.ts'}
assert set(focused_diff.splitlines())<=allowed,focused_diff
for path in focused_diff.splitlines():
 old_test=git('show','7aa8b068:'+path)
 new_test=git('show',source+':'+path)
 if path.endswith('audit-read-recovery.spec.ts'):
  assert re.sub(r'\s+','',old_test)==re.sub(r'\s+','',new_test)
 else:
  reviewed=json.loads((root/'reviewed-node-recovery-test.json').read_text())
  raw=subprocess.check_output(['git','show',source+':'+path],cwd=worktree)
  assert hashlib.sha256(raw).hexdigest()==reviewed['sha256']
 (run/(Path(path).stem+'-reviewed-test.diff')).write_text(git('diff','7aa8b068',source,'--',path)+'\n')
images=json.loads((root/'images-read.json').read_text())
assert len(images)==18,len(images)
for path,digest in images.items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
qualified={'source':source,'run':str(run),'stats':{n:r['stats'] for n,r in reports.items()},'imagesRead':images,'installedRun':False,'SQLRun':False,'focusedProductSource':'7aa8b068','focusedTestDifference':'Reviewed Help-action formatting and strengthened node-activity recovery assertions; product inputs unchanged','newRecoveryCases':len(new_cases)}
(root/'final-qualification.json').write_text(json.dumps(qualified,indent=2)+'\n')
console=reports['console']['stats'];portal=reports['portal']['stats']
text=f'''
