# Owner: workflows native acceptance fixture; absolute UTF-8 path to the existing
# protected Dameng ConnectionConfiguration JSON. Required; no default or inline
# password/DSN. The JSON references a private password file and pinned native
# manifest, and its validated typed policy owns connection/time/byte limits.
# Allowed: canonical absolute file path accepted by LoadConnectionConfiguration.
# This sole test-boundary environment value maps to that loader with no override
# env-file or competing runtime setting. Read once per test; restart test to change.
PROJECT_ONE_LOCALE_DAMENG_CONFIGURATION=

# Owner: workflows native acceptance fixture; exact disposable schema identifier.
# Required; no default. Allowed: M20_LOCALE_[A-F0-9]{32}_TEST, matching the above
# typed configuration Schema exactly. Nonsecret explicit ownership acknowledgement.
# It grants no production access and does not create/drop a schema. The operator
# must supply an exclusive migrated empty fixture and retain its cleanup inventory.
# Read once per test; no alternative source, reload or application runtime mapping.
PROJECT_ONE_LOCALE_DAMENG_DISPOSABLE_SCHEMA=
