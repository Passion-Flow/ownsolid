# Compose-only host staging directory; owner: deployment operator; absolute path, required, no default.
# Existing private0700 directory owned by the serving UID; contains no credentials. Bind source only;
# maps to the same typed staging_root target below. Explicit Compose --env-file; restart required.
PROJECT_ONE_OBJECT_STAGE_HOST_ROOT=/srv/projectone/object-staging
# Existing protected policy basename; owner: control deployment; string, required, no default.
# Must name the single protected policy file already mounted under /run/projectone. No contents/secrets;
# used by control --env-file, which overrides valid YAML. Compose --env-file interpolation; restart required.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=object-storage.env
# Container staging directory; owner: typed object_storage configuration; absolute canonical path,
# required, no default; must equal YAML object_storage.staging_root/effective protected policy value.
# No secret value. Compose maps this exact target; control --env-file owns runtime precedence; restart required.
PROJECT_ONE_OBJECT_STORAGE_STAGING_ROOT=/var/lib/projectone/object-staging
