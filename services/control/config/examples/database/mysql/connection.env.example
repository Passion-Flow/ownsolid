# Protected MySQL kernel overlay. Never source as shell.
# Precedence: explicit --env-file bytes > JSON > owned policy defaults.json. Ambient environment is ignored.
# All inputs are captured once; changes require pool/application restart. No hot reload.
# This example contains no working password, endpoint or complete MySQL product profile.

# Connection owner: explicit destination DNS name or IP; reject URLs, userinfo, unspecified/multicast addresses.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_HOST -> host; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_HOST='mysql.example.invalid'

# Connection owner: explicit TCP destination port, integer1..65535; no runtime port default.
# Type: integer, no default; range1..65535.
# Mapping: PROJECT_ONE_MYSQL_PORT -> port; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_PORT=3306

# Metadata owner: exact lowercase database name,1..64 ASCII letters/digits/underscores starting with a letter. No SQL override.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_DATABASE -> database; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_DATABASE='projectone'

# Security owner: exact provisioned MySQL account,1..32 ASCII letters/digits/underscores starting with a letter. No implicit root.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_USER -> user; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_USER='projectone_runtime'

# Security owner: canonical absolute single-link0600 password file under current-owner0700 parent. File reference only, never literal secret.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_PASSWORD_FILE -> password_file; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_PASSWORD_FILE='/run/projectone/mysql/password'

# TLS owner: canonical absolute single-link0600 PEM CA file under current-owner0700 parent, distinct from password. No verification bypass.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_CA_FILE -> ca_file; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_CA_FILE='/run/projectone/mysql/ca.pem'

# TLS owner: exact DNS/IP certificate identity; explicit SNI/SAN verification, no alias rewriting or plaintext fallback.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_SERVER_NAME -> server_name; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_SERVER_NAME='mysql.example.invalid'

# Release owner: exact approved8.4 patch version from pinned profile; no floating latest or version auto-upgrade.
# Type: literal UTF8 string; required, no working default.
# Mapping: PROJECT_ONE_MYSQL_EXPECTED_VERSION -> expected_version; explicit env > JSON; restart required.
PROJECT_ONE_MYSQL_EXPECTED_VERSION='8.4.12'

# Pool/transaction policy owner: maximum open connections.
# Type: integer connections; default4 from mysqlstore/defaults.json; allowed1..32.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_MAXIMUM_OPEN_CONNECTIONS -> policy.maximum_open_connections; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_MAXIMUM_OPEN_CONNECTIONS=4

# Pool/transaction policy owner: maximum idle connections.
# Type: integer connections; default1 from mysqlstore/defaults.json; allowed0..32.
# Zero explicitly disables idle pooling; must not exceed maximum_open_connections.
# Mapping: PROJECT_ONE_MYSQL_MAXIMUM_IDLE_CONNECTIONS -> policy.maximum_idle_connections; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_MAXIMUM_IDLE_CONNECTIONS=1

# Pool/transaction policy owner: connect seconds.
# Type: integer seconds; default5 from mysqlstore/defaults.json; allowed1..60.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_CONNECT_SECONDS -> policy.connect_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_CONNECT_SECONDS=5

# Pool/transaction policy owner: read seconds.
# Type: integer seconds; default10 from mysqlstore/defaults.json; allowed1..300.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_READ_SECONDS -> policy.read_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_READ_SECONDS=10

# Pool/transaction policy owner: write seconds.
# Type: integer seconds; default10 from mysqlstore/defaults.json; allowed1..300.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_WRITE_SECONDS -> policy.write_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_WRITE_SECONDS=10

# Pool/transaction policy owner: statement seconds.
# Type: integer seconds; default5 from mysqlstore/defaults.json; allowed1..300.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_STATEMENT_SECONDS -> policy.statement_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_STATEMENT_SECONDS=5

# Pool/transaction policy owner: transaction seconds.
# Type: integer seconds; default10 from mysqlstore/defaults.json; allowed1..300.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_TRANSACTION_SECONDS -> policy.transaction_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_TRANSACTION_SECONDS=10

# Pool/transaction policy owner: lock seconds.
# Type: integer seconds; default3 from mysqlstore/defaults.json; allowed1..60.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_LOCK_SECONDS -> policy.lock_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_LOCK_SECONDS=3

# Pool/transaction policy owner: maximum lifetime seconds.
# Type: integer seconds; default300 from mysqlstore/defaults.json; allowed1..86400.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_MAXIMUM_LIFETIME_SECONDS -> policy.maximum_lifetime_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_MAXIMUM_LIFETIME_SECONDS=300

# Pool/transaction policy owner: maximum idle seconds.
# Type: integer seconds; default60 from mysqlstore/defaults.json; allowed1..86400.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_MAXIMUM_IDLE_SECONDS -> policy.maximum_idle_seconds; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_MAXIMUM_IDLE_SECONDS=60

# Pool/transaction policy owner: maximum packet bytes.
# Type: integer bytes; default16777216 from mysqlstore/defaults.json; allowed1048576..67108864.
# No secret value; this does not disable TLS, parameter binding or authorization.
# Mapping: PROJECT_ONE_MYSQL_MAXIMUM_PACKET_BYTES -> policy.maximum_packet_bytes; env > JSON > owned default; restart required.
PROJECT_ONE_MYSQL_MAXIMUM_PACKET_BYTES=16777216

