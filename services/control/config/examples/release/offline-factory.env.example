# Offline factory component mapping. Copy to0600; never source this file.
# Explicit env-file > explicit JSON config > embedded versioned defaults. Ambient variables are ignored.
# All overrides apply on next command; no runtime process reload or live environment mutation.

# Factory owner -> Config.mount_root; string absolute path. Existing genuine nonroot external mount; required for all commands; no internal fallback.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MOUNT_ROOT=

# Factory owner -> Config.artifact_root; string absolute path. Existing owner-only canonical input directory beneath mount_root; required by validate/build.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_ARTIFACT_ROOT=

# Factory owner -> Config.manifest_file; string absolute path. Existing owner-only manifest JSON beneath mount_root; required by validate/build.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MANIFEST_FILE=

# Factory owner -> Config.trust_file; string absolute path. Existing owner-only independent public Ed25519 key map; required by build/inspect.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_TRUST_FILE=

# Factory owner -> Config.private_key_file; string absolute path. Existing owner-only base64 Ed25519 signing-key reference; required only by build, internal for real releases, never inside artifact_root. Synthetic tests explicitly use fixture-only keys.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_PRIVATE_KEY_FILE=

# Factory owner -> Config.output_file; string absolute path. New .tar.gz destination for build, existing bundle for inspect; beneath mount_root with existing owner-only parent. Existing output/incomplete/journal is preserved/refused for builds.
# No default; empty means missing and fails when the command requires it. Public path/reference; private_key_file is a sensitive reference, never a secret literal.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_OUTPUT_FILE=

# Factory owner -> Config.maximum_manifest_bytes; 1024..4194304 bytes.
# Nonsecret integer; default 1048576 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_MANIFEST_BYTES=1048576

# Factory owner -> Config.maximum_assets; 1..4096 entries.
# Nonsecret integer; default 512 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_ASSETS=512

# Factory owner -> Config.maximum_asset_bytes; 1..1099511627776 bytes.
# Nonsecret integer; default 34359738368 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_ASSET_BYTES=34359738368

# Factory owner -> Config.maximum_total_bytes; maximum_asset_bytes..4398046511104 bytes.
# Nonsecret integer; default 68719476736 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_TOTAL_BYTES=68719476736

# Factory owner -> Config.maximum_metadata_bytes; 1024..16777216 bytes aggregate OCI metadata.
# Nonsecret integer; default 4194304 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_METADATA_BYTES=4194304

# Factory owner -> Config.maximum_archive_entries; 16..131072 entries, outer count and each nested OCI archive.
# Nonsecret integer; default 16384 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_MAXIMUM_ARCHIVE_ENTRIES=16384

# Factory owner -> Config.timeout_seconds; 1..86400 seconds, whole operation context.
# Nonsecret integer; default 1800 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_TIMEOUT_SECONDS=1800

# Factory owner -> Config.compression_level; 1..9 gzip level.
# Nonsecret integer; default 1 from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_COMPRESSION_LEVEL=1

# Factory owner -> Config.allow_test_fixture; boolean exactly true or false; fixed fixture profile only, never a release qualification.
# Nonsecret boolean; default false from embedded factory-defaults.json. Empty or invalid fails; explicit false remains false.
# Explicit env-file overrides JSON/defaults; rerun the command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_FACTORY_ALLOW_TEST_FIXTURE=false

# Factory owner -> Config.minimum_free_bytes (also bundle Verification.minimum_free_bytes); integer bytes.
# Default0 keeps the historical30percent selected-filesystem floor. Positive1..1125899906842624 selects
# projected operation allocation plus exactly this fixed byte safety reserve, with no extra percentage floor.
# For the verified Project-one external data volume select34359738368 (32GiB reserve); outer M18 admission
# separately budgets32GiB peak+32GiB reserve. Zero does not disable admission. Negative/null/empty/invalid fails.
# Nonsecret policy; genuine mount/UID/ownership/immutable IO/durability guards remain mandatory. Host RAM/CPU
# and internal backing storage still need30percent headroom under the execution owner's resource checks.
# Explicit env-file overrides JSON/defaults; ambient variables ignored. Rerun command; no runtime reload.
PROJECT_ONE_OFFLINE_FACTORY_MINIMUM_FREE_BYTES=0
