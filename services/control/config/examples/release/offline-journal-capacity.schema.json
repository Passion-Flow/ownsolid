{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Explicit isolated journal capacity request",
 "type":"object","additionalProperties":false,
 "required":["format_version","expected_current_bytes","maximum_journal_bytes","reason"],
 "properties":{
  "format_version":{"const":1},
  "expected_current_bytes":{"type":"integer","minimum":16384,"maximum":16777215},
  "maximum_journal_bytes":{"type":"integer","minimum":16385,"maximum":16777216},
  "reason":{"type":"string","minLength":1,"maxLength":500}
 },
 "description":"Runtime also requires strictly increasing capacity, exact current expected value and a nonblank/control-free reason. No implicit expansion."
}
