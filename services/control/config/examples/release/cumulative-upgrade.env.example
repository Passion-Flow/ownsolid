# Effect: frozen at upgrade intent; later changes refuse; no application rebuild; changed reader policy requires new runtime generation.
PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_READINESS_DIAL_ADDRESS=127.0.0.1:8443

# Owner cumulative upgrade: Existing runtime payload certificate-only CA for direct HTTPS.
# Type/units/range/required/default: single safe basename; empty default allowed only for explicit HTTP by native probe; no trust bypass.
# Mapping: readiness_ca_name; explicit env-file overrides operation JSON on each invocation.
# Secret handling: reference/digest/public policy only; private key/DSN bytes remain in original protected scope.
# Effect: frozen at upgrade intent; later changes refuse; no application rebuild; changed reader policy requires new runtime generation.
PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_READINESS_CA_NAME=certificate.pem

# Owner cumulative upgrade: Bound each existing native readiness probe.
# Type/units/range/required/default: integer seconds; default5;1..60 and less than Compose command_seconds.
# Mapping: readiness_timeout_seconds; explicit env-file overrides operation JSON on each invocation.
# Secret handling: reference/digest/public policy only; private key/DSN bytes remain in original protected scope.
# Effect: frozen at upgrade intent; later changes refuse; no application rebuild; changed reader policy requires new runtime generation.
PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_READINESS_TIMEOUT_SECONDS=5

# Owner cumulative upgrade: Protected inventory of new MVP capability configuration files.
# Type/units/range: canonical absolute JSON file path; required for M17-to-MVP,
# omitted for M16-to-M17. An explicitly empty value is invalid; no guessed source.
# Mapping: mvp_configuration_files; this explicit env-file overrides operation JSON.
# The inventory supplies control-config/operator-config names, protected source_file
# references, exact bytes and SHA256; secret bytes never enter this env-file.
# Catalog targets: registry_release_mount_target is the independent readonly signed
# artifact mount; registry_mount_target must be exactly its /store child. Both are
# canonical absolute container paths, required only for the MVP edge and frozen
# with the protected catalog. See mvp-configuration-files.example.json; replace all
# example byte/digest placeholders with actual protected-source facts.
# Effect: frozen with the original upgrade intent; contents and mount closure must
# remain exact on reopen. Existing Control typed loaders validate capability values;
# no rebuild, ambient environment, UID/publisher override or new configuration authority.
# PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_MVP_CONFIGURATION_FILES=/verified-volume/private/mvp-configuration-files.json
