# Protected --operation-env-file; never load ambient shell configuration.
# Copy to0600 in an owned0700 parent; these examples contain no credential values.

# Owner cumulative upgrade: Existing complete separately unpacked signed M17 root.
# Type/units/range/required/default: canonical absolute directory; required; separate from scope and backup.
# Mapping: prepared_root; explicit env-file overrides operation JSON on each invocation.
# Secret handling: reference/digest/public policy only; private key/DSN bytes remain in original protected scope.
# Effect: frozen at upgrade intent; later changes refuse; no application rebuild; changed reader policy requires new runtime generation.
PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_PREPARED_ROOT=/verified-volume/m17-prepared

# Owner cumulative upgrade: Expected immutable target preparation archive identity.
# Type/units/range/required/default: lowercase SHA256; required.
# Mapping: expected_archive_sha256; explicit env-file overrides operation JSON on each invocation.
# Secret handling: reference/digest/public policy only; private key/DSN bytes remain in original protected scope.
# Effect: frozen at upgrade intent; later changes refuse; no application rebuild; changed reader policy requires new runtime generation.
PROJECT_ONE_OFFLINE_CUMULATIVE_UPGRADE_ARCHIVE_SHA256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Owner cumulative upgrade: Expected signed target manifest identity.
