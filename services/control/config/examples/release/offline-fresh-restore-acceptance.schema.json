{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit synthetic fresh effective restore acceptance expectations",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "source_scope_id", "source_manifest_sha256", "maximum_journal_bytes", "users", "datasets", "dataset_versions", "schema_version"],
  "properties": {
    "format_version": {"const": 1},
    "source_scope_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "maximum_journal_bytes": {"type": "integer", "minimum": 16384, "maximum": 16777216},
    "users": {"type": "integer", "minimum": 1, "maximum": 10000},
    "datasets": {"type": "integer", "minimum": 1, "maximum": 10000},
    "dataset_versions": {"type": "integer", "minimum": 1, "maximum": 10000},
    "schema_version": {"const": 16}
  }
}
