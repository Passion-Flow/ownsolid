# Control image producer. Copy to a protected0600 env file; never source as shell.
# Explicit CLI operation targets > explicit env-file > versioned resource defaults. No ambient build setting reads.
# All fields are nonsecret; no token, private key, customer data or working credential belongs here.

# Exact Linux architecture; producer owner -> --arch.
# String arm64 or amd64, required unless explicit CLI supplies it; no host-architecture fallback.
# Public input/reference only; CLI overrides explicit env. Restart the build process to apply, no service reload.
PROJECT_ONE_CONTROL_BUILD_ARCH=

# Unique local destination image tag; producer owner -> --tag.
# Explicit projectone/control tag; existing tags always preserved. Missing inherits the development profile prefix and architecture.
# Public input/reference only; CLI overrides explicit env. Restart the build process to apply, no service reload.
PROJECT_ONE_CONTROL_BUILD_TAG=

# New protected external result receipt; producer owner -> --manifest.
# Absolute uncreated path beneath verified state root with a private existing parent. Required via CLI or env; never overwrite a receipt.
# Public input/reference only; CLI overrides explicit env. Restart the build process to apply, no service reload.
PROJECT_ONE_CONTROL_BUILD_MANIFEST=

# Runtime contents; producer owner -> --runtime-profile.
# Enum full, account, components, maintenance, models, gateway, datasets, training, lifecycle, sso, knowledge, workflows, plugins, portal, localization, releases, kubernetes or mvp-postgresql-cpu-v1; default full preserves the existing Python/optional knowledge image.
# account uses scratch plus static Go/web/security; components adds the fixed M04 archive/provenance.
# maintenance, models and gateway include both approved component versions/catalog/provenance.
# models and gateway use the same closed scratch asset inventory; immutable model/vLLM bytes remain separate offline artifacts.
# datasets includes the pinned CPython runtime and six protected dataset processor files, with no later runtime.
# training/lifecycle/sso retain the dataset foundation; knowledge/workflows/plugins/portal/localization/releases/kubernetes require their exact CPU foundation and includes both component versions, data processor and localization assets.
# kubernetes retains releases assets and adds current kube-job plus fixed offline Debian18.6 native clients/libraries/notices.
# mvp-postgresql-cpu-v1 retains the complete CPU assets/native PostgreSQL tools and requires explicit manufacturing/native-connector manifests; Control uses CGO1+odbc_manager with a matching Bookworm public unixODBC closure. No vendor client enters the image.
# All scratch profiles conflict with a knowledge foundation; components still requires explicit runtime YAML.
# No secret. CLI > explicit env > full; selects a new image build, never changes a deployed image in place.
PROJECT_ONE_CONTROL_BUILD_RUNTIME_PROFILE=full

# Optional frozen CPU foundation receipt; producer owner -> --knowledge-runtime-manifest.
# Canonical existing approved state JSON receipt; empty selects the pinned Python foundation for full; knowledge/workflows/plugins/portal/localization/releases/kubernetes/mvp-postgresql-cpu-v1 require an approved receipt; all other profiles require empty. Must match the requested architecture/current source.
# Public input/reference only; CLI overrides explicit env. Restart the build process to apply, no service reload.
PROJECT_ONE_CONTROL_BUILD_KNOWLEDGE_RUNTIME_MANIFEST=

# Kubernetes native client input; manufacturer owner -> --postgres-client-manifest.
# Absolute existing current-owner0600 single-link JSON under verified external state, with a private0700 parent.
# Required only for runtime_profile=kubernetes or mvp-postgresql-cpu-v1; other profiles require empty. No implicit package downloads.
# The typed three-field manifest selects architecture and a private package root; exact identities come from the versioned catalog.
# Nonsecret reference only, never credentials. CLI > explicit env-file; no ambient/Compose/Helm expansion.
# Applies to the next new image build; no deployed-image mutation, live reload or runtime restart setting.
PROJECT_ONE_CONTROL_BUILD_POSTGRES_CLIENT_MANIFEST=

# Existing producer's complete healthy Linux path/resource group -> --manufacturing-environment.
# Canonical current-owner0600 single-link JSON, required only for mvp-postgresql-cpu-v1; all older profiles require empty and keep workstation Settings defaults.
# Schema: control-manufacturing-environment.schema.json. Requires actual source/state/toolchain/cache/compiler/runtime/Engine backing and peak coexistence; no mount aliases or global settings changes.
# Nonsecret references only; no HOME, credential, private key or ambient interpolation fields. Explicit CLI > this protected env-file; no runtime/Compose/Helm effect.
# Changing any path/budget requires a new manufacturing process/receipt, no application rebuild merely to select customer deployment settings.
PROJECT_ONE_CONTROL_BUILD_MANUFACTURING_ENVIRONMENT=

# Public native connector closure -> --native-connector-manifest.
# Canonical current-owner0600 single-link JSON under selected state; required only for mvp-postgresql-cpu-v1, empty for every older profile.
# Schema: control-unixodbc.schema.json. Exact pinned public source/header/library checksums, matching target C compiler and public provenance; libraries/final Control must require no GLIBC newer than2.36.
# No vendor driver, client, connection string, password or private key is accepted. Explicit CLI > this protected env-file; no ambient or Compose/Helm mapping.
# Applies to a new image manufacture and native loader readback; deployed database mode remains selected by the existing typed application configuration without rebuilding.
PROJECT_ONE_CONTROL_BUILD_NATIVE_CONNECTOR_MANIFEST=

# Control producer frontend_timeout_seconds; owner -> typed build policy and bounded subprocess/probe context.
# Integer 30..600 seconds; default 120 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_FRONTEND_TIMEOUT_SECONDS=120

# Control producer compile_timeout_seconds; owner -> typed build policy and bounded subprocess/probe context.
# Integer 30..900 seconds; default 180 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_COMPILE_TIMEOUT_SECONDS=180

# Control producer image_build_timeout_seconds; owner -> typed build policy and bounded subprocess/probe context.
# Integer 30..1800 seconds; default 600 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_IMAGE_BUILD_TIMEOUT_SECONDS=600

# Control producer docker_operation_timeout_seconds; owner -> typed build policy and bounded subprocess/probe context.
# Integer 5..120 seconds; default 30 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_DOCKER_OPERATION_TIMEOUT_SECONDS=30

# Control producer probe_timeout_seconds; owner -> typed build policy and bounded subprocess/probe context.
# Integer 5..120 seconds; default 30 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_PROBE_TIMEOUT_SECONDS=30

# Control producer probe_memory_bytes; owner -> typed build policy and bounded subprocess/probe context.
# Integer 134217728..536870912 bytes; default 268435456 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_PROBE_MEMORY_BYTES=268435456

# Control producer probe_milli_cpu; owner -> typed build policy and bounded subprocess/probe context.
# Integer 100..1000 millicores; default 500 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_PROBE_MILLI_CPU=500

# Control producer probe_pids; owner -> typed build policy and bounded subprocess/probe context.
# Integer 16..128 processes; default 32 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_PROBE_PIDS=32

# Control producer maximum_context_bytes; owner -> typed build policy and bounded subprocess/probe context.
# Integer 16777216..536870912 bytes; default 134217728 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_MAXIMUM_CONTEXT_BYTES=134217728

# Control producer go_memory_bytes; owner -> typed build policy and bounded subprocess/probe context.
# Integer 134217728..1073741824 bytes; default 536870912 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_GO_MEMORY_BYTES=536870912

# Control producer frontend_memory_mib; owner -> typed build policy and bounded subprocess/probe context.
# Integer 256..1536 MiB; default 768 from control-build-policy.json. No secret.
# Explicit env > versioned default; restart the build process to apply, no runtime service reload.
PROJECT_ONE_CONTROL_BUILD_FRONTEND_MEMORY_MIB=768

# Control image default numeric nonroot user; producer owner -> Docker build ARG PROJECT_ONE_CONTROL_UID and final USER.
# Integer1..2147483647 UID; default65532 from control-build-policy.json. No secret or host account creation.
# Explicit env > owned default. Rebuild image metadata to change its default; deployment --user/Helm UID can override without rebuilding application code.
PROJECT_ONE_CONTROL_BUILD_IMAGE_UID=65532

# Control image default numeric group; producer owner -> Docker build ARG PROJECT_ONE_CONTROL_GID and final USER.
# Integer1..2147483647 GID; default65532 from control-build-policy.json. No secret or host group creation.
# Explicit env > owned default. Rebuild image metadata to change its default; deployment --user/Helm GID can override without rebuilding application code.
PROJECT_ONE_CONTROL_BUILD_IMAGE_GID=65532

# Control producer owned child/container termination grace; owner -> process join and exact Docker stop.
# Integer1..30 seconds; default5 from control-build-policy.json. No secret, no unrelated process control.
# Explicit env > owned default. Restart this producer process to apply; no service reload.
PROJECT_ONE_CONTROL_BUILD_STOP_SECONDS=5

# training retains the data-enabled control foundation; CUDA computation belongs to the separate Linux amd64 node image.

# lifecycle uses the same bounded Python/data control contents and an explicit M10 receipt.
# It requires four distinct stores; node computation remains separate.
