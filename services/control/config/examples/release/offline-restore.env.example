# Owner: host offline operator; maps to RestoreRequest.reason for prepare-restore,
# reconcile-restore-reservation and abort-restore-reservation. String, no units;
# required, no default, 1..500 Unicode characters after rejecting blank values
# and control characters. Nonsecret audit context only; never include credentials.
# Protected operation JSON is loaded first; this explicit protected env-file
# overrides it. Ambient environment is ignored. Read per command, no reload.
PROJECT_ONE_OFFLINE_RESTORE_REASON=Explicit isolated backup recovery

# Owner: offline operator; maps only to RestoreRequest.compatibility_file.
# Optional absolute canonical path, UTF-8 string up to1024 bytes; omitted by
# default so ordinary independent same-release checks remain mandatory. When
# set, references a protected release-trusted Ed25519 certificate binding this
# exact source backup and target manifest/scope, account22 and four stores.
# This path contains no secret value; the certificate is read as protected input.
# Protected operation JSON loads first and this explicit env-file overrides it;
# ambient environment is ignored. Read per command; no runtime reload or rebuild.
# PROJECT_ONE_OFFLINE_RESTORE_COMPATIBILITY_FILE=/mnt/projectone/inputs/restore-compatibility.json

# Source fields use exactly the PROJECT_ONE_OFFLINE_RESTORE_SOURCE_* mappings
# documented in offline-restore-source.env.example. Copy only required overrides
# into this same protected operation env-file; unknown and duplicate keys fail.
# Each key retains that example's owner, type, range, default and per-command
# precedence. No Compose/runtime setting is introduced by operation metadata.
