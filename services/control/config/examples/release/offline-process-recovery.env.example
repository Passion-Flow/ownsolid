# Owner: explicit offline recovery operation; original failed start reference, string of32lowercase hex characters.
# Required after JSON+this optional overlay; no default and no secret value. Replace the placeholder.
# Maps failed_control_start_operation_id, overrides only explicit operation JSON, never reads ambient variables.
# Reloaded for each resume operation; no running service reload/restart is performed by parsing this input.
PROJECT_ONE_OFFLINE_PROCESS_RECOVERY_FAILED_CONTROL_START_OPERATION_ID=REPLACE_WITH_ORIGINAL_FAILED_START_ID

# Owner: operator audit context; nonblank UTF-8 string,1..500Unicode characters, no control characters or shell syntax.
# Required after JSON+overlay, no default; do not include secrets. Maps reason and overrides explicit operation JSON.
# The protected --operation-env-file supplies this value; ambient variables have no effect.
# Applied only to the next explicit recovery operation, whose runtime effects still need complete current admission.
PROJECT_ONE_OFFLINE_PROCESS_RECOVERY_REASON=Explicit recovery of the same failed control after owned safe shutdown
