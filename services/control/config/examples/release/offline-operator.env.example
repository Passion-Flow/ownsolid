# Protected explicit offline operator mapping; copy to0600, never source it as shell.
# No private signing keys or secret literals are accepted by this component.

# Operator Verification.mount_root: existing genuine nonroot mounted external filesystem. Absolute path, required, no default or internal fallback. Public reference.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MOUNT_ROOT=

# Operator Verification.trust_file: protected0600 independent public-key JSON. Absolute existing path, required, no default. Public-key reference; never a private signing key.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_TRUST_FILE=

# Verification.maximum_manifest_bytes: integer1024..4194304 bytes, default1048576. Nonsecret manifest read bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_MANIFEST_BYTES=1048576

# Verification.maximum_assets: integer1..4096 entries, default512. Nonsecret inventory bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_ASSETS=512

# Verification.maximum_asset_bytes: integer1..1099511627776 bytes, default34359738368. Nonsecret per-asset bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_ASSET_BYTES=34359738368

# Verification.maximum_total_bytes: integermaximum_asset_bytes..4398046511104 bytes, default68719476736. Nonsecret total byte bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_TOTAL_BYTES=68719476736

# Verification.maximum_metadata_bytes: integer1024..16777216 bytes, default4194304. Nonsecret aggregate OCI metadata bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_METADATA_BYTES=4194304

# Verification.maximum_archive_entries: integer16..131072 entries, default16384. Nonsecret outer/nested archive bound.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_ARCHIVE_ENTRIES=16384

# Verification.allow_test_fixture: boolean exactly true or false, defaultfalse. Nonsecret explicit synthetic fixture admission; does not waive production requirements or establish release qualification.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_ALLOW_TEST_FIXTURE=false

# Operator bundle_file: existing protected signed .tar.gz beneath mount_root. Absolute path, required with no default. Public artifact reference.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_BUNDLE_FILE=

# Operator expected_archive_sha256: independently supplied lowercase64-hex SHA-256 of every archive byte. Required, no default; never auto-derived from the untrusted input. Public digest.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_EXPECTED_ARCHIVE_SHA256=

# Operator expected_manifest_sha256: independently supplied lowercase64-hex SHA-256 of exact signed manifest bytes. Required, no default. Public digest.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_EXPECTED_MANIFEST_SHA256=

# Operator destination_root: new absolute owner-only preparation root beneath mount_root; existing parent required. Required for unpack and verify-prepared, no default. Existing roots/journals always preserved/refused. Public explicit output reference.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_DESTINATION_ROOT=

# Operator timeout_seconds: integer1..86400 seconds, default1800 from operator-defaults.json. Nonsecret complete-command deadline.
# Explicit env-file overrides JSON, then versioned defaults. Empty required strings or invalid/empty numeric/boolean inputs fail.
# Restart this command to apply; no ambient reads or live reload. All key values here are public paths, public hashes or nonsecret limits.
PROJECT_ONE_OFFLINE_OPERATOR_TIMEOUT_SECONDS=1800

# Operator scope_root: new absolute installation test scope beneath mount_root, with an existing owner-only parent.
# String path, no default; required for init-scope/status. Existing/partial/overlapping roots are preserved/refused. Public path reference.
# Explicit env-file overrides JSON/defaults; rerun this command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_OPERATOR_SCOPE_ROOT=

# Operator initial maximum_journal_bytes: integer16384..16777216 bytes; default1048576 from operator-defaults.json.
# Scope creation freezes this configuration fingerprint. Later monotonic extension
# uses the protected explicit journal-capacity operation, not an edited base config.
# Nonsecret append-only scope-journal capacity. Empty/invalid fails; capacity exhaustion preserves uncertainty and never authorizes an effect replay.
# Explicit env-file overrides JSON/defaults; rerun this command to apply. No ambient override or live reload.
PROJECT_ONE_OFFLINE_OPERATOR_MAXIMUM_JOURNAL_BYTES=1048576

# Optional engine group: omit every ENGINE_ entry for file-only operation. Any ENGINE_ key activates the group and requires socket/profile.
# Engine socket_file: absolute existing local Unix Docker socket reference, required with engine group; no default, no TCP/HTTP URL or credential content.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Public path reference; no environment proxy, redirect or retry.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_SOCKET_FILE=

# Engine profile: string ubuntu24.04-amd64-containerd or local-macos-amd64-emulation, required, no default/host fallback.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Nonsecret declared profile; local emulation never establishes native/NVIDIA qualification.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_PROFILE=

# Engine dial_seconds: integer1..30 seconds, default5 from operator-defaults.json; must be <=request_seconds. Nonsecret Unix connection bound.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Empty/invalid fails; overall command context can expire earlier.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_DIAL_SECONDS=5

# Engine request_seconds: integer2..120 seconds, default30, >=dial_seconds and <=load_seconds. Nonsecret read-only API request bound.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Empty/invalid fails; no live reload.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_REQUEST_SECONDS=30

# Engine load_seconds: integer5..7200 seconds, default600, >=request_seconds. Nonsecret upload/response bound; uncertain effects are never automatically replayed.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Empty/invalid fails; overall command context can expire earlier.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_LOAD_SECONDS=600

# Engine response_bytes: integer4096..16777216 bytes, default1048576. Nonsecret aggregate JSON/stream response and configuration-archive readback bound.
# Explicit env-file overrides engine JSON/defaults. Select before init-scope: an existing scope retains its immutable configuration fingerprint.
# Current cumulative CPU en/ar/fr locale files total4552871 bytes before tar framing; select8388608 as in cumulative-cpu.env.example.
# Empty/invalid fails; no file-size, ownership, signature or 30percent resource guard is relaxed. Future inventories must fit the independently selected bound.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_RESPONSE_BYTES=8388608

# Engine maximum_expanded_image_bytes: integer1048576..1099511627776 bytes, default68719476736. Nonsecret total uncompressed layer bound per image, verified before upload.
# Explicit env-file overrides engine JSON/defaults; rerun this command to apply. Empty/invalid fails; unsupported compression fails explicitly.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_MAXIMUM_EXPANDED_IMAGE_BYTES=68719476736

# Optional compose group: omit every COMPOSE_ key for existing file/image-only scopes. Any key activates the group; engine group is separately required.
# Compose docker_binary: absolute protected local Docker CLI executable reference, required, no default. Public path, never a shell expression or credential.
# Explicit env-file overrides compose JSON/defaults; restart this command to apply, no live reload. Shared Docker config/contexts/proxies are not inherited.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_DOCKER_BINARY=

# Compose plugin_directory: absolute protected local directory containing the pinned docker-compose executable, required, no default. Public path, no credential content.
# Explicit env-file overrides compose JSON/defaults; restart this command to apply, no live reload. No runtime plugin download or alternate-version fallback.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_PLUGIN_DIRECTORY=

# Compose command_seconds: integer2..300 seconds, default30 from compose-profile.json. Nonsecret complete subprocess/output bound; parent context can expire earlier.
# Explicit env-file overrides compose JSON/defaults; restart this command to apply, no live reload. Cancellation terminates/reaps the exact subprocess group.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_COMMAND_SECONDS=30

# Compose output_bytes: integer4096..16777216 bytes, default1048576 from compose-profile.json. Nonsecret bound separately applied to stdout and stderr.
# Explicit env-file overrides compose JSON/defaults; restart this command to apply, no live reload. Excess output cancels the process; raw stderr is not returned.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_OUTPUT_BYTES=1048576

# Compose model_file: optional absolute canonical private JSON model beneath mount_root, default absent/empty; required only for plan-compose.
# Nonsecret path reference; file is owner-only0600/single-linked with a private parent and verification.maximum_metadata_bytes bound. No YAML/includes/inline credentials.
# Explicit env-file overrides compose JSON/defaults; restart this command to apply, no live reload. Plan reads data only and does not initialize stores or mutate scope/Docker objects.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_MODEL_FILE=

# Optional engine.utility group: omit every ENGINE_UTILITY_ key for existing metadata/image-only scopes. Any key activates bounded utility resources and separately requires engine socket/profile.
# Utility memory_bytes: integer16777216..268435456 bytes, default67108864 from volume-utility-profile.json; explicit never-started configuration-container memory bound.
# Nonsecret; explicit env-file overrides engine.utility JSON/defaults. Restart command to apply, no live reload; no security/ownership bypass is exposed.
# Bootstrap password hashing was locally exercised with268435456 bytes; choose that explicit bound before freezing a bootstrap scope.64MiB is only the projection/default baseline, not bootstrap qualification.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_UTILITY_MEMORY_BYTES=67108864

# Utility milli_cpu: integer10..1000 millicores, default100 from volume-utility-profile.json; explicit container CPU quota,1000 millicores per core.
# Nonsecret; explicit env-file overrides engine.utility JSON/defaults. Restart command to apply, no live reload; utility API never starts a process.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_UTILITY_MILLI_CPU=100

# Utility pids: integer4..128 processes, default16 from volume-utility-profile.json; explicit utility-container process limit even though it remains never-started.
# Nonsecret; explicit env-file overrides engine.utility JSON/defaults. Restart command to apply, no live reload; empty/invalid/false-as-number fails.
# PROJECT_ONE_OFFLINE_OPERATOR_ENGINE_UTILITY_PIDS=16

# Compose inputs_file: optional absolute canonical private initialization catalog JSON beneath mount_root, default absent/empty; storage initialization requires it.
# Nonsecret path reference; file/source references are owner-only0600/single-linked with private parents and existing metadata/count/response bounds. No inline credentials or caller scope/global names.
# Explicit env-file overrides compose JSON/defaults; restart command to apply, no live reload. Absent mapping preserves existing file/image/plan scopes; new scope identity binds the effective reference.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_INPUTS_FILE=

# Optional compose.process group: omit all PROCESS_ keys for legacy creation-only scopes. Any key activates embedded defaults; process effects require this group.
# stop_seconds: integer1..120 seconds, default15 from process-profile.json; must be less than compose.command_seconds. Public grace before Docker stop terminates an owned process.
# Explicit env-file overrides compose.process JSON/defaults; restart command/new scope required, no reload. Never a secret or a permission to stop existing customer systems.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_PROCESS_STOP_SECONDS=15

# observe_seconds: integer1..120 seconds, default10 from process-profile.json; public read-only observation deadline for process actions and fixed SQL/store tasks. Parent context may expire earlier.
# Explicit env-file overrides compose.process JSON/defaults; restart command/new scope required, no reload. Choose before init-scope; an executing task may outlive this observer. Timeout remains uncertain and never authorizes a repeated start/import.
# Observe the exact recorded task through the configured Engine before explicit reconciliation. Store/current-store reconciliation may advance fresh remaining steps after verifying the pending result; it is not a wholly read-only diagnosis command. Backup observe_seconds belongs to its separate operation request.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_PROCESS_OBSERVE_SECONDS=10

# poll_milliseconds: integer50..5000 milliseconds, default200 from process-profile.json; cannot exceed observe_seconds times1000. Public readonly observation interval, no mutation retry.
# Explicit env-file overrides compose.process JSON/defaults; restart command/new scope required, no reload. Missing group preserves legacy fingerprints; invalid/false-as-number fails.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_PROCESS_POLL_MILLISECONDS=200

# reserve_percent: integer30..90 percent, default30 from process-profile.json; public minimum CPU/RAM headroom on both Engine and operator host. The30percent floor cannot be disabled.
# Explicit env-file overrides compose.process JSON/defaults; restart command/new scope required, no reload. Admission failure never changes existing containers or host settings.
# PROJECT_ONE_OFFLINE_OPERATOR_COMPOSE_PROCESS_RESERVE_PERCENT=30
