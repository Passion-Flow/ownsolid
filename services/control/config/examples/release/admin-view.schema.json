{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admin release projection configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directory",
    "scope_id",
    "manifest_sha256",
    "configuration_sha256",
    "publisher_uid",
    "page_size",
    "operation_seconds"
  ],
  "properties": {
    "directory": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publisher_uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "operation_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
