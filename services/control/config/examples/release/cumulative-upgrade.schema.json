{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectone.invalid/release/cumulative-upgrade/v1",
  "title": "Cumulative M16 to M17 account22 upgrade operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prepared_root",
    "expected_archive_sha256",
    "expected_manifest_sha256",
    "backup_source",
    "readiness_dial_address"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "prepared_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expected_archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backup_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_root",
        "manifest_sha256"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "backup_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_entries": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1000000
        }
      }
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "operation_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "readiness_dial_address": {
      "type": "string",
      "minLength": 1
    },
    "readiness_ca_name": {
      "type": "string"
    },
    "readiness_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    }
  }
}
