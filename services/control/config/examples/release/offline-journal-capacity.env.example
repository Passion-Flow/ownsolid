# Owner: offline operator capacity request. Expected currently admitted capacity,
# int64 bytes, required in JSON; overlay below wins, range16384..16777215.
# No secret value. Explicit operation-env-file only; immediate one-shot operation.
PROJECT_ONE_OFFLINE_JOURNAL_EXPECTED_CURRENT_BYTES=2097152
# Owner: same request. New cap, int64 bytes, required in JSON; overlay wins.
# Must exceed expected capacity and be <=16777216. No automatic resizing/restart.
# No secret value; applies only after the durable explicit extension completes.
PROJECT_ONE_OFFLINE_JOURNAL_MAXIMUM_BYTES=8388608
# Owner: local operational audit. Nonempty UTF-8 text, at most500 characters,
# no control characters or shell expansion. Required JSON value, overlay wins.
# No secret or credential content. Immediate recorded operation; no service restart.
PROJECT_ONE_OFFLINE_JOURNAL_CAPACITY_REASON=Extend capacity for recorded isolated recovery operations
