# All values use unquoted literal KEY=value syntax; shell expansion, dollar signs, backticks
# and quote characters are refused. Use protected JSON references for paths needing those characters.
# Certificate operator: canonical absolute protected file reference, no default; required
# PEM serving leaf/chain under the verified external mount, bounded by operator metadata limit.
# Overrides certificate_file in operation JSON; consumed only by explicit --operation-env-file.
# No certificate bytes/secrets here. Applies only to a new stopped-service generation, not live reload.
PROJECT_ONE_OFFLINE_TLS_CERTIFICATE_FILE=/verified-external/operator/tls/machine-chain.pem
# Certificate operator: canonical absolute protected unencrypted PEM key-file reference, no default;
# required, distinct from certificate/CA paths, metadata-limit bounded. Never place key bytes here.
# Overrides private_key_file in operation JSON; same explicit env-file precedence/new-generation behavior.
PROJECT_ONE_OFFLINE_TLS_PRIVATE_KEY_FILE=/verified-external/operator/tls/machine-key.pem
# Certificate operator: canonical absolute protected CA PEM reference, no default; required,
# metadata-limit bounded, distinct paths. Overrides trust_bundle_file in operation JSON.
# Verification input only; never installs global trust. Explicit env-file/new generation, no reload.
PROJECT_ONE_OFFLINE_TLS_TRUST_BUNDLE_FILE=/verified-external/operator/tls/explicit-ca.pem
# Operator: required nonempty UTF-8 audit explanation, 1..500 code points, no control characters;
# no secret content. Overrides reason in operation JSON through explicit env-file only.
# New generation owns this reason; immutable historical records never change, no live reload.
PROJECT_ONE_OFFLINE_TLS_REASON=Rotate the isolated machine serving certificate
# Offline TLS generation operator: enum string browser|machine, no default; required in V2
# operation JSON. Optional explicit override of its valid target; forbidden for V1 (no promotion).
# Public selector only, never a secret; --operation-env-file overrides target for this operation.
# Format version stays in protected JSON. New stopped-service generation only; no reload.
PROJECT_ONE_OFFLINE_TLS_TARGET=machine
