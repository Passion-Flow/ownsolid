# Scope owner: existing offline installation named by the protected operation.
# Type/units: lowercase 32-character hexadecimal identity; no numeric units.
# Required after JSON/env composition; no inferred/default scope is permitted.
# Secret handling: identity only; never supply credentials or file contents.
# Mapping/precedence: explicit operation-env-file overrides request.scope_id;
# ambient environment is ignored. Applies to one invocation; no service restart.
PROJECT_ONE_OFFLINE_RUNTIME_RECOVERY_SCOPE_ID=11111111111111111111111111111111

# Recovery owner: exact original pending runtime_create operation, not a resource ID.
# Type/units: lowercase 32-character hexadecimal operation identity; no units.
# Required after composition; no default, wildcard or partial/completed substitution.
# Secret handling: metadata only; no tokens, connection strings or secret references.
# Mapping/precedence: explicit operation-env-file overrides runtime_create_operation_id.
# Applies to one recovery invocation; no reload/restart or automatic create follows.
PROJECT_ONE_OFFLINE_RUNTIME_RECOVERY_CREATE_OPERATION_ID=22222222222222222222222222222222

# Recovery owner: explicit operator explanation for the observation-only action.
# Type/units: nonblank UTF-8 string, at most 500 Unicode runes, no control characters.
# Required after composition; no default. Never include secrets or private payloads.
# Only its canonical request digest enters the private journal; no reason is public.
# Mapping/precedence: explicit operation-env-file overrides reason; ambient ignored.
# One invocation only; does not change runtime policy or restart/start any process.
PROJECT_ONE_OFFLINE_RUNTIME_RECOVERY_REASON=Record observed absence without resubmitting creation
