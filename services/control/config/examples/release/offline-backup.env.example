# Explicit backup-operation environment file; never sourced by a shell.
# All entries override the protected operation JSON through LoadBackupRequest;
# they affect only a new attempt. Resume requires identical effective settings.
# No secret values belong here. Paths reference the verified external mount.

# Backup operator owner; absolute canonical new directory, required, no default.
# Its existing parent must be private/owned on the verified external volume.
# Public path only; JSON destination_root override; new attempt, no runtime reload.
PROJECT_ONE_OFFLINE_BACKUP_DESTINATION_ROOT=/replace/verified-external-volume/private/new-backup
# Backup operator owner; nonsecret UTF-8 reason, 1-500 runes, no control characters.
# Required, no default; overrides JSON reason; new attempt only, never a credential.
PROJECT_ONE_OFFLINE_BACKUP_REASON=Scheduled isolated recovery verification
# Backup operator owner; aggregate artifact bytes, integer 1048576-1099511627776.
# Default68719476736; JSON maximum_bytes override; no secrets; new attempt only.
# Disk admission reserves bounded additional space before any Docker effect.
PROJECT_ONE_OFFLINE_BACKUP_MAXIMUM_BYTES=68719476736
# Backup operator owner; aggregate archive entry count, integer4-1000000.
# Default100000; JSON maximum_entries override; no secrets; new attempt only.
PROJECT_ONE_OFFLINE_BACKUP_MAXIMUM_ENTRIES=100000
# Backup operator owner; each stream deadline, integer seconds5-7200.
# Default1800; JSON stream_seconds override; bounded by Engine load_seconds.
# No secret; new attempt only; expiry preserves an incomplete artifact.
PROJECT_ONE_OFFLINE_BACKUP_STREAM_SECONDS=1800
# Backup operator owner; each task observation deadline, integer seconds5-7200.
# Default1800; JSON observe_seconds override; no secrets; new attempt only.
# Expiry requires observation/reconciliation, never physical task resend.
PROJECT_ONE_OFFLINE_BACKUP_OBSERVE_SECONDS=1800
# Backup operator owner; observation poll interval, integer milliseconds50-5000.
# Default250; cannot exceed observation deadline; JSON poll_milliseconds override.
# No secret; new attempt only; no runtime/daemon scheduling is changed.
PROJECT_ONE_OFFLINE_BACKUP_POLL_MILLISECONDS=250
