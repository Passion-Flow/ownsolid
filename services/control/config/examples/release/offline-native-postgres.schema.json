{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected native PostgreSQL recovery descriptor",
  "description": "Existing operator-config/native-postgres.json snapshot; typed original request/policy validators and Scope/Engine authority remain mandatory. Template context is derived once before immutable plan publication. This schema grants no runtime qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "backup_template",
    "store_roots",
    "registry_root",
    "prepared_release_root",
    "registry_scaffold_root"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "backup_template": {
      "$ref": "#/$defs/backup"
    },
    "restore_template": {
      "$ref": "#/$defs/restore"
    },
    "initialization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_seconds",
        "cleanup_seconds",
        "maximum_record_bytes",
        "minimum_free_bytes"
      ],
      "properties": {
        "operation_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maximum_record_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "minimum_free_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        }
      }
    },
    "initialization_parent_root": {
      "type": "string",
      "pattern": "^/[^\\x00\\r\\n]+$"
    },
    "store_roots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/[^\\x00\\r\\n]+$"
      }
    },
    "registry_root": {
      "type": "string",
      "pattern": "^/[^\\x00\\r\\n]+$"
    },
    "prepared_release_root": {
      "type": "string",
      "pattern": "^/[^\\x00\\r\\n]+$"
    },
    "registry_scaffold_root": {
      "type": "string",
      "pattern": "^/[^\\x00\\r\\n]+$"
    }
  },
  "dependentRequired": {
    "restore_template": [
      "initialization_policy",
      "initialization_parent_root"
    ],
    "initialization_policy": [
      "restore_template",
      "initialization_parent_root"
    ],
    "initialization_parent_root": [
      "restore_template",
      "initialization_policy"
    ]
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dump_file",
        "dump_sha256",
        "restore_file",
        "restore_sha256",
        "control_file",
        "control_sha256",
        "expected_version",
        "scratch_root",
        "operation_seconds",
        "termination_grace_seconds",
        "maximum_store_bytes",
        "maximum_store_files",
        "maximum_sql_bytes",
        "maximum_configuration_bytes",
        "maximum_manifest_bytes",
        "minimum_free_bytes"
      ],
      "properties": {
        "dump_file": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "dump_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "restore_file": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "restore_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_file": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "control_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_version": {
          "const": "18.6"
        },
        "scratch_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "operation_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "termination_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "maximum_store_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_store_files": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1000000
        },
        "maximum_sql_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_configuration_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1073741824
        },
        "maximum_manifest_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 16777216
        },
        "minimum_free_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "client_distribution": {
          "type": "string",
          "enum": [
            "upstream",
            "pgdg-bookworm-18.6-1.pgdg12+2"
          ]
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_profile",
        "format_version",
        "backup_id",
        "source_scope_id",
        "maintenance_sha256",
        "source_manifest_sha256",
        "control_image_sha256",
        "postgres_image_sha256",
        "tenant_id",
        "database",
        "operator",
        "runtime_configuration_file",
        "configuration_root",
        "backup_root",
        "reason",
        "policy"
      ],
      "properties": {
        "application_profile": {
          "const": "mvp-postgresql-cpu-v1"
        },
        "format_version": {
          "const": 1
        },
        "backup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "source_scope_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "maintenance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "postgres_image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "runtime_configuration_file": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "configuration_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "backup_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_profile",
        "format_version",
        "restore_id",
        "target_scope_id",
        "source_manifest_sha256",
        "backup_root",
        "restore_root",
        "target_database",
        "target_operator",
        "runtime_configuration_file",
        "configuration_root",
        "reason",
        "policy"
      ],
      "properties": {
        "application_profile": {
          "const": "mvp-postgresql-cpu-v1"
        },
        "format_version": {
          "const": 1
        },
        "restore_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "target_scope_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backup_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "restore_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "target_database": {
          "type": "string",
          "minLength": 1
        },
        "target_operator": {
          "type": "string",
          "minLength": 1
        },
        "runtime_configuration_file": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "configuration_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "target_roots": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
