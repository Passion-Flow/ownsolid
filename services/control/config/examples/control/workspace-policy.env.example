# The same private policy file may include the documented http-policy.env.example request budget.
# Control runtime owner: maximum Workspace rows in the installation tenant, including archived rows.
# The same private file optionally accepts database-policy.env.example and sso-maintenance.env.example keys.
# Integer count, optional default 100, permitted 1..10000; no secret value or shell expansion.
# Explicit private --env-file overrides runtime.workspaces.maximum_count YAML/defaults; restart required.
PROJECT_ONE_WORKSPACES_MAXIMUM_COUNT=100
# Control runtime owner: maximum nondeleted notes in each Workspace.
# Integer count, optional default 10000, permitted 1..1000000; no secret value or shell expansion.
# Explicit private --env-file overrides runtime.workspaces.maximum_live_notes YAML/defaults; restart required.
PROJECT_ONE_WORKSPACES_MAXIMUM_LIVE_NOTES=10000
