# Owner server.application_profile; string enum account|workspaces|nodes|components|maintenance|models|platform.
# Optional; default platform. models requires the exact11-entry PostgreSQL catalog.
# Nonsecret; protected --env-file overrides valid YAML, ambient environment ignored.
# Maps to the existing Compose/Helm private policy file; restart required.
PROJECT_ONE_APPLICATION_PROFILE=models
# Owner models.artifact_root; required canonical absolute initialized0700 directory, never /.
# String path; no secret bytes. No default for models; bind/volume must already exist.
# Protected --env-file overrides YAML; same control artifact; restart required.
PROJECT_ONE_MODELS_ARTIFACT_ROOT=/var/lib/projectone/models
# Owner components.node_exporter_catalog_directory; optional canonical absolute directory.
# Empty YAML default; both approved maintenance archives required for install/upgrade.
# Nonsecret; protected --env-file overrides YAML; mounted private policy file; restart required.
PROJECT_ONE_COMPONENT_NODE_EXPORTER_CATALOG_DIRECTORY=/opt/projectone/components/node-exporter/catalog
