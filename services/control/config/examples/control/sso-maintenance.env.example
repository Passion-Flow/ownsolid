# The same private policy file may include the documented http-policy.env.example request budget.
# Control SSO maintenance owner: runtime.sso.cleanup_seconds;integer seconds.
# Optional owned default60;allowed10..3600;nonsecret value,no shell expansion.
# Explicit private serve --env-file overrides valid YAML/defaults;ambient environment ignored.
# Put this key in the same0600 single-link policy file as any Workspace/database overrides.
# Requires controlled restart;does not create an external scheduler or reload live policy.
PROJECT_ONE_SSO_CLEANUP_SECONDS=60
# Control SSO maintenance owner: runtime.sso.cleanup_timeout_seconds;integer seconds.
# Optional default5;allowed1..30;nonsecret,no shell expansion;missing preserves YAML/default.
# Explicit protected --env-file wins after independent YAML validation;ambient values ignored.
# Requires restart;bounds each actual cleanup transaction without weakening DB timeouts.
PROJECT_ONE_SSO_CLEANUP_TIMEOUT_SECONDS=5
# Control SSO maintenance owner: runtime.sso.cleanup_batch_size;integer row count per phase.
# Optional default100;allowed1..1000;nonsecret,no shell expansion;missing preserves YAML/default.
# Explicit protected --env-file wins;expiry and deletion each use this independent bound.
# Requires restart;held rows are skipped and this value does not disable authorization checks.
PROJECT_ONE_SSO_CLEANUP_BATCH_SIZE=100
# Control SSO maintenance owner: runtime.sso.flow_retention_days;integer UTC24-hour days.
# Optional default7;allowed1..90;nonsecret,no shell expansion;missing preserves YAML/default.
# Explicit protected --env-file wins;only strictly older terminal rows without any session reference delete.
# Requires restart;never deletes connector/binding history,live sessions or customer databases.
PROJECT_ONE_SSO_FLOW_RETENTION_DAYS=7
