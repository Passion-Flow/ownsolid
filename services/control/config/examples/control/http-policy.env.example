# Control HTTP owner: runtime.http.installation_lease_interval_seconds; mandatory
# original installation lease observation even when no HTTP/ready requests arrive.
# Optional integer seconds; owned default 5; permitted 1..60; zero cannot disable it.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing request_seconds bounds each probe; shutdown_seconds bounds lifecycle join.
# Native Dameng uses the shorter of this interval and database.dameng.readiness_seconds.
PROJECT_ONE_HTTP_INSTALLATION_LEASE_INTERVAL_SECONDS=5

# Control HTTP owner: runtime.http.startup_seconds; startup readiness and selected
# PostgreSQL maintenance read-check initialization budget.
# Optional integer seconds; owned default 20; permitted 1..300.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_STARTUP_SECONDS=20

# Control HTTP owner: runtime.http.read_header_seconds; request header deadline.
# Optional integer seconds; owned default 5; permitted 1..60.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_READ_HEADER_SECONDS=5

# Control HTTP owner: runtime.http.request_seconds; request and captured transaction deadline.
# Optional integer seconds; owned default 15; permitted 1..300.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_REQUEST_SECONDS=15

# Control HTTP owner: runtime.http.idle_seconds; idle connection deadline.
# Optional integer seconds; owned default 60; permitted 1..600.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_IDLE_SECONDS=60

# Control HTTP owner: runtime.http.shutdown_seconds; bounded listener shutdown.
# Optional integer seconds; owned default 5; permitted 1..120.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_SHUTDOWN_SECONDS=20

# Control HTTP owner: runtime.http.max_connections; shared browser/machine connection capacity.
# Optional integer count; owned default 128; permitted 1..4096.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_MAX_CONNECTIONS=128

# Control HTTP owner: runtime.http.max_active_requests; shared active request admission capacity.
# Optional integer count; owned default 64; permitted 1..2048.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_MAX_ACTIVE_REQUESTS=64

# Control HTTP owner: runtime.http.rate_limit_fallback_retry_seconds; 429 retry advice when positive typed wait is absent.
# Optional integer seconds; owned default 900; permitted 1..3600.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_RATE_LIMIT_FALLBACK_RETRY_SECONDS=900

# Control HTTP owner: runtime.http.service_unavailable_retry_seconds; 503 temporary failure retry advice.
# Optional integer seconds; owned default 2; permitted 1..3600.
# Nonsecret value; explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy.yaml mounts this file; Helm configuration.policyEnvironmentFile projects it.
# Use a private 0600 single-link file; no shell expansion, false or empty values; restart required.
# Existing header<=request, active<=connections and request>reset-minimum+jitter relations apply.
PROJECT_ONE_HTTP_SERVICE_UNAVAILABLE_RETRY_SECONDS=2
