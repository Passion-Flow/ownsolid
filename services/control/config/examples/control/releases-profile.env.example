# Owner: server application composition. Enum; required here; default platform if
# omitted from both inputs. Supported values: account, workspaces, nodes, components,
# maintenance, models, gateway, datasets, training, lifecycle, sso, knowledge,
# workflows, plugins, portal, localization, releases, platform. No secret value.
# Explicit protected --env-file overrides server.application_profile YAML; ambient
# environment is ignored. Restart required; releases retains account22/86 tables.
PROJECT_ONE_APPLICATION_PROFILE=releases

# Owner: releases protected policy. Canonical absolute file path, required for
# releases; no default. Contains bound projection identities and bounded read policy,
# never signing/bootstrap/operator secret contents. Explicit --env-file overrides
# release_view_config_file YAML. Restart required; provision exact read-only mount.
PROJECT_ONE_RELEASE_VIEW_CONFIG_FILE=/run/projectone/admin-view.json
