# Owner: releases protected policy. Canonical absolute file path, required for
# releases; no default. Contains bound projection identities and bounded read policy,
# never signing/bootstrap/operator secret contents. Explicit --env-file overrides
# release_view_config_file YAML. Restart required; provision exact read-only mount.
PROJECT_ONE_RELEASE_VIEW_CONFIG_FILE=/run/projectone/admin-view.json
