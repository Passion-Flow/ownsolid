# Control database owner: database.engine; enum string postgresql/mysql; optional default postgresql.
# No secret value. Explicit private serve --env-file overrides valid YAML/defaults; ambient ignored.
# Compose workspace-policy / Helm policyEnvironmentFile map this same file. Restart/new pool required.
# mysql requires its protected configuration reference and no PostgreSQL dsn_file; no implicit switch/fallback.
PROJECT_ONE_DATABASE_ENGINE=postgresql

# Control database owner: database.mysql_configuration_file; canonical absolute protected JSON path.
# Required only for mysql, absent for postgresql; no default. JSON loader owns all MySQL TLS/password-file references.
# The reference is nonsecret; never place credentials here. Explicit private --env-file overrides valid YAML.
# Ambient ignored; Compose/Helm private policy file mapping; restart/new pool. Uncomment only with engine=mysql
# and remove the PostgreSQL dsn_file in the deployment YAML. Example path is a private mount reference.
# PROJECT_ONE_MYSQL_CONFIGURATION_FILE=/run/projectone/private/mysql.json

# MySQL runtime-access operator owner: database.mysql_runtime_access.account_host; canonical lower-case DNS/IP string.
# Optional object, but both fields are required together when selected; mysql only; no default, wildcard, CIDR or zone.
# This is the source host portion of the runtime account, distinct from the database endpoint. Not a secret.
# Protected --env-file > independently valid YAML; ambient ignored; same Compose/Helm private file projection.
# New command/restart required. Serve validates metadata but never opens operator credentials or provisions accounts.
# PROJECT_ONE_MYSQL_RUNTIME_ACCOUNT_HOST=localhost

# MySQL runtime-access operator owner: database.mysql_runtime_access.intent_file; canonical absolute private path string.
# Required with account_host; mysql only; no default. The operator exclusively creates owned0600 intent/receipt files
# inside an existing owned0700 parent; never place credentials in this environment input or overwrite retained evidence.
# Protected --env-file > valid YAML; ambient ignored; same Compose/Helm private file mapping; new command/restart.
# Existing operator commands without --env-file use their protected YAML projection. Provisioning never runs in serve.
# PROJECT_ONE_MYSQL_RUNTIME_INTENT_FILE=/run/projectone/private/runtime-account-intent.json

# Control migration owner: database.mysql_migrations.lock_wait_seconds; integer seconds 1..60; optional default1.
# Nonsecret; protected serve --env-file > independently valid YAML/defaults; ambient ignored.
# Existing Compose/Helm private policy mapping; restart/new command. No lock bypass; total must cover lock+step.
PROJECT_ONE_MYSQL_MIGRATION_LOCK_WAIT_SECONDS=1

# Control migration owner: database.mysql_migrations.step_seconds; integer seconds 1..300; optional default30.
# Nonsecret; protected serve --env-file > valid YAML/defaults; ambient ignored.
# Existing Compose/Helm private policy mapping; restart/new command; total must cover lock+step.
PROJECT_ONE_MYSQL_MIGRATION_STEP_SECONDS=30

# Control migration owner: database.mysql_migrations.total_seconds; integer seconds lock+step..1800; default600.
# Nonsecret; protected serve --env-file > valid YAML/defaults; ambient ignored.
# Existing Compose/Helm private policy mapping; restart/new command. Startup/request contexts may be tighter.
PROJECT_ONE_MYSQL_MIGRATION_TOTAL_SECONDS=600

# Control migration owner: database.mysql_migrations.cleanup_seconds; integer seconds 1..30; optional default5.
# Nonsecret; protected serve --env-file > valid YAML/defaults; ambient ignored.
# Existing Compose/Helm private policy mapping; restart/new command; unconfirmed unlock remains a failure.
PROJECT_ONE_MYSQL_MIGRATION_CLEANUP_SECONDS=5

# Control migration owner: database.mysql_migrations.maximum_metadata_bytes; integer bytes 4096..1048576; default1048576.
# Nonsecret; protected serve --env-file > valid YAML/defaults; ambient ignored.
# Existing Compose/Helm private policy mapping; restart/new command. Does not relax source/object hashes or catalog steps.
PROJECT_ONE_MYSQL_MIGRATION_MAXIMUM_METADATA_BYTES=1048576

# Native MySQL backup owner: database.mysql_backup.client_file; canonical absolute existing executable path string; required with native policy, no default.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_CLIENT_FILE=/run/projectone/native/mysql

# Native MySQL backup owner: database.mysql_backup.client_sha256; lowercase64-hex actual client file SHA256 string; required, no default or zero digest.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_CLIENT_SHA256=REPLACE_WITH_ACTUAL_CLIENT_SHA256

# Native MySQL backup owner: database.mysql_backup.dump_file; canonical absolute existing executable path string; required, distinct from client, no default.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_DUMP_FILE=/run/projectone/native/mysqldump

# Native MySQL backup owner: database.mysql_backup.dump_sha256; lowercase64-hex actual dump file SHA256 string; required, no default or zero digest.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_DUMP_SHA256=REPLACE_WITH_ACTUAL_DUMP_SHA256

# Native MySQL backup owner: database.mysql_backup.artifact_manifest_file; canonical absolute protected actual offline artifact/versions/platform/GPL inventory path string; required, no default.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_ARTIFACT_MANIFEST_FILE=/run/projectone/private/mysql-native-artifacts.json

# Native MySQL backup owner: database.mysql_backup.scratch_root; canonical absolute existing owned0700 directory path string; required, no default.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_SCRATCH_ROOT=/run/projectone/private/native-scratch

# Native MySQL backup owner: database.mysql_backup.operation_seconds; integer seconds30..86400; optional default3600.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_OPERATION_SECONDS=3600

# Native MySQL backup owner: database.mysql_backup.termination_grace_seconds; integer seconds1..60; optional default10, actual process join still required.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_TERMINATION_GRACE_SECONDS=10

# Native MySQL backup owner: database.mysql_backup.maximum_sql_bytes; integer bytes1048576..1099511627776; optional default17179869184, no truncate-and-accept.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_MAXIMUM_SQL_BYTES=17179869184

# Native MySQL backup owner: database.mysql_backup.maximum_manifest_bytes; integer bytes4096..16777216; optional default1048576, bounds retained metadata.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_MAXIMUM_MANIFEST_BYTES=1048576

# Native MySQL backup owner: database.mysql_backup.minimum_free_bytes; integer bytes1048576..1099511627776; optional default1073741824 plus fixed30-percent floor.
# Nonsecret reference/policy only; credentials remain solely in protected mysqlstore JSON/password/CA files.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# MySQL-only optional object; all required references must be supplied together; new command/restart applies.
# Operator commands accept protected YAML without --env-file; never enables automatic backup/restore in serve.
# PROJECT_ONE_MYSQL_BACKUP_MINIMUM_FREE_BYTES=1073741824

# Native MySQL backup owner: database.mysql_backup.maximum_store_bytes; integer bytes1048576..1099511627776; optional default137438953472, combined four-store scan/copy bound.
# Nonsecret policy; actual four-store bytes/files are measured; fixed30-percent disk floor still applies.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# Operator commands use protected YAML without --env-file; new command/restart applies, no automatic backup.
# PROJECT_ONE_MYSQL_BACKUP_MAXIMUM_STORE_BYTES=137438953472

# Native MySQL backup owner: database.mysql_backup.maximum_store_files; integer file count1..1000000; optional default1000000, combined four-store inventory bound.
# Nonsecret policy; actual four-store bytes/files are measured; fixed30-percent disk floor still applies.
# Explicit protected serve --env-file > independently valid YAML/defaults; ambient environment ignored.
# Existing Compose workspace-policy / Helm policyEnvironmentFile project this same private file.
# Operator commands use protected YAML without --env-file; new command/restart applies, no automatic backup.
# PROJECT_ONE_MYSQL_BACKUP_MAXIMUM_STORE_FILES=1000000
