# Control database selection owner: database.engine; enum dameng for this profile.
# Explicit required native selection in YAML; optional repeat here, no native default.
# Nonsecret. Protected serve --env-file > independently valid YAML;
# ambient ignored. Cannot switch engines via this file. Same Compose workspace-policy
# and Helm configuration.policyEnvironmentFile mapping; new owner/restart required.
PROJECT_ONE_DATABASE_ENGINE=dameng

# Native serving owner: database.dameng.runtime_configuration_file; canonical absolute path string.
# Required in base YAML, no default; may override with a different protected runtime JSON reference.
# Reference only: connector owns password-file, native artifact and socket references/budgets.
# No credentials here. Protected --env-file > valid YAML; ambient ignored. Compose workspace-policy
# / Helm configuration.policyEnvironmentFile project this same file, with existing private mounts.
# Restart/new native owner required; no reload. Never select owner credentials or bypass actual grants.
PROJECT_ONE_DAMENG_RUNTIME_CONFIGURATION_FILE=/run/projectone/private/dameng-runtime.json

# Native serving owner: database.dameng.schema_configuration_file; canonical absolute path string.
# Required in base YAML, no default; must differ from runtime reference. Protected schema-policy JSON
# owns exact schema/runtime identity and readback budgets, not account creation or migration permission.
# Nonsecret reference; never inline credentials. Protected --env-file > valid YAML; ambient ignored.
# Same Compose workspace-policy / Helm configuration.policyEnvironmentFile private projection.
# Restart/new owner required. Runtime/schema identities and existing installation must match exactly.
PROJECT_ONE_DAMENG_SCHEMA_CONFIGURATION_FILE=/run/projectone/private/dameng-schema.json

# Native serving owner: database.dameng.readiness_seconds; integer seconds1..300, optional default10.
# Nonsecret. Interval starts after each completed audit; existing runtime.http.request_seconds
# bounds each audit. Failure cancels serving and joins workers before releasing the installation lock.
# Protected --env-file > valid YAML/default; ambient ignored. Same Compose/Helm private mapping.
# Restart required; no reload, fallback, automatic grant or reconnect/retry after failed readiness.
PROJECT_ONE_DAMENG_READINESS_SECONDS=10
