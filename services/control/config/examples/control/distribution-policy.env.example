# Control distribution policy; protected explicit --env-file; no ambient policy reads.

# Owner runtime.distribution.recovery_seconds; integer seconds; optional/default 600.
# Permitted 30..3600; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_RECOVERY_SECONDS=600

# Owner runtime.distribution.key_ttl_seconds; integer seconds; optional/default 86400.
# Permitted 300..key_max_ttl_seconds; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_KEY_TTL_SECONDS=86400

# Owner runtime.distribution.key_max_ttl_seconds; integer seconds; optional/default 7776000.
# Permitted 300..7776000; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_KEY_MAX_TTL_SECONDS=7776000

# Owner runtime.distribution.key_max_active; integer count; optional/default 100.
# Permitted 1..1000; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_KEY_MAX_ACTIVE=100

# Owner runtime.distribution.alias_max_active; integer count; optional/default 16.
# Permitted 1..16; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_ALIAS_MAX_ACTIVE=16

# Owner runtime.distribution.max_concurrent_requests; integer count; optional/default 4.
# Permitted 1..4, shared deployment capacity; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_MAX_CONCURRENT_REQUESTS=4

# Owner runtime.distribution.request_seconds; integer seconds; optional/default 90.
# Permitted 1..300; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_REQUEST_SECONDS=90

# Owner runtime.distribution.context_tokens; integer tokens; optional/default 2048.
# Permitted 1..2048, approved backend ceiling; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_CONTEXT_TOKENS=2048

# Owner runtime.distribution.output_tokens; integer tokens; optional/default 512.
# Permitted 1..512 and <=context_tokens; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_OUTPUT_TOKENS=512

# Owner runtime.distribution.requests_per_window; integer count; optional/default 60.
# Permitted 1..10000; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_REQUESTS_PER_WINDOW=60

# Owner runtime.distribution.rate_window_seconds; integer seconds; optional/default 60.
# Permitted 1..86400; cross-field relationships are validated. No secret bytes.
# Protected --env-file overrides valid YAML; Compose/Helm mount this same policy file.
# Restart required; the same control artifact applies the selected value.
PROJECT_ONE_DISTRIBUTION_RATE_WINDOW_SECONDS=60
