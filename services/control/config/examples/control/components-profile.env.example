# Cumulative server composition owner -> server.application_profile.
# Optional string enum account|workspaces|nodes|components|maintenance|models|platform; default platform.
# Explicit protected --env-file overrides valid YAML; ambient env ignored; restart required.
# Nonsecret. components requires PostgreSQL and the exact nine-entry forward catalog;
# M05 maintenance, logs and later workloads are unavailable. No runtime DDL authority.
PROJECT_ONE_APPLICATION_PROFILE=components

# Owner components.node_exporter_archive_file; optional absolute normalized path string.
# Empty/relative paths fail. Omission retains YAML; absence of the verified archive
# blocks new install and reports unavailable, while observations remain readable.
# Nonsecret immutable file reference, never archive bytes, URL or executable selection.
# Fixed compiled version/size/SHA-256 still apply. Protected env-file overrides YAML;
# restart required, same binary/image. Compose/Helm mount the approved file at this path.
PROJECT_ONE_COMPONENT_NODE_EXPORTER_ARCHIVE_FILE=/opt/projectone/components/node-exporter/node_exporter-1.12.1.linux-amd64.tar.gz
