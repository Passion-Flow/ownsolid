# Owner components.node_exporter_catalog_directory; optional canonical absolute directory string.
# Default empty disables catalog assets; maintenance requires both approved versions for full operation.
# Contains pinned archives/provenance/licenses only, never secret material.
# Explicit --env-file overrides valid YAML; Compose/Helm mount this private policy file.
# Restart required; immutable approved versions/digests remain compiled contracts.
PROJECT_ONE_COMPONENT_NODE_EXPORTER_CATALOG_DIRECTORY=/opt/projectone/components/node-exporter/catalog
