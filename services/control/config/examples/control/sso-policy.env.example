# Explicit protected control --env-file only; no shell execution or ambient policy.
# Valid independently checked YAML first, then this overlay, then final typed validation.
# Restart is required for every change. Never place secret bytes in this file.

# Owner sso.enabled; boolean true|false, default false; false keeps local emergency login.
# Enabled requires HTTPS callbacks, protected keyring and approved providers; env overrides YAML; restart.
PROJECT_ONE_SSO_ENABLED=false

# Owner sso.keyring_file; canonical absolute reference; optional disabled, required enabled.
# Current-owner0700 parent/0600 single-link regular file; AES keys stay there, never inline.
# Env overrides YAML; restart; retain every key referenced by current ciphertext/backups.
PROJECT_ONE_SSO_KEYRING_FILE=/run/projectone/private/sso-keyring.json

# Owner sso.providers; schema-validated JSON array reference; optional if YAML supplies inventory.
#1..64 unique exact HTTPS origins/issuer,1..16 canonical pinned dial addresses, optional private CA.
# Current-owner0700 parent/0600 single-link file; bounded1MiB; no credential values.
# Env replaces the typed YAML inventory; restart; does not open provider sockets while disabled.
PROJECT_ONE_SSO_PROVIDERS_FILE=/run/projectone/private/sso-providers.json

# Owner runtime.sso.flow_seconds; integer seconds; default 300, permitted 60..900.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_FLOW_SECONDS=300

# Owner runtime.sso.operation_seconds; integer seconds; default 10, permitted 2..30.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_OPERATION_SECONDS=10

# Owner runtime.sso.connect_seconds; integer seconds; default 3, permitted 1..10.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CONNECT_SECONDS=3

# Owner runtime.sso.response_bytes; integer bytes; default 65536, permitted 4096..262144.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_RESPONSE_BYTES=65536

# Owner runtime.sso.max_concurrent_exchanges; integer count; default 4, permitted 1..16.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_MAX_CONCURRENT_EXCHANGES=4

# Owner runtime.sso.maximum_connectors; integer count; default 16, permitted 1..64.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_MAXIMUM_CONNECTORS=16

# Owner runtime.sso.maximum_bindings_per_user; integer count; default 64, permitted 1..256.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_MAXIMUM_BINDINGS_PER_USER=64

# Owner runtime.sso.maximum_pending_flows; integer count; default 1000, permitted 1..10000.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_MAXIMUM_PENDING_FLOWS=1000

# Owner runtime.sso.start_ip_count; integer count; default 20, permitted 1..120.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_START_IP_COUNT=20

# Owner runtime.sso.start_window_seconds; integer seconds; default 60, permitted 10..3600.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_START_WINDOW_SECONDS=60

# Owner runtime.sso.callback_ip_count; integer count; default 120, permitted 1..600.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CALLBACK_IP_COUNT=120

# Owner runtime.sso.callback_window_seconds; integer seconds; default 60, permitted 10..3600.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CALLBACK_WINDOW_SECONDS=60

# Owner runtime.sso.password_ip_count; integer count; default 10, permitted 1..60.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_PASSWORD_IP_COUNT=10

# Owner runtime.sso.password_window_seconds; integer seconds; default 60, permitted 10..3600.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_PASSWORD_WINDOW_SECONDS=60

# Owner runtime.sso.cleanup_seconds; integer seconds; default 60, permitted 10..3600.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CLEANUP_SECONDS=60

# Owner runtime.sso.cleanup_timeout_seconds; integer seconds; default 5, permitted 1..30.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CLEANUP_TIMEOUT_SECONDS=5

# Owner runtime.sso.cleanup_batch_size; integer count; default 100, permitted 1..1000.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_CLEANUP_BATCH_SIZE=100

# Owner runtime.sso.flow_retention_days; integer days; default 7, permitted 1..90.
# Nonsecret; optional override of independently valid YAML/defaults; protected --env-file wins; restart.
PROJECT_ONE_SSO_FLOW_RETENTION_DAYS=7
