# Portal settings overlay the protected control YAML through --env-file.
# All changes require a control restart; this file contains no secrets.

# Purpose/owner: Portal commit_seconds; integer seconds, allowed 1..30.
# Optional; default 10. No secret value/reference. Explicit env-file overrides
# protected YAML runtime.portal.commit_seconds; restart required, no live reload.
PROJECT_ONE_PORTAL_COMMIT_SECONDS=10

# Purpose/owner: Portal notification_retention_days; integer days, allowed 1..365.
# Optional; default 30. No secret value/reference. Explicit env-file overrides
# protected YAML runtime.portal.notification_retention_days; restart required, no live reload.
PROJECT_ONE_PORTAL_NOTIFICATION_RETENTION_DAYS=30

# Purpose/owner: Portal notification_maintenance_batch; integer rows, allowed 1..1000.
# Optional; default 100. No secret value/reference. Explicit env-file overrides
# protected YAML runtime.portal.notification_maintenance_batch; restart required, no live reload.
PROJECT_ONE_PORTAL_NOTIFICATION_MAINTENANCE_BATCH=100

# Purpose/owner: Portal notification_maintenance_seconds; integer seconds, allowed 1..3600.
# Optional; default 60. No secret value/reference. Explicit env-file overrides
# protected YAML runtime.portal.notification_maintenance_seconds; restart required, no live reload.
PROJECT_ONE_PORTAL_NOTIFICATION_MAINTENANCE_SECONDS=60
