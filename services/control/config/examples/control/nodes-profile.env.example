# Minimal discovery composition; server owner -> server.application_profile.
# String enum account|workspaces|nodes|components|maintenance|models|platform; default platform; nonsecret; restart required.
# nodes requires PostgreSQL and its exact eight-entry ledger; no later capability owner.
# Explicit protected --env-file overrides YAML; ambient variables are ignored. No reload.
PROJECT_ONE_APPLICATION_PROFILE=nodes
# Transport and optional dedicated machine socket use the existing transport environment
# mapping in transport.env.example. Browser HTTP requires all four machine
# settings, verified HTTPS and a distinct exact origin; no machine credential is public.
