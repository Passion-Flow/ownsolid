# Control Nodes owner: runtime.nodes.join_ttl_seconds; integer seconds until a join token expires.
# Optional default600; allowed60..3600. Nonsecret; no credential/key literal belongs here.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_JOIN_TTL_SECONDS=600

# Control Nodes owner: runtime.nodes.online_seconds; integer seconds for online heartbeat age.
# Optional default30; allowed20..300 and must be less than offline_seconds. Nonsecret.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_ONLINE_SECONDS=30

# Control Nodes owner: runtime.nodes.offline_seconds; integer seconds after which heartbeat is offline.
# Optional default120; allowed30..3600 and must exceed online_seconds. Nonsecret.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_OFFLINE_SECONDS=120

# Control Nodes owner: runtime.nodes.task_seconds; integer seconds for the node task deadline.
# Optional default300; allowed120..1800. Nonsecret; leases/protocol invariants remain independently enforced.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_TASK_SECONDS=300

# Control Nodes owner: runtime.nodes.reconcile_seconds; integer seconds between bounded task sweeps.
# Optional default30; allowed1..300. Nonsecret; this does not enable an additional worker or service.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_RECONCILE_SECONDS=30

# Control Nodes owner: runtime.nodes.reconcile_timeout_seconds; integer seconds per bounded sweep.
# Optional default5; allowed1..30. Nonsecret; shorter caller deadlines remain effective.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_RECONCILE_TIMEOUT_SECONDS=5

# Control Nodes owner: runtime.nodes.liveness_flush_seconds; integer seconds between batched writes of last-seen times and reports.
# Optional default3; allowed1..10, and a heartbeat interval must fit the online window less this. Nonsecret (ADR 0022).
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_LIVENESS_FLUSH_SECONDS=3

# Control Nodes owner: runtime.nodes.state_refresh_seconds; integer seconds an unchanged node state may go without a synchronous write and its checks.
# Optional default300; allowed30..3600. Nonsecret (ADR 0022).
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_STATE_REFRESH_SECONDS=300

# Control Nodes owner: runtime.nodes.outbox_poll_milliseconds; integer milliseconds between reads of the task wake outbox by each gateway.
# Optional default200; allowed50..5000. Nonsecret (ADR 0028).
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_OUTBOX_POLL_MILLISECONDS=200

# Control Nodes owner: runtime.nodes.view_max_age_seconds; integer seconds a gateway may answer a heartbeat from memory before reading the node again.
# Optional default60; allowed1..3600. Nonsecret (ADR 0047).
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_VIEW_MAX_AGE_SECONDS=60

# Control Nodes owner: runtime.nodes.outbox_retention_seconds; integer seconds an outbox event stays for a late reader.
# Optional default300; allowed60..86400. Nonsecret (ADR 0028).
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_OUTBOX_RETENTION_SECONDS=300

# Control UI owner: runtime.ui.page_size; integer items per default page, shared by Portal/Admin consumers.
# Optional default20; allowed1..100. Nonsecret and public runtime data; contains no identity or secret.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_UI_PAGE_SIZE=20

# Control UI owner: runtime.ui.lookup_page_size; integer items per bounded lookup projection.
# Optional owned default100; allowed1..100; nonsecret/public. This is not complete cursor pagination.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
# Compose/Helm deliver this same protected policy file; no application rebuild or browser setting is required.
PROJECT_ONE_UI_LOOKUP_PAGE_SIZE=100

# Control UI owner: runtime.ui.poll_milliseconds; integer milliseconds between ordinary UI polls.
# Optional default5000; allowed1000..60000. Nonsecret/public; unknown node reads still require explicit recovery.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_UI_POLL_MILLISECONDS=5000

# Control Nodes owner: runtime.nodes.maximum_live_join_tokens; integer live tokens per installed tenant.
# Optional default100; allowed1..10000. Nonsecret; expired/consumed/revoked tokens do not count.
# Explicit private serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_NODE_MAXIMUM_LIVE_JOIN_TOKENS=100

# Control Nodes owner: runtime.nodes.maximum_live_nodes; integer nonremoved nodes per installed tenant.
# Optional; owned default100, allowed1..10000; active and disabled nodes across Workspaces count.
# Nonsecret private-file override of valid base YAML; ambient environment is ignored.
# Compose/Helm mount this existing protected policy file; control restart applies changes, no rebuild.
PROJECT_ONE_NODE_MAXIMUM_LIVE_NODES=100

# Control Nodes owner: runtime.nodes.inference_deploy_seconds. Integer seconds 120..1800 and >= runtime.nodes.task_seconds; deployment deadline.
# Optional, default 1800; no secret value/reference. Explicit private serve --env-file
# overrides independently valid YAML/defaults; ambient values ignored. Restart required.
# Compose workspace-policy overlay / Helm policyEnvironmentFile map this same private file.
PROJECT_ONE_NODE_INFERENCE_DEPLOY_SECONDS=1800

# Control Nodes owner: runtime.nodes.task_lease_seconds. Integer seconds 10..30; physical task lease, bounded by the protocol ceiling.
# Optional, default 30; no secret value/reference. Explicit private serve --env-file
# overrides independently valid YAML/defaults; ambient values ignored. Restart required.
# Compose workspace-policy overlay / Helm policyEnvironmentFile map this same private file.
PROJECT_ONE_NODE_TASK_LEASE_SECONDS=30

# Control Nodes owner: runtime.nodes.maximum_task_attempts. Integer count 1..3; expired lease reclaim ceiling, bounded by retained schema.
# Optional, default 3; no secret value/reference. Explicit private serve --env-file
# overrides independently valid YAML/defaults; ambient values ignored. Restart required.
# Compose workspace-policy overlay / Helm policyEnvironmentFile map this same private file.
PROJECT_ONE_NODE_MAXIMUM_TASK_ATTEMPTS=3

# Control Nodes owner: runtime.nodes.task_sweep_batch. Integer count 1..1000; maximum node IDs per expiry sweep.
# Optional, default 100; no secret value/reference. Explicit private serve --env-file
# overrides independently valid YAML/defaults; ambient values ignored. Restart required.
# Compose workspace-policy overlay / Helm policyEnvironmentFile map this same private file.
PROJECT_ONE_NODE_TASK_SWEEP_BATCH=100
