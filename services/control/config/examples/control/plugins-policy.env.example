# Protected control --env-file overrides valid YAML; ambient environment has no authority.
# Combine with inherited transport/knowledge/workflow/SSO/lifecycle settings.

# Owner runtime.plugins.maximum_references; integer references; optional, default 1000.
# Permitted 1..10000; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAXIMUM_REFERENCES=1000

# Owner runtime.plugins.commit_seconds; integer seconds; optional, default 10.
# Permitted 1..30; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_COMMIT_SECONDS=10

# Owner runtime.plugins.maintenance_batch; integer rows; optional, default 100.
# Permitted 1..1000; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAINTENANCE_BATCH=100

# Owner runtime.plugins.maintenance_seconds; integer seconds; optional, default 60.
# Permitted 1..3600; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAINTENANCE_SECONDS=60

# Owner runtime.plugins.capsule_bytes; integer UTF-8 bytes; optional, default 262144.
# Permitted 2048..1048576; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_CAPSULE_BYTES=262144

# Owner runtime.plugins.manifest_bytes; integer UTF-8 bytes; optional, default 8192.
# Permitted 512..16384; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MANIFEST_BYTES=8192

# Owner runtime.plugins.result_bytes; integer UTF-8 bytes; optional, default 65536.
# Permitted 1024..1048576; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_RESULT_BYTES=65536

# Owner runtime.plugins.maximum_models; integer models; optional, default 100.
# Permitted 1..100; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAXIMUM_MODELS=100

# Owner runtime.plugins.maximum_versions; integer versions; optional, default 100.
# Permitted 1..1000; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAXIMUM_VERSIONS=100

# Owner runtime.plugins.maximum_grants; integer grants; optional, default 1000.
# Permitted 1..10000; manifest_bytes must be less than capsule_bytes.
# No secrets. Protected env-file overrides typed YAML; restart required.
PROJECT_ONE_PLUGINS_MAXIMUM_GRANTS=1000

# Owner plugins.enabled; boolean true/false only; optional, default false.
# Enabling requires reviewed public keys and a selected workflow executor.
# No secrets. Protected env-file overrides valid YAML; restart required.
PROJECT_ONE_PLUGINS_ENABLED=false

# Owner plugins.trusted_keys; optional absolute ordinary owner0600 JSON file reference.
# Purpose: reviewed public trust inventory array, at most32 unique Ed25519 keys.
# Each exact object has key_id and public_key. Private signing material is forbidden.
# Default: YAML list; enabled requires a nonempty valid list. No default publisher.
# Protected env-file overrides YAML; restart required. Placeholder must be replaced.
PROJECT_ONE_PLUGINS_TRUSTED_KEYS_FILE=/approved/private/plugin-public-trust.json
