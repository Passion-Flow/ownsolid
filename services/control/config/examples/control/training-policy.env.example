# Explicit protected --env-file; training operational defaults are owned by DefaultTrainingPolicy.
# Values override valid YAML once before owner construction; all changes require restart.
# Every value is nonsecret. Secret material remains a protected file reference at its original owner.

# Purpose/owner: runtime.training.snapshot_maximum_files; integer count; optional default 20000.
# Permitted: 1..1000000 accepted immutable files, receipts and namespace; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_SNAPSHOT_MAXIMUM_FILES=20000

# Purpose/owner: runtime.training.snapshot_maximum_bytes; integer bytes; optional default 17179869184.
# Permitted: 1048576..1099511627776 total copied bytes; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_SNAPSHOT_MAXIMUM_BYTES=17179869184

# Purpose/owner: runtime.training.snapshot_manifest_bytes; integer bytes; optional default 16777216.
# Permitted: 65536..67108864 exact metadata bytes; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_SNAPSHOT_MANIFEST_BYTES=16777216

# Purpose/owner: runtime.training.snapshot_seconds; integer seconds; optional default 300.
# Permitted: 1..3600 bounded export/import seconds; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_SNAPSHOT_SECONDS=300

# Purpose/owner: runtime.training.max_jobs_per_workspace; integer count; optional default 1000.
# Permitted: 1..100000 retained jobs; no automatic provenance pruning; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MAX_JOBS_PER_WORKSPACE=1000

# Purpose/owner: runtime.training.max_active_per_workspace; integer count; optional default 10.
# Permitted: 1..1000 and <=max_jobs_per_workspace; queue/preparing/running/cancelling/recovery_required count; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MAX_ACTIVE_PER_WORKSPACE=10

# Purpose/owner: runtime.training.max_attempts; integer count; optional default 5.
# Permitted: 1..1000 explicit attempts; never redeliver a possibly running attempt; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MAX_ATTEMPTS=5

# Purpose/owner: runtime.training.poll_milliseconds; integer seconds; optional default 1000.
# Permitted: 100..60000; queue retry interval, not a progress estimate; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_POLL_MILLISECONDS=1000

# Purpose/owner: runtime.training.transaction_seconds; integer seconds; optional default 10.
# Permitted: 1..60 bounded business transaction budget; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_TRANSACTION_SECONDS=10

# Purpose/owner: runtime.training.upload_seconds; integer seconds; optional default 30.
# Permitted: 1..300 individual stream/ticket seconds; no business locks during body transfer; current authority is rechecked before accounting; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_UPLOAD_SECONDS=30

# Purpose/owner: runtime.training.minimum_free_bytes; integer bytes; optional default 2147483648.
# Permitted: >=resources.maximum_output_bytes and <=1099511627776; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MINIMUM_FREE_BYTES=2147483648

# Purpose/owner: runtime.training.minimum_host_memory_bytes; integer bytes; optional default 12884901888.
# Permitted: >=resources.memory_bytes and <=1099511627776; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MINIMUM_HOST_MEMORY_BYTES=12884901888

# Purpose/owner: runtime.training.minimum_gpu_memory_mib; integer MiB; optional default 8192.
# Permitted: 8192..1048576 total observed memory; no capacity claim; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MINIMUM_GPU_MEMORY_MIB=8192

# Purpose/owner: runtime.training.minimum_driver_major; integer count; optional default 580.
# Permitted: 580..999; CUDA/PTX caveats still require target execution; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MINIMUM_DRIVER_MAJOR=580

# Purpose/owner: runtime.training.minimum_compute_major; integer count; optional default 8.
# Permitted: 8..99; production BF16 device checks also execute in Python; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_MINIMUM_COMPUTE_MAJOR=8

# Purpose/owner: runtime.training.resources.wall_seconds; integer seconds; optional default 3600.
# Permitted: 1..86400 wall seconds; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_WALL_SECONDS=3600

# Purpose/owner: runtime.training.resources.cpu_seconds; integer seconds; optional default 3600.
# Permitted: 1..172800 process CPU seconds; <=wall_seconds*configuration.threads; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_CPU_SECONDS=3600

# Purpose/owner: runtime.training.resources.memory_bytes; integer bytes; optional default 6442450944.
# Permitted: 134217728..17179869184; actual production cgroup, distinct native parent RSS verification; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_MEMORY_BYTES=6442450944

# Purpose/owner: runtime.training.resources.maximum_output_bytes; integer bytes; optional default 1073741824.
# Permitted: 1048576..2147483648 total ordinary output bytes; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_MAXIMUM_OUTPUT_BYTES=1073741824

# Purpose/owner: runtime.training.resources.maximum_output_files; integer count; optional default 4096.
# Permitted: 16..4096 ordinary output files; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_MAXIMUM_OUTPUT_FILES=4096

# Purpose/owner: runtime.training.resources.maximum_result_bytes; integer bytes; optional default 8388608.
# Permitted: 4096..16777216 structured result bytes; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_MAXIMUM_RESULT_BYTES=8388608

# Purpose/owner: runtime.training.resources.maximum_event_bytes; integer bytes; optional default 8388608.
# Permitted: 65536..16777216 bounded event stream bytes; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_MAXIMUM_EVENT_BYTES=8388608

# Purpose/owner: runtime.training.resources.open_files; integer count; optional default 256.
# Permitted: 64..4096 worker file descriptors; no secret bytes. Explicit protected env-file overrides YAML.
# One validated snapshot; restart required; existing job recipes are immutable.
PROJECT_ONE_TRAINING_RESOURCES_OPEN_FILES=256

# Purpose/owner: training.artifact_root; required nonempty nonsecret string, no default.
# Select the canonical private root or exact verified manufactured receipt identity.
# Explicit protected env-file overrides YAML; restart required; never a user command/image.
PROJECT_ONE_TRAINING_ARTIFACT_ROOT=/var/lib/projectone/training

# Purpose/owner: training.image_reference; required nonempty nonsecret string, no default.
# Select the canonical private root or exact verified manufactured receipt identity.
# Explicit protected env-file overrides YAML; restart required; never a user command/image.
PROJECT_ONE_TRAINING_IMAGE_REFERENCE=projectone/training@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Purpose/owner: training.image_id; required nonempty nonsecret string, no default.
# Select the canonical private root or exact verified manufactured receipt identity.
# Explicit protected env-file overrides YAML; restart required; never a user command/image.
PROJECT_ONE_TRAINING_IMAGE_ID=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Purpose/owner: training.worker_source_sha256; required nonempty nonsecret string, no default.
# Select the canonical private root or exact verified manufactured receipt identity.
# Explicit protected env-file overrides YAML; restart required; never a user command/image.
PROJECT_ONE_TRAINING_WORKER_SOURCE_SHA256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
