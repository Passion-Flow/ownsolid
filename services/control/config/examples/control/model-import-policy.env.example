# Control Models owner: runtime.models.import_seconds; integer seconds per archive verification.
# Optional default600; permitted60..7200. Nonsecret; caller cancellation remains effective.
# Protected serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_MODELS_IMPORT_SECONDS=600

# Control Models owner: runtime.models.import_poll_seconds; integer seconds between worker polls.
# Optional default2; permitted1..60. Nonsecret; this does not activate a separate worker.
# Protected serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_MODELS_IMPORT_POLL_SECONDS=2

# Control Models owner: runtime.models.cleanup_seconds; integer seconds for bounded lock cleanup.
# Optional default2; permitted1..30. Nonsecret; does not weaken finite connector write bounds.
# Protected serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_MODELS_CLEANUP_SECONDS=2

# Control Models owner: runtime.models.maximum_attempts; integer permitted archive verification attempts.
# Optional default3; permitted1..3 within the immutable persistence ceiling. Nonsecret.
# Existing counters remain durable; exhausted imports retain explicit cancellation/recovery.
# Protected serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
PROJECT_ONE_MODELS_MAXIMUM_ATTEMPTS=3

# Control Models owner: runtime.models.maximum_bundle_bytes; integer archive admission bytes.
# Optional default2147483648; permitted1519216128..2147483648 for the frozen approved catalog.
# Includes USTAR headers/padding/trailer. Nonsecret; existing files are never automatically deleted.
# Protected serve --env-file overrides valid YAML/defaults; ambient env ignored; restart required.
# Compose workspace-policy overlay/Helm policyEnvironmentFile project this same protected file.
PROJECT_ONE_MODELS_MAXIMUM_BUNDLE_BYTES=2147483648
