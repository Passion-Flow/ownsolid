# Owner server.application_profile; enum; required here, legacy omitted default platform.
# Permitted selection for this deployment: mvp-postgresql-cpu-v1. Nonsecret.
# Explicit protected --env-file overrides independently valid YAML; ambient values
# are ignored. Restart applies; upgrade the accepted account22 schema first.
PROJECT_ONE_APPLICATION_PROFILE=mvp-postgresql-cpu-v1

# Owner release projection; canonical absolute protected JSON reference; required
# for this profile; no default. File contains read-only original journal policy,
# never operator credentials. Same --env-file precedence; restart applies.
PROJECT_ONE_RELEASE_VIEW_CONFIG_FILE=/run/projectone/admin-view.json
