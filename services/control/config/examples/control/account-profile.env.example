# Account runtime selection; server configuration owner -> server.application_profile.
# String enum: account, workspaces, nodes or platform. Omitted defaults to platform for compatibility.
# account/workspaces/nodes require PostgreSQL and the exact selected checksummed ledger (workspaces/nodes append the M01/M02 prefix); later configured
# providers/stores/workers conflict and fail startup. This is a nonsecret selector.
# Independent valid YAML < explicit protected --env-file; ambient environment is ignored.
# Restart the selected process with the same artifact after changes. No live reload.
PROJECT_ONE_APPLICATION_PROFILE=account
