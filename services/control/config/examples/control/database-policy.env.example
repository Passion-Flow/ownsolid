# The same private policy file may include the documented http-policy.env.example request budget.
# Control PostgreSQL session owner: database.lock_timeout_milliseconds.
# Integer milliseconds; optional default 3000; allowed 1..30000 and less than statement_timeout_seconds*1000.
# Nonsecret policy, no shell expansion. Explicit private serve --env-file overrides valid YAML/defaults.
# Ambient environment is ignored; omission preserves YAML, empty/false/zero/invalid values fail safely.
# Requires controlled restart/new pool. Use a protected 0600 single-link file in a private 0700 directory.
# This file may also include documented Workspace/SSO maintenance keys;do not select separate env files.
PROJECT_ONE_DATABASE_LOCK_TIMEOUT_MILLISECONDS=175
