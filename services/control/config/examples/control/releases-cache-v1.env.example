# Owner: server application composition. Enum; explicit versioned post-M17 profile.
# Required in this example; omitted in both inputs keeps default platform. Only
# releases-cache-v1 is selected here; all existing profile names retain their rules.
# No secret. Protected --env-file overrides server.application_profile YAML;
# ambient environment is ignored. Restart required; exact account22/86 tables.
PROJECT_ONE_APPLICATION_PROFILE=releases-cache-v1

# Owner: existing M17 releases policy. Canonical absolute protected file reference;
# required, no default. Never a signing/bootstrap/operator secret value.
# Protected --env-file overrides release_view_config_file YAML; restart required.
PROJECT_ONE_RELEASE_VIEW_CONFIG_FILE=/run/projectone/admin-view.json

# Models owner: model_cache.enabled; boolean true|false, optional default false.
# Nonsecret. Explicit private serve --env-file overrides YAML/defaults; ambient env ignored.
# Compose workspace-policy overlay / Helm policyEnvironmentFile use this same input; restart required.
PROJECT_ONE_MODEL_CACHE_ENABLED=false

# Models owner: model_cache.address; host:port string (bracket IPv6), required when enabled.
# No default; reject wildcard bind addresses and ports outside1..65535. No credentials/URL here.
# Explicit --env-file overrides YAML; compose service DNS or selected Helm endpoint; restart required.
PROJECT_ONE_MODEL_CACHE_ADDRESS=valkey:6379

# Models owner: model_cache.tls; boolean true|false, optional default true.
# Nonsecret. false explicitly chooses plaintext only on an isolated trusted network.
# Explicit --env-file overrides YAML; independent from browser TLS; restart required.
PROJECT_ONE_MODEL_CACHE_TLS=true

# Models owner: model_cache.ca_file; absolute clean public CA path, optional default empty/system roots.
# Empty uses verified system trust; nonempty requires tls=true. Never disables verification.
# Explicit --env-file overrides YAML; mount this reference in Compose/Helm; restart required.
PROJECT_ONE_MODEL_CACHE_CA_FILE=

# Models owner: model_cache.username; ACL username string, required with password_file when enabled.
# Default empty; no control characters or surrounding whitespace; nonsecret reference.
# Explicit --env-file overrides YAML; configure matching Valkey ACL; restart required.
PROJECT_ONE_MODEL_CACHE_USERNAME=projectone_model_cache

# Models owner: model_cache.password_file; absolute clean secret-file reference, required when enabled.
# Default empty; file1..4096bytes,0600,single link,current UID in0700 owned parent; no symlinks.
# Secret value stays in the private file, never in env. Compose/Helm mount this path; restart required.
# Explicit --env-file overrides YAML; rotate both ACL and protected file together.
PROJECT_ONE_MODEL_CACHE_PASSWORD_FILE=/run/projectone/private/model-cache-password

# Models owner: model_cache.namespace; nonsecret1..64 ASCII letters,digits,_,-; default projectone.
# Installation-specific namespace prevents cross-installation collisions; tenant/Workspace follow it.
# Explicit --env-file overrides YAML; Compose/Helm preserve exact bytes; restart required.
PROJECT_ONE_MODEL_CACHE_NAMESPACE=projectone

# Models owner: model_cache.ttl_seconds; integer seconds1..86400, optional default60.
# Nonsecret. Reclaims obsolete version keys; never controls authorization/freshness.
# Explicit --env-file overrides YAML; Compose/Helm same mapping; restart required.
PROJECT_ONE_MODEL_CACHE_TTL_SECONDS=60

# Models owner: model_cache.timeout_milliseconds; integer milliseconds1..1000, default100.
# Nonsecret. Total connect,TLS,AUTH,command budget per operation; no retries; cancellation preserved.
# Explicit --env-file overrides YAML; Compose/Helm same mapping; restart required.
PROJECT_ONE_MODEL_CACHE_TIMEOUT_MILLISECONDS=100

# Models owner: model_cache.maximum_bytes; integer bytes1024..16777216, default1048576.
# Nonsecret. Maximum cache payload; larger directories use SQL without storing cache bytes.
# Explicit --env-file overrides YAML; Compose/Helm same mapping; restart required.
PROJECT_ONE_MODEL_CACHE_MAXIMUM_BYTES=1048576

# Models owner: model_cache.maximum_concurrent; integer connections1..32, optional default4.
# Nonsecret. Per-process admission; busy calls use SQL immediately; no queue or background worker.
# Explicit --env-file overrides YAML; budget multiplied by control replicas; restart required.
PROJECT_ONE_MODEL_CACHE_MAXIMUM_CONCURRENT=4
