# Protected license component overlay; reference it through licensing.environment_file.
# Do not source as shell. No ambient environment or shell interpolation is read.
# Precedence: explicit protected component env > complete YAML > versioned wire defaults.
# All changes require control restart; public trust is captured once, never hot reloaded.

# Public manufacturer trust reference; configuration owner -> licensing.trust_file.
# Type: canonical absolute runtime file path; required for serving, no working default key.
# Source must be supplied by the authorized manufacturer and fingerprint-verified out of band.
# No secret value: the referenced public JSON file must be single-link0600 under owned0700 parent.
# Component env overrides YAML; Compose private root / Helm selected private projection must deliver this path.
# Restart control after a complete protected generation is provisioned; never mount issuer private keys.
PROJECT_ONE_LICENSE_TRUST_FILE='/run/projectone/license-trust.json'

# Retained signed license history limit; license policy owner -> runtime.licensing.maximum_imports.
# Type: integer count1..1024; default64 from contracts/licensing/v1 DefaultPolicy.
# Nonsecret. Lowering preserves readable existing history but blocks further imports at capacity.
# Component env > YAML > owned default; same mapping in Compose/Helm control YAML/environment projection.
# Restart required; no automatic history pruning or data deletion.
PROJECT_ONE_LICENSE_MAXIMUM_IMPORTS=64

# Clock backwards tolerance; license policy owner -> runtime.licensing.rollback_tolerance_seconds.
# Type: integer seconds0..300; default30 from the same owned policy; explicit zero is supported.
# Nonsecret. It never resets persistent high water or changes the host clock.
# Component env > YAML > owned default; mapped by existing Compose/Helm private configuration projection.
# Restart required; larger rollback denies new work and preserves safe export/recovery integration.
PROJECT_ONE_LICENSE_ROLLBACK_TOLERANCE_SECONDS=30
