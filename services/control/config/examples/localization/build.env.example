# Manufacturer component env; copy to a protected0600 file and edit explicit absolute references.
# Use --env-file with plan.py and execution.py. No shell sourcing, expansion or ambient environment reads.
# Precedence: this explicit env > protected base JSON > typed policy defaults. No hot reload.
# Protocol schema_version/kind remain fixed in the base JSON. This example grants no API budget or credentials.

# Google project for manufacturer translation only; build owner -> project_id.
# Validated Google project identifier or numeric project number; required, no working default. Public identifier.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_PROJECT_ID=example-localization-project

# Official API parent location; build owner -> location.
# Validated location identifier; example global. Required; supported configured project/location must be verified. Public.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_LOCATION=global

# Current implemented official model; manufacturer owner -> model.
# String general/nmt only; required. Later model families remain retained, unsupported values fail. Public.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_MODEL=general/nmt

# Additional offline locale to generate; localization owner -> target_locale.
# Canonical supported target locale; example fr, en excluded. Required, no default. Public.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_TARGET_LOCALE=fr

# Existing internal integration directory and durable approval bindings; operator owner -> credential_directory.
# Canonical absolute private0700 owned directory beneath the actual internal operator home, distinct from home. Required.
# Protected reference only; keep credentials/ledger internal, outside source/output/logs/packages. Never delete or roll back approval tombstones.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_CREDENTIAL_DIRECTORY=/Users/OPERATOR/.config/projectone/localization

# Short-lived official API access-token reference; operator owner -> token_file.
# Canonical absolute immediate0600 private single-link regular child of credential_directory. Required reference, never a literal token.
# Protected reference only; keep credentials/ledger internal, outside source/output/logs/packages. Never delete or roll back approval tombstones.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_TOKEN_FILE=/Users/OPERATOR/.config/projectone/localization/access-token

# Independently supplied budget-approval reference; operator owner -> authorization_file.
# Canonical absolute immediate0600 private single-link regular child of credential_directory. Required reference; no approval is generated.
# Protected reference only; keep credentials/ledger internal, outside source/output/logs/packages. Never delete or roll back approval tombstones.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_AUTHORIZATION_FILE=/Users/OPERATOR/.config/projectone/localization/approval.json

# New output for the exact approved plan; manufacturer owner -> output_directory.
# Canonical absolute uncreated path under the verified external state scope, private existing parent. Required; never reuse an approval with another output.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_OUTPUT_DIRECTORY=/Volumes/APPROVED_EXTERNAL_STATE/localization/approved-build

# Verified official HTTPS request timeout; build owner -> request_timeout_seconds.
# Integer seconds1..120; default30. Public numeric policy; no retry after uncertain charged requests.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_REQUEST_TIMEOUT_SECONDS=30

# Sequential contents per request; build owner -> batch_items.
# Integer count1..1024; default64. Public numeric policy; actual source size also limits batching.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_BATCH_ITEMS=64

# Protected HTML codepoints per batch; build owner -> batch_codepoints.
# Integer Unicode codepoints1..30000; default5000. All sent markup counts; cannot exceed maximum_total_codepoints.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_BATCH_CODEPOINTS=5000

# Conservative run character bound; build owner -> maximum_total_codepoints.
# Integer Unicode codepoints1..10000000; default200000. Must also satisfy the independently supplied monetary/character approval.
# No secret value; do not put tokens, customer content or approval bodies in this env.
# Explicit env overrides JSON/default for this field. Replan and obtain exact approval after a scope change; rerun the process to apply.
PROJECT_ONE_TRANSLATION_MAXIMUM_TOTAL_CODEPOINTS=200000
