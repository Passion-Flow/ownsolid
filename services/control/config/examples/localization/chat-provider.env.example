# Manufacturer-only translation configuration. Copy outside Git, set mode 0600,
# replace the token file reference, then pass its path to ChatConfiguration.load_env.
# Values are literal, unquoted UTF-8; no shell expansion or ambient environment.
# Each explicit field overrides its class default for the next manufacturer run.
# No setting maps to Compose/Helm or public runtime configuration: customers use
# packaged resources offline. No service restart or application rebuild is needed.

# Owner: chat translation transport. Required HTTPS completions URL; no default.
# No userinfo, query or fragment; redirects and TLS verification bypass are refused.
# This is the user-approved provider endpoint, not an official OpenAI endpoint.
OWNSOLID_TRANSLATION_ENDPOINT=https://translate.jayogo.com/v1/chat/completions

# Owner: batch failover. Required ordered list of 1-8 distinct model identifiers;
# comma-separated, no spaces; no default. One request per candidate, no same-model
# automatic retry. These labels have passed small probes, but all responses
# reported gpt-4o-mini; independent underlying models are not established.
OWNSOLID_TRANSLATION_MODELS=gpt-4o-mini,deepseek-chat,gemini-2.0-flash,gpt-5-mini

# Owner: manufacturer credentials. Required absolute path under the operator's
# internal home; no default. Private owned 0600 regular file, no symlinks/hardlinks.
# The value is a file reference only, never a key. Read before each provider call.
OWNSOLID_TRANSLATION_TOKEN_FILE=/Users/your-user/.config/ownsolid/secrets/translation.key

# Owner: transport. Integer seconds, 1-120; default 30. Socket I/O timeout, not a
# total wall-clock deadline. A timeout can be billed even without a response.
OWNSOLID_TRANSLATION_REQUEST_TIMEOUT_SECONDS=30

# Owner: batch generation. Integer output tokens, 64-16384; default 4096.
# Sent as max_tokens. Truncated completions fail validation and may use a fallback.
OWNSOLID_TRANSLATION_MAX_OUTPUT_TOKENS=4096

# Owner: transport admission. Integer encoded request bytes, 256-1048576;
# default 65536. Includes model/messages/JSON envelope; reject before sending.
OWNSOLID_TRANSLATION_MAX_REQUEST_BYTES=65536

# Owner: transport admission. Integer response bytes, 1024-8388608;
# default 1048576. Oversized responses are discarded and recorded as failed.
OWNSOLID_TRANSLATION_MAX_RESPONSE_BYTES=1048576

# Owner: failover pacing. Integer seconds, 0-30; default 1. Delay before each
# subsequent distinct candidate. Account/auth/rate-limit errors halt immediately.
OWNSOLID_TRANSLATION_FALLBACK_DELAY_SECONDS=1
