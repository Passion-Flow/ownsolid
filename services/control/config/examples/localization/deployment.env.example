# Localization component inputs. Copy to a protected0600 env file; no shell sourcing.
# Renderer precedence: explicit component env > complete base control JSON > versioned policy defaults.
# Use render.py --env-file; no ambient environment is read. Values never interpolate shell variables.
# All fields below are nonsecret. Secrets remain protected references in the separate base config.
# Restart/recreate control after rendering/reprovisioning; there is no hot reload.
# False mode works as supplied. Enabled mode requires explicit source, /private child, scope and target storage.

# Enable the external immutable package; locale deployment owner -> optional overlay and localization.package_directory.
# Exact true or false; default follows base package_directory, otherwise false. Explicit false disables the mount.
# No secret; incompatible external package fields must be empty when false.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_ENABLED=false

# Manufacturer package directory on the operator host; deployment owner -> initializer read-only source.
# Canonical absolute existing private directory; required when enabled, empty when disabled.
# No secret content; private path, owner SOURCE_UID, mode0700. Never bind a parent containing credentials.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_PACKAGE_HOST_DIRECTORY=''

# Runtime package child; deployment owner -> localization.package_directory and read-only mount parent.
# Canonical absolute path ending /private; required when enabled, empty when disabled. No overlap with live stores.
# No secret; immutable assets only. Changing requires a fresh scope/volume and control restart.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_PACKAGE_DIRECTORY=''

# Required runtime locales; product deployment owner -> localization.required_locales.
# JSON array of unique supported locale codes; default inherits base, otherwise []. At most256; external locale must exist.
# Public locale identifiers; en and zh-CN are bundled seed resources, not Google-reviewed packs.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_REQUIRED_LOCALES='["en","zh-CN"]'

# Host package numeric owner; deployment owner -> initializer source-uid only.
# Integer0..2147483647; default effective operator UID. Required to override for a different explicit source owner.
# Public identity; nonroot operator must be the source owner. Does not alter host ownership.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
# PROJECT_ONE_LOCALIZATION_SOURCE_UID=501

# Container bind-source UID; locale initializer owner -> materialize --source-uid.
# Integer0..2147483647; default SOURCE_UID. Docker Desktop may expose0; verify read-only metadata and set explicitly.
# Public identity, never a secret. Host SOURCE_UID validation remains independent; no host files are chowned.
# Component env > derived host-source default. Recreate initializer and restart control; no hot reload.
# PROJECT_ONE_LOCALIZATION_INIT_SOURCE_UID=0

# New isolated Docker local volume name; Compose installer owner -> external localization volume.
# Safe Docker name, 1..128 characters; required for enabled Compose; empty when disabled.
# No secret; create only through volume.py ownership guard. Existing foreign volume is preserved.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_VOLUME=''

# Unique installer scope; deployment owner -> initializer receipt and exact Docker ownership labels.
# Canonical lowercase UUID; required when enabled; empty when disabled. Never reuse for unrelated deployments.
# Public identity; changing does not authorize overwriting an initialized volume.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_SCOPE_ID=''

# Preprovisioned immutable Kubernetes PVC; cluster deployment owner -> localization.existingClaim.
# DNS-compatible claim name; required for enabled Helm, empty when disabled. Must differ from live/snapshot claims.
# Public name; chart only mounts it read-only. It does not create/provision locale files or approve a package.
# Precedence: component env > base/default; mapping above. Restart control; no hot reload.
PROJECT_ONE_LOCALIZATION_EXISTING_CLAIM=''

# Runtime numeric UID; shared deployment owner -> initializer private asset owner and Helm runtime.
# Integer1..2147483647; no renderer default; required when enabled. Example10001 must match the selected image/control user.
# Public identity, never a secret. Component env is explicit; Helm values must match. Reprovision a new volume and restart.
PROJECT_ONE_RUNTIME_UID=10001

# Runtime numeric GID; shared deployment owner -> initializer private asset owner and Helm runtime.
# Integer1..2147483647; no renderer default; required when enabled. Example10001 must match the selected image/control user.
# Public identity, never a secret. Component env is explicit; Helm values must match. Reprovision a new volume and restart.
PROJECT_ONE_RUNTIME_GID=10001

# runtime.localization package_bytes; localization deployment owner. Units: bytes.
# Integer65536..4194304; default1048576 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.package_bytes.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_PACKAGE_BYTES=1048576

# runtime.localization font_bytes; localization deployment owner. Units: bytes.
# Integer1048576..134217728; default33554432 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.font_bytes.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_FONT_BYTES=33554432

# runtime.localization aggregate_bytes; localization deployment owner. Units: bytes.
# Integer4194304..268435456; default67108864 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.aggregate_bytes.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_AGGREGATE_BYTES=67108864

# runtime.localization maximum_locales; localization deployment owner. Units: count.
# Integer2..256; default32 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.maximum_locales.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_MAXIMUM_LOCALES=32

# runtime.localization maximum_messages; localization deployment owner. Units: count.
# Integer2000..20000; default10000 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.maximum_messages.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_MAXIMUM_MESSAGES=10000

# runtime.localization maximum_fonts; localization deployment owner. Units: count.
# Integer1..256; default16 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.maximum_fonts.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_MAXIMUM_FONTS=16

# runtime.localization cache_seconds; localization deployment owner. Units: seconds.
# Integer0..86400; default3600 from runtime-policy.json. No secret.
# Precedence: component env > base runtime.localization > versioned default. Maps to runtime.localization.cache_seconds.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_CACHE_SECONDS=3600

# initializer init_memory_bytes; localization deployment owner. Units: bytes.
# Integer33554432..1073741824; default268435456 from deployment-policy.json. No secret.
# Precedence: component env > versioned default. Maps to initializer.init_memory_bytes.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_INIT_MEMORY_BYTES=268435456

# initializer init_milli_cpu; localization deployment owner. Units: millicores.
# Integer100..2000; default500 from deployment-policy.json. No secret.
# Precedence: component env > versioned default. Maps to initializer.init_milli_cpu.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_INIT_MILLI_CPU=500

# initializer init_pids; localization deployment owner. Units: processes.
# Integer16..256; default32 from deployment-policy.json. No secret.
# Precedence: component env > versioned default. Maps to initializer.init_pids.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_INIT_PIDS=32

# initializer init_timeout_seconds; localization deployment owner. Units: seconds.
# Integer5..600; default120 from deployment-policy.json. No secret.
# Precedence: component env > versioned default. Maps to initializer.init_timeout_seconds.
# Apply through renderer; init milli-CPU becomes Compose CPUs. Recreate initializer/control; no hot reload.
PROJECT_ONE_LOCALIZATION_INIT_TIMEOUT_SECONDS=120

# Renderer-owned compose.env outputs MOUNT_ROOT, POLICY_FILE and INIT_CPUS are derived, not input override keys.
# Preserve generated file hashes/manifest. Do not edit them or use compose.env as this component env input.
