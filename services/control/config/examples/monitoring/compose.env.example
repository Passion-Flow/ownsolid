# Owner: Compose control command; required existing protected serving policy
# basename string, no slash. No default/secret. Same private configuration bind;
# merged PROJECT_ONE_MONITORING_CONFIG_FILE maps to global monitoring_config_file,
# with explicit --env-file precedence. Restart applies, no application rebuild.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=workspace-policy.env
# Owner: Compose read-only profile bind; required canonical absolute existing
# host directory string; no default/implicit creation, secret values or relocation.
# Contains protected JSON matching monitoring.schema.json; restart applies.
PROJECT_ONE_MONITORING_PROFILE_HOST_ROOT=/srv/projectone/monitoring-inputs
# Owner: Compose read-only profile target; required canonical absolute directory
# string matching PROJECT_ONE_MONITORING_CONFIG_FILE, no alias/path rewrite.
# No secret/default; original typed file loader validates actual bytes on restart.
PROJECT_ONE_MONITORING_PROFILE_CONTAINER_ROOT=/run/projectone/config
