{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 MongoDB connector deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "timeout_seconds",
    "close_seconds",
    "batch_size",
    "maximum_concurrent",
    "maximum_attempts",
    "maximum_imports_per_dataset",
    "sources"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "close_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maximum_concurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "maximum_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "maximum_imports_per_dataset": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenant_id",
          "workspace_id",
          "uri_file",
          "ca_file",
          "tls",
          "database",
          "collection",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "uri_file": {
            "type": "string",
            "pattern": "^/"
          },
          "ca_file": {
            "type": "string"
          },
          "tls": {
            "type": "boolean"
          },
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
          },
          "collection": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
