# Owner: registry_validation.load_policy. Integer seconds, 30..600; default180.
# Optional nonsecret --env-file override of build_seconds in --validation-configuration.
# Unknown/empty/bool values fail. Re-read on every verification invocation.
PROJECT_ONE_REGISTRY_VALIDATION_BUILD_SECONDS=180
# Owner: registry_validation.load_policy. Integer seconds, 5..7200; default1800.
# Optional nonsecret --env-file override of test_seconds. Actual full-file timeout
# fails and retains evidence; no retry of unknown writes. Next invocation applies.
PROJECT_ONE_REGISTRY_VALIDATION_TEST_SECONDS=1800
# Owner: registry_validation.load_policy. Integer seconds, 5..60; default10.
# Optional nonsecret --env-file override of stability_seconds. Host30%headroom and
# existing <=60second observation remain mandatory. Next invocation applies.
PROJECT_ONE_REGISTRY_VALIDATION_STABILITY_SECONDS=10
# Owner: registry_validation.load_policy. Integer seconds, 1..30; default5.
# Optional nonsecret --env-file override of cleanup_seconds, exact owned groups
# only. Source/input/evidence references are never secrets here. Next run applies.
PROJECT_ONE_REGISTRY_VALIDATION_CLEANUP_SECONDS=5
