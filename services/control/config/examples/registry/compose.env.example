# Owner: existing control deployment. String basename of one merged protected
# policy file under PROJECT_ONE_CONFIG_ROOT; required, no default; canonical
# basename without separators. It contains PROJECT_ONE_REGISTRY_CONFIG_FILE plus
# other selected policies. Compose --env-file selects this mapping, the control
# explicit --env-file loads its content; no literal secrets. Restart required.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=registry-policy.env
# Owner: registry parent mount deployment. String absolute existing private0700 host path;
# required, no default; verified durable volume, no symlinks or implicit creation.
# Nonsecret bind source only; Compose --env-file substitution maps this path to
# the real verification mount; JSON store_root is its private CAS child. JSON remains the policy owner. Restart required.
PROJECT_ONE_REGISTRY_MOUNT_HOST_ROOT=/srv/projectone/registry-root
# Owner: typed registry verification.mount_root. String absolute canonical container path;
# required, no default; must equal protected component JSON verification.mount_root. Nonsecret
# bind destination, Compose --env-file mapping only; no runtime env fallback.
# Contains the separate CAS and prepared children; distinct from product/private roots; deployment restart required.
PROJECT_ONE_REGISTRY_MOUNT_CONTAINER_ROOT=/srv/projectone/registry-root
# Owner: signed prepared release deployment. String absolute existing host path;
# required, no default; actual verified immutable release with retained origin.
# Nonsecret bind source maps via Compose --env-file; never creates missing data.
# Mounted read-only; a deliberately selected different release requires restart.
PROJECT_ONE_REGISTRY_PREPARED_HOST_ROOT=/srv/projectone/registry-root/prepared
# Owner: typed prepared_release_root. String absolute canonical container path;
# required, no default; equals protected component JSON prepared_release_root.
# Nonsecret read-only bind destination from Compose --env-file; must not overlap
# CAS child/product/private roots. Restart and source-identity reconciliation required.
PROJECT_ONE_REGISTRY_PREPARED_CONTAINER_ROOT=/srv/projectone/registry-root/prepared
