# Nonsecret existing-node gateway helm deployment; typed owner tools/deploy/gateway/deployment.py.
# Explicit protected --env-file only; JSON (if supplied) validates before overrides; no ambient reads.

# Owner gateway helm deployment.architecture; Declared Linux image/ELF architecture: amd64 or arm64; never inferred from host.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_ARCHITECTURE=arm64

# Owner gateway helm deployment.configuration_directory; Existing canonical private0700 host directory containing protected JSON/env/CA/key/credential files; mounted read-only at this exact path.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_CONFIGURATION_DIRECTORY=/etc/projectone/gateway

# Owner gateway helm deployment.configuration_file; Protected startup JSON basename under configuration_directory.
# String; optional/default 'gateway.json'. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_CONFIGURATION_FILE=gateway.json

# Owner gateway helm deployment.cpu_millicores; Container CPU ceiling in millicores;1000 equals one CPU.
# Integer millicores; range 100..4000; optional/default 1000.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_CPU_MILLICORES=1000

# Owner gateway helm deployment.deployment_name; New scoped deployment name; DNS label,1..63characters. Does not select gateway authority.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_DEPLOYMENT_NAME=projectone-gateway-example

# Owner gateway helm deployment.environment_file; Optional protected explicit env-file basename under configuration_directory; empty selects JSON only.
# String; optional/default 'gateway.env'. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_ENVIRONMENT_FILE=gateway.env

# Owner gateway helm deployment.gid; Existing numeric service GID; no group is created.
# Integer count/ID; range 1..2147483647; required, no default.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_GID=10001

# Owner gateway helm deployment.image; Exact previously loaded gateway image tag or sha256 reference; latest is refused. No image pull.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_IMAGE=projectone/gateway:m07-example-arm64

# Owner gateway helm deployment.memory_mib; Container memory ceiling in MiB.
# Integer MiB; range 64..4096; optional/default 512.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_MEMORY_MIB=512

# Owner gateway helm deployment.node_name; Explicit existing colocated Kubernetes node name; required for Helm, empty allowed for Compose.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_NODE_NAME=existing-inference-node

# Owner gateway helm deployment.request_cpu_millicores; Kubernetes CPU request in millicores, no greater than ceiling.
# Integer millicores; range 1..4000; optional/default 250.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_REQUEST_CPU_MILLICORES=250

# Owner gateway helm deployment.request_memory_mib; Kubernetes memory request in MiB, no greater than ceiling.
# Integer MiB; range 16..4096; optional/default 128.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_REQUEST_MEMORY_MIB=128

# Owner gateway helm deployment.state_directory; Existing canonical private0700 original host spool directory; exclusive scope and persistent fence remain enforced by Rust.
# String; required, no default. See generated schema for permitted values.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_STATE_DIRECTORY=/var/lib/projectone/gateway

# Owner gateway helm deployment.stop_seconds; Container/pod graceful stop budget in seconds; must cover the selected Rust shutdown policy.
# Integer seconds; range 2..120; optional/default 15.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_STOP_SECONDS=15

# Owner gateway helm deployment.uid; Existing nonroot numeric service UID; no account is created.
# Integer count/ID; range 1..2147483647; required, no default.
# Nonsecret value/reference; protected --env-file overrides JSON; no shell expansion.
# Maps to rendered helm input; re-render and explicitly recreate/roll out to apply. Service restart/recreation required.
PROJECT_ONE_GATEWAY_DEPLOY_UID=10001
