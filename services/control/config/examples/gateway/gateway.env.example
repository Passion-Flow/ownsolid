# Explicit gateway --env-file; owner configuration.rs. No shell evaluation or ambient reads.
# Valid protected JSON is validated first; this file overrides declared fields.
# Every override requires restart; secret values are prohibited, only protected file references.

# Owner gateway.gateway_id; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_GATEWAY_ID=00000000-0000-0000-0000-000000000001

# Owner gateway.node_id; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_NODE_ID=00000000-0000-0000-0000-000000000002

# Owner gateway.listen_address; type string; required JSON field, no default.
# Numeric IPv4 loopback host:nonzero-port only; validated at startup.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_LISTEN_ADDRESS=127.0.0.1:18443

# Owner gateway.backend_address; type string; required JSON field, no default.
# Trusted operator configuration for the scoped colocated backend; numeric IPv4 loopback only. Never selected by a client request.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_BACKEND_ADDRESS=127.0.0.1:18000

# Owner gateway.control_origin; type string; required JSON field, no default.
# HTTPS origin only, no userinfo/path/query/fragment/trailing slash; private configured CA.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_CONTROL_ORIGIN=https://admin.example.invalid:8443

# Owner gateway.control_ca_file; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_CONTROL_CA_FILE=/etc/projectone/gateway/ca.pem

# Owner gateway.gateway_credential_file; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_GATEWAY_CREDENTIAL_FILE=/etc/projectone/gateway/credential

# Owner gateway.tls_certificate_file; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_TLS_CERTIFICATE_FILE=/etc/projectone/gateway/certificate.pem

# Owner gateway.tls_private_key_file; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_TLS_PRIVATE_KEY_FILE=/etc/projectone/gateway/private-key.pem

# Owner gateway.state_directory; type string; required JSON field, no default.
# Canonical UUID identity; new identity requires a new private state directory.
# Nonsecret value/reference; --env-file overrides JSON; restart required.
PROJECT_ONE_GATEWAY_STATE_DIRECTORY=/var/lib/projectone/gateway

# Owner gateway.limits.request_body_bytes; type integer; units bytes; optional/default 65536.
# Range 1..1048576; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_REQUEST_BODY_BYTES=65536

# Owner gateway.limits.request_memory_budget_bytes; type integer; units bytes; optional/default 67108864.
# Range 1..268435456; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_REQUEST_MEMORY_BUDGET_BYTES=67108864

# Owner gateway.limits.active_requests; type integer; units count; optional/default 4.
# Range 1..64; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_ACTIVE_REQUESTS=4

# Owner gateway.limits.queued_requests; type integer; units count; optional/default 8.
# Range 0..512; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_QUEUED_REQUESTS=8

# Owner gateway.limits.queue_milliseconds; type integer; units seconds; optional/default 2000.
# Range 1..10000; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_QUEUE_MILLISECONDS=2000

# Owner gateway.limits.connect_seconds; type integer; units seconds; optional/default 2.
# Range 1..10; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_CONNECT_SECONDS=2

# Owner gateway.limits.control_seconds; type integer; units seconds; optional/default 5.
# Range 1..30; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_CONTROL_SECONDS=5

# Owner gateway.limits.request_seconds; type integer; units seconds; optional/default 90.
# Range 1..300; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_REQUEST_SECONDS=90

# Owner gateway.limits.idle_seconds; type integer; units seconds; optional/default 15.
# Range 1..60; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_IDLE_SECONDS=15

# Owner gateway.limits.shutdown_seconds; type integer; units seconds; optional/default 5.
# Range 1..30; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_SHUTDOWN_SECONDS=5

# Owner gateway.limits.response_bytes; type integer; units bytes; optional/default 1048576.
# Range 1..1048576; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_RESPONSE_BYTES=1048576

# Owner gateway.limits.stream_event_bytes; type integer; units bytes; optional/default 65536.
# Range 256..65536; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_STREAM_EVENT_BYTES=65536

# Owner gateway.limits.stream_total_bytes; type integer; units bytes; optional/default 4194304.
# Range 256..16777216; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_STREAM_TOTAL_BYTES=4194304

# Owner gateway.limits.maximum_messages; type integer; units count; optional/default 32.
# Range 1..128; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_MAXIMUM_MESSAGES=32

# Owner gateway.limits.maximum_output_tokens; type integer; units tokens; optional/default 512.
# Range 1..512; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_MAXIMUM_OUTPUT_TOKENS=512

# Owner gateway.limits.spool_max_entries; type integer; units count; optional/default 1000.
# Range 1..65536; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_SPOOL_MAX_ENTRIES=1000

# Owner gateway.limits.spool_max_bytes; type integer; units bytes; optional/default 16777216.
# Range 4096..268435456; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_SPOOL_MAX_BYTES=16777216

# Owner gateway.limits.outcome_retry_seconds; type integer; units seconds; optional/default 2.
# Range 1..60; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_OUTCOME_RETRY_SECONDS=2

# Owner gateway.limits.maximum_context_tokens; type integer; units tokens; optional/default 2048.
# Range 1..65536; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_MAXIMUM_CONTEXT_TOKENS=2048

# Owner gateway.limits.control_idle_connections; type integer; units count; optional/default 2.
# Range 0..64; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_CONTROL_IDLE_CONNECTIONS=2

# Owner gateway.limits.minimum_free_disk_bytes; type integer; units bytes; optional/default 67108864.
# Range 4096..9007199254740991; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_MINIMUM_FREE_DISK_BYTES=67108864

# Owner gateway.limits.backend_idle_connections; type integer; units count; optional/default 4.
# Range 0..64; Must not exceed active_requests; native startup enforces the relationship.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_BACKEND_IDLE_CONNECTIONS=4

# Owner gateway.limits.runtime_threads; type integer; units count; optional/default 2.
# Range 1..8; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_RUNTIME_THREADS=2

# Owner gateway.limits.blocking_threads; type integer; units count; optional/default 4.
# Range 1..16; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_BLOCKING_THREADS=4

# Owner gateway.limits.maximum_connections; type integer; units count; optional/default 64.
# Range 1..1024; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_MAXIMUM_CONNECTIONS=64

# Owner gateway.limits.header_seconds; type integer; units seconds; optional/default 5.
# Range 1..30; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_HEADER_SECONDS=5

# Owner gateway.limits.header_bytes; type integer; units bytes; optional/default 16384.
# Range 8192..65536; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_HEADER_BYTES=16384

# Owner gateway.limits.default_output_tokens; type integer; units tokens; optional/default 128.
# Range 1..512; Must not exceed maximum_output_tokens.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_DEFAULT_OUTPUT_TOKENS=128

# Owner gateway.limits.default_temperature; type number; units unitless; optional/default 0.0.
# Range 0..2; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_DEFAULT_TEMPERATURE=0.0

# Owner gateway.limits.operator_seconds; type integer; units seconds; optional/default 30.
# Range 1..300; Cross-field bounds also validated by Limits.
# Nonsecret; --env-file overrides JSON/defaults; no ambient reads; restart required.
PROJECT_ONE_GATEWAY_LIMIT_OPERATOR_SECONDS=30
