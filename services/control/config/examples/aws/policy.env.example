# Control AWS discovery policy. Pass the private copy to control serve --env-file.
# Values override valid typed YAML. Ambient environment is ignored; all changes require restart.
# Control AWS owner: aws.enabled; type/units: boolean.
# Default/required: false; optional. Permitted: true or false.
# No secret value. Explicit --env-file overrides YAML aws.enabled; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_ENABLED=false

# Control AWS owner: aws.request_seconds; type/units: integer seconds.
# Default/required: 10; optional. Permitted: 1..60.
# No secret value. Explicit --env-file overrides YAML aws.request_seconds; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_REQUEST_SECONDS=10

# Control AWS owner: aws.import_seconds; type/units: integer seconds.
# Default/required: 25; optional. Permitted: request_seconds..600 and at most runtime.http.request_seconds.
# No secret value. Explicit --env-file overrides YAML aws.import_seconds; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_IMPORT_SECONDS=25

# Control AWS owner: aws.retry_attempts; type/units: integer attempts including initial call.
# Default/required: 3; optional. Permitted: 1..5.
# No secret value. Explicit --env-file overrides YAML aws.retry_attempts; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_RETRY_ATTEMPTS=3

# Control AWS owner: aws.retry_milliseconds; type/units: integer milliseconds, exponential base delay.
# Default/required: 250; optional. Permitted: 1..5000.
# No secret value. Explicit --env-file overrides YAML aws.retry_milliseconds; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_RETRY_MILLISECONDS=250

# Control AWS owner: aws.page_size; type/units: integer instances per EC2 page.
# Default/required: 100; optional. Permitted: 5..1000.
# No secret value. Explicit --env-file overrides YAML aws.page_size; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_PAGE_SIZE=100

# Control AWS owner: aws.maximum_pages; type/units: integer EC2 pages per import.
# Default/required: 100; optional. Permitted: 1..1000.
# No secret value. Explicit --env-file overrides YAML aws.maximum_pages; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_MAXIMUM_PAGES=100

# Control AWS owner: aws.maximum_resources; type/units: integer retained resources per Workspace and per snapshot.
# Default/required: 10000; optional. Permitted: 1..100000.
# No secret value. Explicit --env-file overrides YAML aws.maximum_resources; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_MAXIMUM_RESOURCES=10000

# Control AWS owner: aws.maximum_receipts; type/units: integer retained successful imports per Workspace.
# Default/required: 10000; optional. Permitted: 1..100000.
# No secret value. Explicit --env-file overrides YAML aws.maximum_receipts; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_MAXIMUM_RECEIPTS=10000

# Control AWS owner: aws.maximum_response_bytes; type/units: integer bytes per provider response.
# Default/required: 4194304; optional. Permitted: 1024..16777216.
# No secret value. Explicit --env-file overrides YAML aws.maximum_response_bytes; restart required.
# Compose: existing workspace-policy overlay; Helm: configuration.policyEnvironmentFile.
PROJECT_ONE_AWS_MAXIMUM_RESPONSE_BYTES=4194304

# Control AWS owner: protected JSON array of named account/region/Workspace connections.
# Type: absolute canonical file path; optional (YAML connections retained if omitted); no default file.
# Permitted: private owned 0600 regular file in owned 0700 directory, maximum 16384 bytes.
# Contains credential file REFERENCES only; never put access keys or secret keys in this file.
# Explicit --env-file replaces YAML aws.connections; restart required.
# Compose: provision under PROJECT_ONE_CONFIG_ROOT and existing private bind.
# Helm: include this basename and credential basenames in secrets.files; configuration.policyEnvironmentFile selects this env-file.
# Uncomment only after provisioning a reviewed private connection file.
# PROJECT_ONE_AWS_CONNECTIONS_FILE=/run/projectone/aws-connections.json

# Control HTTP owner: total browser/API request budget, integer seconds; optional default 15.
# Permitted: 1..300 under the existing HTTP policy; must cover enabled AWS import_seconds.
# No secret value. Explicit --env-file overrides runtime.http.request_seconds; restart required.
# Compose/Helm mapping: the same existing private policy env-file used above.
PROJECT_ONE_HTTP_REQUEST_SECONDS=30

# Control AWS owner: aws.maximum_concurrent_imports, integer in-flight imports per process.
# Optional default 1; permitted 1..8; excess new work is rejected, exact completed-key recovery remains available.
# No secret value. Explicit --env-file overrides YAML; restart required.
# Compose/Helm mapping: the same existing private policy env-file used above.
PROJECT_ONE_AWS_MAXIMUM_CONCURRENT_IMPORTS=1
