# Compose image owner; required immutable same-target image reference, no default.
# Replace marker with an already loaded current signed-tool control image @sha256.
# Public metadata, never credentials; maps tool-only.yaml control.image and wins
# over the base control image. Match base PROJECT_ONE_PLATFORM. Recreate to apply.
PROJECT_ONE_PLUGINS_CONTROL_IMAGE=REPLACE_WITH_LOADED_CURRENT_CONTROL_IMAGE_AT_SHA256
# Compose memory owner; positive Docker memory quantity, optional default3g.
# Nonsecret; maps control.mem_limit. Preserve host30percent headroom plus other
# selected services. This declared3GiB budget is not a measured minimum. Recreate.
PROJECT_ONE_PLUGINS_CONTROL_MEMORY=3g
# Compose CPU owner; positive finite CPU quantity, optional default2 CPUs.
# Nonsecret; maps control.cpus over base, constrained by host admission. Recreate.
PROJECT_ONE_PLUGINS_CONTROL_CPUS=2
# Compose process owner; positive integer process limit, optional default128.
# Nonsecret; maps control.pids_limit over base. Recreate required for changes.
PROJECT_ONE_PLUGINS_CONTROL_PIDS=128
# Compose shutdown owner; positive duration, optional default40s, greater than
# effective control runtime.http.shutdown_seconds (example30s). Nonsecret;
# maps control.stop_grace_period, no application-policy override. Recreate.
PROJECT_ONE_PLUGINS_STOP_GRACE=40s

# PostgreSQL catalog owner inherited from M12; required immutable OCI image@sha256.
# Select the already loaded same-target digest in contracts/knowledge/v1/postgres-image.json.
# No secrets; maps tool-only.yaml postgres.image over base. No encoder process.
# No default; retain the existing compatible database or use an explicitly fresh root.
# Recreate applies image selection; never reuse an incompatible database directory.
PROJECT_ONE_KNOWLEDGE_POSTGRES_IMAGE=REPLACE_WITH_APPROVED_SAME_TARGET_POSTGRES_VECTOR_IMAGE_AT_SHA256
