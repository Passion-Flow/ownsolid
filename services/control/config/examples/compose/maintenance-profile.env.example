# Compose command projection owner: basename in the existing protected config root.
# Required string for base/workspace-policy.yaml; no default, no directory or traversal.
# Nonsecret file reference only. Existing Compose mapping passes /run/projectone/<name>
# as control serve --env-file; that typed loader applies maintenance-profile.env.example.
# Restart required; container ambient environment does not configure application policy.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=maintenance-profile.env
