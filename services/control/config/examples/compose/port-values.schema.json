{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectone.invalid/configuration/compose-port-values/v1",
  "title": "Explicit ordinary Compose TCP port binding intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "bind_address",
    "published_port",
    "target_port"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "bind_address": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical numeric unbracketed IP; typed Go validation refuses zones, mapped, multicast, DNS and noncanonical forms. Explicit wildcard bind allowed."
    },
    "published_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "target_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
