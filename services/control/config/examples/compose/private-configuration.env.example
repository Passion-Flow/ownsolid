# Optional explicit native-installer overlay, not a Compose interpolation file.
# Every base JSON field is required and validated before overlay application.
# No ambient environment is read. Identity/hash/file records cannot be overridden.

# Owner/purpose: composeprofile private installer; input mount path.
# Type/range: canonical absolute path, distinct and non-nested with target; required in JSON, no default.
# Secret handling: protected directory reference only. Mapping: source_root; explicit env-file > valid JSON.
# Effect: a new invocation only; keep the same effective request for inspect/recover, no runtime reload.
PROJECT_ONE_PRIVATE_SOURCE_ROOT=/source

# Owner/purpose: composeprofile private installer; exact native volume mount path.
# Type/range: canonical absolute path, distinct and non-nested with source; required in JSON, no default.
# Secret handling: protected volume reference only. Mapping: target_root; explicit env-file > valid JSON.
# Effect: new invocation only; changing an existing operation's root is refused by its identity.
PROJECT_ONE_PRIVATE_TARGET_ROOT=/target

# Owner/purpose: composeprofile private installer; source UID observed inside the selected Engine.
# Type/range: integer ID, 0..2147483647; required in JSON, no default; 0 explicitly selects root view.
# Secret handling: nonsecret ID. Mapping: source_uid; explicit env-file > valid JSON, no inferred translation.
# Effect: invocation only; a changed existing request requires a new owned operation, not reload.
PROJECT_ONE_PRIVATE_SOURCE_UID=0

# Owner/purpose: composeprofile private installer; source GID observed inside the selected Engine.
# Type/range: integer ID, 0..2147483647; required in JSON, no default.
# Secret handling: nonsecret ID. Mapping: source_gid; explicit env-file > valid JSON.
# Effect: invocation only; preserve the original effective request for recovery, no service reload.
PROJECT_ONE_PRIVATE_SOURCE_GID=0

# Owner/purpose: composeprofile private installer; numeric control file owner UID.
# Type/range: integer ID, 1..2147483647; required in JSON, no default; must match runtime user.
# Secret handling: nonsecret ID. Mapping: uid; explicit env-file > valid JSON.
# Effect: new private installation only; cannot change ownership of a committed generation.
PROJECT_ONE_PRIVATE_UID=65532

# Owner/purpose: composeprofile private installer; numeric control file owner GID.
# Type/range: integer ID, 1..2147483647; required in JSON, no default; must match runtime group.
# Secret handling: nonsecret ID. Mapping: gid; explicit env-file > valid JSON.
# Effect: new private installation only; cannot change ownership of a committed generation.
PROJECT_ONE_PRIVATE_GID=65532

# Owner/purpose: composeprofile private installer; per-file encoded read/write budget.
# Type/units/range: integer bytes, 1..4194304; required in JSON, no default.
# Secret handling: nonsecret limit. Mapping: maximum_file_bytes; explicit env-file > valid JSON.
# Effect: invocation only; every declared file must fit, and recovery retains the original limit.
PROJECT_ONE_PRIVATE_MAXIMUM_FILE_BYTES=1048576

# Owner/purpose: composeprofile private installer; aggregate encoded payload budget.
# Type/units/range: integer bytes, file limit..33554432; required in JSON, no default.
# Secret handling: nonsecret limit. Mapping: maximum_total_bytes; explicit env-file > valid JSON.
# Effect: invocation only; bounds frozen payload memory and storage admission, no runtime reload.
PROJECT_ONE_PRIVATE_MAXIMUM_TOTAL_BYTES=4194304

# Owner/purpose: composeprofile private installer; cooperative complete operation deadline.
# Type/units/range: integer seconds, 1..300; required in JSON, no default; caller also bounds OS process/stdin.
# Secret handling: nonsecret limit. Mapping: timeout_seconds; explicit env-file > valid JSON.
# Effect: invocation only; timeout preserves uncertain state for explicit inspection/recovery.
PROJECT_ONE_PRIVATE_TIMEOUT_SECONDS=30
