# Existing base Compose interpolation contract; no application credentials or policy values.
# Provision required paths/image before use; REPLACE markers are deliberately unusable.
# Explicit --env-file is recommended. Ambient shell values take precedence in Compose; clear
# conflicting values explicitly. Unknown unused keys are not rejected by Compose itself.

# Owner: base Compose. Purpose: Compose project name.
# Type/units: string; lowercase project identifier. Required/default/range: default projectone; nonempty [a-z0-9][a-z0-9_-]*.
# Mapping: top-level name. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_COMPOSE_PROJECT=projectone

# Owner: base Compose. Purpose: persistent host data root.
# Type/units: absolute canonical directory path. Required/default/range: required; provision existing postgres child; no automatic directory creation.
# Mapping: postgres bind source. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATA_ROOT=/REPLACE_WITH_EXISTING_PRIVATE_DATA_ROOT

# Owner: base Compose. Purpose: protected host configuration and secret references.
# Type/units: absolute canonical private directory path. Required/default/range: required; provision matching runtime UID access; no secret values here.
# Mapping: control read-only bind and postgres-password secret file. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONFIG_ROOT=/REPLACE_WITH_EXISTING_PRIVATE_CONFIGURATION_ROOT

# Owner: base Compose. Purpose: loaded control image.
# Type/units: immutable image reference/digest. Required/default/range: required; use declared target artifact, never floating latest.
# Mapping: control image. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONTROL_IMAGE=REPLACE_WITH_VERIFIED_IMMUTABLE_CONTROL_IMAGE

# Owner: base Compose. Purpose: exact target architecture.
# Type/units: string enum linux/amd64 or linux/arm64. Required/default/range: required; select only a declared supported image profile.
# Mapping: control platform. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_PLATFORM=linux/amd64

# Owner: base Compose. Purpose: container secret-file owner UID.
# Type/units: positive decimal integer. Required/default/range: required; choose existing numeric container ownership, no host account creation.
# Mapping: control user UID. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_RUNTIME_UID=65532

# Owner: base Compose. Purpose: container secret-file owner GID.
# Type/units: positive decimal integer. Required/default/range: required; match provisioned protected files.
# Mapping: control user GID. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_RUNTIME_GID=65532

# Owner: base Compose. Purpose: host publication bind.
# Type/units: numeric IPv4 or unbracketed IPv6 string. Required/default/range: default 127.0.0.1; explicit wildcard/routable binds need isolated network admission.
# Mapping: control ports.host_ip; never an advertised browser origin. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_BIND_ADDRESS=127.0.0.1

# Owner: base Compose. Purpose: historical host published port.
# Type/units: decimal TCP port. Required/default/range: default 8443; select static 1..65535; no neutral alias in this repair.
# Mapping: control ports.published; independent of origins and target. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_HTTPS_PORT=8443

# Owner: base Compose. Purpose: container control listener target.
# Type/units: decimal TCP port. Required/default/range: default 8443; 1..65535; must match actual typed server listener.
# Mapping: control ports.target. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONTROL_PORT=8443

# Owner: base Compose. Purpose: initial isolated database name.
# Type/units: PostgreSQL database identifier string. Required/default/range: default projectone; valid identifier for the chosen private deployment.
# Mapping: postgres POSTGRES_DB. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_NAME=projectone

# Owner: base Compose. Purpose: initial database operator role.
# Type/units: PostgreSQL role identifier string. Required/default/range: default projectone_migrator; runtime and operator roles remain separate.
# Mapping: postgres POSTGRES_USER; password is protected postgres-password file. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_USER=projectone_migrator

# Owner: base Compose. Purpose: database container memory cap.
# Type/units: positive Compose byte-size string. Required/default/range: default 512m; retain host headroom and selected workload budget.
# Mapping: postgres mem_limit. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_MEMORY=512m

# Owner: base Compose. Purpose: database sustained CPU cap.
# Type/units: positive decimal CPU cores. Required/default/range: default 1; obey admitted host concurrency/headroom.
# Mapping: postgres cpus. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_CPUS=1

# Owner: base Compose. Purpose: database process cap.
# Type/units: positive decimal process count. Required/default/range: default 100; ensure selected PostgreSQL workers fit.
# Mapping: postgres pids_limit. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_PIDS=100

# Owner: base Compose. Purpose: database maximum connections.
# Type/units: positive decimal connection count. Required/default/range: default 30; budget backend memory and clients before increasing.
# Mapping: postgres -c max_connections. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_MAX_CONNECTIONS=30

# Owner: base Compose. Purpose: database shared buffers.
# Type/units: positive PostgreSQL memory-size string. Required/default/range: default 64MB; must fit database memory cap and target policy.
# Mapping: postgres -c shared_buffers. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_SHARED_BUFFERS=64MB

# Owner: base Compose. Purpose: database health interval.
# Type/units: positive Compose duration. Required/default/range: default 5s; units required; selected deployment scheduler policy.
# Mapping: postgres healthcheck.interval. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_HEALTH_INTERVAL=5s

# Owner: base Compose. Purpose: database health timeout.
# Type/units: positive Compose duration. Required/default/range: default 3s; units required; keep below declared interval.
# Mapping: postgres healthcheck.timeout. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_HEALTH_TIMEOUT=3s

# Owner: base Compose. Purpose: database health consecutive failure limit.
# Type/units: positive decimal attempts. Required/default/range: default 12; no disabled health or arbitrary security toggle.
# Mapping: postgres healthcheck.retries. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_DATABASE_HEALTH_RETRIES=12

# Owner: base Compose. Purpose: control container memory cap.
# Type/units: positive Compose byte-size string. Required/default/range: default 384m; fit Go heap/native overhead and selected modules.
# Mapping: control mem_limit. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONTROL_MEMORY=384m

# Owner: base Compose. Purpose: control sustained CPU cap.
# Type/units: positive decimal CPU cores. Required/default/range: default 1; obey admitted host concurrency/headroom.
# Mapping: control cpus. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONTROL_CPUS=1

# Owner: base Compose. Purpose: control process cap.
# Type/units: positive decimal process count. Required/default/range: default 128; account for selected owned execution profile.
# Mapping: control pids_limit. Secret handling: protected file references only, never inline credentials.
# Precedence: Compose shell > explicit --env-file > template default; empty optional values use defaults.
# Effect: recreate/restart the affected service explicitly; no hot reload or automatic migration.
PROJECT_ONE_CONTROL_PIDS=128
