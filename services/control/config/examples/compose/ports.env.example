# Port renderer owner: explicit host bind, numeric unbracketed IPv4/IPv6 string.
# Optional override of required JSON bind_address; no default here; canonical loopback/global-unicast/wildcard only.
# No secret; exact reference identity is retained, never used as an advertised origin.
# Explicit operator --env-file > independently valid JSON; ambient environment is ignored.
# Mapping: compose-port-values host_ip; regenerate final override and explicitly recreate affected service, no reload.
PROJECT_ONE_BIND_ADDRESS=::1

# Port renderer owner: host-published TCP port, canonical decimal integer1..65535.
# Optional override of required JSON published_port; no default or neutral alias here; false/empty/unknown reject.
# No secret/reference; this is distinct from container target and advertised origin port.
# Explicit operator --env-file > independently valid JSON; ambient environment is ignored.
# Mapping: compose-port-values published; regenerate override and explicitly recreate service, no reload.
PROJECT_ONE_HTTPS_PORT=19443

# Port renderer owner: container listener target, canonical decimal TCP integer1..65535.
# Optional override of required JSON target_port; no default here; must match effective application listener.
# No secret/reference; actual nonroot binding permissions need installed qualification.
# Explicit operator --env-file > independently valid JSON; ambient environment is ignored.
# Mapping: compose-port-values target; regenerate override and explicitly recreate service, no reload.
PROJECT_ONE_CONTROL_PORT=9443
