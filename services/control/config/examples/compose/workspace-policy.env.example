# Compose/control owner: existing protected file basename inside PROJECT_ONE_CONFIG_ROOT.
# Required string when workspace-policy.yaml is selected; choose workspace-policy.env after provisioning it.
# No secret value; pass only a single ASCII basename (letters/digits/dot/underscore/hyphen), no path traversal.
# Compose maps it to control serve --env-file inside the existing /run/projectone bind; restart required.
# Runtime integers are owned by control Workspace/database/HTTP/SSO-maintenance examples,not container variables.
# HTTP keys: all nine PROJECT_ONE_HTTP_* entries in config/examples/control/http-policy.env.example.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=workspace-policy.env
