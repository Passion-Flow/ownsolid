{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local native Dameng connector versions 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "transport",
    "native_manifest_file",
    "native_configuration_directory",
    "socket_file",
    "socket_owner_uid",
    "user",
    "schema",
    "password_file",
    "operation_seconds",
    "transaction_seconds",
    "cleanup_seconds",
    "policy"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "transport": {
      "const": "linux_unixsocket"
    },
    "native_manifest_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "description": "Canonical absolute path; runtime additionally rejects links and enforces private ownership."
    },
    "native_configuration_directory": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "description": "Canonical absolute path; runtime additionally rejects links and enforces private ownership."
    },
    "socket_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "description": "Canonical absolute path; runtime additionally rejects links and enforces private ownership.",
      "maxLength": 107
    },
    "socket_owner_uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "user": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,62}$",
      "not": {
        "enum": [
          "SYS",
          "SYSDBA",
          "SYSSSO",
          "SYSAUDITOR"
        ]
      }
    },
    "schema": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,62}$"
    },
    "password_file": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "description": "Canonical absolute path; runtime additionally rejects links and enforces private ownership."
    },
    "operation_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "transaction_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "cleanup_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login_seconds",
        "connection_seconds",
        "query_seconds",
        "maximum_parameter_bytes",
        "maximum_cell_bytes",
        "maximum_rows",
        "maximum_columns",
        "maximum_result_bytes",
        "maximum_sql_bytes",
        "maximum_open_connections",
        "maximum_physical_connections"
      ],
      "properties": {
        "login_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "connection_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "query_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "maximum_parameter_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximum_cell_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576
        },
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10001
        },
        "maximum_columns": {
          "type": "integer",
          "minimum": 6,
          "maximum": 128
        },
        "maximum_result_bytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 16777216
        },
        "maximum_sql_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "maximum_open_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maximum_physical_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maximum_long_value_bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 67108864,
          "description": "Per LONG text UTF-8 or binary byte bound. Required in long-value format; runtime also requires >= maximum_cell_bytes."
        },
        "transfer_chunk_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 262144,
          "multipleOf": 4,
          "description": "Native transfer scratch in bytes. Runtime also requires <= maximum_parameter_bytes; descriptors plus inline bindings plus the active DAE scratch must fit that parameter bound."
        },
        "maximum_retained_bytes": {
          "type": "integer",
          "minimum": 8256,
          "maximum": 536870912,
          "description": "Manager-wide admission budget for binding/scratch/materialized-result ownership. Runtime additionally requires >= 4*maximum_long_value_bytes + 2*transfer_chunk_bytes. Not a process RSS limit."
        }
      },
      "description": "Runtime also requires maximum_result_bytes >= maximum_cell_bytes and maximum_physical_connections >= maximum_open_connections."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "policy": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "maximum_long_value_bytes"
                  ]
                },
                {
                  "required": [
                    "transfer_chunk_bytes"
                  ]
                },
                {
                  "required": [
                    "maximum_retained_bytes"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "policy": {
            "required": [
              "maximum_long_value_bytes",
              "transfer_chunk_bytes",
              "maximum_retained_bytes"
            ]
          }
        }
      }
    }
  ],
  "description": "Versioned closed input. Runtime checks canonical protected references and all cross-field bounds. Legacy format forbids all long-value fields; new format requires all three. No target qualification or serving selector is implied."
}
