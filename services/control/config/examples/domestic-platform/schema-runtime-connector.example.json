{
  "format_version": 1,
  "transport": "linux_unixsocket",
  "native_manifest_file": "/srv/project-one/dameng/connector/native-manifest.json",
  "native_configuration_directory": "/srv/project-one/dameng/native-config",
  "socket_file": "/srv/project-one/dameng/socket/dm.sock",
  "socket_owner_uid": 1000,
  "user": "P1_RUNTIME",
  "schema": "P1_FOUNDATION",
  "password_file": "/srv/project-one/dameng/connector/runtime-password",
  "operation_seconds": 30,
  "transaction_seconds": 30,
  "cleanup_seconds": 10,
  "policy": {
    "login_seconds": 5,
    "connection_seconds": 20,
    "query_seconds": 20,
    "maximum_parameter_bytes": 65536,
    "maximum_cell_bytes": 16384,
    "maximum_rows": 512,
    "maximum_columns": 16,
    "maximum_result_bytes": 262144,
    "maximum_sql_bytes": 16384,
    "maximum_open_connections": 1,
    "maximum_physical_connections": 1
  }
}
