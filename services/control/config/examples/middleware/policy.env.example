# Owner: middleware request budget; integer seconds, optional default30, range1..300.
# Nonsecret; explicit env-file overrides protected JSON policy.request_seconds; restart required.
PROJECT_ONE_MIDDLEWARE_REQUEST_SECONDS=30
# Owner: middleware read-only connection/probe; integer seconds, optional default10, range1..120.
# Nonsecret; explicit env-file overrides policy.probe_seconds; restart required.
PROJECT_ONE_MIDDLEWARE_PROBE_SECONDS=10
# Owner: middleware owning-operation budget; integer seconds, optional default7200, range30..86400.
# Nonsecret; explicit env-file overrides policy.operation_seconds; restart required.
PROJECT_ONE_MIDDLEWARE_OPERATION_SECONDS=7200
# Owner: middleware worker lease; integer seconds, optional default120, range10..3600.
# Nonsecret; explicit env-file overrides policy.lease_seconds; restart required.
PROJECT_ONE_MIDDLEWARE_LEASE_SECONDS=120
# Owner: middleware lease renewal; integer seconds, optional default30, range1..lease_seconds/3.
# Nonsecret; explicit env-file overrides policy.renew_seconds; restart required.
PROJECT_ONE_MIDDLEWARE_RENEW_SECONDS=30
# Owner: middleware worker polling; integer milliseconds, optional default1000, range100..60000.
# Nonsecret; explicit env-file overrides policy.poll_milliseconds; restart required.
PROJECT_ONE_MIDDLEWARE_POLL_MILLISECONDS=1000
# Owner: middleware Workspace registration count; integer registrations, optional default100, range1..10000.
# Nonsecret; explicit env-file overrides policy.maximum_instances; restart required.
PROJECT_ONE_MIDDLEWARE_MAXIMUM_INSTANCES=100
# Owner: middleware response pagination; integer rows, optional default50, range1..200.
# Nonsecret; explicit env-file overrides policy.page_size; restart required.
PROJECT_ONE_MIDDLEWARE_PAGE_SIZE=50
# Owner: middleware private evidence bound; integer bytes, optional default1048576, range4096..16777216.
# Nonsecret; explicit env-file overrides policy.maximum_evidence_bytes; restart required.
PROJECT_ONE_MIDDLEWARE_MAXIMUM_EVIDENCE_BYTES=1048576
