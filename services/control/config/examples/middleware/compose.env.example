# Owner: Compose control command; required filename string, one existing protected
# merged policy file in the existing private configuration bind. Basename only,
# no path separators. Contains the two explicit component reference keys.
# Nonsecret reference, --env-file input; restart required, no application rebuild.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=workspace-policy.env
# Owner: Compose read-only M26 profile bind; required canonical absolute existing
# host directory string. Contains protected JSON/policy/CA/password references,
# never inline secrets. No implicit creation or relocation; restart required.
PROJECT_ONE_MIDDLEWARE_PROFILE_HOST_ROOT=/srv/projectone/middleware-inputs
# Owner: Compose M26 profile target; required canonical absolute directory string,
# matching component JSON/secret references and the selected reference env-file.
# Nonsecret, no default/path rewrite. Mounted read-only; restart required.
PROJECT_ONE_MIDDLEWARE_PROFILE_CONTAINER_ROOT=/run/projectone/middleware
