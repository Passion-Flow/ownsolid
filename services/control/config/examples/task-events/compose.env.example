# Compose owner: existing private credential directory; string absolute canonical host path.
# Required by task-events overlay, no default; preprovision0700 runtime UID, files0600.
# Secret references only; never key bytes. Maps to read-only bind source; restart.
# Compose explicit --env-file selects this value; does not enter ambient runtime configuration.
PROJECT_ONE_TASK_EVENTS_SECRET_HOST_ROOT=/srv/projectone/private/task-events
# Compose owner: absolute canonical container directory, distinct from existing runtime mounts.
# Required/no default; five task_events file references must name files under this directory.
# No secret bytes; maps to read-only bind target. Explicit Compose --env-file; restart.
PROJECT_ONE_TASK_EVENTS_SECRET_CONTAINER_ROOT=/run/secrets/task-events
# Control deployment owner: existing protected policy basename in PROJECT_ONE_CONFIG_ROOT.
# Required/no default; one plain basename, merge task-event keys with other selected policies.
# Secret-file references only; maps to serving --env-file under /run/projectone; restart.
# Compose --env-file selects the basename; protected file overrides valid control YAML.
PROJECT_ONE_POLICY_ENVIRONMENT_BASENAME=control-policy.env
