@@ -0,0 +1,26 @@
+package inference
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+
+	wire "github.com/Passion-Flow/ownsolid/api/agent/v1"
+)
+
+// gw103ToolCandidate exists only in the disposable qualification build.
+func gw103ToolCandidate(config ContainerConfig, recipe wire.InferenceRecipe, catalog string) (ContainerConfig, error) {
+	const catalogSHA256 = "4d32aa5cd4b2d86f12beff791f0428f0813c2d3479041080d13b0be6bc6842bc"
+	const recipeSHA256 = "48fa2638f2e3e8dca1359e77b34aa4f7a34b9f24ba0dee96602feb6fb1f08a31"
+	encoded, err := json.Marshal(recipe)
+	digest := sha256.Sum256(encoded)
+	if err != nil || catalog != catalogSHA256 || hex.EncodeToString(digest[:]) != recipeSHA256 {
+		return ContainerConfig{}, fail("INFERENCE_CONFIGURATION_INVALID")
+	}
+	config.Cmd = append(config.Cmd,
+		"--enable-auto-tool-choice", "--tool-call-parser", "hermes",
+		"--no-trust-remote-code", "--no-trust-request-chat-template",
+		"--default-chat-template-kwargs", `{"enable_thinking":false}`,
+	)
+	return config, nil
+}
