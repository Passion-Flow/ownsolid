+package inference
+
+import (
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	wire "github.com/Passion-Flow/ownsolid/api/agent/v1"
+)
+
+func TestGW103CandidatePreservesContainerIsolation(t *testing.T) {
+	deployment := "00000000-0000-0000-0000-000000000001"
+	node := "00000000-0000-0000-0000-000000000002"
+	gpu := "GPU-00000000-0000-0000-0000-000000000003"
+	root := "/opt/projectone-inference-test/runtime"
+	catalog := wire.ModelCatalogDigest()
+	model := root + "/models/" + catalog
+	cache := root + "/deployments/" + deployment + "/cache"
+	network := strings.Repeat("a", 64)
+	baseline, err := containerConfiguration(deployment, node, gpu, model, cache, network, catalog, "float16", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	textArgv := []string{"/model", "--tokenizer", "/model", "--served-model-name", "projectone-qwen3-0.6b", "--host", "0.0.0.0", "--port", "8000", "--dtype", "float16", "--max-model-len", "2048", "--max-num-seqs", "4", "--gpu-memory-utilization", "0.75", "--enforce-eager"}
+	if !slices.Equal(baseline.Cmd, textArgv) {
+		t.Fatalf("text argv drifted: %q", baseline.Cmd)
+	}
+	candidate, err := ContainerConfiguration(deployment, node, gpu, model, cache, network)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseline.Cmd = append(textArgv,
+		"--enable-auto-tool-choice", "--tool-call-parser", "hermes", "--no-trust-remote-code", "--no-trust-request-chat-template",
+		"--default-chat-template-kwargs", `{"enable_thinking":false}`)
+	if !reflect.DeepEqual(candidate, baseline) {
+		t.Fatalf("candidate changed container configuration: got %+v, want %+v", candidate, baseline)
+	}
+	manager := Manager{config: Config{RootDirectory: root}}
+	owned, err := manager.commandContainerConfiguration(journal{
+		NodeID: node, NetworkID: network, Command: wire.InferenceCommand{DeploymentID: deployment, GPUUUID: gpu},
+	})
+	if err != nil || !reflect.DeepEqual(candidate, owned) {
+		t.Fatalf("ownership check did not reconstruct the candidate: %v", err)
+	}
+	derived := derivedCommandFixture(t)
+	derivedSpec, err := DerivedContainerConfiguration(derived, node, root+"/models/"+derived.CatalogDigest, root+"/deployments/"+derived.DeploymentID+"/cache", network)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, flag := range []string{"--enable-auto-tool-choice", "--tool-call-parser", "--no-trust-request-chat-template"} {
+		if slices.Contains(derivedSpec.Cmd, flag) {
+			t.Fatalf("derived launch received candidate flag %q", flag)
+		}
+	}
+}
+
+func TestGW103CandidateRejectsUnqualifiedIdentity(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		changeRecipe func(*wire.InferenceRecipe)
+		otherCatalog string
+	}{
+		{name: "different catalog", otherCatalog: strings.Repeat("c", 64)},
+		{name: "derived catalog", otherCatalog: derivedCommandFixture(t).CatalogDigest},
+		{name: "CPU image version", changeRecipe: func(r *wire.InferenceRecipe) { r.Version = "0.29.0" }},
+		{name: "different manifest", changeRecipe: func(r *wire.InferenceRecipe) { r.ImageManifestDigest = "sha256:" + strings.Repeat("a", 64) }},
+		{name: "different image config", changeRecipe: func(r *wire.InferenceRecipe) { r.ImageConfigDigest = "sha256:" + strings.Repeat("b", 64) }},
+		{name: "different launch recipe", changeRecipe: func(r *wire.InferenceRecipe) { r.MaximumContext++ }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			recipe := wire.ApprovedInferenceRecipe()
+			catalog := wire.ModelCatalogDigest()
+			if tc.otherCatalog != "" {
+				catalog = tc.otherCatalog
+			}
+			if tc.changeRecipe != nil {
+				tc.changeRecipe(&recipe)
+			}
+			config, err := gw103ToolCandidate(ContainerConfig{Cmd: []string{"/model"}}, recipe, catalog)
+			if err == nil || err.Error() != "INFERENCE_CONFIGURATION_INVALID" || !reflect.DeepEqual(config, ContainerConfig{}) {
+				t.Fatalf("unqualified identity yielded a launch configuration: %+v, %v", config, err)
+			}
+		})
+	}
+}
