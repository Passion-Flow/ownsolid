{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected SSO provider inventory mapped to sso.providers",
  "type": "array",
  "maxItems": 64,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "origin",
      "issuer",
      "dial_addresses"
    ],
    "properties": {
      "origin": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "issuer": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "dial_addresses": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "ca_file": {
        "type": "string"
      }
    }
  }
}
