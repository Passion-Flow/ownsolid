{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectone.invalid/configuration/v1/control-knowledge/gateways",
  "title": "Protected approved knowledge HTTPS gateway inventory",
  "type": "array",
  "maxItems": 64,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "origin",
      "dial_addresses"
    ],
    "properties": {
      "origin": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "dial_addresses": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "ca_file": {
        "type": "string"
      }
    }
  }
}
