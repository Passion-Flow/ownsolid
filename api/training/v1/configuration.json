{
  "schema_version": 1,
  "configuration": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "device": {
        "type": "string",
        "enum": [
          "nvidia_bfloat16",
          "cpu_verification"
        ],
        "default": "nvidia_bfloat16"
      },
      "maximum_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 100
      },
      "maximum_tokens": {
        "type": "integer",
        "minimum": 32,
        "maximum": 2048,
        "default": 256
      },
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "default": 1
      },
      "gradient_accumulation_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "default": 1
      },
      "learning_rate": {
        "type": "string",
        "pattern": "^0\\.[0-9]{1,6}$",
        "decimal_minimum": "0.000001",
        "decimal_maximum": "0.01",
        "default": "0.0002"
      },
      "rank": {
        "type": "integer",
        "enum": [
          4,
          8,
          16
        ],
        "default": 8
      },
      "alpha": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 16
      },
      "dropout": {
        "type": "string",
        "pattern": "^(0|0\\.[0-9]{1,6})$",
        "decimal_minimum": "0",
        "decimal_maximum": "0.5",
        "default": "0"
      },
      "checkpoint_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 10
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 42
      },
      "threads": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 2
      }
    },
    "required": [
      "device",
      "maximum_steps",
      "maximum_tokens",
      "batch_size",
      "gradient_accumulation_steps",
      "learning_rate",
      "rank",
      "alpha",
      "dropout",
      "checkpoint_steps",
      "seed",
      "threads"
    ]
  },
  "recipe": {
    "version": 1,
    "modules": [
      "q_proj",
      "v_proj"
    ],
    "task_type": "CAUSAL_LM",
    "optimizer": "adamw_torch",
    "scheduler": "constant",
    "weight_decay": 0,
    "maximum_gradient_norm": 1,
    "maximum_checkpoints": 100,
    "deterministic": true,
    "dataloader_workers": 0,
    "interop_threads": 1,
    "gradient_checkpointing": false
  },
  "wire_limits": {
    "maximum_checkpoint_metadata_bytes": 1048576,
    "maximum_checkpoint_files": 4096,
    "maximum_checkpoint_bytes": 2147483648
  }
}
