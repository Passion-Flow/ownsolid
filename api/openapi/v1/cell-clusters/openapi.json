          }
        }
      ],
      "post": {
        "operationId": "observeCellCluster",
        "summary": "Ask every settled member whose node is idle to report its readiness",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
