{
  "openapi": "3.1.0",
  "info": {
    "title": "ownsolid cell clusters",
    "version": "1.0.0",
    "description": "One Kubernetes cluster per cell, installed by ownsolid on nodes of the kubernetes_node profile (ARC-104, ADR 0051). Control writes join, token and observe tasks; the agent on each node installs RKE2 from the offline bundle. PostgreSQL only."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/sites/{site_id}/cells/{cell_id}/admin/cell-clusters": {
      "parameters": [
        {
          "name": "site_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
          }
        },
        {
          "name": "cell_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
          }
        }
      ],
      "get": {
        "operationId": "listCellClusters",
        "summary": "List this cell's Kubernetes clusters (at most one)",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "The cell's clusters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterListResponse"
                }
              }
            }
          },
          "default": {
            "description": "Structured failure; no fake success",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-error-codes": {
          "400": [
            "VALIDATION_FAILED"
          ],
          "401": [
            "AUTH_REQUIRED",
            "AUTH_SESSION_EXPIRED"
          ],
          "403": [
            "ACCESS_DENIED",
            "ORIGIN_REJECTED"
          ],
          "404": [
            "RESOURCE_NOT_FOUND"
          ],
          "409": [
            "KUBERNETES_CELLS_UNCONFIGURED",
            "KUBERNETES_CLUSTER_STORAGE_UNSUPPORTED"
          ],
          "503": [
            "STORAGE_UNAVAILABLE"
          ]
        }
      },
      "post": {
        "operationId": "createCellCluster",
        "summary": "Create the cell's Kubernetes cluster from a server node and worker nodes",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created, or the cluster this key created before. The server's join task is written at once when the server is idle; workers join once it is ready, in batches.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterResponse"
                }
              }
            }
          },
          "default": {
            "description": "Structured failure; no fake success",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-error-codes": {
          "400": [
            "VALIDATION_FAILED"
          ],
          "401": [
            "AUTH_REQUIRED",
            "AUTH_SESSION_EXPIRED"
          ],
          "403": [
            "ACCESS_DENIED",
            "ORIGIN_REJECTED",
            "CSRF_INVALID",
            "LICENSE_NEW_BUSINESS_UNAVAILABLE",
            "AGENT_PROFILE_REJECTED"
          ],
          "404": [
            "RESOURCE_NOT_FOUND"
          ],
          "409": [
            "KUBERNETES_CELLS_UNCONFIGURED",
            "KUBERNETES_CLUSTER_STORAGE_UNSUPPORTED",
            "IDEMPOTENCY_CONFLICT",
            "KUBERNETES_CELL_CLUSTER_EXISTS",
            "KUBERNETES_NODE_IN_CLUSTER",
            "KUBERNETES_NODE_ADDRESS_INVALID",
            "KUBERNETES_NODE_ADDRESS_CONFLICT",
            "NODE_UNAVAILABLE"
          ],
          "429": [
            "RATE_LIMITED"
          ],
          "503": [
            "LICENSE_CONFIGURATION_REQUIRED",
            "LICENSE_STORED_STATE_INVALID",
            "STORAGE_UNAVAILABLE"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCluster"
              }
            }
          }
        }
      }
    },
