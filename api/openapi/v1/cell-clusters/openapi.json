  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "ACCESS_DENIED",
              "AGENT_PROFILE_REJECTED",
              "AUTH_REQUIRED",
              "AUTH_SESSION_EXPIRED",
              "CSRF_INVALID",
              "IDEMPOTENCY_CONFLICT",
              "INVALID_CURSOR",
              "KUBERNETES_CELLS_UNCONFIGURED",
              "KUBERNETES_CELL_CLUSTER_EXISTS",
              "KUBERNETES_CLUSTER_STORAGE_UNSUPPORTED",
              "KUBERNETES_MEMBER_STATE_CONFLICT",
              "KUBERNETES_NODE_ADDRESS_CONFLICT",
              "KUBERNETES_NODE_ADDRESS_INVALID",
              "KUBERNETES_NODE_IN_CLUSTER",
              "LICENSE_CONFIGURATION_REQUIRED",
              "LICENSE_NEW_BUSINESS_UNAVAILABLE",
              "LICENSE_STORED_STATE_INVALID",
              "NODE_UNAVAILABLE",
              "ORIGIN_REJECTED",
              "RATE_LIMITED",
              "RESOURCE_NOT_FOUND",
              "STORAGE_UNAVAILABLE",
              "VALIDATION_FAILED"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 64
                },
                "code": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ]
      },
      "MemberCounts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pending": {
            "type": "integer",
            "minimum": 0
          },
          "joining": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "type": "integer",
            "minimum": 0
          },
          "not_ready": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "pending",
          "joining",
          "ready",
          "not_ready",
          "failed"
        ]
      },
      "Cluster": {
        "type": "object",
        "additionalProperties": false,
        "description": "A cell's Kubernetes cluster. Its state follows from its members: failed when the server failed, installing while any member waits or joins, ready when every member is, degraded otherwise.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "site_id": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "distribution_version": {
            "type": "string",
            "description": "The RKE2 release the cluster runs."
          },
          "state": {
            "type": "string",
            "enum": [
              "installing",
              "ready",
              "degraded",
              "failed"
            ]
          },
          "server_node_id": {
            "type": "string",
            "format": "uuid"
          },
          "server_state": {
            "type": "string",
            "enum": [
              "pending",
              "joining",
              "ready",
              "not_ready",
              "failed"
            ]
          },
          "ca_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The SHA-256 of the server CA, which join tokens pin."
              },
              {
                "type": "null"
              }
            ]
          },
          "members": {
            "$ref": "#/components/schemas/MemberCounts"
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "site_id",
          "cell_id",
          "name",
          "distribution_version",
          "state",
          "server_node_id",
          "server_state",
          "ca_sha256",
          "members",
          "created_by",
          "created_at",
          "updated_at"
        ]
      },
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "node_name": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "server",
              "worker"
            ]
          },
          "node_address": {
            "type": "string",
            "description": "The address the node advertises in the cluster: the one its agent enrolled from."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "joining",
              "ready",
              "not_ready",
              "failed"
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "description": "Why the member failed: a KUBERNETES_* code its agent reported, a task code such as TASK_DEADLINE_EXCEEDED, or NODE_UNAVAILABLE."
              },
              {
                "type": "null"
              }
            ]
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "join_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "node_id",
          "node_name",
          "workspace_id",
          "role",
          "node_address",
          "state",
          "error_code",
          "task_id",
          "join_attempts",
          "observed_at",
          "created_at",
          "updated_at"
        ]
      },
      "ClusterList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/Cluster"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "MemberList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "CreateCluster": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "server_node_id": {
            "type": "string",
            "format": "uuid"
          },
          "worker_node_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "server_node_id",
          "worker_node_ids",
          "reason"
        ]
      },
      "AddWorkers": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "worker_node_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "worker_node_ids",
          "reason"
        ]
      },
      "Reason": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "ClusterResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Cluster"
          }
        },
        "required": [
          "data"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Member"
          }
        },
        "required": [
          "data"
        ]
      },
      "ClusterListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ClusterList"
          }
        },
        "required": [
          "data"
        ]
      },
      "MemberListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MemberList"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "securitySchemes": {
      "adminCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-admin_session"
      }
    }
  }
}
