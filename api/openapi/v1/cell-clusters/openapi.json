      "get": {
        "operationId": "listCellClusterMembers",
        "summary": "Page through a cluster's members in the order they were added",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Only members in this state.",
