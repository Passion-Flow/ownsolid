{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin installation release view",
    "version": "1.0.0",
    "description": "Recorded bounded journal projection. Current Admin authority and read audit are rechecked in the selected-store transaction. No live-health or whole-target claim."
  },
  "paths": {
    "/api/v1/admin/releases/current": {
      "get": {
        "operationId": "readReleaseCurrent",
        "x-audiences": [
          "admin"
        ],
        "description": "Current platform administrator only. No path/scope/tenant/limit selector. Dirty/missing projection never serves cached data.",
        "responses": {
          "200": {
            "description": "Original data envelope after successful read-audit commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Current"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or currently ineligible Admin session"
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND: Admin release routes are hidden from Portal; unsupported release route or method"
          },
          "409": {
            "description": "RELEASE_VIEW_CHANGED: explicitly reload current and first history page"
          },
          "400": {
            "description": "VALIDATION_FAILED: unknown, duplicate, empty or oversized query; nonempty body or alternate path encoding"
          },
          "503": {
            "description": "RELEASE_VIEW_UNAVAILABLE; projection/configuration/identity/publication unavailable"
          }
        }
      }
    },
    "/api/v1/admin/releases/history": {
      "get": {
        "operationId": "readReleaseHistory",
        "x-audiences": [
          "admin"
        ],
        "description": "Current platform administrator only. No path/scope/tenant/limit selector. Dirty/missing projection never serves cached data.",
        "responses": {
          "200": {
            "description": "Original data envelope after successful read-audit commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/History"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or currently ineligible Admin session"
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND: Admin release routes are hidden from Portal; unsupported release route or method"
          },
          "409": {
            "description": "RELEASE_VIEW_CHANGED: explicitly reload current and first history page"
          },
          "400": {
            "description": "VALIDATION_FAILED: unknown, duplicate, empty or oversized query; nonempty body or alternate path encoding"
          },
          "503": {
            "description": "RELEASE_VIEW_UNAVAILABLE; projection/configuration/identity/publication unavailable"
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "description": "Opaque original scope/head-bound cursor; a new head invalidates prior pages."
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "operation_id",
          "action",
          "outcome",
          "code",
          "time"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "action": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Snapshot": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/LegacySnapshot"
          },
          {
            "$ref": "#/components/schemas/KubernetesSnapshot"
          }
        ]
      },
      "Current": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot",
          "database",
          "applied_schema",
          "locales",
          "live_health"
        ],
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "database": {
            "enum": [
              "postgresql",
              "mysql"
            ]
          },
          "applied_schema": {
            "type": "integer",
            "minimum": 0
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locale",
                "package_sha256",
                "translation_state",
                "google_translated_complete"
              ],
              "properties": {
                "locale": {
                  "type": "string"
                },
                "package_sha256": {
                  "type": "string"
                },
                "translation_state": {
                  "type": "string"
                },
                "google_translated_complete": {
                  "type": "boolean"
                }
              }
            }
          },
          "live_health": {
            "const": false
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "head_sha256",
          "sequence",
          "first_sequence",
          "items",
          "next_cursor"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "head_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "InstalledRelease": {
        "type": "object",
        "additionalProperties": false,
        "description": "The installed release that last completed. A record, not live health.",
        "required": [
          "release_id",
          "profile",
          "archive_sha256",
          "manifest_sha256",
          "source_commit",
          "schema_version",
          "activation_sequence"
        ],
        "properties": {
          "release_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "profile": {
            "const": "m17-postgresql-cpu-linux-amd64"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "schema_version": {
            "const": 22
          },
          "activation_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "LegacySnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "scope_id",
          "release_id",
          "profile",
          "archive_sha256",
          "manifest_sha256",
          "configuration_sha256",
          "sequence",
          "head_sha256",
          "journal_bytes",
          "recorded_at",
          "first_sequence",
          "events"
        ],
        "properties": {
          "format": {
            "const": "projectone.release-view.v1"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "release_id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "head_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "journal_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "installed_release": {
            "$ref": "#/components/schemas/InstalledRelease"
          }
        }
      },
      "KubernetesSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "scope_id",
          "release_id",
          "profile",
          "archive_sha256",
          "manifest_sha256",
          "configuration_sha256",
          "sequence",
          "head_sha256",
          "journal_bytes",
          "recorded_at",
          "first_sequence",
          "events",
          "kubernetes"
        ],
        "properties": {
          "format": {
            "const": "projectone.kubernetes-release-view.v1"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "release_id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "head_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "journal_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "first_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "kubernetes": {
            "$ref": "#/components/schemas/KubernetesBinding"
          }
        }
      },
      "KubernetesInstalledRelease": {
        "type": "object",
        "additionalProperties": false,
        "description": "The last verified serving completion on record. A record, not live health.",
        "required": [
          "release_id",
          "profile",
          "archive_sha256",
          "manifest_sha256",
          "source_commit",
          "schema_version",
          "activation_sequence"
        ],
        "properties": {
          "release_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "profile": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "schema_version": {
            "const": 29
          },
          "activation_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "KubernetesSource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "event_kind",
          "operation_id",
          "plan_sha256",
          "sequence",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "preparation",
              "installation",
              "maintenance",
              "drain",
              "schema",
              "postgres_backup",
              "postgres_restore",
              "restore_observer",
              "restored_readiness",
              "restored_serving",
              "upgrade_jobs",
              "upgrade_serving",
              "uninstall"
            ]
          },
          "event_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "description": "Actual last original event reference. source.sequence cannot exceed containing snapshot.sequence; operation_id and kind + underscore + event_kind must match the last retained event. Index order never sorts timestamps."
      },
      "KubernetesBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index_format",
          "application_profile",
          "schema_version",
          "prepared_plan_sha256",
          "last_source"
        ],
        "properties": {
          "index_format": {
            "const": "projectone.kubernetes-operation-index.v1"
          },
          "application_profile": {
            "const": "mvp-postgresql-cpu-v1"
          },
          "schema_version": {
            "const": 29
          },
          "prepared_plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "last_source": {
            "$ref": "#/components/schemas/KubernetesSource"
          },
          "installed_release": {
            "$ref": "#/components/schemas/KubernetesInstalledRelease"
          }
        }
      }
    }
  }
}
