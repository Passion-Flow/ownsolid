{
  "openapi": "3.1.1",
  "info": {
    "title": "Project-one Public Model Gateway",
    "version": "0.7.0",
    "description": "Strict scoped text subset of the current OpenAI-shaped model/chat protocol over private loopback TLS. Cookie/Origin/alternate authority headers and query credentials are rejected. Actual NVIDIA qualification is tracked separately."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "listAuthorizedModels",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Actual scoped result; no Go data envelope.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Models"
                }
              }
            }
          },
          "default": {
            "description": "Safe OpenAI-shaped error; stable code and request UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "createScopedChatCompletion",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Actual scoped result; no Go data envelope.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "description": "Alias-normalized incremental text chunks. Optional actual final usage when requested; DONE follows actual upstream EOF and durable metadata. Midstream failures emit a safe error event without fabricated DONE/usage. Bounded event/total/idle/deadlines and cancellation apply."
              }
            }
          },
          "default": {
            "description": "Safe OpenAI-shaped error; stable code and request UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "license_unavailable denies new completion admission before backend forwarding; permission_denied retains existing role and Workspace checks. Model discovery and prior outcome/recovery remain available after license expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pk1.UUID.secret"
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "StreamOptions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "include_usage": {
            "type": "boolean",
            "default": false
          }
        },
        "required": []
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "max_completion_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "n": {
            "anyOf": [
              {
                "const": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "stream_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StreamOptions"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "description": "Configured request/message/output/context limits may be lower. max_tokens and max_completion_tokens cannot both be nonnull. Nonnull stream_options requires stream=true. Duplicate/case-variant/unknown fields and arbitrary tools/images/audio/templates/destinations are rejected. No inference retry."
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 512
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ]
      },
      "Completion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "chat.completion"
          },
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "index": {
                  "const": 0
                },
                "message": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "role": {
                      "const": "assistant"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "content"
                  ]
                },
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length",
                    "content_filter"
                  ]
                }
              },
              "required": [
                "index",
                "message",
                "finish_reason"
              ]
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices",
          "usage"
        ]
      },
      "Model": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "object": {
            "const": "model"
          },
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "owned_by": {
            "const": "workspace"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ]
      },
      "Models": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        },
        "required": [
          "object",
          "data"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "const": "The request could not be completed."
              },
              "type": {
                "type": "string"
              },
              "param": {
                "type": "null"
              },
              "code": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "type",
              "param",
              "code"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "request_id"
        ]
      }
    }
  }
}
