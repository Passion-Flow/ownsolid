{
  "openapi": "3.1.0",
  "info": {
    "title": "Project-one offline localization",
    "version": "0.16.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/localization/catalog": {
      "get": {
        "operationId": "GetLocalizationCatalog",
        "security": [],
        "responses": {
          "200": {
            "description": "Installed immutable offline locales; seeds retain explicit pending provider/review state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalizationCatalogResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe metadata/availability error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/localization/packages/{sha256}": {
      "get": {
        "operationId": "GetLocalizationPackage",
        "security": [],
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact declared SHA256 bytes. Client verifies integrity before activation. No arbitrary filename or external URL.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Exact immutable ETag matches."
          },
          "default": {
            "description": "Absent/invalid hash, wrong asset category, method or query; no filesystem path.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/localization/fonts/{sha256}": {
      "get": {
        "operationId": "GetLocalizationFont",
        "security": [],
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact declared SHA256 bytes. Client verifies integrity before activation. No arbitrary filename or external URL.",
            "content": {
              "font/ttf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Exact immutable ETag matches."
          },
          "default": {
            "description": "Absent/invalid hash, wrong asset category, method or query; no filesystem path.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/localization/assets/{sha256}": {
      "get": {
        "operationId": "GetLocalizationAsset",
        "security": [],
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact declared SHA256 bytes. Client verifies integrity before activation. No arbitrary filename or external URL.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Exact immutable ETag matches."
          },
          "default": {
            "description": "Absent/invalid hash, wrong asset category, method or query; no filesystem path.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocalizationCatalogResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sha256",
              "locales",
              "limits"
            ],
            "properties": {
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locales": {
                "type": "array",
                "minItems": 2,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "locale",
                    "display_name",
                    "english_name",
                    "aliases",
                    "direction",
                    "package_sha256",
                    "package_url",
                    "translation_state",
                    "review_state",
                    "google_translated_complete",
                    "fonts",
                    "formatting"
                  ],
                  "properties": {
                    "locale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "english_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aliases": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "direction": {
                      "enum": [
                        "ltr",
                        "rtl"
                      ]
                    },
                    "package_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "package_url": {
                      "type": "string",
                      "pattern": "^/api/v1/localization/packages/[a-f0-9]{64}$"
                    },
                    "translation_state": {
                      "enum": [
                        "canonical_English_source",
                        "first_party_seed_pending_Google_review",
                        "google_generated_human_reviewed"
                      ]
                    },
                    "review_state": {
                      "enum": [
                        "pending",
                        "approved"
                      ]
                    },
                    "google_translated_complete": {
                      "type": "boolean"
                    },
                    "fonts": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sha256",
                          "license_sha256",
                          "family",
                          "format",
                          "weight",
                          "style"
                        ],
                        "properties": {
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "license_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "family": {
                            "type": "string",
                            "minLength": 1
                          },
                          "format": {
                            "const": "truetype"
                          },
                          "weight": {
                            "const": "100 900"
                          },
                          "style": {
                            "const": "normal"
                          }
                        }
                      }
                    },
                    "formatting": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "plural_categories",
                        "plural_rules_supported",
                        "number_format_supported",
                        "date_format_supported"
                      ],
                      "properties": {
                        "plural_categories": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "string",
                            "enum": [
                              "zero",
                              "one",
                              "two",
                              "few",
                              "many",
                              "other"
                            ]
                          }
                        },
                        "plural_rules_supported": {
                          "type": "boolean"
                        },
                        "number_format_supported": {
                          "type": "boolean"
                        },
                        "date_format_supported": {
                          "type": "boolean"
                        },
                        "google_code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "locale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "likely_script": {
                          "type": "string",
                          "minLength": 1
                        },
                        "direction": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resolved_plural_locale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resolved_number_locale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resolved_date_locale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "metadata_status": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "package_bytes",
                  "font_bytes",
                  "aggregate_bytes",
                  "maximum_messages",
                  "maximum_fonts"
                ],
                "properties": {
                  "package_bytes": {
                    "type": "integer",
                    "minimum": 65536,
                    "maximum": 4194304
                  },
                  "font_bytes": {
                    "type": "integer",
                    "minimum": 1048576,
                    "maximum": 134217728
                  },
                  "aggregate_bytes": {
                    "type": "integer",
                    "minimum": 4194304,
                    "maximum": 268435456
                  },
                  "maximum_messages": {
                    "type": "integer",
                    "minimum": 2000,
                    "maximum": 20000
                  },
                  "maximum_fonts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            }
          }
        }
      },
      "LocaleChoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "display_name",
          "english_name",
          "aliases",
          "direction",
          "package_sha256",
          "package_url",
          "translation_state",
          "review_state",
          "google_translated_complete",
          "fonts",
          "formatting"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "english_name": {
            "type": "string",
