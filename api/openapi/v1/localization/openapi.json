          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package_url": {
            "type": "string",
            "pattern": "^/api/v1/localization/packages/[a-f0-9]{64}$"
          },
          "translation_state": {
            "enum": [
              "canonical_English_source",
              "first_party_seed_pending_Google_review",
              "google_generated_human_reviewed"
            ]
          },
          "review_state": {
            "enum": [
              "pending",
              "approved"
            ]
          },
          "google_translated_complete": {
            "type": "boolean"
          },
          "fonts": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "license_sha256",
                "family",
                "format",
                "weight",
                "style"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "license_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "const": "truetype"
                },
                "weight": {
                  "const": "100 900"
                },
                "style": {
                  "const": "normal"
                }
              }
            }
          },
          "formatting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plural_categories",
              "plural_rules_supported",
              "number_format_supported",
              "date_format_supported"
            ],
            "properties": {
              "plural_categories": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "enum": [
                    "zero",
                    "one",
                    "two",
                    "few",
                    "many",
                    "other"
                  ]
                }
              },
              "plural_rules_supported": {
                "type": "boolean"
              },
              "number_format_supported": {
                "type": "boolean"
              },
              "date_format_supported": {
                "type": "boolean"
              },
              "google_code": {
                "type": "string",
                "minLength": 1
              },
              "locale": {
                "type": "string",
                "minLength": 1
              },
              "likely_script": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "type": "string",
                "minLength": 1
              },
              "resolved_plural_locale": {
                "type": "string",
                "minLength": 1
              },
              "resolved_number_locale": {
                "type": "string",
                "minLength": 1
              },
              "resolved_date_locale": {
                "type": "string",
                "minLength": 1
              },
              "metadata_status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "LocaleFont": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "license_sha256",
          "family",
          "format",
          "weight",
          "style"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "const": "truetype"
          },
          "weight": {
            "const": "100 900"
          },
          "style": {
            "const": "normal"
          }
        }
      },
      "LocaleFormatting": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plural_categories",
          "plural_rules_supported",
          "number_format_supported",
          "date_format_supported"
        ],
        "properties": {
          "plural_categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "zero",
                "one",
                "two",
                "few",
                "many",
                "other"
              ]
            }
          },
          "plural_rules_supported": {
            "type": "boolean"
          },
          "number_format_supported": {
            "type": "boolean"
          },
          "date_format_supported": {
            "type": "boolean"
          },
          "google_code": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "likely_script": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "resolved_plural_locale": {
            "type": "string",
            "minLength": 1
          },
          "resolved_number_locale": {
            "type": "string",
            "minLength": 1
          },
          "resolved_date_locale": {
            "type": "string",
            "minLength": 1
          },
          "metadata_status": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "INVALID_CURSOR",
              "TOKEN_UNUSABLE",
              "AUTH_INVALID_CREDENTIALS",
              "AUTH_REQUIRED",
              "AUTH_SESSION_EXPIRED",
              "ACCESS_DENIED",
              "CSRF_INVALID",
              "ORIGIN_REJECTED",
              "RESOURCE_NOT_FOUND",
              "ACCOUNT_EXISTS",
              "INVITATION_EXISTS",
              "INVITATION_STATE_CONFLICT",
              "VERSION_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "PROTECTED_ACCOUNT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "MISDIRECTED_REQUEST",
              "PASSWORD_POLICY_VIOLATION",
              "PASSWORD_BLOCKED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "STORAGE_UNAVAILABLE",
              "STORAGE_COMMIT_OUTCOME_UNKNOWN",
              "AUTH_CAPACITY_EXCEEDED",
              "SERVICE_NOT_READY",
              "LICENSE_NEW_BUSINESS_UNAVAILABLE",
              "LICENSE_STORED_STATE_INVALID",
              "LICENSE_CONFIGURATION_REQUIRED"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 64
                },
                "code": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ]
      }
