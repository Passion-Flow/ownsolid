{
  "openapi": "3.1.0",
  "info": {
    "title": "Project-one whole-platform License",
    "version": "0.19.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-license-wire-limits": {
    "maximum_diagnostics_bytes": 16384
  },
  "paths": {
    "/api/v1/admin/license": {
      "get": {
        "operationId": "GetPlatformLicense",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "AdminSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current validated state, idempotent import or audited bounded diagnostics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseStateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Fixed redacted authentication, authorization, validation, license conflict or storage error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "ImportPlatformLicense",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "AdminSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current validated state, idempotent import or audited bounded diagnostics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseImportResultResponse"
                }
              }
            }
          },
          "default": {
            "description": "Fixed redacted authentication, authorization, validation, license conflict or storage error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportLicense"
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/license/diagnostics": {
      "get": {
        "operationId": "DownloadLicenseDiagnostics",
        "x-audiences": [
          "admin"
        ],
        "security": [
          {
            "AdminSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current validated state, idempotent import or audited bounded diagnostics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicenseDiagnostics"
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Artifact-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "default": {
            "description": "Fixed redacted authentication, authorization, validation, license conflict or storage error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/license/status": {
      "get": {
        "operationId": "GetPortalLicenseStatus",
        "x-audiences": [
          "portal",
          "admin"
        ],
        "security": [
          {
            "PortalSession": []
          },
          {
            "AdminSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current validated state, idempotent import or audited bounded diagnostics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalLicenseStateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Fixed redacted authentication, authorization, validation, license conflict or storage error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-error-codes": {
          "401": [
            "AUTH_REQUIRED",
            "AUTH_SESSION_EXPIRED"
          ],
          "403": [
            "ACCESS_DENIED"
          ],
          "421": [
            "MISDIRECTED_REQUEST"
          ],
          "503": [
            "STORAGE_UNAVAILABLE",
            "SERVICE_NOT_READY",
            "LICENSE_CONFIGURATION_REQUIRED",
            "LICENSE_STORED_STATE_INVALID"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      },
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-admin_session"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "INVALID_CURSOR",
              "TOKEN_UNUSABLE",
              "AUTH_INVALID_CREDENTIALS",
              "AUTH_REQUIRED",
              "AUTH_SESSION_EXPIRED",
              "ACCESS_DENIED",
              "CSRF_INVALID",
              "ORIGIN_REJECTED",
              "RESOURCE_NOT_FOUND",
              "ACCOUNT_EXISTS",
              "INVITATION_EXISTS",
              "INVITATION_STATE_CONFLICT",
              "VERSION_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "PROTECTED_ACCOUNT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "MISDIRECTED_REQUEST",
              "PASSWORD_POLICY_VIOLATION",
              "PASSWORD_BLOCKED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "STORAGE_UNAVAILABLE",
              "STORAGE_COMMIT_OUTCOME_UNKNOWN",
              "AUTH_CAPACITY_EXCEEDED",
              "SERVICE_NOT_READY",
              "LICENSE_NEW_BUSINESS_UNAVAILABLE",
              "LICENSE_STORED_STATE_INVALID",
              "LICENSE_CONFIGURATION_REQUIRED",
              "LICENSE_ARTIFACT_INVALID",
              "LICENSE_DEPLOYMENT_MISMATCH",
              "LICENSE_ID_CONFLICT",
              "LICENSE_CURRENT_CHANGED",
              "LICENSE_IMPORT_CAPACITY_REQUIRED",
              "LICENSE_PREDECESSOR_REQUIRED",
              "LICENSE_PENDING_SUCCESSOR_EXISTS",
              "LICENSE_RENEWAL_WINDOW_INVALID"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 64
                },
                "code": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ]
      },
      "LicenseSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "license_id",
          "artifact_sha256",
          "customer_reference",
          "not_before",
          "expires_at",
          "grace_until"
        ],
        "properties": {
          "license_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "customer_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "not_before": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "grace_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PortalLicenseState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "new_business_allowed",
          "warning"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "missing",
              "not_yet_valid",
              "active",
              "grace",
              "expired",
              "clock_suspect"
            ]
          },
          "new_business_allowed": {
            "type": "boolean"
          },
          "warning": {
            "type": "boolean"
          }
        }
      },
      "LicenseState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "new_business_allowed",
          "warning",
          "deployment_id",
          "current",
          "pending",
          "accepted_licenses",
          "history_head_license_id",
          "observed_at",
          "public_key_fingerprint"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "missing",
              "not_yet_valid",
              "active",
              "grace",
              "expired",
              "clock_suspect"
            ]
          },
          "new_business_allowed": {
            "type": "boolean"
          },
          "warning": {
            "type": "boolean"
          },
          "deployment_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "current": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LicenseSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LicenseSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted_licenses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "history_head_license_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              {
                "const": ""
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "public_key_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "ImportLicense": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "reason",
          "expected_current_license_id"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "expected_current_license_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              {
                "const": ""
              }
            ]
          }
        }
      },
      "LicenseImportResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "imported_license_id",
          "repeated"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/LicenseState"
          },
          "imported_license_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "repeated": {
            "type": "boolean"
          }
        }
      },
      "LicenseDiagnostics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format_version",
          "state"
        ],
        "properties": {
          "format_version": {
            "const": 1,
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/LicenseState"
          }
        }
      },
      "LicenseStateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LicenseState"
          }
        }
      },
      "PortalLicenseStateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PortalLicenseState"
          }
        }
      },
      "LicenseImportResultResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LicenseImportResult"
          }
        }
      }
    }
  }
}
