{
  "openapi": "3.1.0",
  "info": {
    "title": "ownsolid capabilities",
    "version": "1.0.0",
    "description": "Every option the product offers and whether this release can do it, from the declaration the installer also reads (ADR 0036, ADR 0042)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "summary": "List every option and whether this release can do it",
        "x-audiences": [
          "portal",
          "admin"
        ],
        "security": [
          {
            "PortalSession": []
          },
          {
            "AdminSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "The whole declaration, in display order. It has no paging or filters: it is small and fixed for a release.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityDeclaration"
                }
              }
            }
          },
          "default": {
            "description": "The session or the service refused the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-error-codes": {
          "400": [
            "VALIDATION_FAILED"
          ],
          "401": [
            "AUTH_REQUIRED",
            "AUTH_SESSION_EXPIRED"
          ],
          "403": [
            "ACCESS_DENIED"
          ],
          "404": [
            "RESOURCE_NOT_FOUND"
          ],
          "421": [
            "MISDIRECTED_REQUEST"
          ],
          "503": [
            "STORAGE_UNAVAILABLE",
            "SERVICE_NOT_READY",
            "STORAGE_TIMEOUT"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      },
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-admin_session"
      }
    },
    "schemas": {
      "CapabilityDeclaration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registries"
        ],
        "properties": {
          "registries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityRegistry"
            }
          }
        }
      },
      "CapabilityRegistry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "English name."
          },
          "description": {
            "type": "string",
            "description": "English: what the options are for."
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityOption"
            }
          }
        }
      },
      "CapabilityOption": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable within its registry; it also names the option's translated text."
          },
          "name": {
            "type": "string",
            "description": "English name."
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "planned",
              "licensed",
              "unsupported"
            ],
            "description": "ready can be chosen now; planned has an open roadmap item; licensed works under a licence or account the customer holds; unsupported is a decision not to support it."
          },
          "roadmap_item": {
            "type": "string",
            "description": "The roadmap item that makes the option ready or, once ready, made it so. Absent when unsupported."
          },
          "reason": {
            "type": "string",
            "description": "English: why the option cannot simply be chosen. Present in every state but ready."
          },
          "note": {
            "type": "string",
            "description": "English: a fact about what is ready, such as what it was run on."
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "ACCESS_DENIED",
              "AUTH_REQUIRED",
              "AUTH_SESSION_EXPIRED",
              "MISDIRECTED_REQUEST",
              "RESOURCE_NOT_FOUND",
              "SERVICE_NOT_READY",
              "STORAGE_TIMEOUT",
              "STORAGE_UNAVAILABLE",
              "VALIDATION_FAILED"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 64
                },
                "code": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ]
      }
    }
  }
}
