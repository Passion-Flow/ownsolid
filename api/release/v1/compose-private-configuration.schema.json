{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordinary Compose native private configuration intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "scope_id",
    "operation_id",
    "volume_name",
    "source_root",
    "target_root",
    "source_uid",
    "source_gid",
    "uid",
    "gid",
    "maximum_file_bytes",
    "maximum_total_bytes",
    "timeout_seconds",
    "files"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "volume_name": {
      "type": "string",
      "pattern": "^projectone-[a-f0-9]{32}-control-config$"
    },
    "source_root": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/",
      "description": "Canonical, nonsymlink and non-overlapping paths checked by runtime."
    },
    "target_root": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/",
      "description": "Canonical, nonsymlink and non-overlapping paths checked by runtime."
    },
    "source_uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "source_gid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "gid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maximum_file_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "maximum_total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "description": "The typed owner additionally checks exact volume/scope binding, sorted distinct names, aggregate budgets, non-overlapping canonical roots, strict JSON and actual native filesystem authority."
}
