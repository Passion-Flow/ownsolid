 	case listApplications:
 		page, err := s.applications.ListForAssistant(ctx, actor, query, requestID)
 		if err != nil {
diff --git a/services/control/internal/modules/productagent/service_repository_integration_test.go b/services/control/internal/modules/productagent/service_repository_integration_test.go
index 9fbd5725..adb22076 100644
--- a/services/control/internal/modules/productagent/service_repository_integration_test.go
