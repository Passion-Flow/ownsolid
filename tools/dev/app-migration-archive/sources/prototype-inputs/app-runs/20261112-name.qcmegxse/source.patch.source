@@ -93,9 +93,11 @@ func TestOfflineCommandsWithCurrentSessionAndWorkspace(t *testing.T) {
 		return help
 	}
 	assertCommands(admin, "en", "open_audit", "open_gateway", "open_home", "open_model_library", "open_model_services", "open_nodes", "open_support")
