import os
from pathlib import Path
import subprocess
import time
import uuid

def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)

def main():
    output=Path(__file__).resolve().parent
    image, system, arch=run('docker','image','inspect','--format','{{.Id}} {{.Os}} {{.Architecture}}','pgvector/pgvector:0.8.7-pg18-bookworm',capture_output=True).stdout.split()
    assert system == 'linux' and arch == 'amd64'
    (output/'image').write_text(image+'\n')
    cases=[('audit','./internal/modules/audit',[],'TestProductAssistantAuditWithin'),
           ('repository','./internal/modules/productagent',[],'Test(DurableExecutionBudgets|DurableExecutionRuns|OfflineCommandsWithCurrentSessionAndWorkspace)'),
           ('http','./internal/modules/productagent/http',[],'TestAuthenticated(Guarded)?AssistantHTTP')]
    selection=os.environ.get('APP_NATIVE_CASE','')
    if selection:
        cases=[case for case in cases if case[0]==selection]
        assert cases
    args=type('Arguments',(),{'budgets':selection=='repository'})()
    database='assistant_fixture_test'
    container=run('docker','run','--rm','--pull=never','--network','none','-d',
                  '-e','POSTGRES_HOST_AUTH_METHOD=trust','-e','POSTGRES_DB='+database,image,capture_output=True).stdout.strip()
    (output/'container').write_text(container+'\n')
    root='/tmp/assistant-fixture'
    dsn=root+'/postgres.dsn'
    try:
        deadline=time.monotonic()+45
        while True:
            ready=subprocess.run(['docker','exec',container,'pg_isready','-q','-h','127.0.0.1','-U','postgres','-d',database],
                                 stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
            if ready.returncode == 0:
                break
            if time.monotonic() >= deadline:
                raise RuntimeError('Private PostgreSQL fixture did not become ready')
            time.sleep(1)
        with (output/'postgres.log').open('w') as log:
            run('docker','exec',container,'psql','-X','-U','postgres','-d',database,'-v','ON_ERROR_STOP=1','-c',
                "CREATE EXTENSION vector WITH SCHEMA public VERSION '0.8.7'; REVOKE CREATE ON SCHEMA public FROM PUBLIC; SHOW server_version;",
                stdout=log,stderr=subprocess.STDOUT)
        run('docker','exec',container,'install','-d','-m','0700',root,root+'/tools/audit-verify',
            *(root+'/services/control/internal/modules/'+name for name in ('audit','productagent','productagent/http')))
        run('docker','exec','-i',container,'sh','-c','umask 077; cat > "$1"','sh',dsn,
            input='postgresql://postgres@127.0.0.1:5432/'+database+'?sslmode=disable\n')
        for name, _, _, _ in cases:
            run('docker','cp',str(output/(name+'.test')),container+':'+root+'/'+name+'.test',stdout=subprocess.DEVNULL)
        if not args.budgets:
            run('docker','cp',str(output/'audit-verify'),container+':'+root+'/audit-verify',stdout=subprocess.DEVNULL)
        run('docker','cp',str(output/'export.sql'),container+':'+root+'/tools/audit-verify/export.sql',stdout=subprocess.DEVNULL)
        run('docker','exec',container,'install','-d','-m','0700',root+'/services/control/internal/modules/productagent/testdata')
        run('docker','cp',str(output/'execution-budget.sql'),container+':'+root+'/services/control/internal/modules/productagent/testdata/execution-budget.sql',stdout=subprocess.DEVNULL)
        for name, package, _, test in cases:
            cwd=root+'/services/control/'+package.removeprefix('./')
            command=['docker','exec','-w',cwd,'-e','GOMAXPROCS=2',
                     '-e','PROJECT_ONE_TEST_DSN_FILE='+dsn,
                     '-e','PROJECT_ONE_REPOSITORY_ENGINE=postgresql',
                     '-e','PROJECT_ONE_REPOSITORY_POSTGRES_DSN_FILE='+dsn,
                     '-e','PROJECT_ONE_REPOSITORY_POSTGRES_SCHEMA=m20_repository_'+uuid.uuid4().hex,
                     '-e','OWNSOLID_TEST_AUDIT_VERIFY='+root+'/audit-verify',
                     container,root+'/'+name+'.test','-test.v','-test.parallel=1','-test.timeout=240s','-test.run','^'+test+'$']
            result=subprocess.run(command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=270)
            (output/(name+'.log')).write_text(result.stdout)
            result.check_returncode()
            if not any(line.startswith('--- PASS: ') for line in result.stdout.splitlines()) or '--- FAIL:' in result.stdout or '--- SKIP:' in result.stdout:
                raise RuntimeError('Required fixture did not pass: '+test)
            print(test+' passed',flush=True)
        run('docker','inspect','--format','{{.HostConfig.NetworkMode}}',container,stdout=(output/'network-mode').open('w'))
        (output/'ok').write_text((output/'head').read_text())
    finally:
        run('docker','stop','--time','5',container,stdout=subprocess.DEVNULL)


if __name__=='__main__':
    main()
