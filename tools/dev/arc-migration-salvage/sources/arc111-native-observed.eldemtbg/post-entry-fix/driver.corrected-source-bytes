def remaining_work_timeout(now, work_end, maximum):
    remaining = work_end - now
    if remaining <= 0:
        raise TimeoutError("ARC_WORK_DEADLINE_EXHAUSTED")
    return min(maximum, remaining)

def remaining_cleanup_timeout(now, end, maximum):
    return max(0, min(maximum, max(0, end - now)))

def observed_ssh_stages(stderr):
    import re
    text = stderr.decode("utf-8", errors="replace")
    markers = {
        "proxy_command_started": "Executing proxy command:",
        "local_version_emitted": "Local version string SSH-",
        "remote_banner_received": "Remote protocol version",
        "kexinit_received": "SSH2_MSG_KEXINIT received",
        "authenticated": "Authenticated to ",
        "remote_command_sent": "Sending command:",
    }
    stages = {key: True if marker in text else None for key, marker in markers.items()}
    stages["host_key_matched"] = True if re.search(r"is known and matches the .* host key", text) else None
    errors = []
    for line in text.splitlines():
        if any(needle in line for needle in ["timed out", "Timeout, server", "Broken pipe", "Connection reset", "Connection refused", "Permission denied", "Host key verification failed", "Could not resolve hostname", "failed to connect to local tailscaled"]):
            errors.append(re.sub(r"[^\x20-\x7e]", "?", line)[:240])
    return {"stages": stages, "necessary_errors": errors[:6], "missing_marker_means": "unknown, not proof that a stage was not entered"}

def classify_opportunity(ssh_exit, stage_events, remote_receipt=None):
    """Keep confirmed remote entry separate from missing SQL/cleanup evidence."""
    if isinstance(remote_receipt, dict):
        return remote_receipt.get("state", "INCOMPLETE_REMOTE_RECEIPT")
    entered = any(item.get("stage") == "remote_entry_confirmed" for item in stage_events)
    if entered:
        return "FAILED_AFTER_REMOTE_ENTRY" if ssh_exit else "INCOMPLETE_AFTER_REMOTE_ENTRY"
    return "ENTRY_UNCONFIRMED_CONNECTION_FAILED" if ssh_exit else "INCOMPLETE_ENTRY_UNCONFIRMED"

def forwarded_outer_exit(record):
    if record.get("outer_timeout"):
        return 124
    status = record.get("ssh_exit")
    if type(status) is not int:
        return 1
    if status != 0:
        return min(255, 128 - status) if status < 0 else min(255, status)
    remote = record.get("remote")
    if not isinstance(remote, dict) or remote.get("state") != "METADATA_COMPLETE_REBUILD_REQUIRED":
        return 1
    if remote.get("source") != record.get("source") or remote.get("tree") != record.get("tree"):
        return 1
    if not all(remote.get(key) is True for key in ["all_source_paths_and_migration_inputs_verified", "container_absent", "volume_absent", "network_absent", "credential_paths_absent", "lock_identities_retained", "within_remote_budget"]):
        return 1
    if remote.get("remaining_owned_groups") != [] or not record.get("within_budget"):
        return 1
    closed = remote.get("lock_fd_closure")
    if not isinstance(closed, list) or len(closed) != 2 or any(item.get("closed") is not True for item in closed):
        return 1
    return 0


def observe_files(stop, events):
    markers = {
        "stderr": [("proxy_command_started", b"Executing proxy command:"), ("local_version_emitted", b"Local version string SSH-"), ("remote_banner_received", b"Remote protocol version"), ("kexinit_received", b"SSH2_MSG_KEXINIT received"), ("host_key_matched", b"is known and matches the "), ("authenticated", b"Authenticated to "), ("remote_command_sent", b"Sending command:")],
        "stdout": [("remote_entry_confirmed", b"ARC_NATIVE_PREFLIGHT "), ("remote_carrier_admitted", b"ARC_NATIVE_ROOT "), ("remote_result_received", b"ARC_NATIVE_RESULT ")],
    }
    positions = {"stdout": 0, "stderr": 0}
    tails = {"stdout": b"", "stderr": b""}
    observed = set()
    while True:
        for stream in ("stderr", "stdout"):
            path = out / ("transport." + stream)
            if not path.exists():
                continue
            with path.open("rb") as f:
                f.seek(positions[stream])
                data = f.read()
            prior_position = positions[stream]
            positions[stream] += len(data)
            combined = tails[stream] + data
            for stage, marker in markers[stream]:
                index = combined.find(marker)
                if index >= 0 and stage not in observed:
                    observed.add(stage)
                    events.append({"stage": stage, "observed_after_seconds": time.monotonic() - start, "stream": stream, "byte_offset": max(0, prior_position - len(tails[stream]) + index)})
            tails[stream] = combined[-4096:]
        if stop.is_set():
            return
        stop.wait(0.02)

