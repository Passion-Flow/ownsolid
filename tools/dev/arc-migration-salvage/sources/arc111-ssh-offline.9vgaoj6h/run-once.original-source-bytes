  info=json.loads(line[len('ARC_NATIVE_EVIDENCE '):]);data=base64.b64decode(info.pop('base64'));assert hashlib.sha256(data).hexdigest()==info['sha256'] and len(data)==info['bytes'];(out/'native-evidence.tar.gz').write_bytes(data)
