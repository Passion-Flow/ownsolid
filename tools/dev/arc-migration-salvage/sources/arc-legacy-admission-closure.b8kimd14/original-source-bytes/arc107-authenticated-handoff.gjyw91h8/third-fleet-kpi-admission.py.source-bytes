from pathlib import Path
import random,subprocess,time
inputs=Path(__file__).resolve().parent;root=inputs/'fleet-kpis'
assert root.is_dir() and not root.is_symlink()
for attempt in range(120):
 if not(inputs/'build-exit').exists():
  if(inputs/'prepare-driver-exit').exists() and (inputs/'prepare-driver-exit').read_text().strip()!='0':
   code=1;break
  time.sleep(random.uniform(7,13));continue
 assert(inputs/'build-exit').read_text().strip()=='0'
 assert(inputs/'installed-exit').read_text().strip()=='0'
 assert(inputs/'installed-driver-exit').read_text().strip()=='0'
 with(root/'installed-driver.log').open('ab')as log:
  code=subprocess.run(['python3','-I',str(inputs/'fleet-kpi-runner.py'),str(root),str(inputs)],stdout=log,stderr=subprocess.STDOUT).returncode
 if code!=75:break
 with(root/'installed-lease.log').open('a')as log:log.write(str(time.time())+' resource lease busy\n')
 time.sleep(random.uniform(7,13))
else:code=75
(root/'installed-driver-exit').write_text(str(code)+'\n')
raise SystemExit(code)
