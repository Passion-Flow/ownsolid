from pathlib import Path
import random,subprocess,time,sys
b=Path(__file__).resolve().parent
target=sys.argv[1] if len(sys.argv)>1 else 'run-probe.py'
assert target in ('run-probe.py','run-client-probe.py','run-research-check.py','run-module-probe.py','run-module-build.py','run-product-focused.py','run-priority-red.py','full-current.py','run-terminal-red.py','run-fallback-probe.py','run-fallback-focused.py','check-integrated.py')
for attempt in range(90):
 with (b/'admission.log').open('ab') as log:
  code=subprocess.run(['python3','-I',str(b/target)],stdout=log,stderr=subprocess.STDOUT).returncode
 if code!=75:break
 print('workstation resource lease busy; deferring prototype',flush=True)
 time.sleep(random.uniform(7,13))
(b/'admission.exit').write_text(str(code)+'\n')
raise SystemExit(code)
