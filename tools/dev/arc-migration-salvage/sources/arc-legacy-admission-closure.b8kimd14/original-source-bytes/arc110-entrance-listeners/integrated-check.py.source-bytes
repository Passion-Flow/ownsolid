from pathlib import Path
import fcntl,json,os,stat,subprocess,tempfile,shutil
b=Path(__file__).resolve().parent;r=b.parent.parent/'lane-arc110';p=Path('/private/tmp/ownsolid-workstation-full-gate.lock');fd=os.open(p,os.O_RDWR|os.O_NOFOLLOW);s=os.fstat(fd);assert stat.S_ISREG(s.st_mode) and s.st_uid==os.getuid()
try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:os.close(fd);raise SystemExit(75)
try:
 assert(s.st_dev,s.st_ino)==(p.lstat().st_dev,p.lstat().st_ino);assert subprocess.check_output(['git','status','--porcelain'],cwd=r,text=True)==''
 rev=subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip();assert rev=='a27fe64b5ad1faed37d337c09d8ad8f52e3cf456'
 tmp=Path(tempfile.mkdtemp(prefix='ownsolid-arc110-check.',dir='/private/tmp'));os.chown(tmp,-1,os.getgid());os.chmod(tmp,0o700)
 env=os.environ.copy();env.update({'TMPDIR':str(tmp)+'/', 'GOTOOLCHAIN':'local','GOPROXY':'off','GOSUMDB':'off','GOMAXPROCS':'2','GOFLAGS':'-p=1','PYTHON':subprocess.check_output(['uv','python','find','3.12'],text=True).strip()});env['PATH']=str(b.parent/'gw120-schema59.9jT6tZsI/offline-tools')+':'+env['PATH']
 codes={}
 for name,command in [('check',['make','check'])]:
  with(b/('integrated-final-'+name+'.log')).open('wb') as log:codes[name]=subprocess.run(command,cwd=r,env=env,stdout=log,stderr=subprocess.STDOUT,timeout=300).returncode
  if codes[name]:break
 (b/'integrated-final-qualification.json').write_text(json.dumps({'source':rev,'results':codes},indent=2)+'\n');shutil.rmtree(tmp);print(codes,flush=True);raise SystemExit(max(codes.values()))
finally:fcntl.flock(fd,fcntl.LOCK_UN);os.close(fd)
