+func TestActualModelFamilyFormalBackfillAndLifecycle(t *testing.T) {
+	x := familyPredecessor(t)
+	old := uuid.NewString()
+	if err := familyInsert(x.ctx, x.f.Store, x, old, "deleted", time.Now().UTC().Truncate(time.Microsecond)); err != nil {
+		t.Fatal(err)
