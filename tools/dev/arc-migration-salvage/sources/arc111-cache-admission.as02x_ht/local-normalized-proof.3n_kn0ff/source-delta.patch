+package servingcheck
+
+import (
+	"bytes"
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/config"
+)
+
+func TestPortalListenerExpectedIntentPreservesOmissionAndExactBinding(t *testing.T) {
+	c := syntheticServingConfiguration(t, config.TransportHTTP)
+	legacy := syntheticExpected(c)
+	if err := Verify(c, legacy); err != nil {
+		t.Fatal(err)
+	}
+	c.Server.PortalListenAddress = "127.0.0.1:29443"
+	servingCheckFailure(t, Verify(c, legacy), transportMismatch)
+	expected := legacy
+	expected.PortalListenAddress = c.Server.PortalListenAddress
+	raw := syntheticExpectedBytes(t, expected)
+	parsed, err := ParseExpected(raw)
+	if err != nil || !reflect.DeepEqual(parsed, expected) {
+		t.Fatal("explicit split intent changed", err)
+	}
+	if err = Verify(c, parsed); err != nil {
+		t.Fatal("exact split intent refused", err)
+	}
+	c.Server.PortalListenAddress = "127.0.0.1:30443"
+	servingCheckFailure(t, Verify(c, parsed), transportMismatch)
+	c.Server.PortalListenAddress = ""
+	servingCheckFailure(t, Verify(c, parsed), transportMismatch)
+	for _, value := range []any{nil, "", false, []string{}, "127.0.0.1:0", legacy.ListenAddress} {
+		var fields map[string]any
+		if json.Unmarshal(syntheticExpectedBytes(t, legacy), &fields) != nil {
+			t.Fatal("fixture intent")
+		}
+		fields["portal_listen_address"] = value
+		invalid, err := json.Marshal(fields)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = ParseExpected(invalid)
+		servingCheckFailure(t, err, expectationInvalid)
+	}
+	duplicated := bytes.Replace(raw, []byte(`"portal_listen_address":"127.0.0.1:29443"`), []byte(`"portal_listen_address":"127.0.0.1:29443","portal_listen_address":"127.0.0.1:29443"`), 1)
+	_, err = ParseExpected(duplicated)
+	servingCheckFailure(t, err, expectationInvalid)
+	wrongCase := bytes.Replace(raw, []byte(`"portal_listen_address"`), []byte(`"PORTAL_LISTEN_ADDRESS"`), 1)
+	_, err = ParseExpected(wrongCase)
+	servingCheckFailure(t, err, expectationInvalid)
+}
diff --git a/services/control/internal/platform/README.md b/services/control/internal/platform/README.md
index 13d82450065233e6a6de71c72341728c4ad3a89f..bf996cdc7c118879e03042112015eaf3759d3343 100644
--- a/services/control/internal/platform/README.md
+++ b/services/control/internal/platform/README.md
@@ -28,6 +28,13 @@ Platform packages provide bounded shared mechanisms. Domain owners still decide
 
 ## Invariants
 
+Gateway Drain remains nonblocking. A process that owns file/database dependencies
+uses DrainAndWait to join admitted RPC callbacks and their receive loops, together
+with its HTTP request join; an HTTP transport can end before its backend callback.
+A canceled wait reports no completion and never reopens admission. The dedicated
+gateway retains process owners until both joins finish. This source addition
+still requires its affected runtime, race and native composition acceptance.
+
 [database/transaction](database/transaction/README.md) borrows an already configured pool. Repository-owned SQL names its dialect explicitly; the platform does not rewrite SQL, commit inside borrowed callbacks, or log statements and arguments. Preserve uncertain commit classification. [mysqlstore](database/mysqlstore/README.md) owns its protected connection/session invariants; [mysqlmigrate](database/mysqlmigrate/README.md) owns the separate DDL journal and reconciliation.
 
 Transports do not grant business authority. Object keys use server-resolved UUID scope. Task bus publication/consumption transports existing task intent; it does not authorize task execution. Localization is installed offline data, never a customer-runtime translation API.
diff --git a/services/control/internal/platform/agentgateway/drain_join_test.go b/services/control/internal/platform/agentgateway/drain_join_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9eb1618cef51586dd6fafefcf6e2fbd19cae770a
--- /dev/null
+++ b/services/control/internal/platform/agentgateway/drain_join_test.go
@@ -0,0 +1,117 @@
+package agentgateway
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	wire "github.com/Passion-Flow/ownsolid/api/agent/v1"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// This isolates RPC ownership, not database authorization or reader qualification.
+type retainedFileBackend struct {
+	fakeBackend
+	path      string
+	file      *os.File
+	started   chan struct{}
+	cancelled chan struct{}
+	release   chan struct{}
+}
+
+func (b *retainedFileBackend) Heartbeat(ctx context.Context, _, _ string, _ wire.Handshake) (wire.Disposition, error) {
+	f, err := os.Open(b.path)
+	if err != nil {
+		return wire.Disposition{}, err
+	}
+	defer f.Close()
+	b.file = f
+	close(b.started)
+	<-ctx.Done()
+	close(b.cancelled)
+	<-b.release
+	var data [1]byte
+	if _, err := f.Read(data[:]); err != nil {
+		return wire.Disposition{}, err
+	}
+	return wire.Disposition{}, ctx.Err()
+}
+
+func TestDrainAndWaitRetainsBackendUntilActualCallbackExit(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "published-asset")
+	if err := os.WriteFile(file, []byte("synthetic"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	b := &retainedFileBackend{path: file, started: make(chan struct{}), cancelled: make(chan struct{}), release: make(chan struct{})}
+	g, conn := start(t, b, 4)
+	var release sync.Once
+	finish := func() { release.Do(func() { close(b.release) }) }
+	t.Cleanup(finish)
+	stream := open(t, conn)
+	if err := stream.SendMsg(heartbeat(1)); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	select {
+	case <-b.started:
+	case <-ctx.Done():
+		t.Fatal("RPC did not reach retained file owner")
+	}
+	g.Drain()
+	select {
+	case <-b.cancelled:
+	case <-ctx.Done():
+		t.Fatal("drain did not cancel the real RPC callback")
+	}
+	if _, err := exchange(t, open(t, conn), heartbeat(2)); status.Code(err) != codes.Unavailable {
+		t.Fatal("drained gateway admitted another callback", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	short, stop := context.WithCancel(t.Context())
+	stop()
+	if err := g.DrainAndWait(short); !errors.Is(err, context.Canceled) {
+		t.Fatal("unreturned backend reported a join", err)
+	}
+	if _, err := b.file.Stat(); err != nil {
+		t.Fatal("transport close invalidated the callback's retained file", err)
+	}
+	select {
+	case <-g.joined:
+		t.Fatal("closed transport was mistaken for callback completion")
