+			browserEntrance(server, "portal", next, config.DefaultHTTPPolicy(), &rejected).ServeHTTP(w, r)
+			if w.Code < 400 || w.Header().Get("X-Request-ID") == "" {
+				t.Fatal("transport confusion was not refused")
