+				x.exec(t, `INSERT INTO users(id,email_canonical,email_display,display_name,locale,status,is_platform_admin) VALUES($1,$2,$2,'Other publisher','en','active',true)`, "", otherUser, otherUser+"@example.invalid")
+				second := x
