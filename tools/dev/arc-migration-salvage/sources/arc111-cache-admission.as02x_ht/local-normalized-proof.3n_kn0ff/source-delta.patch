@@ -0,0 +1,18 @@
+package sessiontransport
+
+import (
+	"errors"
+	"io"
+
+	"google.golang.org/grpc"
+)
+
+// Exchange sends once and reads one response or final RPC status. A remotely
+// generated refusal can surface from SendMsg as EOF; RecvMsg owns that status.
+// Callers retain cancellation, frame validation and all application retry policy.
+func Exchange(stream grpc.ClientStream, request, reply any) error {
+	if err := stream.SendMsg(request); err != nil && !errors.Is(err, io.EOF) {
+		return err
+	}
+	return stream.RecvMsg(reply)
+}
diff --git a/services/agent/sessiontransport/exchange_test.go b/services/agent/sessiontransport/exchange_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..25d0d3be958c8000ca7e2001b9d04b52cdb6937b
--- /dev/null
+++ b/services/agent/sessiontransport/exchange_test.go
@@ -0,0 +1,68 @@
+package sessiontransport
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type exchangeStream struct {
+	grpc.ClientStream
+	sendError, receiveError error
+	sends, receives         int
+}
+
+func (s *exchangeStream) SendMsg(any) error {
+	s.sends++
+	return s.sendError
+}
+
+func (s *exchangeStream) RecvMsg(reply any) error {
+	s.receives++
+	if s.receiveError == nil {
+		*reply.(*int) = 7
+	}
+	return s.receiveError
+}
+
+func TestExchangeReadsRemoteFinalStatusAfterSenderEOF(t *testing.T) {
+	for _, code := range []codes.Code{codes.Unauthenticated, codes.ResourceExhausted, codes.Unavailable} {
+		t.Run(code.String(), func(t *testing.T) {
+			stream := &exchangeStream{sendError: io.EOF, receiveError: status.Error(code, "refused")}
+			var reply int
+			if err := Exchange(stream, new(int), &reply); status.Code(err) != code {
+				t.Fatalf("final RPC status was lost: %v", err)
+			}
+			if stream.sends != 1 || stream.receives != 1 || reply != 0 {
+				t.Fatal("terminal status was replayed or fabricated an application reply")
+			}
+		})
+	}
+}
+
+func TestExchangeKeepsLocalSendFailureAndEmptyTermination(t *testing.T) {
+	local := &exchangeStream{sendError: context.Canceled}
+	var reply int
+	if err := Exchange(local, new(int), &reply); !errors.Is(err, context.Canceled) || local.sends != 1 || local.receives != 0 {
+		t.Fatal("local send failure initiated another I/O operation")
+	}
+	empty := &exchangeStream{sendError: io.EOF, receiveError: io.EOF}
+	if err := Exchange(empty, new(int), &reply); !errors.Is(err, io.EOF) || empty.sends != 1 || empty.receives != 1 || reply != 0 {
+		t.Fatal("empty stream termination became a successful application reply")
+	}
+}
+
+func TestExchangeDeliversOneDecodedReplyWithoutRepeatingSend(t *testing.T) {
+	for _, sendError := range []error{nil, io.EOF} {
+		stream := &exchangeStream{sendError: sendError}
+		var reply int
+		if err := Exchange(stream, new(int), &reply); err != nil || reply != 7 || stream.sends != 1 || stream.receives != 1 {
+			t.Fatalf("one response was not delivered once: %v", err)
+		}
+	}
+}
diff --git a/services/control/cmd/server/README.md b/services/control/cmd/server/README.md
index 7b4931c32b88afa6ee462d47b3dac1ebf05c14d1..af5409871df0aa7fe4315a353cf2ebe24f114ce2 100644
--- a/services/control/cmd/server/README.md
+++ b/services/control/cmd/server/README.md
@@ -32,6 +32,22 @@ for partial/unknown outcomes, role/serving writes and Kubernetes qualification.
 
 [agent_gateway.go](agent_gateway.go) serves `serve-agent-gateway`: the agent session stream from a process beside control, with its own pool and no installation lock, fenced on the lock's holder and drained on stop ([ADR 0048](../../../../docs/decisions/0048-agent-gateways-beside-control.md)). It builds the agent path with `identityhttp.NewAgentGateway`, the constructor control's own handler uses.
 
+Its lifecycle seals HTTP admission, drains sessions and waits for both the HTTP
+handlers and actual RPC callbacks before closing process-owned stores. The pool
+is the first registered closer and closes last, including after partial startup;
+an unconfirmed join retains it. RPC callbacks may outlive a canceled HTTP
+transport, so transport closure alone never permits a file-owner close.
+Configured dataset/training namespaces select IAM's concrete published-reader
+constructor using the tenant read from the original installed store. Both existing
+namespaces are required; a partial/missing/foreign pair refuses startup without a
+writer or legacy fallback. A namespace-free configuration keeps the original
+constructor. Register reader close immediately after construction, so later
+startup failure or an exhausted startup context also unwinds those readers.
+Their original close codes are retained, and the same request/RPC/worker joins
+precede reader close during serving, with pool close last.
+This combined source increment has not been compiled or run end to end; see the
+[reader ownership boundary](../../../../docs/research/agent-gateway-database-role.md#actual-iam-constructor-consumption).
+
 [runtime_lifecycle.go](runtime_lifecycle.go) owns dependency construction, cancellation, worker readiness, stop/join order and closers. Component helpers such as artifactstores.go, imageregistry.go, task_events.go, middleware.go and monitoring.go connect their existing owners. The identity HTTP package still composes/routes domains; extracting that historical hub is a separate verified change, not an invitation to create duplicate owners here.
 
 Configuration comes from [platform/config](../../internal/platform/config/README.md), protected command inputs and explicit policy environment mapping. Bootstrap packets and verification-store helpers preserve exact installation/artifact identity. Unknown commit, failed readiness, interrupted backup or failed worker shutdown must remain visible; cleanup cannot silently destroy the only recovery evidence.
