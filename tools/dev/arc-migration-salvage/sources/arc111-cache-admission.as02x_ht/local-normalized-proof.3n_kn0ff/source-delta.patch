+-- Retain explicit model family identities (MOD-103).
+CREATE TABLE model_families (
+ id uuid PRIMARY KEY CHECK (id<>'00000000-0000-0000-0000-000000000000'),
+ tenant_id uuid NOT NULL,
+ workspace_id uuid NOT NULL,
