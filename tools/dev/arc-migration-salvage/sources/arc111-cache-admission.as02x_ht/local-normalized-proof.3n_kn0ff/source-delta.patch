@@ -0,0 +1,248 @@
+import { ApiProblem, type AuditPage, type Me } from '@ownsolid/api';
+import { createQueryClient, sessionKey } from '@ownsolid/shell';
+import { act, renderHook, waitFor } from '@testing-library/react';
+import { focusManager, onlineManager, QueryClientProvider } from '@tanstack/react-query';
+import type { ReactNode } from 'react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { useAuditRead } from './audit-read.tsx';
+
+type AuditReader = (cursor: string | null, signal: AbortSignal) => Promise<AuditPage>;
+
+const first: AuditPage = { items: [], next_cursor: 'next' };
+const workspace: NonNullable<Me['workspace']> = {
+  id: '6f1c7a1e-0000-4000-8000-000000000002',
+  tenant_id: '6f1c7a1e-0000-4000-8000-000000000003',
+  name: 'Research Lab',
+  role: 'owner',
+};
+const me: Me = {
+  audience: 'admin',
+  workspace,
+  user: {
+    id: '6f1c7a1e-0000-4000-8000-000000000001',
+    email: 'reader@example.test',
+    display_name: 'Audit reader',
+    locale: 'en',
+    status: 'active',
+    is_platform_admin: true,
+    email_verified_at: null,
+    version: 1,
+    created_at: '2026-11-04T00:00:00Z',
+    updated_at: '2026-11-04T00:00:00Z',
+  },
+};
+
+function setup(read: AuditReader) {
+  const client = createQueryClient({ onSignedOut: () => undefined });
+  client.setQueryData(sessionKey, me);
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <QueryClientProvider client={client}>{children}</QueryClientProvider>
+  );
+  const mount = () => renderHook(() => useAuditRead({ queryKey: ['audit'], read }), { wrapper });
+  return { client, mount };
+}
+
+afterEach(() => {
+  focusManager.setFocused(undefined);
+  onlineManager.setOnline(true);
+});
+
+describe('explicit audit reads', () => {
+  it.each(['reader', 'workspace', 'tenant'] as const)(
+    'does not reuse another %s snapshot after a session change',
+    async (scope) => {
+      const read = vi
+        .fn<AuditReader>()
+        .mockResolvedValueOnce(first)
+        .mockRejectedValueOnce(new ApiProblem('ACCESS_DENIED', { status: 403 }));
+      const { client, mount } = setup(read);
+      const { result, unmount } = mount();
+      await waitFor(() => {
+        expect(result.current.isSuccess).toBe(true);
+      });
+      const changed: Me =
+        scope === 'reader'
+          ? { ...me, user: { ...me.user, id: '6f1c7a1e-0000-4000-8000-000000000070' } }
+          : {
+              ...me,
+              workspace: {
+                ...workspace,
+                ...(scope === 'workspace'
+                  ? { id: '6f1c7a1e-0000-4000-8000-000000000004' }
+                  : { tenant_id: '6f1c7a1e-0000-4000-8000-000000000005' }),
+              },
+            };
+      act(() => {
+        client.setQueryData(sessionKey, changed);
+      });
+      await waitFor(() => {
+        expect(result.current.isError).toBe(true);
+      });
+      expect(result.current.data).toBeUndefined();
+      expect(read).toHaveBeenCalledTimes(2);
+      unmount();
+      client.clear();
+    },
+  );
+  it('keeps a failed cached read through remount, focus, reconnect and invalidation', async () => {
+    const read = vi.fn<AuditReader>().mockRejectedValue(new ApiProblem('NETWORK_UNAVAILABLE'));
+    const { client, mount } = setup(read);
+    const initial = mount();
+    await waitFor(() => {
+      expect(initial.result.current.isError).toBe(true);
+    });
+    initial.unmount();
+    const again = mount();
+    await act(async () => {
+      focusManager.setFocused(false);
+      focusManager.setFocused(true);
+      onlineManager.setOnline(false);
+      onlineManager.setOnline(true);
+      await client.invalidateQueries({ queryKey: ['audit'] });
+    });
+    expect(read).toHaveBeenCalledTimes(1);
+    expect(again.result.current.isError).toBe(true);
+    again.unmount();
+    client.clear();
+  });
+
+  it('does not queue an offline attempt for reconnect and explicitly recovers once', async () => {
+    onlineManager.setOnline(false);
+    const read = vi
+      .fn<AuditReader>()
+      .mockRejectedValueOnce(new ApiProblem('REQUEST_TIMEOUT'))
+      .mockResolvedValue(first);
+    const { client, mount } = setup(read);
+    const { result, unmount } = mount();
+    await waitFor(() => {
+      expect(result.current.isError).toBe(true);
+    });
+    expect(result.current.fetchStatus).toBe('idle');
+    await act(async () => {
+      onlineManager.setOnline(true);
+      await Promise.resolve();
+    });
+    expect(read).toHaveBeenCalledTimes(1);
+    act(() => {
+      result.current.readAgain();
+      result.current.readAgain();
+    });
+    await waitFor(() => {
+      expect(result.current.isSuccess).toBe(true);
+    });
+    expect(read).toHaveBeenCalledTimes(2);
+    unmount();
+    client.clear();
+  });
+
+  it('retries only the failed next page and keeps existing pages after failure', async () => {
+    const read = vi
+      .fn<AuditReader>()
+      .mockResolvedValueOnce(first)
+      .mockRejectedValueOnce(new ApiProblem('STORAGE_COMMIT_OUTCOME_UNKNOWN', { status: 409 }))
+      .mockResolvedValueOnce({ items: [], next_cursor: null });
+    const { client, mount } = setup(read);
+    const { result, unmount } = mount();
+    await waitFor(() => {
+      expect(result.current.isSuccess).toBe(true);
+    });
+    await act(async () => {
+      await result.current.fetchNextPage({ cancelRefetch: false });
+    });
+    await waitFor(() => {
+      expect(result.current.isFetchNextPageError).toBe(true);
+    });
+    expect(result.current.data?.pages).toEqual([first]);
+    act(() => {
+      result.current.readAgain();
+    });
+    await waitFor(() => {
+      expect(result.current.data?.pages).toHaveLength(2);
+    });
+    expect(read.mock.calls.map(([cursor]) => cursor)).toEqual([null, 'next', 'next']);
+    unmount();
+    client.clear();
+  });
+
+  it('restarts an invalid cursor with one page and keeps history until that read succeeds', async () => {
+    const second: AuditPage = { items: [], next_cursor: 'last' };
+    const read = vi
+      .fn<AuditReader>()
+      .mockResolvedValueOnce(first)
+      .mockResolvedValueOnce(second)
+      .mockRejectedValueOnce(new ApiProblem('INVALID_CURSOR', { status: 400 }))
+      .mockRejectedValueOnce(new ApiProblem('STORAGE_UNAVAILABLE', { status: 503 }))
+      .mockResolvedValueOnce(first);
+    const { client, mount } = setup(read);
+    const { result, unmount } = mount();
+    await waitFor(() => {
+      expect(result.current.isSuccess).toBe(true);
+    });
+    await act(async () => {
+      await result.current.fetchNextPage({ cancelRefetch: false });
+    });
+    await act(async () => {
+      await result.current.fetchNextPage({ cancelRefetch: false });
+    });
+    act(() => {
+      result.current.readAgain();
+    });
+    await waitFor(() => {
+      expect(read).toHaveBeenCalledTimes(4);
+    });
+    await waitFor(() => {
+      expect(result.current.fetchStatus).toBe('idle');
+    });
+    expect(result.current.data?.pages).toEqual([first, second]);
+    act(() => {
+      result.current.readAgain();
+    });
+    await waitFor(() => {
+      expect(result.current.isSuccess).toBe(true);
+    });
+    expect(result.current.data?.pages).toEqual([first]);
+    expect(read.mock.calls.map(([cursor]) => cursor)).toEqual([null, 'next', 'last', null, null]);
+    unmount();
+    client.clear();
+  });
+
+  it.each([
+    ['ACCESS_DENIED', 403],
+    ['RESOURCE_NOT_FOUND', 404],
+    ['FUTURE_REFUSAL', 403],
+  ] as const)(
+    'removes cached pages on current %s (%i) and refuses a retry',
+    async (code, status) => {
+      const read = vi
+        .fn<AuditReader>()
+        .mockResolvedValueOnce(first)
+        .mockRejectedValueOnce(new ApiProblem(code, { status }));
+      const { client, mount } = setup(read);
+      const { result, unmount } = mount();
+      await waitFor(() => {
+        expect(result.current.isSuccess).toBe(true);
+      });
+      client.setQueryData(['audit', 'earlier-filter'], { pages: [first], pageParams: [null] });
+      client.setQueryData(['resource-activity', 'earlier-resource'], {
+        pages: [first],
+        pageParams: [null],
+      });
+      client.setQueryData(['nodes'], 'unrelated');
+      await act(async () => {
+        await result.current.fetchNextPage({ cancelRefetch: false });
+      });
+      await waitFor(() => {
+        expect(result.current.data).toBeUndefined();
+      });
+      expect(client.getQueryData(['audit', 'earlier-filter'])).toBeUndefined();
+      expect(client.getQueryData(['resource-activity', 'earlier-resource'])).toBeUndefined();
+      expect(client.getQueryData(['nodes'])).toBe('unrelated');
+      act(() => {
+        result.current.readAgain();
+      });
+      expect(read).toHaveBeenCalledTimes(2);
+      unmount();
+      client.clear();
+    },
+  );
+});
diff --git a/web/apps/console/src/audit-read.tsx b/web/apps/console/src/audit-read.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..faf36b3e30f8401206b48223b7089acb7a971995
--- /dev/null
+++ b/web/apps/console/src/audit-read.tsx
@@ -0,0 +1,149 @@
+import { isProblem, type AuditPage } from '@ownsolid/api';
+import { useI18n } from '@ownsolid/i18n';
+import { useSession } from '@ownsolid/shell';
+import { Button, Notice, ProblemNotice } from '@ownsolid/ui';
+import {
+  infiniteQueryOptions,
+  useInfiniteQuery,
+  useQueryClient,
+  type QueryKey,
+} from '@tanstack/react-query';
+
+interface AuditReadOptions {
+  queryKey: QueryKey;
+  read: (cursor: string | null, signal: AbortSignal) => Promise<AuditPage>;
+  enabled?: boolean;
+}
+
+function deniedRead(error: unknown): boolean {
+  return (
+    isProblem(error) &&
+    (error.status === 401 ||
+      error.status === 403 ||
+      error.status === 404 ||
+      isProblem(
+        error,
+        'ACCESS_DENIED',
+        'RESOURCE_NOT_FOUND',
+        'AUTH_REQUIRED',
+        'AUTH_SESSION_EXPIRED',
+      ))
+  );
+}
+
+/** Audit access is recorded: another attempt must be the person's explicit choice. */
+export function useAuditRead({ queryKey, read, enabled = true }: AuditReadOptions) {
+  const client = useQueryClient();
+  const session = useSession();
+  const key = [
+    ...queryKey,
+    {
+      reader: session?.user.id,
+      audience: session?.audience,
+      tenant: session?.workspace?.tenant_id,
+      workspace: session?.workspace?.id,
+    },
+  ];
+  const canRead = enabled && session !== null;
+  const options = infiniteQueryOptions({
+    queryKey: key,
+    queryFn: async ({ pageParam, signal }) => {
+      try {
+        return await read(pageParam, signal);
+      } catch (error) {
+        if (deniedRead(error)) {
+          // Keep the active refusal cached so remounting cannot retry it. Discard
+          // older inactive views so changing a filter cannot reveal their events.
+          client.removeQueries({
+            predicate: (query) =>
+              query.getObserversCount() === 0 &&
+              (query.queryKey[0] === 'audit' || query.queryKey[0] === 'resource-activity'),
+          });
+        }
+        throw error;
+      }
+    },
+    initialPageParam: null as string | null,
+    getNextPageParam: (last) => last.next_cursor,
+    // Static data blocks invalidation refetches only after a page exists. A failed
+    // initial read must also become manual-only; imperative recovery still works.
+    enabled: (query) => canRead && query.state.status !== 'error',
+    retry: false,
+    retryOnMount: false,
+    refetchOnMount: false,
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false,
+    refetchInterval: false,
+    staleTime: 'static',
+    // An offline read must fail now, not be queued for an implicit reconnect attempt.
+    networkMode: 'always',
+  });
+  const events = useInfiniteQuery(options);
+  const denied = deniedRead(events.error);
+  const readAgain = () => {
+    if (!canRead || denied || client.getQueryState(key)?.fetchStatus !== 'idle') return;
+    if (events.isFetchNextPageError && !isProblem(events.error, 'INVALID_CURSOR')) {
+      void events.fetchNextPage({ cancelRefetch: false });
+    } else {
+      // A normal infinite refetch re-reads every cached page. Restart only one page and
+      // let the cache replace the old pages after success, never before a failed read.
+      void client.infiniteQuery({ ...options, pages: 1, staleTime: 0 }).catch(() => undefined);
+    }
+  };
+  return { ...events, data: denied ? undefined : events.data, readAgain };
+}
+
+/** An audit-specific recovery that preserves the server's Problem and correlation ID. */
+export function AuditReadFailure({
+  error,
+  partial = false,
+  busy,
+  onRetry,
+}: {
+  error: unknown;
+  partial?: boolean;
+  busy: boolean;
+  onRetry: () => void;
+}) {
+  const { t } = useI18n();
+  const problem = isProblem(error) ? error : null;
+  const uncertain =
+    !problem ||
+    problem.status === 0 ||
+    isProblem(problem, 'STORAGE_COMMIT_OUTCOME_UNKNOWN', 'RESPONSE_INVALID');
+  const noRecovery = deniedRead(problem) || isProblem(problem, 'VALIDATION_FAILED');
+  const label = t(
+    busy
+      ? 'audit.read.pending'
+      : isProblem(problem, 'INVALID_CURSOR')
+        ? 'audit.read.restart'
+        : 'audit.read.again',
+  );
+  return (
+    <div className="mb-4" aria-busy={busy}>
+      {problem ? (
+        <ProblemNotice
+          problem={problem}
+          title={uncertain ? t('audit.read.unknown.title') : undefined}
+          detail={uncertain ? t('audit.read.unknown.detail') : undefined}
+          recovery={noRecovery ? undefined : { label, onClick: onRetry, disabled: busy }}
+        />
+      ) : (
+        <Notice
+          tone="critical"
+          title={t('audit.read.unknown.title')}
+          actions={
+            <Button disabled={busy} onClick={onRetry}>
+              {label}
+            </Button>
+          }
+        >
+          {t('audit.read.unknown.detail')}
+        </Notice>
+      )}
+      {partial ? (
+        <p className="mb-0 mt-2 text-[13px] text-text-2">{t('audit.read.partial')}</p>
+      ) : null}
+    </div>
+  );
+}
