@@ -0,0 +1,307 @@
+package models
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+	"unicode/utf8"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/modelpreparations/snapshot"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/workspaces"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/database/transaction"
+)
+
+// Fixed v1 wire ceilings cover bounded schema fields and the complete data envelope.
+const (
+	HistoryMaximumLimit       = 100
+	HistoryMaximumItemBytes   = 4 << 10
+	HistoryMaximumPageBytes   = 512 << 10
+	HistoryMaximumDetailBytes = 128 << 10
+)
+
+// HistoryPolicy reports the installed page default and immutable v1 wire ceilings.
+type HistoryPolicy struct {
+	DefaultLimit       int `json:"default_limit"`
+	MaximumLimit       int `json:"maximum_limit"`
+	MaximumCursorBytes int `json:"maximum_cursor_bytes"`
+	MaximumPageBytes   int `json:"maximum_page_bytes"`
+	MaximumDetailBytes int `json:"maximum_detail_bytes"`
+}
+
+// VersionHistoryPolicy reuses the owning installation's configured UI page size.
+func (s *Service) VersionHistoryPolicy() HistoryPolicy {
+	if s == nil || s.Identity == nil {
+		return HistoryPolicy{}
+	}
+	return HistoryPolicy{s.Identity.Config.Policy().UI.PageSize, HistoryMaximumLimit, HistoryMaximumCursorBytes, HistoryMaximumPageBytes, HistoryMaximumDetailBytes}
+}
+
+// HistoryQuery preserves omitted values separately from explicit invalid empty inputs.
+type HistoryQuery struct {
+	Limit  *int
+	Cursor *string
+	State  *string
+}
+
+// HistoricalMetadata is retained metadata, never an execution admission result.
+type HistoricalMetadata struct {
+	ID            string    `json:"id"`
+	WorkspaceID   string    `json:"workspace_id"`
+	Name          string    `json:"name"`
+	ModelKey      string    `json:"model_key"`
+	Kind          string    `json:"kind"`
+	CatalogDigest string    `json:"catalog_digest"`
+	State         string    `json:"state"`
+	CreatedAt     time.Time `json:"created_at"`
+}
+
+// VersionHistory is one currently authorized page; NextCursor is always encoded.
+type VersionHistory struct {
+	WorkspaceID     string               `json:"workspace_id"`
+	FamilyID        string               `json:"family_id"`
+	AnchorVersionID string               `json:"anchor_version_id"`
+	Items           []HistoricalMetadata `json:"items"`
+	NextCursor      *string              `json:"next_cursor"`
+}
+
+// HistoricalDetail reuses the immutable manifest and existing retained lineage.
+type HistoricalDetail struct {
+	HistoricalMetadata
+	FamilyID        string                   `json:"family_id"`
+	AnchorVersionID string                   `json:"anchor_version_id"`
+	Manifest        json.RawMessage          `json:"manifest"`
+	DatasetLineage  *snapshot.DatasetLineage `json:"dataset_lineage,omitempty"`
+}
+
+func historicalMetadata(value Version) (HistoricalMetadata, error) {
+	state := value.State
+	if state == "deleted" {
+		state = "retired"
+	}
+	if !nonzeroModelID(value.ID) || !nonzeroModelID(value.WorkspaceID) ||
+		!utf8.ValidString(value.Name) || utf8.RuneCountInString(value.Name) < 1 || utf8.RuneCountInString(value.Name) > 100 ||
+		value.ModelKey != "qwen3-0.6b" || state != "ready" && state != "retired" || !historyStampValid(value.CreatedAt) {
+		return HistoricalMetadata{}, fail("MODEL_HISTORY_INVALID")
+	}
+	out := HistoricalMetadata{value.ID, value.WorkspaceID, value.Name, value.ModelKey, value.Kind, value.CatalogDigest, state, value.CreatedAt}
+	raw, err := json.Marshal(out)
+	if err != nil || len(raw) > HistoryMaximumItemBytes {
+		return HistoricalMetadata{}, fail("MODEL_HISTORY_INVALID")
+	}
+	return out, nil
+}
+
+func historyEnvelopeBound(value any, maximum int) error {
+	raw, err := json.Marshal(struct {
+		Data any `json:"data"`
+	}{value})
+	if err != nil || len(raw) > maximum {
+		return fail("MODEL_HISTORY_INVALID")
+	}
+	return nil
+}
+
+func (s *Service) retainedGraphWithin(ctx context.Context, q transaction.Executor, tenant, workspace string, value *Version) error {
+	if _, err := historicalMetadata(*value); err != nil {
+		return err
+	}
+	if value.Kind != "merged_lora" {
+		return nil
+	}
+	catalog, err := s.RetainedDerivedVersionWithin(ctx, q, tenant, workspace, value.ID)
+	if err != nil {
+		if err.Error() == "RESOURCE_NOT_FOUND" {
+			return fail("MODEL_DERIVED_CATALOG_INVALID")
+		}
+		return err
+	}
+	value.DatasetLineage, err = derivedLineageWithin(ctx, q, catalog)
+	return err
+}
+
+func (s *Service) retainedVersionWithin(ctx context.Context, q transaction.Executor, tenant, workspace, version string) (Version, error) {
+	out, err := scanVersion(q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL,
+		`SELECT `+versionFields+` FROM model_versions WHERE tenant_id=$1 AND workspace_id=$2 AND id=$3 AND state IN ('ready','deleted') AND (site_id,cell_id)=(local_site_id(),local_cell_id()) FOR SHARE`, tenant, workspace, version)), tenant)
+	if err == nil {
+		err = s.retainedGraphWithin(ctx, q, tenant, workspace, &out)
+	}
+	if err != nil {
+		return Version{}, err
+	}
+	return out, nil
+}
+
+type historyAnchor struct {
+	workspace  workspaces.Workspace
+	version    Version
+	family     string
+	site, cell string
+}
+
+func (s *Service) historyAnchorWithin(ctx context.Context, q transaction.Executor, a identity.Auth, workspace, anchor string) (historyAnchor, error) {
+	w, err := s.modelScope(ctx, q, a, workspace)
+	if err != nil {
+		return historyAnchor{}, err
+	}
+	if w.Status != "active" {
+		return historyAnchor{}, fail("ACCESS_DENIED")
+	}
+	if err = historyAvailable(ctx, q); err != nil {
+		return historyAnchor{}, err
+	}
+	selected, err := s.retainedVersionWithin(ctx, q, w.TenantID, w.ID, anchor)
+	if err != nil {
+		return historyAnchor{}, err
+	}
+	family, err := versionFamilyWithin(ctx, q, w.TenantID, w.ID, anchor)
+	if err != nil {
+		return historyAnchor{}, err
+	}
+	var site, cell string
+	if err = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT local_site_id(),local_cell_id()`)).Scan(&site, &cell); err != nil {
+		return historyAnchor{}, err
+	}
+	return historyAnchor{workspace: w, version: selected, family: family, site: site, cell: cell}, nil
+}
+
+// History resolves the family from an exact anchor under current Admin authority.
+// It returns a keyset page without scanning physical files or granting execution.
+func (s *Service) History(ctx context.Context, a identity.Auth, workspace, anchor string, input HistoryQuery) (VersionHistory, error) {
+	var out VersionHistory
+	if !admin(a) {
+		return out, fail("ACCESS_DENIED")
+	}
+	if !nonzeroModelID(workspace) || !nonzeroModelID(anchor) {
+		return out, fail("RESOURCE_NOT_FOUND")
+	}
+	err := s.readActor(ctx, a, func(ctx context.Context, q transaction.Executor) error {
+		frame, err := s.historyAnchorWithin(ctx, q, a, workspace, anchor)
+		if err != nil {
+			return err
+		}
+		w, family := frame.workspace, frame.family
+		policy := s.VersionHistoryPolicy()
+		limit, state := policy.DefaultLimit, ""
+		if limit < 1 || limit > policy.MaximumLimit || !historyKeyValid(s.Identity.HMACKey) {
+			return fail("MODEL_HISTORY_UNAVAILABLE")
+		}
+		if input.Limit != nil {
+			limit = *input.Limit
+			if limit < 1 || limit > policy.MaximumLimit {
+				return fail("VALIDATION_FAILED")
+			}
+		}
+		if input.State != nil {
+			state = *input.State
+			if state != "ready" && state != "retired" {
+				return fail("VALIDATION_FAILED")
+			}
+		}
+		scope := historyScope(a, w.TenantID, w.ID, frame.site, frame.cell, family, anchor, state)
+		var stamp, after any
+		if input.Cursor != nil {
+			cursor, err := decodeHistoryCursor(*input.Cursor, scope, s.Identity.HMACKey)
+			if err != nil {
+				return err
+			}
+			stamp, after = cursor.Time, cursor.ID
+		}
+		rows, err := q.Query(ctx, transaction.SQL(transaction.PostgreSQL, `
+SELECT v.id::text,v.workspace_id::text,v.name,v.model_key,v.catalog_digest,v.manifest,v.state,v.created_at,v.kind
+FROM model_family_members m JOIN model_versions v ON (v.tenant_id,v.workspace_id,v.id)=(m.tenant_id,m.workspace_id,m.version_id)
+WHERE m.tenant_id=$1 AND m.workspace_id=$2 AND m.family_id=$3 AND v.state IN ('ready','deleted')
+ AND (m.site_id,m.cell_id)=(local_site_id(),local_cell_id())
+ AND (v.site_id,v.cell_id)=(local_site_id(),local_cell_id())
+ AND ($4='' OR v.state=CASE WHEN $4='retired' THEN 'deleted' ELSE $4 END)
+ AND ($5::timestamptz IS NULL OR (v.created_at,v.id)<($5,$6::uuid))
+ORDER BY v.created_at DESC,v.id DESC LIMIT $7 FOR SHARE OF v`, w.TenantID, w.ID, family, state, stamp, after, limit+1))
+		if err != nil {
+			return err
+		}
+		values := make([]Version, 0, limit+1)
+		for rows.Next() {
+			value, err := scanVersion(rows, w.TenantID)
+			if err != nil {
+				rows.Close()
+				return err
+			}
+			values = append(values, value)
+		}
+		rows.Close()
+		if err = rows.Err(); err != nil {
+			return err
+		}
+		out = VersionHistory{WorkspaceID: w.ID, FamilyID: family, AnchorVersionID: anchor, Items: []HistoricalMetadata{}}
+		for i := range values {
+			if err = s.retainedGraphWithin(ctx, q, w.TenantID, w.ID, &values[i]); err != nil {
+				return err
+			}
+			if i < limit {
+				metadata, err := historicalMetadata(values[i])
+				if err != nil {
+					return err
+				}
+				out.Items = append(out.Items, metadata)
+			}
+		}
+		if len(values) > limit {
+			last := values[limit-1]
+			cursor, err := encodeHistoryCursor(last.CreatedAt, last.ID, scope, s.Identity.HMACKey)
+			if err != nil {
+				return err
+			}
+			out.NextCursor = &cursor
+		}
+		return historyEnvelopeBound(out, policy.MaximumPageBytes)
+	})
+	if err != nil {
+		return VersionHistory{}, err
+	}
+	return out, nil
+}
+
+// HistoricalVersion reads an exact ready or retired member of the anchor's family.
+// It validates retained metadata only; existing ready/file admission stays separate.
+func (s *Service) HistoricalVersion(ctx context.Context, a identity.Auth, workspace, anchor, version string) (HistoricalDetail, error) {
+	var out HistoricalDetail
+	if !admin(a) {
+		return out, fail("ACCESS_DENIED")
+	}
+	if !nonzeroModelID(workspace) || !nonzeroModelID(anchor) || !nonzeroModelID(version) {
+		return out, fail("RESOURCE_NOT_FOUND")
+	}
+	err := s.readActor(ctx, a, func(ctx context.Context, q transaction.Executor) error {
+		frame, err := s.historyAnchorWithin(ctx, q, a, workspace, anchor)
+		if err != nil {
+			return err
+		}
+		w, family, selected := frame.workspace, frame.family, frame.version
+		if version != anchor {
+			var member bool
+			err = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, `SELECT EXISTS(
+ SELECT 1 FROM model_family_members WHERE tenant_id=$1 AND workspace_id=$2 AND family_id=$3 AND version_id=$4 AND (site_id,cell_id)=(local_site_id(),local_cell_id()))`,
+				w.TenantID, w.ID, family, version)).Scan(&member)
+			if err != nil {
+				return err
+			}
+			if !member {
+				return fail("RESOURCE_NOT_FOUND")
+			}
+			selected, err = s.retainedVersionWithin(ctx, q, w.TenantID, w.ID, version)
+			if err != nil {
+				return err
+			}
+		}
+		metadata, err := historicalMetadata(selected)
+		if err != nil {
+			return err
+		}
+		out = HistoricalDetail{HistoricalMetadata: metadata, FamilyID: family, AnchorVersionID: anchor, Manifest: selected.Manifest, DatasetLineage: selected.DatasetLineage}
+		return historyEnvelopeBound(out, HistoryMaximumDetailBytes)
+	})
+	if err != nil {
+		return HistoricalDetail{}, err
+	}
+	return out, nil
+}
diff --git a/services/control/internal/modules/models/history_cursor.go b/services/control/internal/modules/models/history_cursor.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c9d82047de4e04563a9b192f2c0b3eb7d6815f9
--- /dev/null
+++ b/services/control/internal/modules/models/history_cursor.go
@@ -0,0 +1,98 @@
+package models
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+	"time"
+
+	datawire "github.com/Passion-Flow/ownsolid/api/datasets/v1"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity/security"
+)
+
+// HistoryMaximumCursorBytes is the immutable v1 navigation token ceiling.
+const HistoryMaximumCursorBytes = 512
+
+const historyCursorPurpose = "ownsolid.models.history.v1\x00"
+
+type historyCursor struct {
+	Version int       `json:"version"`
+	Time    time.Time `json:"time"`
+	ID      string    `json:"id"`
+	Scope   string    `json:"scope"`
+}
+
+func historyScope(a identity.Auth, tenant, workspace, site, cell, family, anchor, state string) string {
+	raw, _ := json.Marshal([]any{a.Me.User.ID, a.SessionID, a.Epoch, a.Me.Audience, tenant, workspace, site, cell, family, anchor, state})
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+
+func historyKeyValid(key []byte) bool {
+	return len(key) >= security.MinimumHMACKeyBytes && len(key) <= security.MaximumHMACKeyBytes
+}
+
+func historySignature(raw, key []byte) []byte {
+	signature := hmac.New(sha256.New, key)
+	signature.Write([]byte(historyCursorPurpose))
+	signature.Write(raw)
+	return signature.Sum(nil)
+}
+
+func historyStampValid(stamp time.Time) bool {
+	_, offset := stamp.Zone()
+	return !stamp.IsZero() && offset == 0 && stamp.Year() >= 1000 && stamp.Year() <= 9999 && stamp.Equal(stamp.Truncate(time.Microsecond))
+}
+
+func encodeHistoryCursor(stamp time.Time, id, scope string, key []byte) (string, error) {
+	if !historyKeyValid(key) || !historyStampValid(stamp) || !nonzeroModelID(id) || len(scope) != sha256.Size*2 {
+		return "", fail("MODEL_HISTORY_INVALID")
+	}
+	raw, err := json.Marshal(historyCursor{Version: 1, Time: stamp.UTC(), ID: id, Scope: scope})
+	if err != nil {
+		return "", fail("MODEL_HISTORY_INVALID")
+	}
+	token := base64.RawURLEncoding.EncodeToString(raw) + "." + base64.RawURLEncoding.EncodeToString(historySignature(raw, key))
+	if len(token) > HistoryMaximumCursorBytes {
+		return "", fail("MODEL_HISTORY_INVALID")
+	}
+	return token, nil
+}
+
+func decodeHistoryCursor(token, scope string, key []byte) (historyCursor, error) {
+	var value historyCursor
+	bad := fail("INVALID_CURSOR")
+	if !historyKeyValid(key) || len(token) == 0 || len(token) > HistoryMaximumCursorBytes {
+		return value, bad
+	}
+	body, signature, ok := strings.Cut(token, ".")
+	if !ok {
+		return value, bad
+	}
+	decode := func(text string) ([]byte, error) {
+		raw, err := base64.RawURLEncoding.Strict().DecodeString(text)
+		if err != nil || base64.RawURLEncoding.EncodeToString(raw) != text {
+			return nil, bad
+		}
+		return raw, nil
+	}
+	raw, err := decode(body)
+	if err != nil {
+		return value, bad
+	}
+	sig, err := decode(signature)
+	if err != nil || !hmac.Equal(sig, historySignature(raw, key)) || datawire.DecodeStrict(raw, &value) != nil {
+		return historyCursor{}, bad
+	}
+	canonical, err := json.Marshal(value)
+	if err != nil || !bytes.Equal(raw, canonical) || value.Version != 1 || value.Scope != scope ||
+		!nonzeroModelID(value.ID) || !historyStampValid(value.Time) {
+		return historyCursor{}, bad
+	}
+	return value, nil
+}
diff --git a/services/control/internal/modules/models/history_cursor_test.go b/services/control/internal/modules/models/history_cursor_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..35526cd421271cc12535d0b072551c70644d46ea
--- /dev/null
+++ b/services/control/internal/modules/models/history_cursor_test.go
@@ -0,0 +1,90 @@
+package models
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/google/uuid"
+)
+
+func TestModelHistoryCursorIntegrityAndScope(t *testing.T) {
+	key := make([]byte, 32)
+	if _, err := rand.Read(key); err != nil {
+		t.Fatal(err)
+	}
+	a := identity.Auth{Me: identity.Me{User: identity.User{ID: uuid.NewString()}, Audience: "admin"}, SessionID: uuid.NewString(), Epoch: 1}
+	tenant, workspace, family, anchor := uuid.NewString(), uuid.NewString(), uuid.NewString(), uuid.NewString()
+	scope := historyScope(a, tenant, workspace, "site-a", "cell-a", family, anchor, "")
+	stamp, id := time.Date(2026, 11, 13, 1, 2, 3, 123456000, time.UTC), uuid.NewString()
+	token, err := encodeHistoryCursor(stamp, id, scope, key)
+	if err != nil || len(token) > HistoryMaximumCursorBytes {
+		t.Fatal("bounded cursor", err)
+	}
+	value, err := decodeHistoryCursor(token, scope, key)
+	if err != nil || value.ID != id || !value.Time.Equal(stamp) {
+		t.Fatal("exact tuple", err)
+	}
+	for _, change := range []string{"account", "session", "epoch", "audience", "tenant", "workspace", "site", "cell", "family", "anchor", "filter"} {
+		t.Run(change, func(t *testing.T) {
+			actor, te, ws, site, cell, fa, an, filter := a, tenant, workspace, "site-a", "cell-a", family, anchor, ""
+			switch change {
+			case "account":
+				actor.Me.User.ID = uuid.NewString()
+			case "session":
+				actor.SessionID = uuid.NewString()
+			case "epoch":
+				actor.Epoch++
+			case "audience":
+				actor.Me.Audience = "portal"
+			case "tenant":
+				te = uuid.NewString()
+			case "workspace":
+				ws = uuid.NewString()
+			case "site":
+				site = "site-b"
+			case "cell":
+				cell = "cell-b"
+			case "family":
+				fa = uuid.NewString()
+			case "anchor":
+				an = uuid.NewString()
+			case "filter":
+				filter = "retired"
+			}
+			got, err := decodeHistoryCursor(token, historyScope(actor, te, ws, site, cell, fa, an, filter), key)
+			if err == nil || err.Error() != "INVALID_CURSOR" || got != (historyCursor{}) {
+				t.Fatal("scope rebound", got, err)
+			}
+		})
+	}
+	for _, input := range []string{"", token + "=", token + ".extra", strings.Repeat("a", HistoryMaximumCursorBytes+1), "!" + token[1:]} {
+		if _, err := decodeHistoryCursor(input, scope, key); err == nil {
+			t.Fatal("malformed cursor accepted")
+		}
+	}
+	other := make([]byte, 32)
+	if _, err = rand.Read(other); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = decodeHistoryCursor(token, scope, other); err == nil {
+		t.Fatal("rotated key accepted")
+	}
+	// Even a correctly signed noncanonical or invalid payload is not a v1 cursor.
+	raw, _ := json.Marshal(value)
+	for _, payload := range [][]byte{append([]byte(" "), raw...), []byte(strings.Replace(string(raw), `"version":1`, `"version":2`, 1)), []byte(strings.Replace(string(raw), id, "00000000-0000-0000-0000-000000000000", 1)), []byte(strings.Replace(string(raw), `"version":1`, `"version":1,"extra":true`, 1))} {
+		input := base64.RawURLEncoding.EncodeToString(payload) + "." + base64.RawURLEncoding.EncodeToString(historySignature(payload, key))
+		if _, err := decodeHistoryCursor(input, scope, key); err == nil {
+			t.Fatal("invalid canonical payload accepted")
+		}
+	}
+	for _, stamp := range []time.Time{time.Time{}, stamp.Add(time.Nanosecond), stamp.In(time.FixedZone("offset", 3600))} {
+		if _, err := encodeHistoryCursor(stamp, id, scope, key); err == nil {
+			t.Fatal("unrepresentable tuple accepted")
+		}
+	}
+}
