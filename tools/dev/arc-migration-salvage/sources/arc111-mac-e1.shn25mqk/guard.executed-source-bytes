 process=subprocess.check_output(['ps','-axo','pid=,comm='],text=True); heavy=[]
 for line in process.splitlines():
  parts=line.split(None,1)
  if len(parts)==2 and Path(parts[1]).name in {'go','compile','link','cargo','rustc','make','gcc','cc1','clang'}: heavy.append({'pid':int(parts[0]),'executable':Path(parts[1]).name})
