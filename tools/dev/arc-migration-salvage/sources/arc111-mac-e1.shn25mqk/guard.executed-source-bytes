  children.append(child); info['pid']=child.pid; info['initial_identity']=subprocess.run(['ps','-p',str(child.pid),'-o','pid=,ppid=,pgid=,lstart=,comm='],capture_output=True,text=True).stdout.strip()
  try: info['exit_code']=child.wait(timeout=min(timeout,available))
