def members(group):
 rows=[]
 for line in subprocess.check_output(['ps','-axo','pid=,ppid=,pgid=,lstart=,stat=,comm='],text=True).splitlines():
  p=line.split(None,3)
  if len(p)==4 and int(p[2])==group: rows.append(line.strip())
