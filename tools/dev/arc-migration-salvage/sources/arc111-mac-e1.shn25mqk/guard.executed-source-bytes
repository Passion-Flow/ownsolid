 for item in manifest['files']:
  path=source/item['path']; data=os.readlink(path).encode() if path.is_symlink() else path.read_bytes()
  assert len(data)==item['bytes'] and hashlib.sha256(data).hexdigest()==item['sha256'],item['path']
