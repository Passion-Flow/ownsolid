   piece=os.read(mfd,65536)
   if not piece: break
   data+=piece
  assert hashlib.sha256(data).hexdigest()==cfg['manifest_sha256'],'MANIFEST_SHA'
  assert (manifest.lstat().st_dev,manifest.lstat().st_ino)==(ms.st_dev,ms.st_ino),'MANIFEST_PATH_CHANGED'
