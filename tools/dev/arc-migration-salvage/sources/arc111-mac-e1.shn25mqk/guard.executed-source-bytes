 passed=[]; failed=[]
 for i,entry in enumerate(ep['entries']):
  prefix='package-'+str(i+1); replace=lambda a:a.replace('{source_directory}',str(source)).replace('{owned_output_directory}',str(out))
  compile_info=stage(prefix+'-compile',[replace(a) for a in entry['compile_only_argv']],env,110)
  if compile_info['exit_code']!=0: failed.append(prefix+'-compile'); continue
