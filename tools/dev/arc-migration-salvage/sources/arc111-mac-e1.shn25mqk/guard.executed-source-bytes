def stop(child):
 if child.poll() is None:
  os.killpg(child.pid,signal.SIGTERM)
  try: child.wait(timeout=max(.01,min(5,end-time.monotonic())))
  except subprocess.TimeoutExpired:
   os.killpg(child.pid,signal.SIGKILL); child.wait(timeout=max(.01,min(5,end-time.monotonic())))
 remain=members(child.pid)
 if remain:
  os.killpg(child.pid,signal.SIGKILL)
  limit=min(end,time.monotonic()+5)
  while time.monotonic()<limit and members(child.pid): time.sleep(.05)
 return members(child.pid)
def stage(name,argv,env,timeout=100):
