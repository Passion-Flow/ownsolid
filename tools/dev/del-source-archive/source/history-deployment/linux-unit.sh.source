#!/usr/bin/env bash
set -euo pipefail
root=$(realpath "$1")
case "$root" in /root/lane-rel-tools/lane-del-source.????????) ;; *) exit 1 ;; esac
exec 9>/run/lock/ownsolid-heavy.lock
for attempt in $(seq 1 12); do
 if flock -w 45 -E 75 9; then break; fi
 echo "Shared Linux lock still held; unprivileged unit tests have not started"
 if [ "$attempt" -eq 12 ]; then exit 75; fi
done
exec 8>/root/lane-sci-tools/heavy-test.lock
flock -n -E 75 8
df -h /
free -m
cat /proc/pressure/io
awk '/^MemAvailable:/ {a=$2} /^MemFree:/ {f=$2} END {exit !(a>=4194304 && f>=2097152)}' /proc/meminfo
awk '/^full / {split($2,x,"=");exit !(x[2]<=20)}' /proc/pressure/io
source /root/lane-rel-tools/env
export GOPROXY=off GOSUMDB=off GOMAXPROCS=2 GOFLAGS=-p=1
cd "$root/work"
echo "SOURCE_COMMIT=$(git rev-parse HEAD)"
test -z "$(git status --porcelain)"
go -C deploy/offline vet ./...
for package in internal/install cmd/install; do
 case "$package" in internal/install) binary=history.test ;; cmd/install) binary=install-command.test ;; esac
 docker run --rm --pull never --network none --user 65534:65534 --read-only \
  --cap-drop ALL --security-opt no-new-privileges:true --cpus 2 --memory 1g --pids-limit 256 \
  --tmpfs /tmp:rw,exec,nosuid,size=256m,mode=1777 --env GOMAXPROCS=2 \
  --mount "type=bind,source=$root/work,target=/repo,readonly" \
  --mount "type=bind,source=$root/$binary,target=/usr/local/bin/unit.test,readonly" \
  --workdir "/repo/deploy/offline/$package" --entrypoint /usr/local/bin/unit.test \
  sha256:173f284a4299164772a90f52b373e73e087583c0963f1334c9995f190ef6f3f5 \
  -test.v -test.count=1 -test.timeout=180s
 echo "NONROOT_PACKAGE_PASSED=$package"
done
echo LINUX_INSTALLER_TESTS_AND_VET_PASSED
