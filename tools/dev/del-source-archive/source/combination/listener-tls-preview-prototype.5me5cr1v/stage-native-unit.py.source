from pathlib import Path
import base64,json,hashlib,os
p=Path('/root/lane-rel-tools/listener-tls-unit-inputs')
assert not os.path.lexists(p);p.mkdir(mode=0o700)
for n,r in json.loads('{"native_tls_unit_parent.py": {"sha256": "05e423a4979664df08ab126f4c261b3c3c67e7d7c7e88e503cd5d1aeced42b5e", "data": ""}, "native_tls_unit_child.py": {"sha256": "95364631b0dec6cd8b0ec4f77be3f33f8300d5d42db0a6e81b68e00a85c6c837", "data": ""}, "native-unit-runtime.json": {"sha256": "a32b5a153af633780d7b1dec13128f05b8b4c5c9d83991524efb9aa332909524", "data": ""}, "source.json": {"sha256": "517030ab4aab1f4748717bc566ff078061ec858b038edfdf0e6d7093c0d0187d", "data": ""}, "canonical-compose.yaml": {"sha256": "3c753f781471272963ec2fcfd7b88dff19fdb484c0e7242054ca79fa817f0dca", "data": ""}, "native-unit-inputs.json": {"sha256": "eaef216388faf20da16386e2048246027bdc4cc36573079b692c0dc4ed45f4bb", "data": ""}}').items():
 data=base64.b64decode(r['data'],validate=True);assert hashlib.sha256(data).hexdigest()==r['sha256']
 with (p/n).open('xb') as f:f.write(data)
 print(n,hashlib.sha256((p/n).read_bytes()).hexdigest(),flush=True)
print('staged_only_no_execution',str(p),flush=True)
