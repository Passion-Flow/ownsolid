from pathlib import Path
import subprocess,json,hashlib,base64
src=Path('/root/lane-del-latest-main-preparation');w=Path('/root/lane-del-listener-tls-preview');base='c6d5d1c1dbedef3774a7f8862f119ce464f3e240';branch='codex/del-listener-tls-preview'
def git(root,*args):return subprocess.check_output(['git','-C',str(root),*args],text=True,timeout=10).strip()
assert git(src,'rev-parse','HEAD')==base and not git(src,'status','--porcelain')
if not w.exists():subprocess.run(['git','-C',str(src),'worktree','add',str(w),'-b',branch,base],check=True,timeout=15)
assert git(w,'rev-parse','HEAD')==base and not git(w,'status','--porcelain')
records=json.loads('{"deploy/offline/README.md": "", "deploy/offline/internal/install/apply.go": "", "deploy/offline/internal/install/entrance_listeners_test.go": "", "deploy/offline/internal/install/listener_compatibility.go": "", "deploy/offline/internal/install/materialize.go": "", "deploy/offline/internal/install/serving_transport.go": "", "deploy/offline/internal/install/tls.go": "", "docs/research/installer-entrance-listeners.md": "", "deploy/offline/internal/install/listener_tls_preview_test.go": ""}');manifest=json.loads('{"base": "c6d5d1c1dbedef3774a7f8862f119ce464f3e240", "files": {"deploy/offline/README.md": "b733bcc8dff7d9667bf67c35869ae98dbf0cc895e1047a2e730e4461d60b6301", "deploy/offline/internal/install/apply.go": "cad52245efbc62010a7a4f595b456c0082261c459581e7e11cb449484f285ec6", "deploy/offline/internal/install/entrance_listeners_test.go": "6e9887a3ba12a82db8ad5832e1eeb8dfd190471c324ac87605eabbc80b0c29c6", "deploy/offline/internal/install/listener_compatibility.go": "b4b90ac821cbd9da1646a56f9dbbfd1798dfed726e6ec8ce6c644b933d21721c", "deploy/offline/internal/install/materialize.go": "25f82b001438c897ea5450e276b46418b38bf9edb37e557150b7bc8db2b7372e", "deploy/offline/internal/install/serving_transport.go": "3200288d926652c7864f689d0d5b52260fa8b29aee44fcf29c9baf40c27a3b86", "deploy/offline/internal/install/tls.go": "21d87ebcb603f9d7f46e0893f6e51e6d69e8a4fcbb4df0aad9b615798585152b", "docs/research/installer-entrance-listeners.md": "03c88ae7db60ff2e75fddf9e834f85990ba2a8887112b6fde50dfa9a74e4dab6", "deploy/offline/internal/install/listener_tls_preview_test.go": "0cf528f0d9faa4df61bba68dfeda5d121b056dc2a3e197347cf3b0eec5c56cfb"}, "binary_sha256": "de5d6635221c2b377742a1a70f520b91dce869cc6ab0f38b701c22919d869309", "installer_sha256": "cef8df1e450583dd9c23d6b0f1d237ec7e707b27a722ddcc8913213e72936b32", "canonical_sha256": "3c753f781471272963ec2fcfd7b88dff19fdb484c0e7242054ca79fa817f0dca", "scope": "Own installer source only; no changed Control source, image or installed qualification"}')
for name,encoded in records.items():
 raw=base64.b64decode(encoded,validate=True);assert hashlib.sha256(raw).hexdigest()==manifest['files'][name];(w/name).write_bytes(raw)
assert set(git(w,'diff','--name-only').splitlines())|set(git(w,'ls-files','--others','--exclude-standard').splitlines())==set(records)
subprocess.run(['git','-C',str(w),'diff','--check'],check=True,timeout=10)
subprocess.run(['make','check-layout','check-roadmap','PYTHON=/usr/bin/python3'],cwd=w,check=True,timeout=25)
subprocess.run(['git','-C',str(w),'add','--',*records],check=True,timeout=10)
name,email=git(w,'show','-s','--format=%an%n%ae',base).splitlines()
subprocess.run(['git','-C',str(w),'-c','user.name='+name,'-c','user.email='+email,'commit','-m','DEL-114: Admit the selected TLS bytes before changing listeners','-m','Resolve browser material once without publishing, check private runtime-owned staged references with the existing Control verifier, and materialize the exact admitted bytes. Preserve refusal state and generated CA/pair repair, and read repeated external references without collapsing destinations. The unchanged-source prototype reproduced the old-byte failure; the fixed prototype, full installer package (32.885s), vet, Linux amd64 cross-builds and layout/roadmap checks pass. Native execution, actual image CLI and installed/egress qualification remain open.'],check=True,timeout=20)
assert not git(w,'status','--porcelain');head=git(w,'rev-parse','HEAD');print('tls_source_commit',head,flush=True)
p=Path('/root/lane-rel-tools/del-current-inputs.AksJFVcI/tls-preview.bundle');assert not p.exists();subprocess.run(['git','-C',str(w),'bundle','create',str(p),base+'..'+branch],check=True,timeout=10)
print('tls_bundle_sha256',hashlib.file_digest(p.open('rb'),'sha256').hexdigest(),flush=True)
