import json
packet=json.loads('{"data": "", "sha256": "7dfb242125be3fcca8cbce530047369f4f149da284f40dab578d5fb7c58f378c", "chunks": {"0": "f4f194fb7b13395e441fd7075d3508be03d1864393b20e12096c616c9ffc3cd7", "1": "ad955bd18bda65fc34f6d93c1882343a050bcaff92f2ca02a5b8b6fc1da2b66f", "2": "bf9faee32db03c3d0fcd9318a510c15790d82487ae2be9a21dc276cb1b0c2805", "3": "d1e31a6b856e1fe3eab9776f78b8c828a3f7df7303f3416b64baab5fdf345bc4", "4": "e182fe37626d578f8d7f267735f7a0ba386fb57a5288393faf8a5f396a3853df", "5": "2e0ffa4508bae36f823f5a2ee27df2fbe57e6755635acea1f259f1aea8eace3e", "6": "e25f766a198e72d0747f9b7e900dd2cc6915bc31650eaf566735a49159d6e49d", "7": "4334c7e5b6a7e5af44d5a9e91c6cc3d0d8e185620d2200ff26e601f42659d5e1", "8": "082da6fae1017fa2d68711b081a713911b58ae760a0b6afc41b4d230d4bea403", "9": "92a552b715f5e246d8eba9976ed9c20b5d8283efd24599bbac89832a34822e9f", "10": "6b03ce9366f5f19ca915526a83e3465e6d8dd7fb78af8489f1ac3abe0628ee65", "11": "fc634d8cf6c66594732059914ee124902d4b553daaf2b2c2457075f313a4f75b", "12": "d80ea4eab9d9c77633a033185d5f43ed2d822ef7429f5ab880265f423ebadae1", "13": "ac4896a62a15573b25c89fca929d8cb851332000c88a85d6d82ff3be84ddb5fa", "14": "6526d6c2c5659ef2841e6dbc5a1cbfa0143414563ac08d9b90af0bd3f9f5c1af", "15": "6403064bfde6a83b89abc2f1e57eb1e01a4db1630965ea275b44b062296e707e", "16": "6844db0fb2cc19f59035602ef9081706d83e8dde1f817b140e01cfa70f9ae13c", "17": "fb8798fed2e008e064bbd578cd49ddaa888857ea44c545e30971f0de880aa697", "18": "dbe64d50fc3bb23fa2994803a460d768029b89f733e69858a3d7089b27bbdf1d", "19": "2d016758f5e7fe048c92698b13b143966f4c529a74bbbadaf73a903a8f1b15bf"}}')
from pathlib import Path
import subprocess,json,base64,hashlib,os,stat
src=Path('/root/lane-del-listener-tls-preview');w=Path('/root/lane-del-tls-qualification-notes');head='d2ca13940b9d224fb35ed6ac295dbe56ba08b17f'
def git(root,*a):return subprocess.check_output(['git','-C',str(root),*a],text=True,timeout=10).strip()
assert git(src,'rev-parse','HEAD')==head and not git(src,'status','--porcelain')
assert not w.exists();subprocess.run(['git','-C',str(src),'worktree','add',str(w),'-b','codex/del-tls-qualification-notes',head],check=True,timeout=15)
raw=base64.b64decode(packet['data'],validate=True);assert hashlib.sha256(raw).hexdigest()==packet['sha256'];(w/'docs/research/installer-entrance-listeners.md').write_bytes(raw)
assert git(w,'diff','--name-only')=='docs/research/installer-entrance-listeners.md'
subprocess.run(['git','-C',str(w),'diff','--check'],check=True,timeout=10)
subprocess.run(['make','check-layout','check-roadmap','PYTHON=/usr/bin/python3'],cwd=w,check=True,timeout=25)
subprocess.run(['git','-C',str(w),'add','--','docs/research/installer-entrance-listeners.md'],check=True,timeout=10)
name,email=git(src,'show','-s','--format=%an%n%ae',head).splitlines()
subprocess.run(['git','-C',str(w),'-c','user.name='+name,'-c','user.email='+email,'commit','-m','DEL-114: Preserve the native TLS unit memory refusal','-m','Record complete receiver identities, the 0.100454-second pre-launch memory refusal and zero native runs. Independently confirm the parent disappeared, no namespace was created and the implementation source stayed frozen. Keep the failed sample values unknown and all native/installed/full-gate requirements open. Layout and roadmap checks pass.'],check=True,timeout=20)
assert not git(w,'status','--porcelain') and git(src,'rev-parse','HEAD')==head and not git(src,'status','--porcelain')
print('notes_commit',git(w,'rev-parse','HEAD'),flush=True)
p=Path('/root/lane-rel-tools/del-current-inputs.AksJFVcI/tls-qualification-notes.bundle');assert not p.exists();subprocess.run(['git','-C',str(w),'bundle','create',str(p),head+'..codex/del-tls-qualification-notes'],check=True,timeout=10);print('notes_bundle_sha256',hashlib.file_digest(p.open('rb'),'sha256').hexdigest(),flush=True)
stage=Path('/root/lane-rel-tools/listener-tls-unit-inputs');directory=stage/'chunks';expected={f'chunk-{i:03d}':sha for i,sha in ((int(k),v) for k,v in packet['chunks'].items())}
assert {f.name for f in directory.iterdir()}==set(expected)
removed=[]
for name,sha in expected.items():
 f=directory/name;info=f.lstat();assert stat.S_ISREG(info.st_mode) and info.st_uid==os.geteuid() and hashlib.file_digest(f.open('rb'),'sha256').hexdigest()==sha;removed.append({'name':'chunks/'+name,'bytes':info.st_size,'sha256':sha})
partial=stage/'installer.test.gz.partial-1048576';info=partial.lstat();assert stat.S_ISREG(info.st_mode) and info.st_uid==os.geteuid() and info.st_size==1048576 and hashlib.file_digest(partial.open('rb'),'sha256').hexdigest()=='64b8a755163e16f926589f87f65358035fcdff6ca32db9c97bf0b1fdea319c5c';removed.append({'name':partial.name,'bytes':info.st_size,'sha256':'64b8a755163e16f926589f87f65358035fcdff6ca32db9c97bf0b1fdea319c5c'})
for record in removed:(stage/record['name']).unlink()
directory.rmdir()
record={'scope':'Remove only the 20 verified owned chunks and original partial; retain full ELF/gzip and all actual refusal evidence','removed':removed,'removed_bytes':sum(r['bytes'] for r in removed),'elf_retained':(stage/'installer.test').is_file(),'complete_gzip_retained':(stage/'installer.test.gz').is_file()}
(stage/'transfer-fragments-cleanup.json').write_text(json.dumps(record,indent=2)+'\n');print('owned_transfer_fragments_removed',len(removed),record['removed_bytes'],flush=True)
