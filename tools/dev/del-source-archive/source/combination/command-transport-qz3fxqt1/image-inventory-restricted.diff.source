+    def remember_volumes(name, observed):
+        labels = observed['Config'].get('Labels') or {}
+        if labels.get('io.ownsolid.prototype.run_id') != run_id or observed['Image'] != config['image']:
+            raise RuntimeError('Refuse cleanup of an unowned or replaced container')
+        volumes = set()
+        for mount in observed['Mounts']:
+            if mount['Type'] != 'volume' or not re.fullmatch(r'[0-9a-f]{64}', mount.get('Name', '')):
+                raise RuntimeError('Unexpected mount; preserve it for review')
+            volumes.add(mount['Name'])
+        previous = owned_volumes.setdefault(name, volumes)
+        if previous != volumes:
+            raise RuntimeError('Owned anonymous volume set changed')
+        return sorted(volumes)
