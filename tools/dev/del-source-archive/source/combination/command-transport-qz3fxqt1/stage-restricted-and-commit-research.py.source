from pathlib import Path
import base64,hashlib,json,subprocess
p=Path('/root/lane-rel-tools/command-transport-inputs.f0ZcmqT9')
assert p.is_dir() and not p.is_symlink()
for name,r in json.loads('{"native_transport_restricted_parent.py": {"sha256": "9f9800696cead3d2a702e0d9e6c6bb56819e5f843b4077474467176caea85d4d", "data": ""}, "runtime-restricted.json": {"sha256": "cbc2ec44f4df9dea419cc6d5a94bdcc61198cb64260abbb8f1b031103e206244", "data": ""}, "transport-restricted.diff": {"sha256": "09d44d5274ee52d8e6b9ae3b2310aea56fcb12d1683b2cb6d54d48ee1be5928d", "data": ""}, "transport-restricted-review.json": {"sha256": "db012c67baaa958828403f1666242a91d4f66ecc7bf6876179e65b393ad53b40", "data": ""}}').items():
 raw=base64.b64decode(r['data'],validate=True);assert hashlib.sha256(raw).hexdigest()==r['sha256'];f=p/name
 if f.exists():assert not f.is_symlink() and f.read_bytes()==raw
 else:
  with f.open('xb') as stream:stream.write(raw)
 print(name,hashlib.sha256(f.read_bytes()).hexdigest(),flush=True)
c=json.loads((p/'runtime-restricted.json').read_text())
assert hashlib.file_digest(Path(c['binary']).open('rb'),'sha256').hexdigest()==c['binary_sha256']
assert subprocess.check_output(['git','-C',c['source'],'rev-parse','HEAD'],text=True,timeout=2).strip()==c['candidate']
assert not subprocess.check_output(['git','-C',c['source'],'status','--porcelain'],timeout=2)
print('runtime_observer_staged_only',flush=True)
w=Path('/root/lane-del-command-cancellation');base='1a41d97981798440b7f02061d3a73853726b03bc'
def git(*a):return subprocess.check_output(['git','-C',str(w),*a],text=True,timeout=10).strip()
assert git('rev-parse','HEAD')==base and not git('status','--porcelain')
source=Path('/root/lane-rel-tools/del-current-inputs.AksJFVcI/minimal/installer-command-cancellation.md')
assert hashlib.sha256(source.read_bytes()).hexdigest()=='f66b1c5f5cce79a58f42407e6349dd937146adff985bb113325ed66cec20c075'
target=w/'docs/research/installer-command-cancellation.md';target.write_bytes(source.read_bytes())
assert git('diff','--name-only')=='docs/research/installer-command-cancellation.md'
subprocess.run(['git','-C',str(w),'diff','--check'],check=True,timeout=10)
subprocess.run(['make','check-layout','check-roadmap','PYTHON=/usr/bin/python3'],cwd=w,check=True,timeout=25)
print(git('diff','--stat'),flush=True)
subprocess.run(['git','-C',str(w),'add','--','docs/research/installer-command-cancellation.md'],check=True,timeout=10)
subprocess.run(['git','-C',str(w),'commit','-m','REL-106: Record cached-image licence boundaries','-m','Verify the immutable experimental APK inventory and upstream BusyBox and musl terms. Preserve the unresolved notice-copy result and require a fresh bounded runtime observation. Layout, language and roadmap checks pass; no product cancellation change or running-container qualification is claimed.'],check=True,timeout=20)
assert not git('status','--porcelain');print('research_commit',git('rev-parse','HEAD'),flush=True)
