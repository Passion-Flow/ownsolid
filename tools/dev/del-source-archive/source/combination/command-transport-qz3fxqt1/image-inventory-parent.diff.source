+        name = 'lane-del-image-inventory-' + run_id[:20]
+        if inspect(name) is not None or networks(name):
+            raise RuntimeError('Inventory name is occupied; preserve it')
+        containers.append(name)
+        docker('create', '--pull', 'never', '--name', name, '--network', 'none',
+               '--read-only', '--cpus', str(config['cpus']), '--memory', str(config['memory_bytes']),
+               '--memory-swap', str(config['memory_bytes']), '--pids-limit', str(config['pids_limit']),
+               '--no-healthcheck', '--label', 'io.ownsolid.prototype.run_id=' + run_id,
+               '--entrypoint', '/bin/false', config['image'])
+        state = inspect(name)
+        assert state is not None and state['State']['Status'] == 'created'
+        assert not state['State']['Running'] and state['State']['Pid'] == 0
+        assert state['HostConfig']['NetworkMode'] == 'none' and state['HostConfig']['ReadonlyRootfs']
+        assert not state['HostConfig'].get('PortBindings')
+        save(output / 'never-started-container.json', state)
+        case = {'kind': 'never-started-image-inventory', 'container': name, 'copies': {}}
+        result['cases'].append(case)
+        for source, target, required in [('/lib/apk/db/installed', 'apk-installed', True),
+                                         ('/etc/alpine-release', 'alpine-release', True),
+                                         ('/usr/share/licenses', 'image-licenses', False)]:
+            status, _ = docker('cp', '--quiet', name + ':' + source, str(output / target), permit_failure=True)
+            case['copies'][source] = {'exit': status, 'target': target}
+            if required:
+                assert status == 0 and stat.S_ISREG((output / target).lstat().st_mode)
+                case['copies'][source]['sha256'] = digest(output / target)
+        packages = []
+        for paragraph in (output / 'apk-installed').read_text().split('\n\n'):
+            fields = dict(line.split(':', 1) for line in paragraph.splitlines()
+                          if len(line) > 1 and line[1] == ':' and line[0] in 'PVLUo')
+            if fields:
+                assert fields.get('P') and fields.get('V') and fields.get('L')
+                packages.append(fields)
+        assert packages
+        save(output / 'declared-package-licenses.json', packages)
+        case['package_count'] = len(packages)
+        case['declared_licenses'] = sorted({item['L'] for item in packages})
+        case['scope'] = 'Declared package metadata only; notices still need review; no image code was executed'
+        close_container(name)
         assert digest(config['binary']) == config['binary_sha256']
         assert not subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain'])
-        result['status'], code = 'experiment-completed', 0
+        result['status'], code = 'image-inventory-collected', 0
     except BaseException as error:
         result['status'] = 'failed'
         result['error'] = type(error).__name__ + ': ' + str(error)
