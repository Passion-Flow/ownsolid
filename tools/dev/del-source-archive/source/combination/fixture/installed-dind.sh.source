#!/bin/sh
set -eu
recorder=
daemon=
cleanup(){
 result=$?
 trap - EXIT
 if [ -n "$daemon" ]; then kill "$daemon" 2>/dev/null || true; wait "$daemon" 2>/dev/null || true; fi
 if [ -n "$recorder" ]; then kill "$recorder" 2>/dev/null || true; wait "$recorder" 2>/dev/null || true; fi
 cp /tmp/egress.jsonl /evidence/egress.jsonl 2>/dev/null || true
 chmod 600 /evidence/egress.jsonl 2>/dev/null || true
 cat /tmp/egress.jsonl 2>/dev/null || true
 exit "$result"
}
trap cleanup EXIT
/bundle/egress-recorder -interface egress0 -log /tmp/egress.jsonl &
recorder=$!
for n in $(seq 1 50); do
 if ip link show egress0 >/dev/null 2>&1; then break; fi
 sleep .1
done
ip link set lo up
ip addr add 10.77.0.1/32 dev lo
ip link set egress0 up
ip addr add 198.18.0.1/32 dev egress0
ip -6 addr add 2001:db8:e9e5::1/128 dev egress0
sleep 2
ip route add default dev egress0
ip -6 route add default dev egress0
printf 'nameserver 192.0.2.53\n' > /etc/resolv.conf
test "$(ls -1 /sys/class/net | wc -l)" = 2
ip addr show
ip route show
ip -6 route show
/bundle/probe
sleep .2
test "$(wc -l < /tmp/egress.jsonl)" = 3
dockerd --host unix:///var/run/docker.sock --log-level error > /evidence/dockerd.log 2>&1 &
daemon=$!
for n in $(seq 1 90); do
 if docker info >/dev/null 2>&1; then break; fi
 sleep 1
done
docker info >/dev/null
docker load -i /bundle/images.tar >/dev/null
docker network create lane-del-negative-control >/dev/null
docker run --rm --pull never --network lane-del-negative-control \
 --dns 192.0.2.53 --volume /bundle/probe:/probe:ro \
 --entrypoint /probe "$CONTROL_IMAGE"
docker network rm lane-del-negative-control >/dev/null
sleep .2
test "$(wc -l < /tmp/egress.jsonl)" = 5
HISTORY_METRICS_IMAGE="$METRICS_IMAGE" HISTORY_EVALUATOR_IMAGE="$EVALUATOR_IMAGE" \
 /bundle/history-prepare.test -test.run '^TestTemporaryCombinedHistoryPreparation$' -test.v -test.timeout 30s
test -x /usr/local/bin/docker
mkdir /tmp/debug-bin
cat > /tmp/debug-bin/docker <<'DOCKER_TRACE'
#!/bin/sh
out=$(mktemp)
err=$(mktemp)
/usr/local/bin/docker "$@" > "$out" 2> "$err"
result=$?
case "$*" in
 */srv/fleet-history/*)
  { printf 'DOCKER_RESULT=%s\n' "$result"; printf ' %s' "$@"; printf '\n'; cat "$out" "$err"; } >> /evidence/history-docker-trace.log
 ;;
esac
cat "$out"
cat "$err" >&2
rm "$out" "$err"
exit "$result"
DOCKER_TRACE
chmod 755 /tmp/debug-bin/docker
export PATH=/tmp/debug-bin:$PATH
if ! /bundle/ownsolid-install fleet-history apply --config /evidence/history-inputs/site.yaml > /evidence/history-ready.json; then
 cat /evidence/history-docker-trace.log
 exit 1
fi
cat /evidence/history-ready.json
export OWNSOLID_E2E_INSTALLER=/bundle/ownsolid-install
export OWNSOLID_E2E_COMPOSE_FILE=/bundle/compose.yaml
export OWNSOLID_E2E_IMAGE_ARCHIVE=/bundle/images.tar
export OWNSOLID_E2E_CONTROL_IMAGE="$CONTROL_IMAGE"
export OWNSOLID_E2E_POSTGRES_IMAGE="$POSTGRES_IMAGE"
export OWNSOLID_E2E_METRICS_IMAGE="$METRICS_IMAGE"
export OWNSOLID_E2E_LOGS_IMAGE="$LOGS_IMAGE"
export OWNSOLID_E2E_ROOT=/srv/ownsolid
export OWNSOLID_E2E_EGRESS_LOG=/tmp/egress.jsonl
export OWNSOLID_E2E_EGRESS_INTERFACE=egress0
export COMBINED_SOURCE_SHA=4463bbe628f60486bbdb92c15f72311fb53d076a
/bundle/installed.test -test.run '^TestTemporaryCombinedInstalledAcceptance$' -test.v -test.timeout 70m
test "$(wc -l < /tmp/egress.jsonl)" = 5
test "$(grep -Fc '"destination":"192.0.2.10:9"' /tmp/egress.jsonl)" = 2
test "$(grep -Fc '"destination":"[2001:db8::10]:9"' /tmp/egress.jsonl)" = 1
test "$(grep -Fc '"destination":"192.0.2.53:53"' /tmp/egress.jsonl)" = 2
test "$(grep -Fc '"dns_question":"probe.invalid. A"' /tmp/egress.jsonl)" = 2
kill -0 "$recorder"
echo 'COMBINED_INSTALLED_ZERO_EGRESS_PASSED: only deliberate host/workload negative controls captured'
