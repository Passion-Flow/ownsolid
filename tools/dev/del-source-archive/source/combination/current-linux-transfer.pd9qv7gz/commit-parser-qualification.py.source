from pathlib import Path
import json,base64,hashlib,subprocess
w=Path('/root/lane-del-command-cancellation')
def git(*a):return subprocess.check_output(['git','-C',str(w),*a],text=True,timeout=10).strip()
assert git('rev-parse','HEAD')=='e8c8824ddf776f387117589077adaa18d20beea9' and not git('status','--porcelain')
records=json.loads('{"docs/product/roadmap/delivery-and-upgrades.md": {"sha256": "12b46c12c1196109bd7f6ca1df131473eff1b90f3d76676dd8bfc4af4b9d182d", "data": ""}, "docs/research/installer-entrance-listeners.md": {"sha256": "a6fbda60b145ded515106e08d95bfdac7fa794e9f489956bb9f5992abff5a7b4", "data": ""}}')
for name,r in records.items():
 data=base64.b64decode(r['data'],validate=True);assert hashlib.sha256(data).hexdigest()==r['sha256'];(w/name).write_bytes(data)
assert set(git('diff','--name-only').splitlines())==set(records)
subprocess.run(['git','-C',str(w),'diff','--check'],check=True,timeout=10)
subprocess.run(['make','check-layout','check-roadmap','PYTHON=/usr/bin/python3'],cwd=w,check=True,timeout=25)
print(git('diff','--stat'),flush=True)
subprocess.run(['git','-C',str(w),'add','--',*records],check=True,timeout=10)
name,email=git('show','-s','--format=%an%n%ae','HEAD').splitlines()
subprocess.run(['git','-C',str(w),'-c','user.name='+name,'-c','user.email='+email,'commit','-m','DEL-114: Record native Compose projection checks','-m','Verify all four generated configurations with the pinned Linux amd64 Docker and Compose parser, preserve the original pre-exec guard refusal, and record independent process and namespace cleanup. Layout and roadmap checks pass. Installed Control, upgrade/rollback, browser and egress-capture qualification remain open.'],check=True,timeout=20)
assert not git('status','--porcelain');print('qualification_notes_commit',git('rev-parse','HEAD'),flush=True)
p=Path('/root/lane-rel-tools/del-current-inputs.AksJFVcI/qualification-notes.bundle');assert not p.exists()
subprocess.run(['git','-C',str(w),'bundle','create',str(p),'e8c8824ddf776f387117589077adaa18d20beea9..codex/del-command-cancellation'],check=True,timeout=10)
print('notes_bundle_sha256',hashlib.file_digest(p.open('rb'),'sha256').hexdigest(),flush=True)
