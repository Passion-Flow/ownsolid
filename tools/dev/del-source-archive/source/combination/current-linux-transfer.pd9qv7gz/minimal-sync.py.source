from pathlib import Path
import base64,json,hashlib,subprocess
stage=Path('/root/lane-rel-tools/del-current-inputs.AksJFVcI/minimal')
stage.mkdir(mode=0o700,exist_ok=True)
for name,r in json.loads('{"current-main.bundle": {"data": "OMITTED_GIT_BUNDLE_BINARY_SHA256_4ce16d63a651da7105fc80682b7fdd79078e4b1e9e38188009cb51c349e34cc2", "sha256": "4ce16d63a651da7105fc80682b7fdd79078e4b1e9e38188009cb51c349e34cc2"}, "installer-command-cancellation.md": {"data": "", "sha256": "f66b1c5f5cce79a58f42407e6349dd937146adff985bb113325ed66cec20c075"}}').items():
 p=stage/name;data=base64.b64decode(r['data'],validate=True)
 assert hashlib.sha256(data).hexdigest()==r['sha256']
 if p.exists():assert not p.is_symlink() and p.read_bytes()==data
 else:
  with p.open('xb') as f:f.write(data)
 print(name,r['sha256'],flush=True)
source=Path('/root/lane-del-entrance-projection');target=Path('/root/lane-del-current-main-preparation')
base='1a41d97981798440b7f02061d3a73853726b03bc';head='5e764ea567b3613e96679cc3c0ea4d651707826c';branch='codex/del-current-main-preparation'
def git(root,*a):return subprocess.check_output(['git','-C',str(root),*a],text=True,timeout=10).strip()
assert git(source,'rev-parse','HEAD')==base and not git(source,'status','--porcelain')
subprocess.run(['git','-C',str(source),'bundle','verify',str(stage/'current-main.bundle')],check=True,timeout=10)
r=subprocess.run(['git','-C',str(source),'show-ref','--verify','--hash','refs/heads/'+branch],capture_output=True,text=True,timeout=10)
if r.returncode==0:assert r.stdout.strip()==head
else:
 assert r.returncode==1
 subprocess.run(['git','-C',str(source),'fetch',str(stage/'current-main.bundle'),'refs/heads/'+branch+':refs/heads/'+branch],check=True,timeout=15)
if not target.exists():subprocess.run(['git','-C',str(source),'worktree','add',str(target),branch],check=True,timeout=15)
assert git(target,'rev-parse','HEAD')==head and not git(target,'status','--porcelain')
assert git(target,'rev-parse','HEAD^{tree}')=='97bbe87fb95824dde35a4345378f242d891aaa3c'
subprocess.run(['git','-C',str(target),'merge-base','--is-ancestor','6ed5c627a04a52b97d273f6782fdb0733d8703c4',head],check=True,timeout=5)
assert git(source,'rev-parse','HEAD')==base and not git(source,'status','--porcelain')
r={'source':head,'tree':git(target,'rev-parse','HEAD^{tree}'),'path':str(target),'clean':True,'frozen_parser_source_unchanged':base,'asset_transfer':'Partial archive remains inert; no input activation','scope':'Source synchronization only; no build or runtime acceptance'}
(stage/'source-sync.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r),flush=True)
