#!/usr/bin/env bash
set -euo pipefail
work=$(realpath "$1")
repo=$(realpath "$2")
expected=$3
case "$work" in /dev/shm/lane-del-dat107-signed.????????) ;; *) exit 1 ;; esac
cd "$work"
umask 077
test "$(uname -sm)" = 'Linux x86_64'
test "$(git -C "$repo" rev-parse HEAD)" = "$expected"
test -z "$(git -C "$repo" status --porcelain)"
printf 'Fixture source %s\n' "$expected"
df -h / /dev/shm
free -m
head -2 /proc/pressure/io
ss -lntp | wc -l
ready() {
    awk '/^MemAvailable:/ { exit ! ($2 >= 4194304) }' /proc/meminfo &&
        awk '/^full / {split($2, score, "="); exit ! (score[2] <= 20)}' /proc/pressure/io &&
        df -Pk / /dev/shm | awk 'NR==2 {disk=$4} NR==3 {ram=$4} END {exit !(disk>=20971520 && ram>=2097152)}'
}
for _ in {1..10}; do
    if ready; then break; fi
    sleep 10
done
if ! ready; then head -2 /proc/pressure/io; echo 'Shared host preflight refused'; exit 75; fi
exec 9>/run/lock/ownsolid-heavy.lock
flock -n -E 75 9
exec 8>/root/lane-sci-tools/heavy-test.lock
flock -n -E 75 8
if ! ready; then echo 'Shared host preflight refused after lock'; exit 75; fi
echo 'Shared preflight passed and exclusive lock acquired'
name="lane-del-dat107-base-${work##*.}"
if docker container inspect "$name" >/dev/null 2>&1; then exit 1; fi
cleanup() {
    if docker container inspect "$name" >/dev/null 2>&1; then docker rm -f "$name" >/dev/null; fi
}
trap cleanup EXIT
base_ref=$(awk '/^FROM docker.io\/library\/python:/ {print $2}' "$repo/deploy/images/control/Dockerfile")
test "$base_ref" = docker.io/library/python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
docker image inspect "$base_ref" | python3 -IB -c '
import json, sys
[image] = json.load(sys.stdin)
ref = sys.argv[1]
assert image["Os"] == "linux" and image["Architecture"] == "amd64"
assert any(item.split("@")[-1] == ref.split("@")[-1] for item in image["RepoDigests"])
print(json.dumps({"reference":ref,"local_id":image["Id"],"platform":"linux/amd64","layers":image["RootFS"]["Layers"]}, sort_keys=True))
' "$base_ref" > "$work/base-identity.json"
cat "$work/base-identity.json"
# The container can only read the cached image. It has no bridge, published ports or mounts.
timeout 30 docker run --name "$name" --rm --pull=never --network none --read-only \
    --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges \
    --cpus .5 --memory 96m --pids-limit 32 --entrypoint /bin/sh "$base_ref" -ec '
    cd /
    { find -L usr/share/doc -mindepth 2 -maxdepth 2 -name copyright -type f | LC_ALL=C sort; printf "%s\n" usr/local/lib/python3.12/LICENSE.txt; } |
        tar --create --file=- --dereference --files-from=-
' > "$work/base-notices.tar"
tar -tf "$work/base-notices.tar" | wc -l
sha256sum "$work/base-notices.tar"

export FIXTURE_REPO="$repo"
export FIXTURE_GO=/root/lane-rel-tools/go/bin/go
export GOTOOLCHAIN=local GOMAXPROCS=2 GOFLAGS=-p=2 GOPROXY=off GOSUMDB=off
"$FIXTURE_GO" version
mkdir "$work/tmp"
export TMPDIR="$work/tmp"
"$FIXTURE_GO" -C "$repo/tests/e2e" build -trimpath -o "$work/egress-recorder" ./cmd/egress-recorder
timeout 300 unshare --mount --net --propagation private bash "$work/isolated.sh" "$work"
