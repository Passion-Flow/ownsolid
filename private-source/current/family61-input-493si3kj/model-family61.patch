+		defer cancel()
+		var exists bool
+		if err := operator.QueryRow(cleanup, `SELECT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=$1)`, role).Scan(&exists); err != nil {
+			t.Error("owned runtime principal inventory failed")
+			return
+		}
+		if !exists {
+			return
+		}
