set -euo pipefail
cd ~/lane-rel
source ~/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1 CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true
umask 077
exec 9>~/lane-rel-tools/heavy-test.lock
flock -w 300 9
df -h /
free -m
test "$(df -Pm / | awk 'NR == 2 {print $4}')" -ge 15360
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
unshare -n bash -ec '
ip link set lo up
test "$(wc -l < /proc/net/route)" -eq 1
make generate
make check
make build
cd web
pnpm --filter @ownsolid/help test
'
git diff --check
git add -- web/packages/api/src/gen/distribution.ts
git commit -m "DEV-101 S-108: Regenerate the explicit cutover conflict response" -m "Verify disconnected make generate, check and build after publishing the named 409 response. Recheck the 19 Help tests."
git update-ref refs/lane-rel/s108-help-candidate HEAD
test ! -e tools/audit-verify/audit-verify || rm -- tools/audit-verify/audit-verify
git status --short
git log -2 --oneline

