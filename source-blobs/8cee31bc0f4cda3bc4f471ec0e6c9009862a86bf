apiVersion: v1
kind: Service
metadata:
  name: {{ include "ownsolid.controlName" . }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{- include "ownsolid.controlSelector" . | nindent 4 }}
spec:
  type: ClusterIP
  selector:
    {{- include "ownsolid.controlSelector" . | nindent 4 }}
  ports:
    - name: https
      port: 443
      targetPort: https
