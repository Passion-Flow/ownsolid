+	_, err := runtime.Exec(ctx, insert, draft, uuid.NewString())
+	var foreignKey *pgconn.PgError
+	if !errors.As(err, &foreignKey) || foreignKey.Code != "23503" || foreignKey.ConstraintName != "dataset_draft_import_candidate_scope_fk" {
