+	var bytes string
+	if err := runtime.QueryRow(ctx, "SELECT report->>'source_bytes' FROM dataset_draft_import_candidates WHERE draft_id=$1", draft).Scan(&bytes); err != nil || bytes != "42" {
+		t.Fatal("runtime receipt read", err)
