+	if out, err := ReadWorkspaceQuotaStatus(t.Context(), f.authority, f.portal, workspace); err == nil || err.Error() != "RESOURCE_NOT_FOUND" || !reflect.DeepEqual(out, WorkspaceQuotaStatus{}) {
