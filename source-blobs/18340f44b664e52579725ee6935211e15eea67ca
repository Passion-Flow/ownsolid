diff --git a/services/control/internal/modules/sso/connector_sign_in_tests.go b/services/control/internal/modules/sso/connector_sign_in_tests.go
new file mode 100644
index 00000000..2158227a
--- /dev/null
+++ b/services/control/internal/modules/sso/connector_sign_in_tests.go
@@ -0,0 +1,177 @@
+package sso
+
+import (
+	"context"
+	"crypto/hmac"
+	"database/sql"
+	"encoding/json"
+	"time"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity/security"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/config"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/database/transaction"
+)
+
+// ConnectorSignInTests owns diagnostic authentication without local login authority.
+// Its explicit composition requires the separately admitted PostgreSQL test schema.
+type ConnectorSignInTests struct{ service *Service }
+
+// ConnectorSignInTestInput binds a start to the connector the Admin inspected.
+type ConnectorSignInTestInput struct {
+	Revision int64  `json:"revision"`
+	Reason   string `json:"reason"`
+}
+
+// ConnectorSignInTestStart contains the exact pending start and its private cookie proof.
+type ConnectorSignInTestStart struct {
+	ID               string    `json:"id"`
+	AuthorizationURL string    `json:"authorization_url"`
+	ExpiresAt        time.Time `json:"expires_at"`
+	BrowserToken     string    `json:"-"`
+}
+
+// ConnectorSignInTestResult is a minimized diagnostic result, never a local identity.
+type ConnectorSignInTestResult struct {
+	ID          string     `json:"id"`
+	ConnectorID string     `json:"connector_id"`
+	State       string     `json:"state"`
+	Subject     *string    `json:"subject"`
+	Login       *string    `json:"login"`
+	DisplayName *string    `json:"display_name"`
+	ErrorCode   *string    `json:"error_code"`
+	ExpiresAt   time.Time  `json:"expires_at"`
+	FinishedAt  *time.Time `json:"finished_at"`
+}
+
+type connectorTestRow struct {
+	ConnectorSignInTestResult
+	tenant, user, session               string
+	epoch, revision, version            int64
+	fingerprint, browserHash, stateHash []byte
+	sealed                              sealedSecret
+	claim                               sql.NullString
+}
+
+const connectorTestColumns = `id::text,connector_id::text,state,subject,login,display_name,error_code,expires_at,finished_at,tenant_id::text,actor_user_id::text,actor_session_id::text,actor_epoch,connector_revision,auth_version,fingerprint,browser_hash,secret_key_id,secret_nonce,secret_ciphertext,claim_id::text,state_hash`
+
+func scanConnectorTest(row transaction.Row) (connectorTestRow, error) {
+	var r connectorTestRow
+	var key sql.NullString
+	err := row.Scan(&r.ID, &r.ConnectorID, &r.State, &r.Subject, &r.Login, &r.DisplayName, &r.ErrorCode, &r.ExpiresAt, &r.FinishedAt, &r.tenant, &r.user, &r.session, &r.epoch, &r.revision, &r.version, &r.fingerprint, &r.browserHash, &key, &r.sealed.nonce, &r.sealed.ciphertext, &r.claim, &r.stateHash)
+	r.sealed.keyID = key.String
+	r.ExpiresAt = r.ExpiresAt.UTC()
+	return r, err
+}
+
+// NewConnectorSignInTests checks the required PostgreSQL diagnostic projection.
+// Formal catalog, grant and migration admission belongs to the composition owner.
+// No worker, private key or provider connection is created here.
+func NewConnectorSignInTests(ctx context.Context, s *Service) (*ConnectorSignInTests, error) {
+	if ctx == nil || s == nil || s.Identity == nil {
+		return nil, fail("SSO_CONFIGURATION_REQUIRED")
+	}
+	q, err := s.catalogRepository()
+	if err != nil {
+		return nil, err
+	}
+	if q.Dialect() != transaction.PostgreSQL {
+		return nil, fail("SSO_CONFIGURATION_REQUIRED")
+	}
+	ctx, cancel := context.WithTimeout(ctx, config.Seconds(s.policy.OperationSeconds))
+	defer cancel()
+	rows, err := q.Query(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT "+connectorTestColumns+" FROM sso_connector_sign_in_tests WHERE false"))
+	if err != nil {
+		return nil, fail("SERVICE_NOT_READY")
+	}
+	rows.Close()
+	if err = rows.Err(); err != nil {
+		return nil, fail("SERVICE_NOT_READY")
+	}
+	return &ConnectorSignInTests{service: s}, nil
+}
+
+func (t *ConnectorSignInTests) ready(a identity.Auth) error {
+	if !platformAdministrator(a) {
+		return fail("ACCESS_DENIED")
+	}
+	if t == nil || t.service == nil || t.service.Identity == nil {
+		return fail("SERVICE_NOT_READY")
+	}
+	return nil
+}
+
+func (t *ConnectorSignInTests) callback(id string) (string, error) {
+	s := t.service
+	if !canonicalID(id) || !config.SSOOrigin(s.Identity.Config.Server.AdminOrigin) {
+		return "", fail("SSO_AUTHORIZATION_INPUT_INVALID")
+	}
+	return s.Identity.Config.Server.AdminOrigin + "/api/v1/admin/sso/connectors/" + id + "/sign-in-tests/callback", nil
+}
+
+func (t *ConnectorSignInTests) provider(id, origin string) (*giteaProvider, error) {
+	s := t.service
+	c, ok := s.approved[origin]
+	if !s.enabled {
+		return nil, fail("SSO_DISABLED")
+	}
+	if !ok {
+		return nil, fail("SSO_PROVIDER_DESTINATION_REJECTED")
+	}
+	callback, err := t.callback(id)
+	if err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := "connector-test/" + id
+	if p := s.clients[key]; p != nil {
+		if p.configuration.Origin != origin {
+			return nil, fail("SSO_PROVIDER_CONFIGURATION_INVALID")
+		}
+		return p, nil
+	}
+	p, err := newGiteaProvider(c, s.policy, []string{callback}, s.slots)
+	if err != nil {
+		return nil, err
+	}
+	s.clients[key] = p
+	return p, nil
+}
+
+func (t *ConnectorSignInTests) proof(row connectorTestRow, browser string) []byte {
+	callback, err := t.callback(row.ConnectorID)
+	if err != nil {
+		return nil
+	}
+	return security.MAC(t.service.Identity.HMACKey, "sso-connector-test-browser-v1", callback, row.tenant, row.user, row.session, row.ID, browser)
+}
+
+func (t *ConnectorSignInTests) open(row connectorTestRow) ([3]string, error) {
+	var bundle [3]string
+	raw, err := t.service.keys.open(secretScope{row.tenant, row.ConnectorID, row.ID, connectorTestPurpose}, row.sealed)
+	if err != nil {
+		return bundle, err
+	}
+	defer clear(raw)
+	var fields []string
+	if json.Unmarshal(raw, &fields) != nil || len(fields) != len(bundle) {
+		return [3]string{}, errEncryptedState
+	}
+	copy(bundle[:], fields)
+	for _, v := range bundle {
+		if !security.ValidToken(v) {
+			return [3]string{}, errEncryptedState
+		}
+	}
+	if !hmac.Equal(row.stateHash, security.Digest(bundle[0])) || !hmac.Equal(row.browserHash, t.proof(row, bundle[1])) {
+		return [3]string{}, errEncryptedState
+	}
+	return bundle, nil
+}
+
+func (t *ConnectorSignInTests) within(ctx context.Context, a identity.Auth, connector string, fence connectorFence, fn func(context.Context, transaction.Executor, string) error) error {
+	return t.service.actorTransaction(ctx, a, fence, connectorShared, func(_ context.Context, _ transaction.Executor, tenant string) ([]connectorLock, error) {
+		return []connectorLock{{tenant, connector}}, nil
+	}, fn)
+}
diff --git a/services/control/internal/modules/sso/connector_sign_in_tests_completion.go b/services/control/internal/modules/sso/connector_sign_in_tests_completion.go
new file mode 100644
index 00000000..1854b4ef
--- /dev/null
+++ b/services/control/internal/modules/sso/connector_sign_in_tests_completion.go
@@ -0,0 +1,201 @@
+package sso
+
+import (
+	"context"
+	"crypto/hmac"
+	"database/sql"
+	"errors"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/audit"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/identity/security"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/config"
+	"github.com/Passion-Flow/ownsolid/services/control/internal/platform/database/transaction"
+	"github.com/google/uuid"
+)
+
+type claimedConnectorTest struct {
+	row              connectorTestRow
+	connector        Connector
+	verifier, secret string
+}
+
+func (t *ConnectorSignInTests) claim(ctx context.Context, a identity.Auth, connector, state, browser, requestID string) (claimedConnectorTest, error) {
+	var result claimedConnectorTest
+	var refusal error
+	err := t.within(ctx, a, connector, connectorReadFence, func(ctx context.Context, q transaction.Executor, tenant string) error {
+		row, err := scanConnectorTest(q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT "+connectorTestColumns+" FROM sso_connector_sign_in_tests WHERE tenant_id=$1 AND connector_id=$2 AND state_hash=$3 AND actor_user_id=$4 AND actor_session_id=$5 AND actor_epoch=$6 FOR UPDATE", tenant, connector, security.Digest(state), a.Me.User.ID, a.SessionID, a.Epoch)))
+		if errors.Is(err, sql.ErrNoRows) {
+			return fail("SSO_FLOW_INVALID")
+		}
+		if err != nil {
+			return err
+		}
+		if !hmac.Equal(row.browserHash, t.proof(row, browser)) {
+			return fail("SSO_BROWSER_CHANGED")
+		}
+		if row.State != "pending" {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		c, err := selectConnectorWithin(ctx, q, tenant, connector)
+		if err != nil {
+			return err
+		}
+		var fresh bool
+		if err = q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT expires_at>clock_timestamp() FROM sso_connector_sign_in_tests WHERE tenant_id=$1 AND id=$2", tenant, row.ID)).Scan(&fresh); err != nil {
+			return err
+		}
+		if !fresh {
+			refusal = fail("SSO_FLOW_EXPIRED")
+		} else if c.Revision != row.revision || c.AuthVersion != row.version {
+			refusal = fail("SSO_FLOW_UNUSABLE")
+		}
+		bundle, openErr := t.open(row)
+		if refusal == nil && openErr != nil {
+			refusal = openErr
+		}
+		var stored storedConnector
+		if refusal == nil {
+			stored, refusal = t.service.readStoredConnector(ctx, q, tenant, connector)
+		}
+		if refusal != nil {
+			code := refusal.Error()
+			if code != "SSO_FLOW_EXPIRED" && code != "SSO_ENCRYPTED_STATE_INVALID" {
+				code = "SSO_FLOW_UNUSABLE"
+			}
+			if err = t.failWithin(ctx, q, row, code, requestID); err != nil {
+				return err
+			}
+			result.row = row
+			result.row.State = "failed"
+			result.row.ErrorCode = &code
+			return nil
+		}
+		claim := uuid.NewString()
+		changed, err := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, "UPDATE sso_connector_sign_in_tests SET state='claimed',claim_id=$3,secret_key_id=NULL,secret_nonce=NULL,secret_ciphertext=NULL WHERE tenant_id=$1 AND id=$2 AND state='pending'", tenant, row.ID, claim))
+		if err != nil {
+			return err
+		}
+		if changed != 1 {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		row.State = "claimed"
+		row.claim = sql.NullString{String: claim, Valid: true}
+		result = claimedConnectorTest{row: row, connector: c, verifier: bundle[2], secret: stored.secret}
+		return nil
+	})
+	if err != nil {
+		return claimedConnectorTest{}, err
+	}
+	return result, refusal
+}
+
+func (t *ConnectorSignInTests) failWithin(ctx context.Context, q transaction.Executor, row connectorTestRow, code, requestID string) error {
+	changed, err := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, `UPDATE sso_connector_sign_in_tests SET state='failed',error_code=$3,finished_at=clock_timestamp(),secret_key_id=NULL,secret_nonce=NULL,secret_ciphertext=NULL WHERE tenant_id=$1 AND id=$2 AND state IN ('pending','claimed')`, row.tenant, row.ID, code))
+	if err != nil {
+		return err
+	}
+	if changed != 1 {
+		return fail("SSO_FLOW_UNUSABLE")
+	}
+	return audit.WriteWithin(ctx, q, "", "", "admin", "sso.connector_tested", "failure", "sso_connector", row.ConnectorID, code, requestID)
+}
+
+func (t *ConnectorSignInTests) finish(ctx context.Context, a identity.Auth, f claimedConnectorTest, identity providerIdentity, requestID string) (ConnectorSignInTestResult, error) {
+	var out ConnectorSignInTestResult
+	err := t.within(ctx, a, f.row.ConnectorID, connectorReadFence, func(ctx context.Context, q transaction.Executor, tenant string) error {
+		c, err := selectConnectorWithin(ctx, q, tenant, f.row.ConnectorID)
+		if err != nil {
+			return err
+		}
+		if c.Revision != f.row.revision || c.AuthVersion != f.row.version {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		changed, err := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, `UPDATE sso_connector_sign_in_tests SET state='succeeded',subject=$4,login=NULLIF($5,''),display_name=NULLIF($6,''),finished_at=clock_timestamp() WHERE tenant_id=$1 AND id=$2 AND claim_id=$3 AND state='claimed' AND expires_at>clock_timestamp()`, tenant, f.row.ID, f.row.claim.String, identity.subject, identity.login, identity.name))
+		if err != nil {
+			return err
+		}
+		if changed != 1 {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		if err = audit.WriteWithin(ctx, q, a.Me.User.ID, "", "admin", "sso.connector_tested", "success", "sso_connector", f.row.ConnectorID, "interactive_sign_in", requestID); err != nil {
+			return err
+		}
+		row, err := scanConnectorTest(q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT "+connectorTestColumns+" FROM sso_connector_sign_in_tests WHERE tenant_id=$1 AND id=$2", tenant, f.row.ID)))
+		out = row.ConnectorSignInTestResult
+		return err
+	})
+	if err != nil {
+		return ConnectorSignInTestResult{}, err
+	}
+	return out, nil
+}
+
+// Complete consumes a test's proof once before provider I/O. It returns a
+// minimized provider identity and never calls account binding or session issuance.
+func (t *ConnectorSignInTests) Complete(ctx context.Context, a identity.Auth, connector, state, browser, code string, denied bool, requestID string) (ConnectorSignInTestResult, error) {
+	if err := t.ready(a); err != nil {
+		return ConnectorSignInTestResult{}, err
+	}
+	if ctx == nil || !canonicalID(connector) || !canonicalID(requestID) || !security.ValidToken(state) || !security.ValidToken(browser) || denied && code != "" || !denied && !safeOpaque(code, maximumAuthorizationCodeBytes) {
+		return ConnectorSignInTestResult{}, fail("SSO_FLOW_INVALID")
+	}
+	if !t.service.enabled {
+		return ConnectorSignInTestResult{}, fail("SSO_DISABLED")
+	}
+	if err := t.service.Identity.RequireBusinessIntegrity(ctx); err != nil {
+		return ConnectorSignInTestResult{}, err
+	}
+	f, err := t.claim(ctx, a, connector, state, browser, requestID)
+	if err != nil {
+		return ConnectorSignInTestResult{ID: f.row.ID}, err
+	}
+	var out ConnectorSignInTestResult
+	if denied {
+		err = fail("SSO_PROVIDER_DENIED")
+	} else {
+		var p *giteaProvider
+		p, err = t.provider(connector, f.connector.Origin)
+		if err == nil {
+			callback, _ := t.callback(connector)
+			var subject providerIdentity
+			subject, err = p.exchange(ctx, f.connector.ClientID, f.secret, callback, code, f.verifier)
+			f.secret, f.verifier = "", ""
+			if err == nil {
+				out, err = t.finish(ctx, a, f, subject, requestID)
+			}
+		}
+	}
+	f.secret, f.verifier = "", ""
+	if err == nil {
+		return out, nil
+	}
+	if outcome, found := transaction.CommitOutcome(err); found && outcome != transaction.CommitRolledBack {
+		return ConnectorSignInTestResult{}, fail(string(outcome))
+	}
+	err = publicFlowError(err)
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), config.Seconds(t.service.policy.CleanupTimeoutSeconds))
+	defer cancel()
+	store, storageErr := t.service.catalogRepository()
+	if storageErr != nil {
+		return ConnectorSignInTestResult{}, storageErr
+	}
+	cleanupErr := store.Within(cleanup, false, func(ctx context.Context, q transaction.Executor) error {
+		var id string
+		if e := q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT id::text FROM sso_connectors WHERE tenant_id=$1 AND id=$2 FOR SHARE", f.row.tenant, f.row.ConnectorID)).Scan(&id); e != nil {
+			return e
+		}
+		tenant, e := connectorTenant(ctx, q, connectorReadFence)
+		if e != nil {
+			return e
+		}
+		if tenant != f.row.tenant {
+			return fail("SSO_FLOW_UNUSABLE")
+		}
+		return t.failWithin(ctx, q, f.row, err.Error(), requestID)
+	})
+	if cleanupErr != nil {
+		return ConnectorSignInTestResult{}, sourceOutcome(cleanupErr)
+	}
+	return ConnectorSignInTestResult{ID: f.row.ID}, err
+}
