+			p, err := source(ctx, tx, subject)
+			if calls.Add(1) == 4 {
+				p.UserAccess = BudgetAccessDisabled
+			}
+			return p, err
+		}
+		runID := g.start(t)
+		id := uuid.NewString()
+		result, err := g.runs[0].RunCommand(g.ctx, g.actors[1], runID, id, `find application "Protected application"`, "")
