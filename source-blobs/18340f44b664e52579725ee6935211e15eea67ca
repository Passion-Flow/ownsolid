+	worked, err := service.ProcessNext(ctx)
+	if err != nil || !worked {
+		t.Fatal("run the real source draft inspection", err)
+	}
+	draftPath := path + "/drafts/" + draftID
+	draft = portal.Call("GET", draftPath, nil, 200, "DatasetDraftResponse")
