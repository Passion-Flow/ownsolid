+	if err = f.db.QueryRow(f.ctx, "SELECT count(*) FROM dataset_draft_import_candidates WHERE draft_id=$1", f.draft).Scan(&count); err != nil || count != 1 {
+		t.Fatal("rollback lost the concurrent committed receipt", err)
+	}
