      ready=true
      break
    fi
    echo "RESOURCE_FLOOR_PENDING disk_mib=$disk memfree_mib=$memory"
  else
    echo SHARED_HEAVY_LOCK_PENDING
  fi
  flock -u 7
  flock -u 9
  flock -u 8
  sleep 30
done
test "$ready" = true || exit 75
df -h /
free -m
ss -lntp
test "$(git rev-parse HEAD)" = "$expected"
test -z "$(git status --porcelain)"
