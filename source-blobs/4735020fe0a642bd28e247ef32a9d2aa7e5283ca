#!/bin/bash
# Bounded, read-only inspection of shared resources. Persist observations in the ARC runner.
set -euo pipefail
umask 077
runner=/root/lane-arc105-launch.XuP5zk
cd "$runner"
exec 9>"$runner/resource-audit.lock"
flock -n 9 || exit 75
evidence=$(mktemp -d "$runner/resource-attribution.XXXXXX")
printf '%s\n' "$evidence"
test ! -s prelaunch.json || cp -p prelaunch.json "$evidence/prior-prelaunch.json"
set +e
python3 admit.py host --root "$runner" > "$evidence/host-before.json"
before=$?
set -e
printf '%s\n' "$before" > "$evidence/host-before.exit"
{
  date -u --iso-8601=seconds
  cat /proc/meminfo /proc/pressure/memory /proc/pressure/io /proc/pressure/cpu
  findmnt -T "$runner" -n -o TARGET,SOURCE,FSTYPE
  findmnt -rn -t tmpfs,ramfs -o TARGET | while read -r path; do
    df -B1 --output=used,avail,target "$path" | tail -1
  done
  for group in system.slice user.slice system.slice/docker.service; do
    p="/sys/fs/cgroup/$group"
    printf '\n%s current=%s swap=%s high=%s max=%s\n' "$group" "$(cat "$p/memory.current")" "$(cat "$p/memory.swap.current")" "$(cat "$p/memory.high")" "$(cat "$p/memory.max")"
    awk '$1 ~ /^(anon|file|shmem|kernel|slab_reclaimable|slab_unreclaimable|inactive_file|active_file)$/ {print}' "$p/memory.stat"
    cat "$p/memory.events"
  done
  docker info --format 'docker root={{.DockerRootDir}} driver={{.Driver}} cgroup_driver={{.CgroupDriver}} cgroup_version={{.CgroupVersion}}'
  docker ps --format '{{.Names}} {{.ID}}'
  for tag in ownsolid-proto/lane-a-node:24.04 docker:29.1.3-dind; do
    docker image inspect -f '{{.Id}} tags={{json .RepoTags}} layers={{len .RootFS.Layers}}' "$tag"
    docker ps -a --filter "ancestor=$tag" --format '{{.Names}} {{.Status}}'
  done
  echo "ARC loop devices"
  losetup -l --noheadings --output NAME,BACK-FILE | awk '/lane-arc|arc105-managed-/'
  echo "Load or install process names"
  ps -eo pid,ppid,comm,pcpu,rss --sort=-pcpu | awk '$3 ~ /^(e2e\.test|install\.test|ownsolid-install|rke2|dockerd|containerd|unshare|release-factory|syft|rsync|fio|go|kwok|simulator|pgbench|buildkitd)$/ {print}'
  vmstat 1 4
} > "$evidence/host-attribution.txt"
python3 - <<'PY' > "$evidence/arc-inodes-and-namespaces.json"
import ctypes as c
import json
import os
from pathlib import Path
import stat

page=os.sysconf("SC_PAGE_SIZE")
libc=c.CDLL(None,use_errno=True)
libc.mmap.argtypes=[c.c_void_p,c.c_size_t,c.c_int,c.c_int,c.c_int,c.c_long]
libc.mmap.restype=c.c_void_p
libc.mincore.argtypes=[c.c_void_p,c.c_size_t,c.c_void_p]
libc.munmap.argtypes=[c.c_void_p,c.c_size_t]
def resident(path,length):
    # A no-access mapping and mincore query the cache without faulting file pages in.
    with path.open("rb") as f:
        start=libc.mmap(None,length,0,1,f.fileno(),0)
        if start==c.c_void_p(-1).value:
            raise OSError(c.get_errno(),"mmap",path)
        try:
            vector=(c.c_ubyte*((length+page-1)//page))()
            if libc.mincore(start,length,vector):
                raise OSError(c.get_errno(),"mincore",path)
            return page*sum(p&1 for p in vector)
        finally:
            libc.munmap(start,length)

roots=[
    Path("/root/lane-arc-felix-final.v1xoN1"),
    Path("/root/lane-arc-felix.e7LhQM"),
    Path("/root/lane-arc-kwok.0DKaGD"),
    Path("/root/lane-arc-managed.JFUrp5"),
    Path("/root/lane-arc105-launch.XuP5zk"),
]
entries={}
for root in roots:
    device=root.stat().st_dev
    for directory,subdirs,files in os.walk(root):
        subdirs[:]=[d for d in subdirs if not d.startswith(("resource-attribution.","run."))
                    and (Path(directory)/d).lstat().st_dev==device]
        for name in files:
            path=Path(directory)/name
            st=path.lstat()
            if st.st_dev!=device or not stat.S_ISREG(st.st_mode) or not st.st_size:
                continue
            key=f"{st.st_dev}:{st.st_ino}"
            if key not in entries:
                entries[key]={"logical_bytes":st.st_size,"disk_bytes":512*st.st_blocks,
                              "cached_bytes":resident(path,st.st_size),"paths":[]}
            entries[key]["paths"].append(str(path))

namespaces=set()
mounts=[]
handles=[]
observation_handles=[]
observation=("/root/lane-arc105-launch.XuP5zk",)
needles=("lane-arc","arc105-managed-")
for pid in Path("/proc").glob("[0-9]*"):
    try:
        comm=(pid/"comm").read_text().strip()
        ns=(pid/"ns/mnt").readlink()
        if ns not in namespaces:
            info=(pid/"mountinfo").read_text().splitlines()
            namespaces.add(ns)
            for line in info:
                parts=line.split()
                if any(n in f for n in needles for f in parts):
                    mounts.append({"namespace":str(ns),"pid":pid.name,"dev":parts[2],
                                   "root":parts[3],"target":parts[4],"fstype":parts[parts.index("-")+1]})
        refs=[]
        for fd in [pid/"cwd",pid/"root",pid/"exe",*(pid/"fd").iterdir()]:
            try:
                path=os.readlink(fd)
                if any(n in path for n in needles):
                    refs.append(path)
            except (FileNotFoundError,PermissionError,ProcessLookupError):
                continue
        if refs:
            record={"pid":pid.name,"comm":comm,"cgroup":(pid/"cgroup").read_text().strip(),"paths":refs}
            if any(not r.startswith(observation) or "/run." in r for r in refs):
                handles.append(record)
            else:
                observation_handles.append(record)
    except (FileNotFoundError,PermissionError,ProcessLookupError):
        continue

print(json.dumps({
    "scan_roots":[str(p) for p in roots],
    "total_unique_file_disk_bytes":sum(e["disk_bytes"] for e in entries.values()),
    "total_unique_file_cached_bytes":sum(e["cached_bytes"] for e in entries.values()),
    "distinct_mount_namespaces":len(namespaces),"arc_mounts":mounts,"arc_fixture_handles":handles,
    "arc_runner_handles":observation_handles,
    "files":entries,
},indent=2,sort_keys=True))
PY
find /root/lane-arc-managed.JFUrp5/capture -maxdepth 1 -type f \( -name '*egress.jsonl' -o -name 'site-dns*.jsonl' \) -print0 |
    sort -z | xargs -0r sha256sum > "$evidence/prior-raw-captures.sha256"
set +e
bash launch.sh --check > "$evidence/host-after.json" 2> "$evidence/host-after.stderr"
after=$?
set -e
printf '%s\n' "$after" > "$evidence/host-after.exit"
find "$runner" -maxdepth 1 -type d -name 'run.*' > "$evidence/arc-run-dirs.txt"
docker ps -a --filter name=arc105-managed- --format '{{.Names}} {{.Status}}' > "$evidence/arc-containers.txt"
(cd "$evidence" && sha256sum -- *.json *.txt *.exit *.stderr *.sha256 > SHA256SUMS)
python3 - "$evidence" <<'PY'
import json,sys
from pathlib import Path
root=Path(sys.argv[1])
for phase in ("before","after"):
    stem=root/f"host-{phase}"
    status=stem.with_suffix(".exit").read_text().strip()
    raw=stem.with_suffix(".json").read_text()
    print(phase,"status",status,raw.strip())
a=json.loads((root/"arc-inodes-and-namespaces.json").read_text())
print({k:v for k,v in a.items() if k!="files"})
for e in a["files"].values():
    if len(e["paths"])>1 or e["cached_bytes"]>5<<20:
        print(e)
PY
