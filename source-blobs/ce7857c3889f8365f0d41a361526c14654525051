import ast
import datetime as dt
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError
from urllib.parse import urlencode
from urllib.request import ProxyHandler, Request, build_opener

if not __debug__:
    raise SystemExit("Run assertions without Python optimization")
binary = Path(sys.argv[1])
if not binary.is_absolute() or not binary.is_file() or not os.access(binary, os.X_OK):
    raise SystemExit("Require the verified native executable")
interfaces = subprocess.check_output(["ip", "-o", "link", "show"], text=True).splitlines()
assert len(interfaces) == 1 and ": lo:" in interfaces[0]
for family in ("-4", "-6"):
    assert not subprocess.check_output(["ip", family, "route", "show", "default"]).strip()
helpers = ast.parse(Path("/root/lane-obs-tools/obs110-node-scan-refined.py").read_text())
helper_nodes = [n for n in helpers.body if isinstance(n, ast.FunctionDef) and n.name in {"start_store", "wait_store", "stop_store"}]
assert len(helper_nodes) == 3
exec(compile(ast.Module(body=helper_nodes, type_ignores=[]), "<qualified native lifecycle>", "exec"))
client = build_opener(ProxyHandler({}))
stamp = int(time.time()) - 20
day = dt.datetime.fromtimestamp(stamp, dt.timezone.utc).date().isoformat()
first = "11111111-1111-4111-8111-111111111111"
second = "22222222-2222-4222-8222-222222222222"
name = "card_\u6d4b\u8bd5_\"\\escaped"
def sample(metric, node=None, tenant="tenant-a"):
    labels = {"__name__":metric, "tenant_id":tenant, "workspace_id":"work-a"}
    if node:
        labels["node_id"] = node
    return {"metric":labels,"values":[1],"timestamps":[stamp*1000]}
rows = [sample("scope_cpu",first), sample("scope_cpu",second),
    sample("scope_app"), sample(name,first), sample(name,second,"tenant-b")]
data = b"".join(json.dumps(row, ensure_ascii=True).encode()+b"\n" for row in rows)
with tempfile.TemporaryDirectory(prefix="ownsolid-cardinality-shape-") as work, open(work+"/service.log","w+") as log:
    addr, service = start_store(binary,work,log,100,10)
    base = "http://"+addr
    def request(path, query=(), payload=None):
        with client.open(Request(base+path+"?"+urlencode(query),data=payload,
                headers={"Content-Type":"application/json"}),timeout=6) as response:
            body = response.read(32769)
            assert len(body) <= 32768
            return body
    def stats(metric=None, ascii_names=True):
        query = [("date",day),("topN","10"),("focusLabel","node_id"),
            ("extra_label","tenant_id=tenant-a"),("extra_label","workspace_id=work-a"),("timeout","2s")]
        if metric is not None:
            query.append(("match[]",'{__name__='+json.dumps(metric,ensure_ascii=ascii_names)+'}'))
        reply=json.loads(request("/api/v1/status/tsdb",query))
        assert reply["status"]=="success"
        return reply["data"]
    try:
        wait_store(service,request)
        request("/api/v1/import",payload=data)
        request("/internal/force_flush")
        for _ in range(30):
            overall=stats()
            if overall.get("totalSeries")==4:
                break
            time.sleep(0.1)
        assert overall["totalSeries"]==4, overall
        app=stats("scope_app")
        assert app["totalSeries"]==1, app
        exact=stats(name)
        assert exact["totalSeries"]==1, exact
        assert exact["seriesCountByMetricName"][0]["name"]==name, exact
        exact_raw=stats(name,False)
        assert exact_raw["totalSeries"]==1, exact_raw
        assert exact_raw["seriesCountByMetricName"][0]["name"]==name, exact_raw
        missing=stats("does_not_exist")
        assert missing["totalSeries"]==0, missing
        print(json.dumps({"address":addr,"overall":overall,"withoutNode":app,
            "exactEscapedUnicode":exact,"exactRawUnicode":exact_raw,"missingMetric":missing},ensure_ascii=True))
    except Exception:
        log.seek(0)
        print(log.read()[-3200:])
        raise
    finally:
        stop_store(service)
