CREATE TABLE knowledge_attempts (
 id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY,
 tenant_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workspace_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 base_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 document_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 source_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 generation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 kind VARCHAR(8) NOT NULL CHECK(kind IN('ingest','rebuild')),
 attempt_number INTEGER NOT NULL CHECK(attempt_number BETWEEN 1 AND 10),
 expected_document_revision BIGINT NOT NULL CHECK(expected_document_revision BETWEEN 1 AND 9007199254740991),
 requested_by CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 requested_audience VARCHAR(8) NOT NULL CHECK(requested_audience IN('portal','admin')),
 requested_epoch BIGINT NOT NULL CHECK(requested_epoch>=0),
 membership_authority CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
 state VARCHAR(12) NOT NULL CHECK(state IN('pending','running','ready','failed','cancelled')),
 lease_hash VARBINARY(32) CHECK(lease_hash IS NULL OR OCTET_LENGTH(lease_hash)=32),
 lease_expires_at DATETIME(6),
 chunk_count INTEGER NOT NULL DEFAULT 0 CHECK(chunk_count BETWEEN 0 AND 4096),
 error_code VARCHAR(80) CHARACTER SET ascii COLLATE ascii_bin CHECK(error_code IS NULL OR REGEXP_LIKE(error_code,'^[A-Z][A-Z0-9_]{1,79}$','c')),
 created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
 started_at DATETIME(6),
 finished_at DATETIME(6),
 ready_source_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin GENERATED ALWAYS AS(CASE WHEN state='ready' THEN source_id ELSE NULL END) STORED,
 live_source_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin GENERATED ALWAYS AS(CASE WHEN state IN('pending','running') THEN source_id ELSE NULL END) STORED,
 UNIQUE(tenant_id,workspace_id,base_id,document_id,generation_id,source_id,id),
 UNIQUE(tenant_id,workspace_id,base_id,document_id,id),
 UNIQUE(generation_id,document_id,source_id,attempt_number),
 UNIQUE KEY knowledge_one_ready_attempt_idx(generation_id,document_id,ready_source_id),
 UNIQUE KEY knowledge_one_live_attempt_idx(generation_id,document_id,live_source_id),
 KEY knowledge_pending_attempt_idx(state,created_at,id),
 FOREIGN KEY(requested_by) REFERENCES users(id),
 FOREIGN KEY(tenant_id,workspace_id,base_id,document_id,source_id) REFERENCES knowledge_source_versions(tenant_id,workspace_id,base_id,document_id,id),
 FOREIGN KEY(tenant_id,workspace_id,base_id,generation_id) REFERENCES knowledge_generations(tenant_id,workspace_id,base_id,id),
 CHECK(requested_audience='admin' OR membership_authority IS NOT NULL),
 CHECK((state='running' AND lease_hash IS NOT NULL AND lease_expires_at IS NOT NULL) OR (state<>'running' AND lease_hash IS NULL AND lease_expires_at IS NULL)),
 CHECK((state IN('failed','cancelled') AND error_code IS NOT NULL) OR (state NOT IN('failed','cancelled') AND error_code IS NULL)),
 CHECK((state IN('ready','failed','cancelled') AND finished_at IS NOT NULL) OR (state IN('pending','running') AND finished_at IS NULL)),
 CONSTRAINT knowledge_attempts_id_canonical CHECK(REGEXP_LIKE(id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_tenant_id_canonical CHECK(REGEXP_LIKE(tenant_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_workspace_id_canonical CHECK(REGEXP_LIKE(workspace_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_base_id_canonical CHECK(REGEXP_LIKE(base_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_document_id_canonical CHECK(REGEXP_LIKE(document_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_source_id_canonical CHECK(REGEXP_LIKE(source_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_generation_id_canonical CHECK(REGEXP_LIKE(generation_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_requested_by_canonical CHECK(REGEXP_LIKE(requested_by,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
 CONSTRAINT knowledge_attempts_membership_authority_canonical CHECK(membership_authority IS NULL OR REGEXP_LIKE(membership_authority,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin;
