"""Refresh only the synthetic raw window before the sole driver is released."""
import datetime as dt
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import ssl
import sys
import time
import urllib.parse
import urllib.request

root = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("seed", root / "seed-installed-history.py")
seed_helpers = importlib.util.module_from_spec(spec)
spec.loader.exec_module(seed_helpers)
evidence = root / "runtime-evidence"
seed = seed_helpers.load(evidence / "history-seed.json")
scope = seed_helpers.load(evidence / "scope-state.json")
assert seed["source_sha"] == seed_helpers.SOURCE
assert seed["tenant_id"] == scope["primary_tenant"]
assert seed["workspace_id"] == scope["primary_workspace"]
route = seed_helpers.command("ip", "route", "show", "default").strip()
assert "dev egress0" in route and " via " not in route
refresh = evidence / "history-raw-refresh.json"
if refresh.exists():
    state = seed_helpers.load(refresh)
else:
    now = int(time.time()) // 60 * 60
    state = {"source_sha": seed_helpers.SOURCE, "workspace_id": seed["workspace_id"],
             "from": now - 600, "to": now - 120, "status": "prepared"}
    seed_helpers.save(refresh, state)
assert state["source_sha"] == seed_helpers.SOURCE
assert state["workspace_id"] == seed["workspace_id"]
policy = seed_helpers.load(evidence / "history-inputs/monitoring.json")["fleet_history"]
context = ssl.create_default_context(cafile=str(evidence / "history-inputs/raw-ca.pem"))
context.minimum_version = ssl.TLSVersion.TLSv1_2
client = urllib.request.build_opener(urllib.request.ProxyHandler({}), urllib.request.HTTPSHandler(context=context))


def request(path, data=None):
    req = urllib.request.Request(policy["raw_origin"] + path, data=data,
                                 headers={"Content-Type": "text/plain"} if data else {})
    with client.open(req, timeout=15) as reply:
        assert reply.status == 200 or reply.status == 204
        return reply.read(2 << 20)


labels = {key: seed[key] for key in ["tenant_id", "workspace_id", "site_id", "cell_id"]}
lines = []
for at in range(state["from"] - 60, state["to"] + 1, 15):
    if state["from"] + 180 <= at < state["from"] + 420:
        continue
    for node in seed["nodes"]:
        values = {"job": "ownsolid-node", **labels, "node_id": node}
        encoded = ",".join(key + "=" + json.dumps(value) for key, value in values.items())
        lines.append("up{" + encoded + "} 0 " + str(at * 1000))
payload = ("\n".join(lines) + "\n").encode()
request("/api/v1/import/prometheus", payload)
request("/internal/resetRollupResultCache")
selector = ",".join(key + "=" + json.dumps(value) for key, value in labels.items())
source = 'last_over_time(up{job="ownsolid-node",' + selector + '}[45s])'
grouping = " by (tenant_id, workspace_id, site_id, cell_id) "
expr = 'label_set(count' + grouping + '(' + source + '),"measure","observed") or label_set(sum' + grouping + '(' + source + ' == bool 1),"measure","reachable")'
query = urllib.parse.urlencode({"query": expr, "start": state["from"], "end": state["to"],
                               "step": 15, "latency_offset": "1ms", "deny_partial_response": 1, "nocache": 1})
deadline = time.monotonic() + 20
while True:
    result = json.loads(request("/api/v1/query_range?" + query))
    series = result.get("data", {}).get("result", [])
    measured = {row["metric"].get("measure"): row for row in series}
    if set(measured) == {"observed", "reachable"}:
        for measure, expected in [("observed", 2), ("reachable", 0)]:
            row = measured[measure]
            assert all(row["metric"].get(key) == value for key, value in labels.items())
            assert row["values"] and all(float(value) == expected for _, value in row["values"])
        observed_times = [at for at, _ in measured["observed"]["values"]]
        assert observed_times == [at for at, _ in measured["reachable"]["values"]]
        assert 0 < len(observed_times) < (state["to"] - state["from"]) // 15 + 1
        break
    assert time.monotonic() < deadline, "New raw samples did not become visible"
    time.sleep(0.2)
state.update(status="native_raw_verified", samples=len(lines), observed=2, reachable=0,
             measured_points=len(observed_times), sparse=True,
             payload_sha256=hashlib.sha256(payload).hexdigest(),
             verified_at=dt.datetime.now(dt.timezone.utc).isoformat())
seed_helpers.save(refresh, state)
windows = seed_helpers.load(evidence / "history-windows.json")
for name in ["history-windows.json", "obs-history-input.json"]:
    path = evidence / name
    original = path.with_name(path.name + ".before-raw-refresh")
    if not original.exists():
        fd = os.open(original, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(path.read_bytes())
windows["raw"].update({"from": seed_helpers.utc(state["from"]), "to": seed_helpers.utc(state["to"])})
seed_helpers.save(evidence / "history-windows.json", windows)
config = seed_helpers.load(evidence / "obs-history-input.json")
config["raw_window"] = windows["raw"]
seed_helpers.save(evidence / "obs-history-input.json", config)
state["input_sha256"] = hashlib.sha256((evidence / "obs-history-input.json").read_bytes()).hexdigest()
seed_helpers.save(refresh, state)
proof = seed_helpers.load(evidence / "schema-table-set-proof.json")
assert proof["exact_non_partition_set_verified"] and proof["exact_partition_children_verified"]
assert proof["exact_migration_ledger_verified"] and proof["schema_version"] == 58
ready = seed_helpers.load(evidence / "installed-ready.json")
assert ready["candidate"] == seed_helpers.SOURCE
ready.update({"status": "INPUTS_PREPARED_AWAIT_COORDINATOR_GO", "database": proof,
              "scope_prepared": True, "primary_workspace_id": seed["workspace_id"],
              "scope_projection_boundary": "Published empty workflow projections; not runnable workflow proof",
              "history_windows": windows, "driver_input_file": "/evidence/obs-history-input.json",
              "driver_input_sha256": state["input_sha256"],
              "source_provenance_file": "/evidence/installed-provenance.json",
              "client_replacement_status": "Awaiting independently checked static ELF",
              "counter_boundary": "Native seed verification completed before sole driver baseline; no further range probes"})
seed_helpers.save(evidence / "acceptance-ready.json", ready)
print(json.dumps({"event": "RAW_WINDOW_REFRESH_VERIFIED", **state, "raw_window": windows["raw"]}))
