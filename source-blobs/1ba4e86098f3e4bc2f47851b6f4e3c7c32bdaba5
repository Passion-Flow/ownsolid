set -euo pipefail
cd /root/lane-rel-history
source /root/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1 CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true
exec 8>/run/lock/ownsolid-heavy.lock
flock -w 45 8 || exit 75
exec 9>/root/lane-sci-tools/heavy-test.lock
flock -n 9 || exit 75
exec 7>/root/lane-rel-tools/heavy-test.lock
flock -n 7 || exit 75
df -h /
free -m
test "$(df -Pm / | awk 'NR==2 {print $4}')" -ge 15360
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
before=$(sha256sum web/packages/help/locales/zh-cn/api-descriptions.json)
unshare -m -n bash -ec '
mount --make-rprivate /
ip link set lo up
test "$(ip -o link show | wc -l)" -eq 1
test -z "$(ip route show default)"
test -z "$(ip -6 route show default)"
mount --bind /root/lane-rel-tools/gw104-contract.qgEXzK0n/translations/web/packages/help/locales/zh-cn/api-descriptions.json web/packages/help/locales/zh-cn/api-descriptions.json
mount -o remount,bind,ro web/packages/help/locales/zh-cn/api-descriptions.json
make generate
pnpm --dir web generate:check
pnpm --dir web --filter @ownsolid/help test
'
test "$(sha256sum web/packages/help/locales/zh-cn/api-descriptions.json)" = "$before"
echo PRIVATE_TRANSLATION_PROJECTION_PASSED
