 "schemas": {
  "GrantPlugin": {
   "type": "object",
   "required": [
    "plugin_version_id",
    "reason"
   ],
   "properties": {
    "plugin_version_id": {
     "type": "string",
     "format": "uuid"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "ImportPlugin": {
   "type": "object",
   "required": [
    "capsule",
    "sha256",
    "reason"
   ],
   "properties": {
    "capsule": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1398104
    },
    "sha256": {
     "type": "string"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "PluginConfiguration": {
   "type": "object",
   "required": [
    "enabled",
    "can_manage",
    "trusted_key_ids",
    "abi",
    "executor",
    "limits"
   ],
   "properties": {
    "enabled": {
     "type": "boolean"
    },
    "can_manage": {
     "type": "boolean"
    },
    "trusted_key_ids": {
     "type": "array",
     "maxItems": 32,
     "items": {
      "type": "string"
     }
    },
    "abi": {
     "type": "string",
     "const": "projectone.tools.v1"
    },
    "executor": {
     "type": "string",
     "const": "model-directory-v1"
    },
    "limits": {
     "type": "object",
     "required": [
      "capsule_bytes",
      "manifest_bytes",
      "result_bytes",
      "maximum_models",
      "maximum_versions",
      "maximum_grants",
      "maximum_references"
     ],
     "properties": {
      "capsule_bytes": {
       "type": "integer",
       "minimum": 2048,
       "maximum": 1048576
      },
      "manifest_bytes": {
       "type": "integer",
       "minimum": 512,
       "maximum": 16384
      },
      "result_bytes": {
       "type": "integer",
       "minimum": 1024,
       "maximum": 1048576
      },
      "maximum_models": {
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      },
      "maximum_versions": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000
      },
      "maximum_grants": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10000
      },
      "maximum_references": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10000
      }
     }
    }
   }
  },
  "PluginConfigurationResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "PluginConfiguration"
    }
   }
  },
  "PluginGrant": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "plugin_version_id",
    "enabled",
    "revision",
    "granted_by",
    "created_at",
    "updated_at",
    "version"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "plugin_version_id": {
     "type": "string",
     "format": "uuid"
    },
    "enabled": {
     "type": "boolean"
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "granted_by": {
     "type": "string",
     "format": "uuid"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    },
    "version": {
     "$ref": "PluginVersion"
    }
   }
  },
  "PluginGrantPage": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "PluginGrant"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "PluginGrantPageResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
