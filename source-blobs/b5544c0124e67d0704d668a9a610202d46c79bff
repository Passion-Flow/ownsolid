   "type": "object",
   "required": [
    "kind",
    "workspace_id",
    "workflow_id",
    "entity_id",
    "graph_sha256"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "draft",
      "publication",
      "conversation",
      "active_run"
     ]
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "workflow_id": {
     "type": "string",
     "format": "uuid"
    },
    "entity_id": {
     "type": "string",
     "format": "uuid"
    },
    "graph_sha256": {
     "type": "string"
    }
   }
  },
  "PluginReferences": {
   "type": "object",
   "required": [
    "items",
    "sha256",
    "count"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 10000,
     "items": {
      "$ref": "PluginReference"
     }
    },
    "sha256": {
     "type": "string"
    },
    "count": {
     "type": "integer",
     "minimum": 0,
     "maximum": 10000
