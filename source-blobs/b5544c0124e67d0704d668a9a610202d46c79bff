  "PluginVersion": {
   "type": "object",
   "required": [
    "id",
    "plugin_id",
    "version",
    "abi",
    "executor",
    "capabilities",
    "license",
    "capsule_sha256",
    "manifest_sha256",
    "key_id",
    "state",
    "revision",
    "trusted",
    "available",
    "unavailable_code",
    "imported_by",
    "created_at",
    "installed_at",
    "uninstalled_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "plugin_id": {
     "type": "string",
     "const": "projectone.model-directory"
    },
    "version": {
     "type": "string"
    },
    "abi": {
     "type": "string",
     "const": "projectone.tools.v1"
    },
    "executor": {
     "type": "string",
     "const": "model-directory-v1"
    },
    "capabilities": {
     "type": "array",
     "maxItems": 1,
     "items": {
      "type": "string",
      "const": "models.list"
     }
    },
    "license": {
     "type": "string",
     "minLength": 0,
     "maxLength": 100
    },
    "capsule_sha256": {
     "type": "string"
    },
    "manifest_sha256": {
     "type": "string"
    },
    "key_id": {
     "type": "string"
    },
    "state": {
     "type": "string",
     "enum": [
      "imported",
      "installed",
      "uninstalled"
     ]
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "trusted": {
     "type": "boolean"
    },
    "available": {
     "type": "boolean"
    },
    "unavailable_code": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 100
      },
      {
       "type": "null"
      }
     ]
    },
    "imported_by": {
     "type": "string",
     "format": "uuid"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "installed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "uninstalled_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "PluginVersionPage": {
