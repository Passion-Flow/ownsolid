#!/bin/bash
set -euo pipefail
run=$1
trap 'echo "overall-stage-exit=$?"' EXIT
cd /root/lane-gw
test "$(git rev-parse HEAD)" = "$(cat "$run/commit")"
bash "$run/make-gate.sh" "$run" > "$run/make.log" 2>&1
alias_run=$(cat /root/lane-gw-acceptance/current-gw104)
bash "$alias_run/rust.sh" green > "$run/rust.log" 2>&1
bash /root/lane-gw-acceptance/gw107.ri6nhx80/run-pg.sh "$run" final-native '^(TestRealGoRustPostgresApplicationBudget|TestRealGoRustPostgresForegroundResponses|TestRealGoRustPostgresForegroundMessages)$' > "$run/native.log" 2>&1
test "$(git rev-parse HEAD)" = "$(cat "$run/commit")"
test -z "$(git status --porcelain)"
echo "verified-commit=$(git rev-parse HEAD)"
