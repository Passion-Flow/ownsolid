 "schemas": {
  "AddWorkers": {
   "type": "object",
   "required": [
    "worker_node_ids",
    "reason"
   ],
   "properties": {
    "worker_node_ids": {
     "type": "array",
     "maxItems": 1000,
     "items": {
      "type": "string",
      "format": "uuid"
     }
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "Cluster": {
   "type": "object",
   "description": "A cell's Kubernetes cluster. Its state follows from its members: failed when the server failed, installing while any member waits or joins, ready when every member is, degraded otherwise.",
   "required": [
    "id",
    "site_id",
    "cell_id",
    "name",
    "distribution_version",
    "state",
    "server_node_id",
    "server_state",
    "ca_sha256",
    "members",
    "created_by",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "site_id": {
     "type": "string"
    },
    "cell_id": {
     "type": "string"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "distribution_version": {
     "type": "string",
     "description": "The RKE2 release the cluster runs."
    },
    "state": {
     "type": "string",
     "enum": [
      "installing",
      "ready",
      "degraded",
      "failed"
     ]
    },
    "server_node_id": {
     "type": "string",
     "format": "uuid"
    },
    "server_state": {
     "type": "string",
     "enum": [
      "pending",
      "joining",
      "ready",
      "not_ready",
      "failed"
     ]
    },
    "ca_sha256": {
     "anyOf": [
      {
       "type": "string",
       "description": "The SHA-256 of the server CA, which join tokens pin."
      },
      {
       "type": "null"
      }
     ]
    },
    "members": {
     "$ref": "MemberCounts"
    },
    "created_by": {
     "type": "string",
     "format": "uuid"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "ClusterList": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 1,
     "items": {
      "$ref": "Cluster"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "ClusterListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "ClusterList"
    }
   }
  },
  "ClusterResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "Cluster"
    }
   }
  },
  "CreateCluster": {
   "type": "object",
   "required": [
    "name",
    "server_node_id",
    "worker_node_ids",
    "reason"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "server_node_id": {
     "type": "string",
     "format": "uuid"
    },
    "worker_node_ids": {
     "type": "array",
     "maxItems": 1000,
     "items": {
      "type": "string",
      "format": "uuid"
     }
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "Member": {
   "type": "object",
   "required": [
    "node_id",
    "node_name",
    "workspace_id",
    "role",
    "node_address",
    "state",
    "error_code",
    "task_id",
    "join_attempts",
    "observed_at",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "node_id": {
     "type": "string",
     "format": "uuid"
    },
    "node_name": {
     "type": "string"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "role": {
     "type": "string",
     "enum": [
      "server",
      "worker"
     ]
    },
    "node_address": {
     "type": "string",
     "description": "The address the node advertises in the cluster: the one its agent enrolled from."
    },
    "state": {
     "type": "string",
     "enum": [
      "pending",
      "joining",
      "ready",
      "not_ready",
      "failed"
     ]
    },
    "error_code": {
     "anyOf": [
      {
       "type": "string",
       "description": "Why the member failed: a KUBERNETES_* code its agent reported, a task code such as TASK_DEADLINE_EXCEEDED, or NODE_UNAVAILABLE.",
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "task_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "join_attempts": {
     "type": "integer",
     "minimum": 0
    },
    "observed_at": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "MemberCounts": {
   "type": "object",
   "required": [
    "pending",
    "joining",
    "ready",
    "not_ready",
    "failed"
   ],
   "properties": {
    "pending": {
     "type": "integer",
     "minimum": 0
    },
    "joining": {
     "type": "integer",
     "minimum": 0
    },
    "ready": {
     "type": "integer",
     "minimum": 0
    },
    "not_ready": {
     "type": "integer",
     "minimum": 0
    },
    "failed": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "MemberList": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "Member"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "MemberListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "MemberList"
    }
   }
  },
  "MemberResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "Member"
    }
   }
  },
  "Reason": {
   "type": "object",
   "required": [
    "reason"
   ],
   "properties": {
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  }
 }
}
