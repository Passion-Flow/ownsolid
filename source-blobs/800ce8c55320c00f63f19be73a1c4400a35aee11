+		var calls atomic.Int64
+		g.gates[0].commands.executionPolicy = func(ctx context.Context) (bool, error) {
+			if calls.Add(1) == 4 {
+				close(entered)
+				select {
+				case <-release:
+				case <-ctx.Done():
+					return false, ctx.Err()
+				}
+			}
+			return true, nil
+		}
