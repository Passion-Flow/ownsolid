+
+	changed := bytes.Clone(raw)
+	changed[len(changed)-3] ^= 1
+	if err = os.WriteFile(originalPath, changed, 0600); err != nil {
+		t.Fatal(err)
+	}
+	corrupt := portal.Call("POST", upload, raw, 409, "Problem")
