+		g.gates[0].policy = func(ctx context.Context, tx transaction.Executor, subject BudgetSubject) (ExecutionBudgetPolicy, error) {
+			p, err := source(ctx, tx, subject)
+			if calls.Add(1) == 4 {
+				p.UserAccess = BudgetAccessDisabled
+			}
+			return p, err
+		}
