+		}
+	}
+	out.status, out.headers = response.StatusCode, response.Header.Clone()
+	out.raw, err = io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
+	if err != nil || len(out.raw) > 1<<20 || json.Unmarshal(out.raw, &out.body) != nil {
