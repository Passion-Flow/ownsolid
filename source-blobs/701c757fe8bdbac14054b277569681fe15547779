from pathlib import Path
import re
import textwrap

root = Path("services/control/internal/modules/distribution")
current_file = root / "cutovers.go"
source = current_file.read_text()
start = source.index("\t\t// The Workspace lock serializes")
end = source.index("\t\tif _, e = tx.Exec", source.index("\t\tout.AppliedRevision = current.Revision + 1", start))
original = source[start:end]
plan_header = original[:original.index("\t\taction := ")]
nonpause = original[original.index("\t\t\tif current.DisabledAt == nil"):original.index("\t\t\t\t_, e = tx.Exec", original.index("\t\t\tif in.Action == \"resume\" {\n\t\t\t\tvar count"))]
pause_update = next(line.strip() for line in original.splitlines() if "SET disabled_at=clock_timestamp(),revision=revision+1" in line)
resume_update = next(line.strip() for line in original.splitlines() if "SET disabled_at=NULL,revision=revision+1" in line)
target_update = next(line.strip() for line in original.splitlines() if "SET deployment_id=$2,deployment_revision=$3,revision=revision+1" in line)
assert pause_update.startswith("if _, e = tx.Exec") and pause_update.endswith("; e != nil {")
pause_update = pause_update[3:-len("; e != nil {")]
assert target_update.count("target.ID") == target_update.count("target.Revision") == 2
target_update = target_update.replace("target.ID", "plan.After.DeploymentID").replace("target.Revision", "plan.After.DeploymentRevision")

def body(code, indent="\t"):
    code = re.sub(r"\breturn (e|fail\([^\n]+\))$", r"return CutoverPreview{}, \1", code, flags=re.MULTILINE)
    return textwrap.indent(textwrap.dedent(code), indent)

insert = """		plan, e := s.planCutover(ctx, tx, w, id, in)
		if e != nil {
			return e
		}
		action := map[string]string{"pause": "paused", "resume": "resumed", "retarget": "retargeted", "rollback": "rolled_back"}[in.Action]
		switch in.Action {
		case "pause":
			"""+pause_update+"""
		case "resume":
			"""+resume_update+"""
		default:
			"""+target_update+"""
		}
		if e != nil {
			return e
		}
		out.AppliedRevision = plan.After.Revision
"""
current_file.write_text((source[:start]+insert+source[end:]).replace('\n\t"reflect"', ""))
preview_file = root / "cutover_preview.go"
assert not preview_file.exists()
