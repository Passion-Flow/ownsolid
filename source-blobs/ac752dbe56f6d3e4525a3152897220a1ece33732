from pathlib import Path
import math,re
def parse_full_avg10(document):
    full=[line.split() for line in document.splitlines() if line.split() and line.split()[0]=='full']
    if len(full)!=1:raise ValueError('Exactly one full PSI row is required')
    fields=[token.split('=',1) for token in full[0][1:]]
