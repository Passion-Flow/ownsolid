    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?',values[0]):raise ValueError('Malformed full avg10')
    value=float(values[0])
    if not math.isfinite(value) or not 0<=value<=100:raise ValueError('Full avg10 must be finite within 0..100')
    return value
