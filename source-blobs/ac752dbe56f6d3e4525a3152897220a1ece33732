import os,stat,sys
def open_carrier(path, target, expected):
    try:
        os.fstat(target)
    except OSError:
        pass
    else:
        raise RuntimeError('Refuse an unexpected inherited target descriptor')
    fd=os.open(path,os.O_RDWR|os.O_NOFOLLOW|os.O_CLOEXEC)
    try:
        info=os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink!=1 or (info.st_dev,info.st_ino)!=expected:
            raise RuntimeError('Refuse a changed or nonregular lock carrier')
        if fd==target:os.set_inheritable(fd,True)
        else:os.dup2(fd,target,inheritable=True)
    finally:
        if fd!=target:os.close(fd)
for path,target,expected in [
    ('/run/lock/ownsolid-heavy.lock',8,(29,82)),
