'
export OWNSOLID_TEST_VICTORIA_METRICS=/root/lane-obs-tools/victoria-metrics-prod
export OWNSOLID_TEST_VMALERT=/root/lane-obs-tools/vmalert-prod
work=$(mktemp -d)
container=
cleanup() {
  if [ -n "$container" ]; then
    docker stop --time 10 "$container" >/dev/null
    docker rm "$container" >/dev/null
    echo STOPPED_OWN_HISTORY_CLI_POSTGRESQL
  fi
  rm -f -- "$work/dsn"
  rmdir -- "$work"
}
trap cleanup EXIT
container=$(docker run --detach --pull never --network none --memory 384m \
  --name "lane-rel-history-${work##*.}" --tmpfs /var/lib/postgresql:rw,nosuid,nodev,size=256m \
  -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_USER=fixture -e POSTGRES_DB=ownsolid_history_cli_test \
  sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47 \
  -c listen_addresses=127.0.0.1 -c shared_buffers=16MB -c max_connections=16)
pid=$(docker inspect --format '{{.State.Pid}}' "$container")
printf 'postgresql://fixture@127.0.0.1:5432/ownsolid_history_cli_test?sslmode=disable\n' >"$work/dsn"
export PROJECT_ONE_TEST_DSN_FILE="$work/dsn"
export PROJECT_ONE_REPOSITORY_ENGINE=postgresql
export PROJECT_ONE_REPOSITORY_POSTGRES_DSN_FILE="$work/dsn"
export PROJECT_ONE_REPOSITORY_POSTGRES_SCHEMA="cli_history_$(tr -d '-' </proc/sys/kernel/random/uuid)"
nsenter --target "$pid" --net unshare --pid --fork --kill-child bash -ec '
  ip link set lo up
  test "$(ip -o link show | wc -l)" -eq 1
  test -z "$(ip route show default)"
  test -z "$(ip -6 route show default)"
  for attempt in $(seq 1 80); do
    if (exec 3<>/dev/tcp/127.0.0.1/5432) 2>/dev/null; then
      docker exec "$1" psql -X -U fixture -d ownsolid_history_cli_test -v ON_ERROR_STOP=1 -c "$2"
      GOFLAGS="-p=1 -race" bash tools/cli/testdata/run-history-tls.sh
      exit
    fi
    sleep 0.25
  done
  exit 1
' bash "$container" "CREATE EXTENSION vector WITH SCHEMA public VERSION '0.8.7'; REVOKE CREATE ON SCHEMA public FROM PUBLIC;"
echo COMPILED_HISTORY_CLI_NATIVE_TLS_PASSED

test ! -e tools/audit-verify/audit-verify || rm -- tools/audit-verify/audit-verify
