set -euo pipefail
umask 077
cd /root/lane-rel-history
expected=f88e1ef91bc7e9b9a92d2fef8a0fa2722c697857
test "$(git rev-parse HEAD)" = "$expected"
test -z "$(git status --porcelain)"
git diff --exit-code 93b79363 HEAD -- tools/cli
source /root/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1 CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true
exec 8>/run/lock/ownsolid-heavy.lock
until flock -w 45 8; do echo SHARED_HEAVY_LOCK_PENDING; done
exec 9>/root/lane-sci-tools/heavy-test.lock
flock -n 9 || exit 75
exec 7>/root/lane-rel-tools/heavy-test.lock
flock -n 7 || exit 75
df -h /
free -m
ss -lntp
test "$(df -Pm / | awk 'NR == 2 {print $4}')" -ge 15360
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
echo "SOURCE_COMMIT=$(git rev-parse HEAD)"
unshare -n bash -ec '
ip link set lo up
test "$(ip -o link show | wc -l)" -eq 1
test -z "$(ip route show default)"
test -z "$(ip -6 route show default)"
make check
echo MAKE_CHECK_PASSED
make build
echo MAKE_BUILD_PASSED
go -C tools/cli test -race -count=1 ./...
