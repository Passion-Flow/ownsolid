#!/usr/bin/env bash
# SCI_OLD_ADMISSION_CLOSED_2026_11_13
printf '%s\n' 'NOTRUN: SCI old admission is closed pending coordinator epoch activation.' >&2
exit 78
set -euo pipefail
umask 077
fixture="$(cd -- "$(dirname -- "$0")" && pwd)"
root="$HOME/lane-sci"
git -C "$root" diff --exit-code d48d4a57 -- \
  api/agent/v1/model-catalog.json runtimes/model-lifecycle runtimes/training runtimes/data-processing
replay="$(mktemp -d "$HOME/lane-sci-tools/evl106-replay.XXXXXXXX")"
printf 'Replay evidence %s\n' "$replay"
mkdir "$replay/publication"
for name in version.json validation.jsonl train.jsonl manifest.json; do
  cp -- "$fixture/publication/$name" "$replay/publication/$name"
done
for name in generate.py run-generation.sh score.sh verify.py refusal.py publication.sha256; do
  cp -- "$fixture/$name" "$replay/$name"
done
bash "$replay/run-generation.sh" 1 2
bash "$replay/score.sh"
export PYTHONPATH="$root/runtimes/model-lifecycle:$root/runtimes/data-processing:$root/runtimes/training"
export PYTHONDONTWRITEBYTECODE=1
unshare --net "$HOME/lane-sci-tools/evaluation/python/bin/python3.12" "$replay/refusal.py" "$replay" "$root" | tee "$replay/refusals.log"
