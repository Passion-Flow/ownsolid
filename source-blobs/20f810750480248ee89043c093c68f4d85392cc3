+	reader, err := NewDraftSourceCandidate(fresh, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := reader.Read(ctx, actor, workspace, data.ID, before.Draft.ID)
+	if err != nil || !reflect.DeepEqual(got, before) {
+		t.Fatal("CSV report changed after file restore", err)
+	}
+	var original string
