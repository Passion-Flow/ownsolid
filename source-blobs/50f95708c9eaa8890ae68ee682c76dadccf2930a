package datasets

import (
	"bytes"
	"crypto/sha256"
	"fmt"
	"os"
	"path/filepath"
	"testing"
)

func TestDraftSourceFingerprintHandoff(t *testing.T) {
	proof := os.Getenv("DAT101_FINGERPRINT_PROOF")
	raw, err := os.ReadFile(filepath.Join(proof, "source.parquet"))
	if err != nil {
		t.Fatal(err)
	}
	decoder, err := filepath.Abs("../../../../../runtimes/data-processing/import_parquet.py")
	if err != nil {
		t.Fatal(err)
	}
	original := fmt.Sprintf("%x", sha256.Sum256(raw))
	importer, err := NewSourceImporter(testImportLimits(), &ParquetImportConfig{
		PythonExecutable: filepath.Join(proof, "venv/bin/python3.12"), DecoderFile: decoder,
		BatchRows: 1, MetadataBytes: 1 << 20, RowGroupBytes: 8 << 20, MemoryBytes: 512 << 20,
	})
	if err != nil {
		t.Fatal(err)
	}
	out := filepath.Join(privateImportDir(t), "source.jsonl")
	report, err := importer.ImportUpload(t.Context(), bytes.NewReader(raw), out, SourceImportOptions{
		Format: SourceParquet, ExpectedBytes: int64(len(raw)), ExpectedSHA256: original,
	})
	if err != nil {
		t.Fatal(err)
	}
	normalized, err := os.ReadFile(out)
	if err != nil {
		t.Fatal(err)
	}
	if report.Rows != 2 || report.SourceSHA256 != original ||
		report.OutputSHA256 != fmt.Sprintf("%x", sha256.Sum256(normalized)) || report.OutputBytes != int64(len(normalized)) {
		t.Fatal("fingerprint differs from normalized bytes", report)
	}
	fmt.Printf("source.parquet %d %s\nsource.jsonl %d %s\n", report.SourceBytes, report.SourceSHA256, report.OutputBytes, report.OutputSHA256)
}
