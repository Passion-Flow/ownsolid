insert('\tif mode == promptCapacityRelease {\n\t\tverifyPromptCapacityRelease', '''	if cpuPair != nil {
		cpuPair.verify(t, c, access, request)
		return
	}
	if mode == promptCapacityRelease {
		verifyPromptCapacityRelease''')
helper = (scratch / 'pair-helper.go').read_text()
replacement = scratch / relative.name
replacement.write_text(source + '\n' + helper)
(scratch / 'overlay.json').write_text(json.dumps({'Replace': {str(repo / relative): str(replacement)}}) + '\n')
