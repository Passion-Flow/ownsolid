from uuid import uuid4
import httpx
from ownsolid_sdk.monitoring import AuthenticatedClient
from ownsolid_sdk.monitoring.api.default import admin_monitoring

origin = "https://admin.example.invalid"
workspace = uuid4()
for code in ("STORAGE_TIMEOUT", "STORAGE_CANCELLED", "STORAGE_COMMIT_ROLLED_BACK", "STORAGE_DEADLOCK", "STORAGE_LOCK_TIMEOUT"):
    def respond(request):
        assert request.method == "GET"
        assert request.url.path == "/api/v1/sites/default/cells/default/admin/monitoring"
        assert dict(request.url.params) == {"workspace_id": str(workspace)}
        return httpx.Response(503, headers={"Content-Type": "application/problem+json"}, json={
            "type": "about:blank", "title": "Synthetic transaction refusal",
            "status": 503, "code": code, "request_id": str(uuid4()),
        })
    with httpx.Client(base_url=origin, transport=httpx.MockTransport(respond), trust_env=False, follow_redirects=False) as transport:
        client = AuthenticatedClient(base_url=origin, token="").set_httpx_client(transport)
        result = admin_monitoring.sync_detailed("default", "default", client=client, workspace_id=workspace)
        assert result.status_code == 503 and result.parsed.code == code
print("Published monitoring read decoded all five native transaction refusals")
PY
'
