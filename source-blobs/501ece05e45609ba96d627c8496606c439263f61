{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual isolated local Kubernetes gate deadlines",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_seconds",
    "test_seconds",
    "stability_seconds",
    "cleanup_seconds"
  ],
  "properties": {
    "build_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600,
      "default": 180,
      "description": "Compile deadline in seconds, fixed shared Go memory/CPU limits preserved."
    },
    "test_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 7200,
      "default": 600,
      "description": "Bounded actual local namespace/Job/proof/cleanup deadline in seconds. No automatic retry of unknown mutation; true timeout fails. Host samples at most 60 seconds apart."
    },
    "stability_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60,
      "default": 10,
      "description": "Seconds between host admission observations before actual work."
    },
    "cleanup_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 5,
      "description": "Seconds after TERM before only the exact owned process group is killed; retain failed evidence."
    }
  }
}
