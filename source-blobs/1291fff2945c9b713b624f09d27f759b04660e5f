def sha(path):
    with path.open('rb') as f:
        return hashlib.file_digest(f,'sha256').hexdigest()

def stage(item, source=None):
    target = wheelhouse/item['filename']
    if target.exists():
        assert sha(target) == item['sha256'], item['filename']
        return target
    temporary = target.with_suffix(target.suffix+'.partial')
    assert not temporary.exists(), str(temporary)
    if source is not None:
        assert sha(source) == item['sha256'], str(source)
        with source.open('rb') as src, temporary.open('xb') as dst:
            shutil.copyfileobj(src,dst,1024*1024)
    else:
        assert item['url'].startswith('https://files.pythonhosted.org/'), item['url']
        with urlopen(item['url'],timeout=30) as src, temporary.open('xb') as dst:
            remaining = item['size_bytes']
            while remaining:
                chunk=src.read(min(1024*1024,remaining))
                assert chunk, item['filename']
                dst.write(chunk); remaining-=len(chunk)
            assert not src.read(1)
    temporary.chmod(0o600)
    assert sha(temporary)==item['sha256'], item['filename']
    if item.get('size_bytes'):
        assert temporary.stat().st_size==item['size_bytes']
    temporary.rename(target)
    return target

def audit(item, wheel):
    with zipfile.ZipFile(wheel) as archive:
        names=archive.namelist()
        assert len(names)==len(set(names))
        for n in names:
            assert not PurePosixPath(n).is_absolute() and '..' not in PurePosixPath(n).parts
        metadata_path=next(n for n in names if n.endswith('.dist-info/METADATA'))
        distinfo=metadata_path.rsplit('/',1)[0]
        raw=archive.read(metadata_path)
        if 'metadata_sha256' in item:
            assert hashlib.sha256(raw).hexdigest()==item['metadata_sha256']
        metadata=BytesParser().parsebytes(raw)
        assert metadata['Version']==item['version']
        record={}
        for path,digest,size in csv.reader(io.StringIO(archive.read(distinfo+'/RECORD').decode())):
            assert path not in record
            record[path]=(digest,size)
        selected={metadata_path,distinfo+'/WHEEL'}
        declared=metadata.get_all('License-File',[])
        for name in declared:
            candidates=[distinfo+'/licenses/'+name,distinfo+'/'+name]
            found=[n for n in candidates if n in names]
            assert found, (item['filename'],name)
            selected.update(found)
        notices={n for n in names if not n.endswith('/') and (
            '/licenses/' in n.lower() or re.match(r'^(license|copying|notice|copyright|authors)([.\-_]|$)',PurePosixPath(n).name.lower()))}
        selected.update(notices)
        inventory=[]
        for path in sorted(selected):
            payload=archive.read(path)
            original_digest,size=record[path]
            algorithm,digest=original_digest.split('=',1)
            assert algorithm in {'sha256','sha384','sha512'}
            calculated=hashlib.new(algorithm,payload).digest()
            assert base64.urlsafe_b64encode(calculated).decode().rstrip('=')==digest
            assert str(len(payload))==size
            destination=root/'cpu-prototype-inputs/notices'/metadata['Name'].lower()/path
            destination.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
            destination.write_bytes(payload);destination.chmod(0o600)
            inventory.append({'path':path,'size':len(payload),'sha256':hashlib.sha256(payload).hexdigest(),'notice':path in notices})
        return {'filename':item['filename'],'version':metadata['Version'],'sha256':sha(wheel),'size':wheel.stat().st_size,
            'license_expression':metadata['License-Expression'],'license':metadata['License'],
            'license_classifiers':[x for x in metadata.get_all('Classifier',[]) if x.startswith('License ::')],
            'declared_license_files':declared,'files':inventory}

