#!/usr/bin/env bash
set -euo pipefail
cd "$HOME/lane-sch"
fixture="$(cat "$HOME/lane-sch-tools/waitreason-fixture")"
frozen_head="$(git rev-parse HEAD)"
test -z "$(git status --porcelain)"
for phase in check build modules; do
 for attempt in $(seq 1 120); do
  test "$(git rev-parse HEAD)" = "$frozen_head"
  test -z "$(git status --porcelain)"
  if bash "$HOME/lane-sch-tools/quota-reason-remaining-gate.sh" "$phase" >"$fixture/$phase-attempt.log" 2>&1; then
   cat "$fixture/$phase-attempt.log"
   break
  else
   code=$?
   if [ "$code" != 75 ]; then
    cat "$fixture/$phase-attempt.log"
    exit "$code"
   fi
  fi
  if [ "$attempt" = 120 ]; then
   cat "$fixture/$phase-attempt.log"
   exit 75
  fi
  if [ "$((attempt % 4))" = 1 ]; then
   printf 'Waiting for resource and lock gate before %s (attempt %s).\n' "$phase" "$attempt"
  fi
  sleep 15
 done
done
printf 'PASS all remaining gates on %s; evidence %s\n' "$frozen_head" "$fixture"
