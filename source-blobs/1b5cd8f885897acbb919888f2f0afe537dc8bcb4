#!/usr/bin/env bash
set -euo pipefail
qualified="$1"
base="$2"
mac="$3"
cd /root/lane-sch
test "$(git branch --show-current)" = codex/sch-queued-admission
test "$(git rev-parse HEAD)" = "$qualified"
test -z "$(git status --porcelain)"
fixture=/root/lane-sch-tools/queuedadmission.TrwMl7Fa
native=62c9dd0947f967291e2fa805b39742e23e02944b
test "$(cat "$fixture/source-head")" = "$native"
test -f "$fixture/queuedadmission-offline.passed"
test "$(grep -c '^--- PASS: TestPostgres' "$fixture/queuedadmission-offline.log")" = 45
test "$(grep -c '^--- PASS: Test' "$fixture/queuedadmission-offline.log")" = 66
git diff --exit-code "$native" "$qualified" -- services/control/internal/modules/scheduling services/control/internal/modules/workspaces services/control/internal/modules/audit services/control/internal/platform api pkg tools/release/offline/pkg/bundle services/control/go.mod services/control/go.sum ':!services/control/internal/modules/scheduling/README.md' > /root/lane-sch-tools/current-queue-native-input-equivalence.diff
git diff --exit-code db7ee24a "$qualified" -- services/control/internal/modules/identity/audit_read.go services/control/internal/modules/identity/lists.go > /root/lane-sch-tools/current-queue-reviewed-audit-equivalence.diff
mac_source="$(cat "$mac/source-head")"
for phase in modules check build; do
 test "$(cat "$mac/$phase.passed")" = PASS
 test "$(cat "$mac/$phase-head")" = "$mac_source"
done
git diff --name-only "$mac_source" "$qualified" >/root/lane-sch-tools/current-queue-mac-input-delta
python3 - /root/lane-sch-tools/current-queue-mac-input-delta <<'INPUT'
import re,sys
def documentary(p):
 return (p.endswith('.md') and (p.startswith('docs/research/') or p.startswith('docs/decisions/'))) or p in {'docs/product/status.md','services/control/internal/modules/scheduling/README.md'}
assert all(documentary(p) for p in open(sys.argv[1]).read().splitlines()),'MAC_PROGRAM_INPUT_CHANGED'
INPUT
mac_base="$(git merge-base "$mac_source" "$base")"
git merge-base --is-ancestor "$qualified" codex/sch-follow-on-research
git diff --exit-code "$qualified" codex/sch-follow-on-research -- api services web pkg deploy runtimes tools Makefile go.work
git switch codex/sch-follow-on-research
python3 - "$qualified" "$base" "$mac_source" "$mac_base" <<'PY'
from pathlib import Path
import re,sys
current,base,mac,mac_base=(s[:8] for s in sys.argv[1:])
p=Path('docs/research/scheduling-queue-policy.md');s=p.read_text()
heading='### Component qualification'
start=s.index(heading); after=start+len(heading)
later=re.search(r'(?m)^#{1,3} ',s[after:])
end=after+later.start() if later else len(s)
section=f"""### Component qualification

Source 62c9dd09 on base 726f2149 passed 45 real PostgreSQL cases and 66
top-level component tests with Go race instrumentation, PostgreSQL 18.6 and
pgvector 0.8.7 on Linux amd64. That exact source also passed full Control
modules, make check and make build with Go 1.27.3 and offline dependencies.
The network namespace had no default route; the private database had no
container network or host port.

Tests verified current usage after ordinary and queued waits, shared-writer
concurrency, tenant isolation, owner rollback and commit, replay, cancellation,
positive release, borrowing/reclaim and a suppressed real COMMIT acknowledgement.
The configured 10,000-workspace domain held exactly two advisory lock tags.
This is not SCH-111 fleet admission latency evidence.

Source {mac} on base {mac_base} passed full Control modules, make check and
make build on macOS arm64 with Go 1.27.3, Python 3.12 and offline dependencies.
Integration source {current} on base {base} retained that immutable-source
qualification after checking the documentary delta and rerunning layout and
roadmap checks. The scheduling Go/SQL, Workspace, session authority, transaction,
database, configuration and protected-file inputs retain the exact native
qualification above. The reviewed IAM runtime delta is limited to Admin
audit-events list accounting outside the scheduling call path. No earlier run
is relabeled as a new execution.

With both protected fixture DSN variables configured, the native component
command is:

    go -C services/control test -p 1 -race -tags repository_integration ./internal/modules/scheduling/... -skip '^TestPostgresReservationCatalogRoundTrip$' -count=1 -timeout 8m -v

The separate fresh/dump/restore catalog harness was explicitly excluded; this
admission change has no production DDL. Privileged fixtures do not qualify native
serving-role grants. Production eligible-batch and priority authority, all-writer
protocol cutover, authenticated dispatch and the installed offline UI flow remain
open. SCH-103 stays unticked.

"""
p.write_text(s[:start]+section+s[end:])
p=Path('docs/product/status.md');lines=p.read_text().splitlines();found=0
for i,line in enumerate(lines):
 if line.startswith('| Current queue admission (SCH-103, open)'):
  found+=1
  lines[i]=f'| Current queue admission (SCH-103, open) | Current fair-queue decision and exact reservation in one owner transaction, with bounded tenant fences | Source 62c9dd09 passed 45 route-free PostgreSQL 18.6 race cases, 66 component tests and full Control modules/check/build on Linux amd64. The configured 10,000-workspace domain held two advisory lock tags. Source {mac} passed full Control modules/check/build on macOS arm64. Integration {current} on base {base} retained the actual immutable-source evidence after input-equivalence, layout and roadmap checks | No | Native serving-role grants, the real bounded eligible batch and priority authority, all-writer cutover, authenticated dispatch and the installed UI remain open. See [component qualification](../research/scheduling-queue-policy.md#component-qualification) |'
assert found==1
p.write_text('\n'.join(lines)+'\n')
PY
git diff --check
make check-layout
python3 tools/dev/roadmap_progress.py --check
git add docs/research/scheduling-queue-policy.md docs/product/status.md
git diff --cached --check
if ! git diff --cached --quiet; then
 git commit -m "SCH-103: Retain immutable admission evidence on the integration head" -m "Preserve exact-source native PostgreSQL and full Linux qualification at 62c9dd09 and the actual macOS full-gate source. Verify the documentary integration delta, critical runtime inputs, layout and roadmap without relabeling earlier runs." -m "Keep production owner, serving-role and installed UI acceptance open; no roadmap tick or program change."
fi
printf 'FINAL_CANDIDATE %s\n' "$(git rev-parse HEAD)"
git switch codex/sch-queued-admission
