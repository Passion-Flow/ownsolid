  flags=()
  if test "$mode" = disabled; then flags=(-u OWNSOLID_TEST_PREVIEW_PYTHON); fi
  ionice -c2 -n7 nice -n10 nsenter -t "$pid" -n env "${flags[@]}" sh -ec '
    test "$(wc -l < /proc/net/route)" -eq 1
    go -C services/control test -tags dataset_processor_integration -overlay "$LANE_REL_DAT107_OVERLAY" \
      ./internal/modules/datasets -run "^TestActualDatasetTLSContractsLargeUnicodeRowsCSRFExportAndReadiness$" -v -count=1
  ' > "$scratch/$mode.log" 2>&1 || { tail -48 "$scratch/$mode.log"; exit 1; }
  grep -E 'both authorized entrances|real HTTPS 429|scoped HTTPS|--- (PASS|FAIL)' "$scratch/$mode.log"
  grep -q '^--- PASS: TestActualDatasetTLSContractsLargeUnicodeRowsCSRFExportAndReadiness ' "$scratch/$mode.log"
done
