#!/usr/bin/env python3
# Lane B GW-114 live-run helper, not product code: scripted-node.py at protocol 1.6, whose
# gateway leases run the agent's own gateway code (gateway-harness).
# Lane B test helper, not product code. A scripted node: it speaks the real agent protocol to a real
# control plane and reports a synthetic GPU and synthetic container state. No model runs, and a run
# that uses it proves the console and the server, never serving.
import datetime, json, socket, ssl, sys, time, urllib.error, urllib.request, uuid
origin, ca, name = sys.argv[1], sys.argv[2], sys.argv[3]
token = sys.stdin.read().strip()
gpu = "GPU-" + str(uuid.uuid4())
real = socket.getaddrinfo
socket.getaddrinfo = lambda h, *a, **k: real("127.0.0.1" if h.endswith("lane-b.test") else h, *a, **k)
context = ssl.create_default_context(cafile=ca)
now = lambda: datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
caps = ["collect_facts.v1"] + ["inference.%s.v1" % a for a in ("deploy", "stop", "remove", "observe", "verify")] + ["gateway.start.v1", "gateway.stop.v1"]
facts = lambda: {"os_id": "ubuntu", "os_version": "24.04", "architecture": "amd64", "hostname": name, "logical_cpus": 16,
    "memory_total_bytes": 64 << 30, "disk_path": "/", "disk_total_bytes": 1 << 40, "disk_available_bytes": 1 << 39,
    "observed_at": now(), "agent_version": "0.10.0"}
hand = lambda: {"protocol_version": "1.6", "capabilities": caps, "facts": facts(), "execution_profile": "docker_inference"}
def post(path, body, credential=None):
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if credential: headers["Authorization"] = "Bearer " + credential
    r = urllib.request.Request(origin + path, data=json.dumps(body).encode(), method="POST", headers=headers)
    try:
        with urllib.request.urlopen(r, context=context, timeout=40) as x:
            return json.loads(x.read() or b"{}").get("data")
    except urllib.error.HTTPError as e:
        print("HTTP", e.code, path, e.read()[:300], flush=True)
        return None
import subprocess, os
ident = "/root/lane-b/gw114/live/scripted-identity-" + name
os.makedirs(ident, mode=0o700, exist_ok=True)
subprocess.run(["sh", "-c", "openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out %s/key.pem && openssl req -new -key %s/key.pem -subj / -out %s/csr.pem" % (ident, ident, ident)], check=True)
node = post("/agent/v1/enroll", {"join_token": token, "certificate_request": open(ident + "/csr.pem").read(), **hand()})
if node:
    open(ident + "/cert.pem", "w").write(node["certificate"])
    context.load_cert_chain(ident + "/cert.pem", ident + "/key.pem")
if not node: sys.exit("enrollment refused")
print("enrolled", node["node_id"], flush=True)
credential = node["credential"]
base = "/agent/v1/sites/%s/cells/%s/nodes/%s" % (node["site_id"], node["cell_id"], node["node_id"])
observation = lambda: {"gpus": [{"uuid": gpu, "name": "Synthetic GPU (no hardware)", "driver_version": "580.1", "memory_total_mib": 24576,
    "memory_free_mib": 24000, "compute_capability": 8.9, "mig_mode": "Disabled", "observed_at": now()}], "observed_at": now()}
container = "c" * 64
image = "sha256:c76d0e2225a4b1cb1e2109ace39639f55e714abd1a7a427acc8b0bbd7f6a83b3"
prompt = "629db30bb15622269509c04bfbe5228292c84d2baae27e81d8c902091f1089cb"
def deployment(c, state):
    d = {"deployment_id": c["deployment_id"], "model_id": c["model_id"], "catalog_digest": c["catalog_digest"], "gpu_uuid": c["gpu_uuid"],
         "revision": c["revision"], "managed": state != "not_installed", "state": state, "ready": state == "running"}
    if state != "not_installed": d.update({"container_id": container, "image_id": image})
    if state == "running":
        d["verification"] = {"model": "projectone-qwen3-0.6b", "prompt_sha256": prompt, "response_sha256": "b" * 64, "input_tokens": 10, "output_tokens": 1, "observed_at": now()}
    return d
current = {}
acknowledged = 0
latest = None  # The command a real agent's journal would hold, reported on every heartbeat.
last = 0
while True:
    if time.time() - last > 5:
        seen = observation()
        if latest and current.get(latest["deployment_id"]) != "not_installed":
            seen["deployment"] = deployment(latest, current[latest["deployment_id"]])
        post(base + "/heartbeat", {**hand(), "inference": seen}, credential)
        last = time.time()
    claim = post(base + "/tasks/claims", {"wait_seconds": 4, "acknowledged_sequence": acknowledged}, credential)
    if claim is None:
        time.sleep(5)
        continue
    if claim.get("resync"):
        acknowledged = claim["resync"]["acknowledged_sequence"]
    lease = claim.get("lease")
    if not lease:
        continue
    task = base + "/tasks/" + lease["task_id"]
    post(task + "/acknowledgements", {"sequence": lease["sequence"], "lease_token": lease["lease_token"]}, credential)
    acknowledged = lease["sequence"]
    c = lease.get("inference") or {}
    print("task", lease["operation"], c.get("action"), flush=True)
    time.sleep(3)  # A pause, so a browser can see the work in progress.
    result = {"lease_token": lease["lease_token"], "outcome": "success", "error_code": ""}
    if lease["operation"].startswith("inference."):
        inference = {"gpus": [], "observed_at": now()}
        if c.get("deployment_id"):
            action = c["action"]
            state = {"deploy": "running", "stop": "stopped", "remove": "not_installed"}.get(action) or current.get(c["deployment_id"], "running")
            current[c["deployment_id"]] = state
            latest = c
            inference["deployment"] = deployment(c, state)
        else:
            inference = observation()
        result["inference"] = inference
    elif lease["operation"].startswith("gateway."):
        import subprocess
        harness = {"origin": origin, "ca_file": ca, "credential": credential, "certificate": open(ident + "/cert.pem").read(), "key": open(ident + "/key.pem").read(), "node": node["node_id"],
                   "scope": {"site_id": node["site_id"], "cell_id": node["cell_id"]}, "lease": lease, "docker": "/run/docker.sock",
                   "gateway": json.load(open("/root/lane-b/gw114/live/scripted-gateway.json"))}
        run = subprocess.run(["/root/lane-b/gw114/live/gateway-harness"], input=json.dumps(harness).encode(), capture_output=True, timeout=110)
        print("harness", run.stderr.decode()[-500:], flush=True)
        o = json.loads(run.stdout)
        result["gateway"] = o
        if o.get("error_code"):
            result["outcome"], result["error_code"] = "failure", o["error_code"]
    else:
        result["facts"] = facts()
    print("result", post(task + "/results", result, credential), flush=True)
