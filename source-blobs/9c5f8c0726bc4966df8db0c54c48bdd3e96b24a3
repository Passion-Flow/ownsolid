+	"google.golang.org/grpc/status"
+)
+
+type terminalRefusalStream struct {
+	grpc.ClientStream
+	code            string
+	sends, receives int
+}
+
+func (s *terminalRefusalStream) SendMsg(any) error {
+	s.sends++
