#!/usr/bin/env bash
set -euo pipefail
scratch="$(cd -- "$(dirname -- "$0")" && pwd)"
root="$HOME/lane-sci"
tools="$HOME/lane-sci-tools"
export PATH="$tools/go/bin:$PATH" GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off
export GOCACHE="$tools/go-cache" GOMODCACHE="$tools/go-mod" GOFLAGS=-p=1
exec 9>"$tools/heavy-test.lock"
flock 9
while [ "$(free -m | awk '/^Mem:/ {print $4}')" -lt 2048 ] || pgrep -x 'cargo|rustc|compile|link' >/dev/null; do sleep 8; done
df -h /
free -m
test "$(df --output=avail -BG / | tail -1 | tr -dc '0-9')" -ge 15
cd "$root"
git diff --exit-code ad7cf37e -- services/control/internal/modules/audit/testdata
git diff --exit-code df1ec219 -- services/control/migrations/postgresql
ionice -c3 nice -n 15 unshare --net go -C tools/audit-verify build -o "$scratch/audit-verify" .
ss -lntp '( sport = :5432 )'
name=lane-sci-aud55-32-ad7cf37e
image=sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47
id="$(docker run --pull never -d --rm --name "$name" --network none --shm-size 128m \
  --tmpfs /var/lib/postgresql/data:size=256m \
  -e PGDATA=/var/lib/postgresql/data/pgdata -e POSTGRES_PASSWORD_FILE=/fixture/pg-password \
  --mount "type=bind,source=$root,target=/repo,readonly" \
  --mount "type=bind,source=$scratch,target=/fixture" "$image")"
trap 'docker stop "$id" >/dev/null' EXIT
for ((i=0;i<60;i++)); do
  if docker exec "$id" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1; then break; fi
  sleep 1
done
docker exec "$id" pg_isready -h 127.0.0.1 -U postgres >/dev/null
docker exec "$id" createdb -U postgres audit_scope_test
docker exec "$id" psql -Xq -U postgres -d audit_scope_test -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION vector'
docker exec "$id" sh /fixture/verify55.sh 2>&1 | tee "$scratch/restore55-32.log"
