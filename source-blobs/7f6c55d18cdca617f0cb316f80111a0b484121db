    "answer_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 60,
      "x-environment": "PROJECT_ONE_WORKFLOWS_ANSWER_SECONDS",
      "x-runtime-path": "runtime.workflows.answer_seconds"
