      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 60,
      "x-environment": "PROJECT_ONE_WORKFLOWS_MAINTENANCE_SECONDS",
      "x-runtime-path": "runtime.workflows.maintenance_seconds"
    },
