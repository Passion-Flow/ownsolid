      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "x-environment": "PROJECT_ONE_WORKFLOWS_MAINTENANCE_BATCH",
      "x-runtime-path": "runtime.workflows.maintenance_batch"
