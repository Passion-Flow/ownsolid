      "type": "boolean",
      "default": false,
      "x-environment": "PROJECT_ONE_WORKFLOWS_ENABLED",
      "x-runtime-path": "workflows.enabled"
    }
  },
  "x-cross-field-constraints": [
    "run_seconds >= retrieval_seconds + answer_seconds + commit_seconds",
    "lease_seconds >= run_seconds + commit_seconds",
    "heartbeat_seconds * 3 < lease_seconds",
    "HTTP request budget >= commit_seconds; HTTP shutdown budget >= commit_seconds + knowledge key cleanup + child stop",
    "Cumulative workflows requires enabled Knowledge only when workflow execution is enabled; all later features remain disabled"
