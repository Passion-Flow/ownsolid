 "schemas": {
  "Binding": {
   "type": "object",
   "required": [
    "profile_id",
    "reason",
    "expected_revision"
   ],
   "properties": {
    "profile_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 63
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    },
    "expected_revision": {
     "type": "integer",
     "const": 0
    }
   }
  },
  "Connection": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "profile_id",
    "profile",
    "namespace",
    "state",
    "revision",
    "active_run_id",
    "observation",
    "created_at",
    "updated_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "profile_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 63
    },
    "profile": {
     "type": "string",
     "enum": [
      "kubernetes1.36.4-linux-amd64",
      "local-kind1.36.4-linux-arm64"
     ]
    },
    "namespace": {
     "type": "string",
     "minLength": 17,
     "maxLength": 63
    },
    "state": {
     "type": "string",
     "enum": [
      "active",
      "disabled",
      "restore_fenced"
     ]
    },
    "revision": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "active_run_id": {
     "anyOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "observation": {
     "anyOf": [
      {
       "$ref": "Observation"
      },
      {
       "type": "null"
      }
     ]
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  },
  "ConnectionPage": {
   "type": "object",
   "required": [
    "items",
    "next_cursor"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "Connection"
     }
    },
    "next_cursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "ExecutionProof": {
   "type": "object",
   "required": [
    "run_id",
    "profile",
    "manufacturer_manifest_sha256",
    "image_digest",
    "config_digest",
    "observed_image_id",
    "node_name",
    "container_id",
    "proof",
    "logs",
    "qualification"
   ],
   "properties": {
    "run_id": {
     "type": "string",
     "format": "uuid"
