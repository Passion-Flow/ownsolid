	HeartbeatSeconds int `json:"heartbeat_seconds"`

	// JitterPercent Spreads each interval evenly around heartbeat_seconds.
	JitterPercent int `json:"jitter_percent"`

	// OnlineWindowSeconds What one and a half of the longest interval, heartbeat_seconds plus its jitter, must fit in. Set by nodes.online_seconds less the liveness flush interval.
	OnlineWindowSeconds int `json:"online_window_seconds"`

	// ReconnectBaseSeconds Ceiling of the full-jitter delay after the first failed cycle.
	ReconnectBaseSeconds int `json:"reconnect_base_seconds"`

	// ReconnectMaxSeconds Largest ceiling of the full-jitter delay; not below reconnect_base_seconds.
	ReconnectMaxSeconds int       `json:"reconnect_max_seconds"`
	UpdatedAt           time.Time `json:"updated_at"`
	Version             int64     `json:"version"`
}

