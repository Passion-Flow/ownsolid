+		e := f.event
+		e.RequestID = uuid.NewString()
+		appendAsRole := func() error {
+			ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+			defer cancel()
+			tx, err := f.db.Begin(ctx)
