+		t.Fatal("exact split intent refused", err)
+	}
+	c.Server.PortalListenAddress = "127.0.0.1:30443"
+	servingCheckFailure(t, Verify(c, parsed), transportMismatch)
+	c.Server.PortalListenAddress = ""
