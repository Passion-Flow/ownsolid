+	t.Run("least_privilege_refusal_and_repair", func(t *testing.T) {
+		var schema string
+		if err := f.db.QueryRow(t.Context(), `SELECT current_schema()`).Scan(&schema); err != nil {
+			t.Fatal(err)
+		}
