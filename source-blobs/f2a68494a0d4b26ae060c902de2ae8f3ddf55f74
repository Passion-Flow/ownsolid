#!/usr/bin/env bash
set -euo pipefail
scratch="$(cd -- "$(dirname -- "$0")" && pwd)"
tools="$HOME/lane-sci-tools"
cd "$HOME/lane-sci"
export PATH="$tools/go/bin:$tools/node/node_modules/.bin:$tools/cargo/bin:$PATH"
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOCACHE="$tools/go-cache" GOMODCACHE="$tools/go-mod" GOFLAGS=-p=1
export CARGO_HOME="$tools/cargo" RUSTUP_HOME="$tools/rustup" RUSTUP_TOOLCHAIN=1.99.1
export CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true npm_config_offline=true
exec 9>"$tools/heavy-test.lock"
flock 9
while [ "$(free -m | awk '/^Mem:/ {print $4}')" -lt 2048 ] || pgrep -x 'cargo|rustc|compile|link' >/dev/null; do
  sleep 8
done
df -h /
free -m
test "$(df --output=avail -BG / | tail -1 | tr -dc '0-9')" -ge 15
printf 'Repository base %s\n' "$(git rev-parse HEAD)"
test ! -e tools/audit-verify/audit-verify
trap 'rm -f -- tools/audit-verify/audit-verify' EXIT
ionice -c3 nice -n 12 unshare --net make check 2>&1 | tee "$scratch/agt112-check.log"
ionice -c3 nice -n 12 unshare --net make build 2>&1 | tee "$scratch/agt112-build.log"
printf 'AGT-112 paired fixture make check && make build passed with no network\n'
