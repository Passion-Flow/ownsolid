 result['passed']=True
finally:
 for child in children:
  if child.poll() is None:os.killpg(child.pid,signal.SIGKILL);child.wait(timeout=2)
 if fixture is not None:shutil.rmtree(fixture)
 result['owned_fixture_removed']=fixture is None or not fixture.exists()
 result['children_joined']=all(child.poll() is not None for child in children)
 result['packet_capture']='Not used; no new zero-egress detector qualification claimed'
 (output/'result.json').write_text(json.dumps(result,indent=2)+'\n')
 print(output,flush=True);print(json.dumps(result),flush=True)
