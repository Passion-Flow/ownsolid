+func (p *gatewayTestProcess) stop(signal syscall.Signal) error {
+	if p == nil {
+		return nil
+	}
+	if err := p.child.Process.Signal(signal); err != nil && !errors.Is(err, os.ErrProcessDone) {
+		p.child.Process.Kill()
