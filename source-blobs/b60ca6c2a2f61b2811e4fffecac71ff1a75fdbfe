set -euo pipefail
cd ~/lane-rel
source ~/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1 CARGO_BUILD_JOBS=1 CARGO_NET_OFFLINE=true
umask 077
exec 9>~/lane-rel-tools/heavy-test.lock
flock -w 300 9
df -h /
free -m
cat /proc/pressure/io
test "$(df -Pm / | awk 'NR == 2 {print $4}')" -ge 15360
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
image=pgvector/pgvector@sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47
container=$(docker run -d --rm --pull never --network none --memory 896m --cpus 2 --tmpfs /tmp:rw,size=384m --name lane-rel-help-cutover-contract --label ownsolid.lane=lane-rel --entrypoint sh "$image" -ec '
data=$(mktemp -d)
chown postgres "$data"
gosu postgres initdb -D "$data" --auth=trust --locale=C --encoding=UTF8 >/dev/null
exec gosu postgres postgres -D "$data" -h 127.0.0.1
')
trap 'docker stop --time 5 "$container" >/dev/null 2>&1 || true' EXIT
for attempt in $(seq 1 30); do
    if docker exec "$container" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1; then break; fi
    sleep 1
done
docker exec "$container" createdb -h 127.0.0.1 -U postgres lane_rel_help_cutover_test
docker exec "$container" psql -h 127.0.0.1 -U postgres -d lane_rel_help_cutover_test -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION vector WITH SCHEMA public VERSION $$0.8.7$$; REVOKE CREATE ON SCHEMA public FROM PUBLIC' >/dev/null
pid=$(docker inspect -f '{{.State.Pid}}' "$container")
export PROJECT_ONE_TEST_DSN=postgresql://postgres@127.0.0.1/lane_rel_help_cutover_test?sslmode=disable
export PROJECT_ONE_DATA_PYTHON=$(readlink -f /usr/bin/python3.12)
nsenter -t "$pid" -n sh -ec '
test "$(wc -l < /proc/net/route)" -eq 1
make check
make build
go -C services/control test ./internal/modules/distribution -run "^TestActualAliasCutover(TLSNullableContractCSRFHistoryAndExactReplay|PauseDrainSameKeyRetargetRecordedRollbackAndImmutableHistory|RejectsMixedStaleForeignAndRollsBackAudit)$" -count=1 -v
'

