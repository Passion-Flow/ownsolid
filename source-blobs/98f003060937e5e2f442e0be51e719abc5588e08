#!/bin/bash
# ARC-103: the full install suite with its real agent and simulated fleet, then the gateways.
cd /root/lane-a-e2e
images="ownsolid/control:lane-a-e2e ownsolid-e2e/postgres:18.6-pgvector-0.8.7 victoriametrics/victoria-metrics:v1.155.0 victoriametrics/victoria-logs:v1.53.0 docker:29.1.3-dind"
OWNSOLID_E2E_RUN=TestSingleNodeInstall OWNSOLID_E2E_TIMEOUT=60m OWNSOLID_E2E_SCRATCH=/dev/shm OWNSOLID_E2E_DOCKER_TMPFS=12g ./run-single-node.sh /root/lane-a-e2e $images </dev/null > arc103-install.log 2>&1
echo "install exit=$?" > arc103.status
./gateways.sh arc103-gateways.log >> arc103.status 2>&1
echo "gateways exit=$?" >> arc103.status
echo finished >> arc103.status
