set -euo pipefail
cd ~/lane-rel
test -z "$(git status --porcelain)"
git switch --detach refs/lane-rel/linux-test-identity-base
source ~/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1
exec 9>~/lane-rel-tools/heavy-test.lock
flock -w 300 9
df -h /
free -m
cat /proc/pressure/io
for attempt in $(seq 1 90); do
    if test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048; then break; fi
    sleep 4
done
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
test "$(df -Pm / | awk 'NR==2 {print $4}')" -ge 15360
scratch=$(mktemp -d /var/tmp/ownsolid-lane-rel-restore.XXXXXXXX)
echo "$scratch"
chmod 0755 "$scratch"
trap 'chmod 0700 "$scratch"' EXIT
mkdir "$scratch/source" "$scratch/tmp"
export LANE_REL_UID_SCRATCH=$scratch LANE_REL_UID_SOURCE=$PWD/deploy/offline/internal/install
unshare --mount --propagation private --net bash -s <<'TESTS'
set -euo pipefail
ip link set lo up
test "$(wc -l < /proc/net/route)" -eq 1
scratch=$LANE_REL_UID_SCRATCH
CGO_ENABLED=0 go -C deploy/offline test -c -o "$scratch/install.test" ./internal/install
chmod 0755 "$scratch/install.test"
mount -t tmpfs -o size=128m,mode=1777 tmpfs /tmp
mount -t tmpfs -o size=128m,mode=0700 tmpfs "$scratch/tmp"
chown nobody:nogroup "$scratch/tmp"
mount --bind "$LANE_REL_UID_SOURCE" "$scratch/source"
mount -o remount,bind,ro "$scratch/source"
cd "$scratch/source"
pattern='^TestRestore(PutsBackAMissingModelBeforeTheDatabaseChanges|LeavesAMatchingModelAndReplacesADamagedOne|OntoAnEmptyInstallationBringsBackItsFilesAndRoles)$'
run() {
    name=$1
    tmp=$2
    shift 2
    result=0
    timeout 40 strace -f -e trace=fchownat,chown,lchown,fchown -o "$scratch/$name.syscalls" \
        "$@" env -i PATH=/usr/bin:/bin TMPDIR="$tmp" HOME=/nonexistent \
        "$scratch/install.test" -test.run "$pattern" -test.count=1 -test.v -test.timeout=30s \
        > "$scratch/$name.log" 2>&1 || result=$?
    printf '%s\n' "$result" > "$scratch/$name.exit"
    printf '%s exit=%s\n' "$name" "$result"
    grep -E '^--- (PASS|FAIL)|INSTALL_CONFIG_INVALID|chown .*invalid argument' "$scratch/$name.log" | head -8
    grep -m 2 -E '(fchownat|chown)\(.*EINVAL' "$scratch/$name.syscalls" || true
}
run host-root /tmp
run uid-map-only /tmp unshare --user --map-user=1000
run uid-and-gid-map /tmp unshare --user --map-user=1000 --map-group=1000
run documented-setpriv "$scratch/tmp" setpriv --reuid=nobody --regid=nogroup --clear-groups
test "$(cat "$scratch/host-root.exit")" = 1
test "$(cat "$scratch/uid-map-only.exit")" = 1
test "$(cat "$scratch/documented-setpriv.exit")" = 0
TESTS
