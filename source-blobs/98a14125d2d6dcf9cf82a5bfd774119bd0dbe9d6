set -euo pipefail
cd ~/lane-rel
source ~/lane-rel-tools/env
umask 077
exec 8>/run/lock/ownsolid-heavy.lock
flock -w 45 8 || exit 75
exec 9>/root/lane-sci-tools/heavy-test.lock
flock -n 9 || exit 75
exec 7>~/lane-rel-tools/heavy-test.lock
flock -n 7 || exit 75
test "$(df -Pm / | awk 'NR == 2 {print $4}')" -ge 15360
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
scratch=$HOME/lane-rel-tools/obs109-contract.Psjaj7Gp
before=$(sha256sum web/packages/i18n/locales/en.json web/packages/i18n/locales/zh-cn.json)
export LANE_REL_OBS109_LOCALE_PROPOSAL=$scratch
unshare --mount --net --propagation private bash -ec '
ip link set lo up
test "$(ip -o link show | wc -l)" -eq 1
mount --bind "$LANE_REL_OBS109_LOCALE_PROPOSAL/locales/complete-en.json" web/packages/i18n/locales/en.json
mount -o remount,bind,ro web/packages/i18n/locales/en.json
mount --bind "$LANE_REL_OBS109_LOCALE_PROPOSAL/locales/complete-zh-cn.json" web/packages/i18n/locales/zh-cn.json
mount -o remount,bind,ro web/packages/i18n/locales/zh-cn.json
cd web
pnpm --filter @ownsolid/help --filter @ownsolid/i18n test
pnpm --filter @ownsolid/i18n typecheck
'
test "$before" = "$(sha256sum web/packages/i18n/locales/en.json web/packages/i18n/locales/zh-cn.json)"
echo PRODUCT_LOCALE_FILES_UNCHANGED
echo PROPOSED_LOCALE_ACCEPTANCE_PASSED

