CREATE TABLE dataset_jobs (
    id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin PRIMARY KEY,
    tenant_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    workspace_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    dataset_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    draft_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    kind VARCHAR(8) NOT NULL CHECK(kind IN('import','publish')),
    requested_by CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    requested_audience VARCHAR(8) NOT NULL CHECK(requested_audience IN('portal','admin')),
    requested_epoch BIGINT NOT NULL CHECK(requested_epoch>=0),
    membership_authority CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    reason VARCHAR(500) NOT NULL CHECK(CHAR_LENGTH(reason)>0),
    expected_revision BIGINT NOT NULL CHECK(expected_revision BETWEEN 1 AND 9007199254740991),
    state VARCHAR(12) NOT NULL CHECK(state IN('pending','running','succeeded','failed','cancelled')),
    version_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    input_sha256 VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin CHECK(input_sha256 IS NULL OR REGEXP_LIKE(input_sha256,'^[a-f0-9]{64}$','c')),
    input_policy JSON NOT NULL,
    split_seed VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin CHECK(split_seed IS NULL OR REGEXP_LIKE(split_seed,'^[a-f0-9]{32}$','c')),
    validation_basis_points INT CHECK(validation_basis_points BETWEEN 100 AND 5000),
    attempt_count INT NOT NULL DEFAULT 0 CHECK(attempt_count BETWEEN 0 AND 5),
    attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    lease_expires_at DATETIME(6),
    cancel_requested_at DATETIME(6),
    cancel_requested_by CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    error_code VARCHAR(80),
    error_line_number INT CHECK(error_line_number BETWEEN 0 AND 10001),
    retryable BOOLEAN NOT NULL DEFAULT 0 CHECK(retryable IN(0,1)),
    retry_of CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    not_before DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    completed_at DATETIME(6),
    creation_key CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    creation_fingerprint VARBINARY(32) NOT NULL CHECK(OCTET_LENGTH(creation_fingerprint)=32),
    UNIQUE KEY dataset_job_full_identity(tenant_id,workspace_id,dataset_id,draft_id,id),
    UNIQUE KEY dataset_job_scope_identity(tenant_id,workspace_id,id),
    UNIQUE KEY dataset_job_creation_intent(tenant_id,workspace_id,dataset_id,draft_id,requested_by,creation_key),
    KEY dataset_job_claim_idx(state,not_before,created_at,id),
    FOREIGN KEY(tenant_id,workspace_id,dataset_id,draft_id) REFERENCES dataset_drafts(tenant_id,workspace_id,dataset_id,id),
    FOREIGN KEY(tenant_id,workspace_id,retry_of) REFERENCES dataset_jobs(tenant_id,workspace_id,id),
    FOREIGN KEY(requested_by) REFERENCES users(id),
    FOREIGN KEY(cancel_requested_by) REFERENCES users(id),
    CHECK(requested_audience='admin' OR membership_authority IS NOT NULL),
    CHECK(JSON_TYPE(input_policy)='OBJECT' AND OCTET_LENGTH(CAST(input_policy AS CHAR CHARACTER SET utf8mb4))<=16384),
    CHECK((kind='publish' AND version_id IS NOT NULL AND split_seed IS NOT NULL AND validation_basis_points IS NOT NULL) OR (kind='import' AND version_id IS NULL AND split_seed IS NULL AND validation_basis_points IS NULL)),
    CHECK((state='running' AND attempt_id IS NOT NULL AND lease_expires_at IS NOT NULL AND completed_at IS NULL) OR (state='pending' AND lease_expires_at IS NULL AND completed_at IS NULL) OR (state IN('succeeded','failed','cancelled') AND lease_expires_at IS NULL AND completed_at IS NOT NULL)),
    CHECK((cancel_requested_at IS NULL)=(cancel_requested_by IS NULL)),
    CONSTRAINT dataset_jobs_id_canonical CHECK(REGEXP_LIKE(id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_tenant_id_canonical CHECK(REGEXP_LIKE(tenant_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_workspace_id_canonical CHECK(REGEXP_LIKE(workspace_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_dataset_id_canonical CHECK(REGEXP_LIKE(dataset_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_draft_id_canonical CHECK(REGEXP_LIKE(draft_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_requested_by_canonical CHECK(REGEXP_LIKE(requested_by,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_membership_authority_canonical CHECK(membership_authority IS NULL OR REGEXP_LIKE(membership_authority,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_version_id_canonical CHECK(version_id IS NULL OR REGEXP_LIKE(version_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_attempt_id_canonical CHECK(attempt_id IS NULL OR REGEXP_LIKE(attempt_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_cancel_requested_by_canonical CHECK(cancel_requested_by IS NULL OR REGEXP_LIKE(cancel_requested_by,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_retry_of_canonical CHECK(retry_of IS NULL OR REGEXP_LIKE(retry_of,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT dataset_jobs_creation_key_canonical CHECK(REGEXP_LIKE(creation_key,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin;
