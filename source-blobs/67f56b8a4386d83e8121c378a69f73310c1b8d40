#!/bin/bash
set -euo pipefail
gate=$LANE_REL_FINAL_GATE
cd "$LANE_REL_FINAL_ROOT"
git rev-parse HEAD > "$gate/revision"
old=~/lane-rel-tools/cli-gw107-joint-gate.WDCatjNo
for attempt in $(seq 1 180); do
  if test -f "$old/check-build.exit"; then break; fi
  sleep 5
done
test "$(cat "$old/fixture.exit")" = 0
test "$(cat "$old/check-build.exit")" = 0
test "$(cat "$old/revision")" = 47de04c274f896fe30ec935f351963e0aac79c69
df -h /
free -m
cat /proc/pressure/io
for attempt in $(seq 1 90); do
  if test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048; then break; fi
  sleep 5
done
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
rc=0
ionice -c2 -n7 nice -n10 unshare -n sh -ec '
  ip link set lo up
  test "$(wc -l < /proc/net/route)" -eq 1
  make check && make build &&
  pnpm -C web/packages/help exec vitest run src/help.test.ts --maxWorkers=1 &&
  pnpm -C web/apps/portal exec playwright test e2e/home.spec.ts e2e/models.spec.ts --workers=2 &&
  go -C services/control test ./internal/modules/distribution &&
  go -C tools/cli test ./... &&
  cd services/gateway && cargo test --locked
' > "$gate/run.log" 2>&1 || rc=$?
echo "$rc" > "$gate/exit"
test "$rc" = 0
python3 - <<'PY'
from pathlib import Path
from subprocess import check_output
for name in ("go.work.sum", "tools/audit-verify/audit-verify"):
    if not check_output(["git", "ls-files", "--", name]):
        Path(name).unlink(missing_ok=True)
PY
git diff --check HEAD~7..HEAD
test -z "$(git status --porcelain)"
git update-ref refs/codex/handoff/lane-rel-completed-stack HEAD
