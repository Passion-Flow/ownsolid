+func TestPostgresQueuedReservationWaitsForOrdinaryUsageCommit(t *testing.T) {
+	f := newQueuedFixture(t)
+	ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+	defer cancel()
+	ordinary, err := f.pool.Begin(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ordinary.Rollback(ctx)
+	if changed, err := ReserveWithin(ctx, transaction.PostgreSQLTransaction(ordinary), f.reservationFixture.first, borrowingIntent(f.reservationFixture.first, 2)); err != nil || !changed {
+		t.Fatalf("uncommitted ordinary hold: %v, %v", changed, err)
+	}
+	var reads atomic.Int32
+	pids := make(chan uint32, 1)
+	result := make(chan error, 1)
+	go func() {
+		result <- pgx.BeginFunc(ctx, f.pool, func(tx pgx.Tx) error {
+			pids <- tx.Conn().PgConn().PID()
+			read := func(ctx context.Context, q transaction.Executor) ([]QueueEntry, error) {
+				reads.Add(1)
+				return f.read(ctx, q)
+			}
+			_, err := ReserveQueuedWithin(ctx, transaction.PostgreSQLTransaction(tx), f.first, borrowingIntent(f.first, 2), f.domain, read)
+			return err
+		})
+	}()
+	var pid uint32
+	select {
+	case pid = <-pids:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	waitForSchedulingBlocker(t, ctx, f.pool, pid, ordinary.Conn().PgConn().PID(), result)
+	if reads.Load() != 0 {
+		t.Fatal("queue was read before ordinary usage committed")
+	}
+	if err := ordinary.Commit(ctx); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrQueueTurnPending) {
+			t.Fatalf("admission ignored new committed usage: %v", err)
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	if reads.Load() != 1 {
+		t.Fatalf("queue reads=%d", reads.Load())
+	}
+	f.assertState(t, f.first, "queued", 1, 1)
+	if changed, err := f.admit(ctx, f.second, f.read, nil); err != nil || !changed {
+		t.Fatalf("new fair head: %v, %v", changed, err)
+	}
+}
