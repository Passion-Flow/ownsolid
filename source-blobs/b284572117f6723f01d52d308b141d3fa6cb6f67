+	if changed, err := admit(f.second, 2); changed || !errors.Is(err, ErrReclaimPending) {
+		t.Fatalf("plan freed a live borrower: %v, %v", changed, err)
+	}
+	f.assertState(t, f.second, "queued", 1, 1)
+	failedAudit := errors.New("verified release audit failed")
+	stop := func(after error) error {
