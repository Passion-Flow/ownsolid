+				err = first.Commit(ctx)
+			} else {
+				err = first.Rollback(ctx)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case err := <-result:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			}
+			if commit {
+				f.assertState(t, f.first, "preparing", 2, 2)
+			} else {
+				f.assertState(t, f.first, "queued", 1, 1)
+			}
+		})
+	}
