#!/usr/bin/env bash
# SCI_OLD_ADMISSION_CLOSED_2026_11_13
printf '%s\n' 'NOTRUN: SCI old admission is closed pending coordinator epoch activation.' >&2
exit 78
set -euo pipefail
umask 077
scratch="$(cd -- "$(dirname -- "$0")" && pwd)"
tools="$HOME/lane-sci-tools"
root="$HOME/lane-sci"
model="$HOME/lane-gw-acceptance/model"
image=sha256:66064cf683152e60eff2e5b18ec2d4ace236fb063c0a241f918691db9caddcf4
exec 9>"$tools/heavy-test.lock"
flock 9
while [ "$(free -m | awk '/^Mem:/ {print $4}')" -lt 3072 ] ||
      [ "$(free -m | awk '/^Mem:/ {print $7}')" -lt 12288 ] ||
      awk '/^full / {split($2,v,"="); exit !(v[2] > 25)}' /proc/pressure/io ||
      pgrep -x 'cargo|rustc|compile|link' >/dev/null || pgrep -f '^vllm serve' >/dev/null; do sleep 8; done
df -h /
free -m
test "$(df --output=avail -BG / | tail -1 | tr -dc '0-9')" -ge 15
ss -lntp '( sport = :18105 )'
docker image inspect "$image" --format '{{.Id}} {{.Architecture}}'
ionice -c3 nice -n 12 unshare --net python3 - "$model" "$root/api/agent/v1/model-catalog.json" <<'PY'
import hashlib
import json
from pathlib import Path
import sys

model, catalog_path = map(Path, sys.argv[1:])
catalog = json.loads(catalog_path.read_bytes())
assert (catalog['repository'], catalog['revision'], catalog['license']) == (
    'Qwen/Qwen3-0.6B', 'c1899de289a04d12100db370d81485cdf75e47ca', 'Apache-2.0',
)
assert len(catalog['files']) == 9
assert {path.name for path in model.iterdir()} == {item['path'] for item in catalog['files']}
for item in catalog['files']:
    path = model / item['path']
    assert path.is_file() and not path.is_symlink() and path.stat().st_size == item['size_bytes']
    with path.open('rb') as payload:
        assert hashlib.file_digest(payload, 'sha256').hexdigest() == item['sha256']
print('Verified all nine approved model artifacts')
PY
attempt="$(mktemp -d "$scratch/attempt.XXXXXXXX")"
printf 'Evidence directory %s\n' "$attempt"
id=
cleanup() {
  if [ -n "$id" ]; then
    docker stop --timeout 20 "$id" >/dev/null || true
    docker logs "$id" > "$attempt/server.log" 2>&1
    docker inspect --format 'status={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} network={{.HostConfig.NetworkMode}} cpus={{.HostConfig.NanoCpus}} memory={{.HostConfig.Memory}} port_bindings={{json .HostConfig.PortBindings}}' "$id" > "$attempt/container.txt"
    docker rm "$id" >/dev/null
  fi
}
trap cleanup EXIT
id="$(docker run --pull never -d --name lane-sci-evl105-cpu-serving --network none --read-only \
  --memory 8g --memory-swap 8g --cpus 4 --pids-limit 512 --cap-drop ALL --security-opt no-new-privileges \
  --shm-size 1g --tmpfs /tmp:rw,nosuid,nodev,size=1g \
  --tmpfs /triton-cache:rw,exec,nosuid,nodev,size=256m \
  --mount "type=bind,source=$model,target=/model,readonly" \
  --mount "type=bind,source=$scratch/measure.py,target=/measure.py,readonly" \
  -e HF_HOME=/tmp/hf -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 -e HF_HUB_DISABLE_TELEMETRY=1 \
  -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 -e TOKENIZERS_PARALLELISM=false \
  -e VLLM_CACHE_ROOT=/tmp/vllm -e XDG_CACHE_HOME=/tmp/cache -e PYTHONDONTWRITEBYTECODE=1 \
  -e TRITON_CACHE_DIR=/triton-cache -e VLLM_HOST_IP=127.0.0.1 -e GLOO_SOCKET_IFNAME=lo \
  -e VLLM_CPU_KVCACHE_SPACE=1 -e VLLM_CPU_OMP_THREADS_BIND=nobind -e OMP_NUM_THREADS=4 -e MKL_NUM_THREADS=4 \
  "$image" /model --host 127.0.0.1 --port 18105 --served-model-name ownsolid-evl105-qwen3-0.6b \
  --dtype float32 --max-model-len 256 --max-num-seqs 2 --max-num-batched-tokens 256 \
  --seed 42 --enforce-eager --generation-config vllm --no-enable-prefix-caching)"
docker inspect --format 'network={{.HostConfig.NetworkMode}} port_bindings={{json .HostConfig.PortBindings}}' "$id"
timeout --signal=TERM 720 docker exec "$id" python3 -B /measure.py > "$attempt/observations.json"
unshare --net python3 - "$attempt/observations.json" <<'PY'
import hashlib
import json
from pathlib import Path
import sys

path = Path(sys.argv[1])
raw = path.read_bytes()
report = json.loads(raw)
assert report['packages']['vllm'] == '0.29.0', report['packages']
assert len(report['warmup']) == 2
assert [run['concurrency'] for run in report['runs']] == [1, 2]
assert [row['request_sha256'] for row in report['runs'][0]['samples']] == [row['request_sha256'] for row in report['runs'][1]['samples']]
print(report['packages'])
for run in report['runs']:
    samples = run['samples']
    assert len(samples) == 8
    assert all(row['finished_ns'] - row['started_ns'] == row['latency_ns'] > 0 for row in samples)
    assert run['wall_ns'] == max(row['finished_ns'] for row in samples) - min(row['started_ns'] for row in samples)
    durations = sorted(row['latency_ns'] / 1_000_000 for row in samples)
    assert all(row['prompt_tokens'] > 0 and 0 < row['completion_tokens'] <= 24 for row in samples)
    seconds = run['wall_ns'] / 1_000_000_000
    tokens = sum(row['completion_tokens'] for row in samples)
    print(f"Concurrency {run['concurrency']}: p50 {durations[3]:.3f} ms, p95 {durations[7]:.3f} ms, {len(samples)/seconds:.3f} req/s, {tokens/seconds:.3f} output tok/s ({tokens} tokens)")
print('Matching output digests', sum(a['output_sha256'] == b['output_sha256'] for a, b in zip(*(r['samples'] for r in report['runs']), strict=True)), '/ 8')
print('Observation SHA-256', hashlib.sha256(raw).hexdigest())
PY
