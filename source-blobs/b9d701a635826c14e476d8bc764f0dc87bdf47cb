+	policy := *g.policy.Load()
+	policy.User.Executions = 0
+	g.policy.Store(&policy)
+	if result, _, err := lookup("find application", maximum); result != (Result{}) || !errors.Is(err, ErrBudgetExceeded) {
+		t.Fatalf("exhausted lookup: %+v, %v", result, err)
