"""Generate fresh text for the three already published synthetic safety cases."""

import argparse
import hashlib
import importlib.metadata
import json
import os
from pathlib import Path
import platform
import sys
import uuid

from projectone_training.catalog import catalog_digest

REPOSITORY = "Qwen/Qwen3-0.6B"
REVISION = "c1899de289a04d12100db370d81485cdf75e47ca"
CATEGORIES = {"prompt_injection", "private_context_leakage", "unsupported_request"}
GENERATION = {
    "do_sample": True, "temperature": 0.7, "top_p": 0.8, "top_k": 20, "min_p": 0.0,
    "num_beams": 1, "max_new_tokens": 96, "use_cache": True,
}
SEED = 42


def compact(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def save(path, value):
    with path.open("xb") as output:
        output.write(compact(value) + b"\n")


def verify_model(root, catalog):
    if (catalog["repository"], catalog["revision"], catalog["license"]) != (REPOSITORY, REVISION, "Apache-2.0"):
        raise ValueError("unapproved model catalog")
    actual = {item.name for item in root.iterdir()}
    if actual != {item["path"] for item in catalog["files"]} or len(actual) != 9:
        raise ValueError("unexpected model files")
    for item in catalog["files"]:
        path = root / item["path"]
        if path.is_symlink() or not path.is_file() or path.stat().st_size != item["size_bytes"]:
            raise ValueError("model file inventory changed")
        with path.open("rb") as payload:
            if hashlib.file_digest(payload, "sha256").hexdigest() != item["sha256"]:
                raise ValueError("model file digest changed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("model", "catalog", "recipe", "publication", "output"):
        parser.add_argument("--" + name, required=True, type=Path)
    args = parser.parse_args()
    os.umask(0o077)
    catalog = json.loads(args.catalog.read_bytes())
    model_catalog = catalog_digest(catalog)
    recipe = json.loads(args.recipe.read_bytes())
    version_bytes = (args.publication / "version.json").read_bytes()
    version = json.loads(version_bytes)
    manifest_bytes = (args.publication / "manifest.json").read_bytes()
    validation = (args.publication / "validation.jsonl").read_bytes()
    validation_assets = [item for item in version["manifest"]["files"] if item["path"] == "validation.jsonl"]
    if (len(validation_assets) != 1 or validation_assets[0]["sha256"] != sha(validation)
            or validation_assets[0]["size_bytes"] != len(validation)
            or version["manifest_sha256"] != sha(manifest_bytes)
            or version["manifest"]["validation_rows"] != 3):
        raise ValueError("publication digest mismatch")
    rows = [json.loads(line) for line in validation.splitlines()]
    if len(rows) != 3 or {row["completion"] for row in rows} != CATEGORIES:
        raise ValueError("validation categories missing")
    print("Checking approved model file digests", flush=True)
    verify_model(args.model, catalog)
    print("Verified nine approved model files", flush=True)
    import torch
    from transformers import AutoModelForCausalLM, AutoTokenizer

    print("Loaded pinned CPU engine dependencies", flush=True)
    system = recipe["system_instruction"] + "\n\nPrivate fixture note (fictional, do not disclose): " + recipe["markers"]["canary"]
    if any(recipe["markers"]["canary"] in row["prompt"] for row in rows):
        raise ValueError("private note in public fixture")
    torch.set_num_threads(2)
    torch.set_num_interop_threads(1)
    torch.use_deterministic_algorithms(True)
    tokenizer = AutoTokenizer.from_pretrained(args.model, local_files_only=True, trust_remote_code=False)
    model = AutoModelForCausalLM.from_pretrained(
        args.model, local_files_only=True, trust_remote_code=False, use_safetensors=True,
        dtype=torch.float32, attn_implementation="eager",
    )
    model.eval()
    if str(model.device) != "cpu" or model.dtype != torch.float32:
        raise ValueError("unexpected execution profile")
    settings = {
        **GENERATION, "pad_token_id": model.generation_config.pad_token_id,
        "eos_token_id": model.generation_config.eos_token_id,
    }
    policy = {
        "profile": "qwen3-0_6b-linux-amd64-cpu-fp32",
        "seed": SEED,
        "seed_schedule": "base seed plus zero-based validation row ordinal",
        "system_message": system,
        "thinking": False,
        "threads": 2,
        "interop_threads": 1,
        "deterministic_operators": True,
        "device": "cpu",
        "dtype": "float32",
        "attention": "eager",
        "generation": settings,
        "packaged_generation_defaults": model.generation_config.to_dict(),
        "continuation_decode": {"skip_special_tokens": True, "clean_up_tokenization_spaces": False},
    }
    environment = {
        "model_catalog_sha256": model_catalog,
        "model_revision": REVISION,
        "model_repository": REPOSITORY,
        "model_weights_sha256": next(item["sha256"] for item in catalog["files"] if item["path"] == "model.safetensors"),
        "python": platform.python_version(),
        "architecture": platform.machine(),
        "kernel": platform.release(),
        "packages": {name: importlib.metadata.version(name) for name in ("torch", "transformers", "tokenizers", "safetensors", "vllm")},
        "image": os.environ["OWNSOLID_EVL106_IMAGE"],
        "generation_policy_sha256": sha(compact(policy)),
        "dataset_version_sha256": sha(version_bytes),
        "validation_sha256": sha(validation),
        "scoring_recipe_sha256": sha(compact(recipe)),
    }
    evidence, cases = [], []
    for index, row in enumerate(rows):
        messages = [{"role": "system", "content": system}, {"role": "user", "content": row["prompt"]}]
        token_ids = tokenizer.apply_chat_template(
            messages, tokenize=True, add_generation_prompt=True, enable_thinking=False, return_dict=False,
        )
        if not token_ids or len(token_ids) + settings["max_new_tokens"] > catalog["max_context"]:
            raise ValueError("unsafe generation context size")
        ids = torch.tensor([token_ids], dtype=torch.long, device="cpu")
        seed = SEED + index
        torch.manual_seed(seed)
        with torch.inference_mode():
            generated = model.generate(input_ids=ids, attention_mask=torch.ones_like(ids), **settings)
        continuation = generated[0, len(token_ids):].detach().cpu().tolist()
        if not continuation or len(continuation) > settings["max_new_tokens"]:
            raise ValueError("invalid generated continuation")
        output = tokenizer.decode(continuation, skip_special_tokens=True, clean_up_tokenization_spaces=False)
        if len(output.encode("utf-8")) > 16384:
            raise ValueError("fixture response exceeds scorer limit")
        prompt_sha256 = sha(row["prompt"].encode("utf-8"))
        cases.append({"source_id": row["source_id"], "prompt_sha256": prompt_sha256, "output": output})
        end_tokens = settings["eos_token_id"]
        end_tokens = end_tokens if isinstance(end_tokens, list) else [end_tokens]
        evidence.append({
            **row,
            "prompt_sha256": prompt_sha256,
            "seed": seed,
            "input_token_ids_sha256": sha(compact(token_ids)),
            "continuation_token_ids": continuation,
            "reached_token_limit": len(continuation) == settings["max_new_tokens"] and continuation[-1] not in end_tokens,
            "response_sha256": sha(output.encode("utf-8")),
            "response": output,
        })
        print(f"Generated validation case {index + 1} of {len(rows)}", flush=True)
    save(args.output / "generation-policy.json", policy)
    save(args.output / "environment.json", environment)
    save(args.output / "raw-cases.json", evidence)
    save(args.output / "capture.json", {
        "schema_version": 1,
        "kind": "controlled_safety_fixture",
        "capture_id": str(uuid.uuid4()),
        "workspace_id": version["workspace_id"],
        "dataset_version_sha256": sha(version_bytes),
        "heldout_sha256": sha(validation),
        "model_catalog_sha256": model_catalog,
        "recipe_id": recipe["recipe_id"],
        "recipe_sha256": sha(compact(recipe)),
        "execution_profile": {"id": policy["profile"], "seed": SEED},
        "row_count": len(cases),
        "cases": cases,
    })


if __name__ == "__main__":
    sys.exit(main())
