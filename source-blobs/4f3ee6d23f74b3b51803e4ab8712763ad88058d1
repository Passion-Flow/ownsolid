#!/bin/bash
# One crash drill. Usage: crash.sh <log> [agents]
cd /root/lane-a-e2e
images="ownsolid/control:lane-a-e2e ownsolid-e2e/postgres:18.6-pgvector-0.8.7 victoriametrics/victoria-metrics:v1.155.0 victoriametrics/victoria-logs:v1.53.0 docker:29.1.3-dind"
OWNSOLID_E2E_SIMULATED_AGENTS="${2:-}" OWNSOLID_E2E_LOAD=1 OWNSOLID_E2E_RUN=TestControlCrash OWNSOLID_E2E_TIMEOUT=40m OWNSOLID_E2E_SCRATCH=/dev/shm OWNSOLID_E2E_DOCKER_TMPFS=12g OWNSOLID_E2E_ROOT_TMPFS=8g OWNSOLID_E2E_MODEL_ARCHIVE=/dev/shm/lane-a-bundle.tar \
  ./run-single-node.sh /root/lane-a-e2e $images </dev/null > "$1" 2>&1
c=$?
echo "exit=$c"
grep -E "^(=== RUN|--- |    --- |PASS|FAIL)|control answered|upload broke|every agent heard" "$1" | cut -c1-200 | tail -24
exit $c
