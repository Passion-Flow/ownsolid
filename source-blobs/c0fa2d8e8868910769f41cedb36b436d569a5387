def reaches(node,seen=frozenset()):
 if isinstance(node,list): return any(reaches(v,seen) for v in node)
 if not isinstance(node,dict): return False
 ref=node.get('$ref')
 if ref=='#/components/schemas/ModelAliasRead': return True
 if isinstance(ref,str) and ref.startswith('#/') and ref not in seen:
  target=d
  for part in ref[2:].split('/'): target=target[part]
  if reaches(target,seen|{ref}): return True
 return any(reaches(v,seen) for key,v in node.items() if key!='$ref')
wanted={'adminListModelAlias','adminGetModelAlias','portalListModelAlias','portalGetModelAlias'}
reads={}
assert set(d['paths'])==set(before['paths'])
for path,methods in d['paths'].items():
 for method,operation in methods.items():
  if not isinstance(operation,dict) or 'operationId' not in operation: continue
  name=operation['operationId']
  if any(reaches(response) for code,response in operation.get('responses',{}).items() if str(code).startswith('2')):
   reads[name]={'method':method,'path':path}
  if name not in wanted: assert operation==before['paths'][path][method],name
assert set(reads)==wanted and all(v['method']=='get' for v in reads.values())
