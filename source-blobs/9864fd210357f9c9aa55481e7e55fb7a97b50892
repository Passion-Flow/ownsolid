+	case <-retirement.Done():
+	default:
+		t.Fatal("session close did not join its retirement worker")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.streams != 2 {
+		t.Fatalf("retirement opened %d streams", c.streams)
+	}
+}
+
