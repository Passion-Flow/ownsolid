+			if _, err := s.Heartbeat(t.Context(), wire.Handshake{}); err != nil {
+				t.Fatal(err)
+			}
+			if s.conn != connection || s.stream != stream || s.retiring != nil {
+				t.Fatal("invalid or missing metadata changed the legacy path")
