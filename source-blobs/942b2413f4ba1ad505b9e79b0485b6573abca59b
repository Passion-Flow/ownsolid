+func TestAcceptedOperationKeyCannotRotateToAnOrdinaryCredential(t *testing.T) {
+	c := setup(t)
+	a := c.access(t)
+	ctx := t.Context()
+	workspace := a.alias.WorkspaceID
+	var operationID string
+	err := c.s.WithTransientKey(ctx, a.owner, keyInput(a.alias), 2*time.Second, uuid.NewString(), func(raw string) error {
+		operationID = strings.Split(raw, ".")[1]
+		keys, err := c.s.KeyPage(ctx, a.owner, workspace, nil)
+		if err != nil {
+			return err
+		}
+		visible := false
+		for _, key := range keys.Items {
+			if key.ID == operationID && key.State == "active" {
+				visible = true
+			}
+		}
+		if !visible {
+			t.Error("expected the operation key to be visible in the owner's current key history")
+		}
+		rotated, err := c.s.RotateKey(ctx, a.owner, workspace, operationID,
+			distribution.RotateRequest{Reason: "Synthetic owner rotation"}, uuid.NewString(), uuid.NewString())
+		if err != nil {
+			check(t, err, "API_KEY_NOT_ACTIVE")
+			return nil
+		}
+		if rotated.Secret == nil {
+			t.Error("operation rotation unexpectedly succeeded")
+			return nil
+		}
+		for range 2 {
+			in := a.input()
+			in.APIKey = *rotated.Secret
+			if _, err = c.s.Admit(ctx, a.gateway.Gateway.ID, *a.gateway.Secret, in, uuid.NewString()); err != nil {
+				return err
+			}
+			if _, err = c.s.Report(ctx, a.gateway.Gateway.ID, *a.gateway.Secret, success(in.RequestID), uuid.NewString()); err != nil {
+				return err
+			}
+		}
+		t.Error("operation key rotation created a successor that admitted two requests")
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var successors int
+	if err = c.s.DB.QueryRow(ctx, "SELECT count(*) FROM api_keys WHERE rotated_from=$1", operationID).Scan(&successors); err != nil || successors != 0 {
+		t.Fatal("operation key must have no durable successor", successors, err)
+	}
+}
