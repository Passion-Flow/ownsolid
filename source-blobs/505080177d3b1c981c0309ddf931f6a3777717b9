+		}
+	}
+	for _, origin := range []string{browser.PortalOrigin, machine.Origin} {
+		response, err := client.Get(origin + "/")
+		if err != nil {
+			t.Fatal(err)
+		}
+		transportRead(t, response, 200)
+	}
+	cancel()
+	if err := machineAwaitServe(t, done); err != nil {
+		t.Fatal(err)
+	}
+}
