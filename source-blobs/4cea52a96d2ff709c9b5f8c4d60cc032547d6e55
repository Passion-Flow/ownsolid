+-- Only an empty candidate can be removed without losing established identities.
+DO $$ BEGIN
+ IF EXISTS(SELECT 1 FROM model_families) THEN
+  RAISE EXCEPTION 'MODEL_FAMILY_DOWNGRADE_REQUIRES_RETENTION' USING ERRCODE='0A000';
+ END IF;
+END $$;
