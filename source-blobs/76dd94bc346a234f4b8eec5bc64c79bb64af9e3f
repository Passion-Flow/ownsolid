+		if out.State != scheduling.WorkspaceQuotaUnconfigured || out.Reason == nil ||
+			out.Reason.Action != scheduling.ConfigureQuotaPolicy || out.Resources != nil {
+			t.Fatalf("missing policy became capacity: %+v", out)
+		}
+	}
