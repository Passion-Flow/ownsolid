+			t.Fatalf("authenticated handler: %+v, %d, %v", value, status, err)
+		}
+		out, ok := value.(scheduling.WorkspaceQuotaStatus)
+		if !ok || out.WorkspaceID != scope.ID {
+			t.Fatalf("incorrect public subject: %+v", value)
+		}
