+		{exact.Metric, g.f.Tenant, other, 1},
+		{exact.Metric, foreignTenant, foreign, 1},
+		{exact.Metric, foreignTenant, g.f.Workspace, 1},
+		{exact.Metric, "", g.f.Workspace, 1},
+	})
+
