+		emit(day, cpu, foreignTenant, foreign, uuid.NewString())
+		emit(day, cpu, foreignTenant, g.f.Workspace, uuid.NewString())
+		emit(day, cpu, "", g.f.Workspace, uuid.NewString())
+	}
