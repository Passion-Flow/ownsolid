+	// were requested. Narrowing to the exact 10,000-series metric must recover.
+	refused(g.admin, g.f.Workspace, overview, "MONITORING_CARDINALITY_UNAVAILABLE")
+	requestID := uuid.NewString()
+	started := time.Now()
