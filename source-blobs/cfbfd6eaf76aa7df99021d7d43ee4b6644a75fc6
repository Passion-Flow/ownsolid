+
+// The wrapper observes a real final audit insert. It provokes a real constraint
+// rollback or drops delivery only after the real PostgreSQL commit completes.
+type cardinalityCommitFault struct {
+	transaction.Store
+	requestID, mode string
+	cancel          context.CancelFunc
+	armed           atomic.Bool
+}
+
+func (s *cardinalityCommitFault) Within(ctx context.Context, ro bool, fn func(context.Context, transaction.Executor) error) error {
+	injected := false
+	err := s.Store.Within(ctx, ro, func(ctx context.Context, q transaction.Executor) error {
+		if err := fn(ctx, q); err != nil {
+			return err
+		}
+		if !s.armed.Load() {
+			return nil
+		}
+		var count int
+		if err := q.QueryRow(ctx, transaction.SQL(transaction.PostgreSQL, "SELECT count(*) FROM audit_events WHERE action='monitoring.snapshot' AND request_id=$1", s.requestID)).Scan(&count); err != nil {
+			return err
+		}
+		if count == 1 && s.armed.CompareAndSwap(true, false) {
+			injected = true
+			if s.mode == "rollback" {
+				_, err := q.Exec(ctx, transaction.SQL(transaction.PostgreSQL, "INSERT INTO audit_events(id,audience,action,outcome,request_id) VALUES('invalid','admin','monitoring.constraint','invalid','invalid')"))
+				return err
+			}
+		}
+		return nil
+	})
+	if err == nil && injected {
+		if s.mode == "unknown" {
+			return errors.Join(context.Canceled, &transaction.Error{Kind: transaction.CommitRolledBack}, &transaction.Error{Kind: transaction.CommitUnknown})
+		}
+		if s.mode == "cancel" {
+			s.cancel()
+		}
+	}
+	return err
+}
+
+type cardinalityFixtureScope struct {
+	metric, tenant, workspace string
+	series                    uint64
+}
+
+// Read native fixture counts directly; product observations and their audit
+// assertions must remain single attempts through the authorized service.
+func waitForCardinalityFixture(t *testing.T, parent context.Context, origin string, day time.Time, scopes []cardinalityFixtureScope) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	defer cancel()
+	for _, scope := range scopes {
+		query := url.Values{
+			"date": {day.Format("2006-01-02")}, "topN": {"1"}, "timeout": {"2s"},
+			"match[]": {fmt.Sprintf("{__name__=%s,tenant_id=%s,workspace_id=%s}", strconv.Quote(scope.metric), strconv.Quote(scope.tenant), strconv.Quote(scope.workspace))},
+		}
+		for {
+			request, err := http.NewRequestWithContext(ctx, http.MethodGet, origin+"/api/v1/status/tsdb?"+query.Encode(), nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			response, err := http.DefaultClient.Do(request)
+			if err != nil {
+				t.Fatalf("native cardinality fixture readiness: %v", err)
+			}
+			body, readErr := io.ReadAll(io.LimitReader(response.Body, 8193))
+			closeErr := response.Body.Close()
+			var reply struct {
+				Status   string   `json:"status"`
+				Partial  bool     `json:"isPartial"`
+				Warnings []string `json:"warnings"`
+				Data     *struct {
+					Total *uint64 `json:"totalSeries"`
+				} `json:"data"`
+			}
+			if readErr != nil || closeErr != nil || response.StatusCode != http.StatusOK || len(body) > 8192 ||
+				json.Unmarshal(body, &reply) != nil || reply.Status != "success" || reply.Partial || len(reply.Warnings) != 0 ||
+				reply.Data == nil || reply.Data.Total == nil {
+				t.Fatal("native cardinality fixture returned an invalid readiness response")
+			}
+			if *reply.Data.Total > scope.series {
+				t.Fatalf("native fixture has excess series for %q: %d, expected %d", scope.metric, *reply.Data.Total, scope.series)
+			}
+			if *reply.Data.Total == scope.series {
+				break
+			}
+			select {
+			case <-ctx.Done():
+				t.Fatalf("native fixture visibility deadline for %q: %d, expected %d", scope.metric, *reply.Data.Total, scope.series)
+			case <-time.After(100 * time.Millisecond):
+			}
+		}
+	}
+}
diff --git a/services/control/internal/modules/monitoring/series_cardinality_store.go b/services/control/internal/modules/monitoring/series_cardinality_store.go
new file mode 100644
index 00000000..2801d5c1
--- /dev/null
+++ b/services/control/internal/modules/monitoring/series_cardinality_store.go
@@ -0,0 +1,183 @@
+package monitoring
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"time"
+	"unicode/utf8"
+
+	"github.com/Passion-Flow/ownsolid/services/control/internal/modules/workspaces"
+)
+
+const maximumCardinalityReplyBytes = 4 << 20
+
+type seriesCardinalityReader struct {
+	policy SeriesCardinalityPolicy
+	origin *url.URL
+	client *http.Client
+}
+
+func newSeriesCardinalityReader(p SeriesCardinalityPolicy, timeout time.Duration, concurrent int) *seriesCardinalityReader {
+	if p.RawOrigin == "" {
+		return nil
+	}
+	return &seriesCardinalityReader{p, metricsQueryOrigin(p.RawOrigin), newMetricsQueryClient(timeout, concurrent)}
+}
+
+func cardinalitySourceError(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return errors.New("MONITORING_CARDINALITY_UNAVAILABLE")
+}
+
+func (r *seriesCardinalityReader) read(ctx context.Context, scope workspaces.Workspace, now time.Time, selection SeriesCardinalityQuery) (SeriesCardinality, error) {
+	if ctx == nil || r == nil || r.origin == nil || r.client == nil {
+		return SeriesCardinality{}, errors.New("MONITORING_OWNER_REQUIRED")
+	}
+	today := now.UTC().Truncate(24 * time.Hour)
+	earliest := today.AddDate(0, 0, 1-r.policy.LookbackDays)
+	if selection.Date.Before(earliest) || selection.Date.After(today) {
+		return SeriesCardinality{}, errors.New("MONITORING_CARDINALITY_RANGE_INVALID")
+	}
+	limit := selection.Limit
+	if limit == 0 {
+		limit = r.policy.MaximumRanks
+	}
+	if limit < 1 || limit > r.policy.MaximumRanks {
+		return SeriesCardinality{}, errors.New("VALIDATION_FAILED")
+	}
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		return SeriesCardinality{}, errors.New("MONITORING_OWNER_REQUIRED")
+	}
+	if err := ctx.Err(); err != nil {
+		return SeriesCardinality{}, err
+	}
+	query := url.Values{
+		"date":                  {selection.Date.Format(cardinalityDateFormat)},
+		"topN":                  {strconv.Itoa(limit)},
+		"focusLabel":            {"node_id"},
+		"extra_label":           {"tenant_id=" + scope.TenantID, "workspace_id=" + scope.ID},
+		"timeout":               {strconv.FormatInt(max(1, time.Until(deadline).Milliseconds()), 10) + "ms"},
+		"deny_partial_response": {"1"},
+	}
+	if selection.Metric != "" {
+		query.Set("match[]", "{__name__="+strconv.Quote(selection.Metric)+"}")
+	}
+	endpoint := *r.origin
+	endpoint.Path, endpoint.RawQuery = "/api/v1/status/tsdb", query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	response, err := r.client.Do(request)
+	if err != nil {
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	if response.StatusCode != http.StatusOK {
+		response.Body.Close()
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	body, readError := io.ReadAll(io.LimitReader(response.Body, maximumCardinalityReplyBytes+1))
+	closeError := response.Body.Close()
+	if readError != nil || closeError != nil || len(body) > maximumCardinalityReplyBytes || !utf8.Valid(body) {
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	var reply cardinalityReply
+	if json.Unmarshal(body, &reply) != nil || reply.Status != "success" || !reply.complete() || len(reply.Warnings) != 0 || reply.Data == nil {
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	out, err := reply.project(scope, selection, limit)
+	if err != nil {
+		return SeriesCardinality{}, cardinalitySourceError(ctx)
+	}
+	return out, nil
+}
+
+type cardinalityNativeRank struct {
+	Name  *string `json:"name"`
+	Value *uint64 `json:"value"`
+}
+
+type cardinalityReply struct {
+	Status   string          `json:"status"`
+	Partial  json.RawMessage `json:"isPartial"`
+	Warnings []string        `json:"warnings"`
+	Data     *struct {
+		Total   *uint64                 `json:"totalSeries"`
+		Metrics []cardinalityNativeRank `json:"seriesCountByMetricName"`
+		Nodes   []cardinalityNativeRank `json:"seriesCountByFocusLabelValue"`
+	} `json:"data"`
+}
+
+func (r cardinalityReply) complete() bool {
+	return r.Partial == nil || string(r.Partial) == "false"
+}
+
+func (r cardinalityReply) project(scope workspaces.Workspace, selection SeriesCardinalityQuery, limit int) (SeriesCardinality, error) {
+	invalid := errors.New("invalid cardinality source projection")
+	if r.Data == nil || r.Data.Total == nil || *r.Data.Total > maximumCardinalityCount ||
+		len(r.Data.Metrics) > limit || len(r.Data.Nodes) > limit {
+		return SeriesCardinality{}, invalid
+	}
+	total := *r.Data.Total
+	if total > 0 && len(r.Data.Metrics) == 0 {
+		return SeriesCardinality{}, invalid
+	}
+	out := SeriesCardinality{
+		WorkspaceID: scope.ID, Date: selection.Date.Format(cardinalityDateFormat),
+		TotalSeries: total, RankLimit: limit,
+		Metrics: make([]MetricCardinality, 0, len(r.Data.Metrics)),
+		Nodes:   make([]NodeCardinality, 0, len(r.Data.Nodes)),
+	}
+	seen := make(map[string]bool, len(r.Data.Metrics))
+	var sum uint64
+	for _, row := range r.Data.Metrics {
+		if row.Name == nil || row.Value == nil || *row.Name == "" || len(*row.Name) > maximumCardinalityNameBytes ||
+			!utf8.ValidString(*row.Name) || *row.Value == 0 || *row.Value > total-sum || seen[*row.Name] ||
+			selection.Metric != "" && *row.Name != selection.Metric {
+			return SeriesCardinality{}, invalid
+		}
+		sum += *row.Value
+		seen[*row.Name] = true
+		out.Metrics = append(out.Metrics, MetricCardinality{*row.Name, *row.Value})
+	}
+	if selection.Metric != "" && sum != total {
+		return SeriesCardinality{}, invalid
+	}
+	seen = make(map[string]bool, len(r.Data.Nodes))
+	sum = 0
+	for _, row := range r.Data.Nodes {
+		if row.Name == nil || row.Value == nil || *row.Value == 0 || *row.Value > total-sum || seen[*row.Name] {
+			return SeriesCardinality{}, invalid
+		}
+		if !validID(*row.Name) {
+			return SeriesCardinality{}, invalid
+		}
+		sum += *row.Value
+		seen[*row.Name] = true
+		out.Nodes = append(out.Nodes, NodeCardinality{*row.Name, *row.Value})
+	}
+	sort.Slice(out.Metrics, func(i, j int) bool {
+		a, b := out.Metrics[i], out.Metrics[j]
+		if a.SeriesCount != b.SeriesCount {
+			return a.SeriesCount > b.SeriesCount
+		}
+		return a.MetricName < b.MetricName
+	})
+	sort.Slice(out.Nodes, func(i, j int) bool {
+		a, b := out.Nodes[i], out.Nodes[j]
+		if a.SeriesCount != b.SeriesCount {
+			return a.SeriesCount > b.SeriesCount
+		}
+		return a.NodeID < b.NodeID
+	})
+	return out, nil
+}
