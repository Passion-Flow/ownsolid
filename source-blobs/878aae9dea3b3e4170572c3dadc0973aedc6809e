func TestHeldReferenceIsNeverForcedThroughCleanup(t *testing.T) {
	f, api := fixture(t)
	for _, mode := range []string{"init", "verify"} {
		if e := phase(t, api, mode); e != nil {
			t.Fatal(e)
		}
	}
	f.set(func() { f.held = true })
	if e := phase(t, api, "cleanup"); e == nil {
		t.Fatal("held reference ignored")
	}
	f.mu.Lock()
	id := f.current.ID
	f.mu.Unlock()
	if f.count("POST "+registryRoot+"/pins/"+id+"/remove") != 0 {
		t.Fatal("referenced pin mutated")
	}
}
func TestFreshSessionFormatAndPathIsolation(t *testing.T) {
	f, api := fixture(t)
	if e := os.WriteFile(f.config.SessionFile, []byte(`{"format":"foreign-test-driver"}`), 0600); e != nil {
		t.Fatal(e)
