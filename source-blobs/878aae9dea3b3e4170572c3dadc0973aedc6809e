func TestRedirectAndOversizedResponsesStopBeforeLogin(t *testing.T) {
	for _, mode := range []string{"redirect", "oversized"} {
		t.Run(mode, func(t *testing.T) {
			f, api := fixture(t)
			f.set(func() { f.redirect = mode == "redirect"; f.oversized = mode == "oversized" })
			if e := phase(t, api, "init"); e == nil {
				t.Fatal("invalid bootstrap accepted")
			}
			if f.count("GET /should-not-be-requested") != 0 || f.count("POST /api/v1/auth/login") != 0 {
				t.Fatal("bootstrap refusal caused an extra request")
			}
		})
	}
}
func TestUntrustedPrivatePeerIsRejected(t *testing.T) {
	f, _ := fixture(t)
	pub, key, e := ed25519.GenerateKey(rand.Reader)
	if e != nil {
		t.Fatal(e)
	}
	cert := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "Unrelated fixture CA"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign}
	der, e := x509.CreateCertificate(rand.Reader, cert, cert, pub, key)
	if e != nil {
		t.Fatal(e)
	}
	ca := filepath.Join(t.TempDir(), "unrelated.pem")
	if e = os.WriteFile(ca, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0600); e != nil {
		t.Fatal(e)
	}
	cfg := f.config
	cfg.Admin.CAFile = ca
	api, e := newAPIClient(cfg)
	if e != nil {
		t.Fatal(e)
	}
	defer api.close()
	if e = phase(t, api, "init"); e == nil {
		t.Fatal("untrusted private TLS peer accepted")
	}
	if f.count("POST /api/v1/auth/login") != 0 {
		t.Fatal("credentials reached an untrusted peer")
	}
}
func TestInputValidationAndImmutableConfiguration(t *testing.T) {
	f, api := fixture(t)
	original := api.config.fingerprint()
	f.config.Asset.Licenses[0] = "Changed"
	if api.config.fingerprint() != original {
		t.Fatal("caller changed the selected configuration through a slice")
	}
	for _, change := range []func(*configuration){
		func(c *configuration) { c.ApproveLicenses = false }, func(c *configuration) { c.SourceCommit = "" },
		func(c *configuration) { c.Asset.ManifestDigest = "" }, func(c *configuration) { c.Asset.ArchiveBytes = 0 },
		func(c *configuration) { c.Admin.DialAddress = "8.8.8.8:443" }, func(c *configuration) { c.Admin.DialAddress = "127.0.0.1:ssh" },
		func(c *configuration) { c.Admin.Origin = "http://127.0.0.1" }, func(c *configuration) { c.Admin.Origin = f.server.URL + "?" },
	} {
		cfg := f.config
		change(&cfg)
		if cfg.validate() == nil {
			t.Fatal("invalid or unapproved input accepted")
		}
	}
	raw, _ := json.Marshal(api.config)
	root := filepath.Join(t.TempDir(), "config.json")
	if e := os.WriteFile(root, raw, 0600); e != nil {
		t.Fatal(e)
	}
	if _, e := loadConfiguration(root); e != nil {
		t.Fatal(e)
	}
	duplicate := append([]byte(`{"source_commit":"bad",`), raw[1:]...)
	if e := os.WriteFile(root, duplicate, 0600); e != nil {
		t.Fatal(e)
	}
	if _, e := loadConfiguration(root); e == nil {
		t.Fatal("duplicate member admitted")
	}
}

func TestCancellationReachesAnInflightRequest(t *testing.T) {
	f, _ := fixture(t)
	f.set(func() { f.waitForCancel = true; f.entered = make(chan struct{}) })
	cfg := f.config
	cfg.RequestSeconds = 30
	cfg.PhaseSeconds = 60
	api, err := newAPIClient(cfg)
	if err != nil {
		t.Fatal(err)
	}
	defer api.close()
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	completed := make(chan error, 1)
	go func() { _, err := api.csrf(ctx); completed <- err }()
	select {
	case <-f.entered:
	case <-time.After(5 * time.Second):
		t.Fatal("controlled request did not start")
	}
	cancel()
	select {
	case err := <-completed:
		if err == nil {
			t.Fatal("canceled request succeeded")
		}
	case <-time.After(2 * time.Second):
		t.Fatal("cancellation did not reach the inflight request")
	}
	if f.count("POST /api/v1/auth/login") != 0 {
		t.Fatal("canceled bootstrap reached login")
	}
}
func TestOwnedSessionChangesAreNotOverwritten(t *testing.T) {
	f, api := fixture(t)
	if e := phase(t, api, "init"); e != nil {
		t.Fatal(e)
	}
	d := &driver{api: api}
	if e := d.load(); e != nil {
		t.Fatal(e)
	}
	replacement := []byte("replacement fixture state")
	if e := os.WriteFile(f.config.SessionFile, replacement, 0600); e != nil {
		t.Fatal(e)
	}
	if d.save(false) == nil {
		t.Fatal("overwrote another actor's state")
	}
	body, e := os.ReadFile(f.config.SessionFile)
	if e != nil || string(body) != string(replacement) {
		t.Fatal("replacement state changed")
	}
}
