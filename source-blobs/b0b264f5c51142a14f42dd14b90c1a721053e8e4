set -euo pipefail
cd ~/lane-rel-cloud
test "$(git rev-parse --short HEAD)" = fb27e6a9
git diff --quiet
source ~/lane-rel-tools/env
export GOPROXY=off GOMAXPROCS=2 GOFLAGS=-p=1 npm_config_offline=true CARGO_NET_OFFLINE=true CARGO_BUILD_JOBS=1
export PLAYWRIGHT_BROWSERS_PATH=$HOME/lane-rel-tools/playwright-browsers
export OWNSOLID_PLAYWRIGHT_PORT_OFFSET=15000
export CI=1
unset PROJECT_ONE_TEST_DSN PROJECT_ONE_TEST_DSN_FILE
exec 9>~/lane-rel-tools/heavy-test.lock
flock -w 900 9
df -h /
free -m
cat /proc/pressure/io
for attempt in $(seq 1 120); do
    if test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048; then break; fi
    sleep 4
done
test "$(free -m | awk '/^Mem:/ {print $4}')" -ge 2048
test "$(df -Pm / | awk 'NR==2 {print $4}')" -ge 15360
test -x "$PLAYWRIGHT_BROWSERS_PATH/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell"
available_cpus=$(python3 -c 'import os; print(",".join(map(str, sorted(os.sched_getaffinity(0))[:4])))')
export LANE_REL_GATE_STATUS_DIR=$1
ionice -c2 -n7 nice -n10 taskset -c "$available_cpus" unshare -n bash -ec '
    ip link set lo up
    test "$(wc -l < /proc/net/route)" -eq 1
    make check-layout check-roadmap
    export LD_LIBRARY_PATH="$HOME/lane-rel-tools/browser-root/usr/lib/x86_64-linux-gnu"
    ldd "$PLAYWRIGHT_BROWSERS_PATH/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell" > "$LANE_REL_GATE_STATUS_DIR/browser-libraries"
    if grep -q "not found" "$LANE_REL_GATE_STATUS_DIR/browser-libraries"; then exit 1; fi
    timeout --signal=TERM --kill-after=30s 30m make -f Makefile -f "$LANE_REL_GATE_STATUS_DIR/browser-budget.mk" test
    go -C deploy/offline build ./...
    go -C services/control build ./...
'
git diff --exit-code
