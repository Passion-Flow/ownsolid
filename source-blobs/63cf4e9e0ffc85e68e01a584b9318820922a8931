cd ~/lane-rel-usage-cli
test "$(cat ~/lane-rel-tools/train-gpu-gate.oX33ymCU/exit)" = 0
test "$(cat ~/lane-rel-tools/train-gpu-delta.Kwf0Vm41/exit)" = 0
test "$(git rev-parse --short HEAD)" = e324b20e
git diff --quiet
git diff --cached --quiet
git rebase --onto refs/lane-rel/train-gpu-base-latest 57b84c17
git diff --exit-code e324b20e..HEAD -- api/openapi tools services/agent services/control/internal/modules/training web
