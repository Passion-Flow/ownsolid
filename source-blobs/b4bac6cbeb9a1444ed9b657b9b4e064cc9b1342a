import errno,fcntl,hashlib,json,os,resource,subprocess,sys
from pathlib import Path
source,target=map(Path,sys.argv[1:3]);expected=sys.argv[3];checks=[]
subprocess.run(['mount','--bind',str(source),str(target)],check=True)
try:
 subprocess.run(['mount','-o','remount,bind,ro',str(target)],check=True)
 a,b=source.stat(),target.stat()
 assert (a.st_dev,a.st_ino)==(b.st_dev,b.st_ino);checks.append('exact_root_inode')
 data=(target/'asset.jsonl').read_bytes()
 assert hashlib.sha256(data).hexdigest()==expected;checks.append('actual_immutable_bytes')
 fd=os.open(target/'owner.lock',os.O_RDONLY|os.O_NOFOLLOW)
 try:
  try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except OSError as err:assert err.errno in (errno.EAGAIN,errno.EACCES)
  else:raise AssertionError('writer lock lost')
 finally:os.close(fd)
 checks.append('writer_exclusion_preserved')
 for name,op in [
  ('create',lambda:os.open(target/'generated-new',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)),
  ('write',lambda:os.open(target/'asset.jsonl',os.O_WRONLY)),
  ('unlink',lambda:os.unlink(target/'asset.jsonl')),
  ('chmod',lambda:os.chmod(target/'asset.jsonl',0o644))]:
  try:op()
  except OSError as err:assert err.errno==errno.EROFS,(name,err.errno)
  else:raise AssertionError('read-only mutation accepted: '+name)
  checks.append(name+'_refused_EROFS')
 print(json.dumps({'checks':checks,'passed':len(checks),'child_maximum_rss_kib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}))
finally:subprocess.run(['umount',str(target)],check=True)
