CREATE TABLE model_preparation_attempts (
    id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin PRIMARY KEY,
    tenant_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    workspace_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    preparation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    node_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL UNIQUE,
    attempt_number integer NOT NULL CHECK(attempt_number BETWEEN 1 AND 1000),
    state VARCHAR(24) NOT NULL CHECK(state IN ('pending','preparing','running','stopping','recovery_required','stopped','prepared','cancelled','failed')),
    requested_by CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    requested_audience VARCHAR(8) NOT NULL CHECK(requested_audience IN ('portal','admin')),
    requested_epoch bigint NOT NULL CHECK(requested_epoch>=0),
    membership_authority CHAR(36) CHARACTER SET ascii COLLATE ascii_bin,
    command_sha256 VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL CHECK(REGEXP_LIKE(command_sha256,'^[a-f0-9]{64}$','c')),
    last_event_sequence bigint NOT NULL DEFAULT 0 CHECK(last_event_sequence BETWEEN 0 AND 1024),
    stop_token_hash VARBINARY(32) CHECK(stop_token_hash IS NULL OR OCTET_LENGTH(stop_token_hash)=32),
    outcome_sha256 VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin CHECK(outcome_sha256 IS NULL OR REGEXP_LIKE(outcome_sha256,'^[a-f0-9]{64}$','c')),
    outcome JSON CHECK(outcome IS NULL OR JSON_TYPE(outcome)='OBJECT' AND OCTET_LENGTH(CAST(outcome AS CHAR CHARACTER SET utf8mb4))<=8388608),
    physical_stop_receipt JSON CHECK(physical_stop_receipt IS NULL OR JSON_TYPE(physical_stop_receipt)='OBJECT' AND OCTET_LENGTH(CAST(physical_stop_receipt AS CHAR CHARACTER SET utf8mb4))<=32768),
    physical_stop_sha256 VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin CHECK(physical_stop_sha256 IS NULL OR REGEXP_LIKE(physical_stop_sha256,'^[a-f0-9]{64}$','c')),
    physical_stopped_at DATETIME(6),
    error_code VARCHAR(80) CHARACTER SET ascii COLLATE ascii_bin CHECK(error_code IS NULL OR REGEXP_LIKE(error_code,'^[A-Z][A-Z0-9_]{1,79}$','c')),
    created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    started_at DATETIME(6),
    finished_at DATETIME(6),
    updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    UNIQUE(tenant_id,workspace_id,preparation_id,id),
    UNIQUE(preparation_id,attempt_number),
    FOREIGN KEY(tenant_id,workspace_id,preparation_id) REFERENCES model_preparations(tenant_id,workspace_id,id),
    FOREIGN KEY(tenant_id,workspace_id,node_id) REFERENCES managed_nodes(tenant_id,workspace_id,id),
    FOREIGN KEY(tenant_id,workspace_id,node_id,task_id) REFERENCES node_tasks(tenant_id,workspace_id,node_id,id),
    CHECK(requested_audience='admin' OR membership_authority IS NOT NULL),
    CHECK((outcome IS NULL)=(outcome_sha256 IS NULL)),
    CHECK((physical_stop_receipt IS NULL)=(physical_stop_sha256 IS NULL)),
    CHECK((physical_stop_receipt IS NULL)=(physical_stopped_at IS NULL)),
    event_bytes bigint NOT NULL DEFAULT 0 CHECK(event_bytes BETWEEN 0 AND 16777216),
    outcome_bytes LONGBLOB CHECK(outcome_bytes IS NULL OR OCTET_LENGTH(outcome_bytes) BETWEEN 2 AND 8388608),
    CHECK((outcome IS NULL)=(outcome_bytes IS NULL)),
    uncleared_preparation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin GENERATED ALWAYS AS(CASE WHEN state IN('pending','preparing','running','stopping','recovery_required') AND physical_stopped_at IS NULL THEN preparation_id ELSE NULL END) STORED,
    UNIQUE KEY model_preparation_one_uncleared_idx(uncleared_preparation_id),
    KEY model_preparation_attempt_page_idx(tenant_id,workspace_id,preparation_id,created_at DESC,id DESC),
    FOREIGN KEY(requested_by) REFERENCES users(id),
    CONSTRAINT model_preparation_attempts_id_canonical CHECK(REGEXP_LIKE(id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_tenant_id_canonical CHECK(REGEXP_LIKE(tenant_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_workspace_id_canonical CHECK(REGEXP_LIKE(workspace_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_preparation_id_canonical CHECK(REGEXP_LIKE(preparation_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_node_id_canonical CHECK(REGEXP_LIKE(node_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_task_id_canonical CHECK(REGEXP_LIKE(task_id,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_requested_by_canonical CHECK(REGEXP_LIKE(requested_by,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c')),
    CONSTRAINT model_preparation_attempts_membership_authority_canonical CHECK(membership_authority IS NULL OR REGEXP_LIKE(membership_authority,'^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$','c'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin;
