    def simulated_parent(self, busy=None, foreign_cleanup=False, go_failure=False, ready_codes=None):
        """Exercise the full Python path with every external operation replaced."""
        calls = []
        clock = Clock()
        readiness = list(ready_codes if ready_codes is not None else (0,))
        name = 'lane-trn-reader-' + 'a' * 32
        container = 'b' * 64
        info = {'Id': container, 'Name': '/' + name, 'Image': CONFIG['image_id'],
                'Config': {'Labels': {'ownsolid.fixture.owner': 'lane-trn', 'ownsolid.fixture.run': 'a' * 32}},
                'HostConfig': {'NetworkMode': 'none', 'Memory': 1073741824, 'NanoCpus': 2000000000, 'PortBindings': {}},
                'State': {'Pid': 900}, 'Mounts': [{'Type': 'volume', 'Name': 'mock-owned-volume'}]}
        def command(argv, phase, budget, **kwargs):
            calls.append((phase, argv, kwargs))
            if phase == 'pg_ready':
                return (readiness.pop(0) if len(readiness) > 1 else readiness[0]), b'mock readiness'
            if 'log_path' in kwargs:
                kwargs['log_path'].write_bytes(go_log() if phase == 'go_reader_owners' else b'mock-only')
            if phase == 'go_reader_owners' and go_failure:
                raise w.Refusal('CHILD_TIMEOUT', -signal.SIGKILL, phase)
            output = {
                'original_admission': b'{}',
                'docker_context': json.dumps([{'Endpoints': {'docker': {'Host': CONFIG['docker_endpoint']}}}]).encode(),
                'cached_image': json.dumps([{'Id': CONFIG['image_id'], 'Os': 'linux', 'Architecture': 'amd64'}]).encode(),
                'pg_create': container.encode(), 'pg_identity': json.dumps([info]).encode(),
                'cleanup_presence': container.encode(), 'cleanup_identity': json.dumps([info]).encode(),
            }.get(phase, b'')
            if phase == 'cleanup_identity' and foreign_cleanup:
                changed = copy.deepcopy(info)
                changed['Config']['Labels']['ownsolid.fixture.owner'] = 'foreign'
                output = json.dumps([changed]).encode()
            return 0, output
        with tempfile.TemporaryDirectory() as temporary:
            config = {**CONFIG, 'evidence_parent': temporary}
            acquire_effect = w.Refusal(busy, 73 if busy == 'FIRST_LOCK_BUSY' else 74) if busy else None
            with patch.object(w, 'assert_source'), \
                 patch.object(w, 'acquire_carriers', side_effect=acquire_effect, return_value=[11, 12]), \
                 patch.object(w, 'release_carriers', return_value=[]) as released, \
                 patch.object(w, 'command', side_effect=command), \
                 patch.object(w.Path, 'read_text', return_value='full avg10=0.00 avg60=0.00 avg300=0.00 total=0'), \
                 patch.object(w.signal, 'signal'), patch.object(w.signal, 'setitimer'), \
                 patch.object(w.time, 'sleep', side_effect=lambda delay: setattr(clock, 'now', clock.now + delay)), \
                 patch.object(w.uuid, 'uuid4', return_value=SimpleNamespace(hex='a' * 32)), \
                 patch('sys.stdout', new=io.StringIO()):
                code = w.execute(config, PLAN, BINDING, {'maximum_io_full_average_percent': 5}, w.Budget(clock))
            evidence = next(Path(temporary).glob('lane-trn-reader-native.*'))
            with (evidence / 'result.json').open() as stream:
                result = json.load(stream)
            self.assertFalse((evidence / 'dsn').exists())
            released.assert_called_once()
            return code, result, calls

