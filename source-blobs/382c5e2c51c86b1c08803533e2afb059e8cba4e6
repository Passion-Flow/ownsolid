    def refusal(self, kind, call):
        with self.assertRaises(w.Refusal) as raised:
            call()
        self.assertEqual(raised.exception.kind, kind)
        return raised.exception

    def test_fixed_budget_reserves_cleanup_and_caps_go(self):
        clock = Clock()
        budget = w.Budget(clock)
        self.assertEqual((budget.hard, budget.work), (1300, 1270))
        self.assertEqual(budget.child_end(170), 1170)
        clock.now = 1250
        self.assertEqual(budget.child_end(170), 1270)
        clock.now = 1270
        self.refusal('WORK_DEADLINE', lambda: budget.child_end(1))
        budget.enter_cleanup()
        self.assertEqual(budget.cleanup_end, 1295)
        self.assertEqual(budget.child_end(170), 1295)
        clock.now = 1295
        self.refusal('CLEANUP_DEADLINE', lambda: budget.child_end(1))

