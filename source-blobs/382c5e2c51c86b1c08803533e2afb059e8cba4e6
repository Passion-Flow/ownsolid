class Clock:
    def __init__(self):
        self.now = 1000.0

    def __call__(self):
        return self.now


class FakeProcess:
    pid = 987654

    def __init__(self, rc=0, timeout=False):
        self.returncode = rc
        self.timeout = timeout
        self.waits = []

    def wait(self, timeout):
        self.waits.append(timeout)
        if self.timeout:
            self.timeout = False
            self.returncode = -signal.SIGTERM
            raise subprocess.TimeoutExpired('mock', timeout)
        return self.returncode

    def poll(self):
        return self.returncode


def go_log():
    events = [
        {'Action': 'pass', 'Package': w.PACKAGES[0], 'Test': w.DATASET_ROOT},
        {'Action': 'pass', 'Package': w.PACKAGES[1], 'Test': w.TRAINING_ROOT},
        {'Action': 'pass', 'Package': w.PACKAGES[1], 'Test': w.SUBCASE},
        *[{'Action': 'pass', 'Package': package} for package in w.PACKAGES],
    ]
    return b''.join(json.dumps(event).encode() + b'\n' for event in events)


