    def test_child_timeout_kills_only_owned_group_and_retains_partial_log(self):
        budget = w.Budget(Clock())
        process = FakeProcess(timeout=True)
        with tempfile.TemporaryDirectory() as temporary:
            log = Path(temporary) / 'partial.log'
            def spawn(*args, **kwargs):
                kwargs['stdout'].write(b'partial fixture output\n')
                return process
            with patch.object(w.subprocess, 'Popen', side_effect=spawn), patch.object(w.os, 'killpg', side_effect=[None, None, ProcessLookupError()]) as killed:
                error = self.refusal('CHILD_TIMEOUT', lambda: w.command(['mock'], 'mock_go', budget, cap=170, log_path=log))
            self.assertEqual(error.raw, -signal.SIGTERM)
            self.assertEqual(log.read_bytes(), b'partial fixture output\n')
            self.assertEqual(killed.call_args_list[0].args, (process.pid, signal.SIGTERM))
            self.assertEqual(killed.call_args_list[1].args, (process.pid, signal.SIGKILL))
            self.assertTrue(budget.commands[0]['reaped'])

