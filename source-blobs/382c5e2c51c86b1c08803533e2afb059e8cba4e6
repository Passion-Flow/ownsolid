    def carriers(self):
        return [{'path': '/mock/one', 'device': 29, 'inode': 82, 'uid': os.geteuid()},
                {'path': '/mock/two', 'device': 64512, 'inode': 7508772, 'uid': os.geteuid()}]

    def metadata(self, index):
        carrier = self.carriers()[index]
        return SimpleNamespace(st_mode=stat.S_IFREG | 0o644, st_dev=carrier['device'],
                               st_ino=carrier['inode'], st_uid=carrier['uid'])

    def acquire(self, flock):
        carriers = self.carriers()
        with patch.object(w.os, 'open', side_effect=[11, 12]) as opened, \
             patch.object(w.os, 'fstat', side_effect=[self.metadata(0), self.metadata(1)]), \
             patch.object(w.os, 'stat', side_effect=[self.metadata(0), self.metadata(1)]), \
             patch.object(w.fcntl, 'flock', side_effect=flock), \
             patch.object(w.os, 'close') as closed, \
             patch.object(w.signal, 'signal'), patch.object(w.signal, 'setitimer') as timer:
            try:
                result = w.acquire_carriers(carriers, w.Budget(Clock()))
                return result, opened.call_args_list, closed.call_args_list, timer.call_args_list
            except w.Refusal as error:
                return error, opened.call_args_list, closed.call_args_list, timer.call_args_list

    def test_first_kernel_once_second_nonblocking_and_no_truncation(self):
        operations = []
        result, opened, _, timers = self.acquire(lambda fd, flags: operations.append((fd, flags)))
        self.assertEqual(result, [11, 12])
        self.assertEqual(operations, [(11, w.fcntl.LOCK_EX), (12, w.fcntl.LOCK_EX | w.fcntl.LOCK_NB)])
        for args in opened:
            flags = args.args[1]
            self.assertTrue(flags & os.O_NOFOLLOW)
            self.assertTrue(flags & os.O_CLOEXEC)
            self.assertFalse(flags & (os.O_CREAT | os.O_TRUNC))
        self.assertEqual(timers[0].args[1], 60)

    def test_second_busy_releases_both_before_return(self):
        operations = []
        def flock(fd, flags):
            operations.append((fd, flags))
            if fd == 12 and flags & w.fcntl.LOCK_NB:
                raise BlockingIOError()
        result, _, closed, _ = self.acquire(flock)
        self.assertEqual((result.kind, result.raw), ('SECOND_LOCK_BUSY', 74))
        self.assertEqual(operations[-2:], [(12, w.fcntl.LOCK_UN), (11, w.fcntl.LOCK_UN)])
        self.assertEqual([args.args[0] for args in closed], [12, 11])

    def test_first_busy_is_not_retried_and_closed(self):
        operations = []
        def flock(fd, flags):
            operations.append((fd, flags))
            if flags == w.fcntl.LOCK_EX:
                raise w.Refusal('FIRST_LOCK_BUSY', 73)
        result, opened, closed, _ = self.acquire(flock)
        self.assertEqual((result.kind, result.raw), ('FIRST_LOCK_BUSY', 73))
        self.assertEqual(len(opened), 1)
        self.assertEqual(operations, [(11, w.fcntl.LOCK_EX), (11, w.fcntl.LOCK_UN)])
        self.assertEqual(len(closed), 1)

