    def test_main_late_evidence_failure_preserves_started_state(self):
        def late_failure(_config, _plan, _binding, _policy, _budget, progress):
            progress['record'] = {'native_started': True, 'qualification': True, 'container_id': 'mock-owned', 'driver_exit_code': 0}
            progress['evidence'] = '/mock/private-evidence'
            raise OSError('mock final record write failure')
        output = io.StringIO()
        with patch.object(w.sys, 'argv', ['reader_native_bounded.py', '--config', 'mock', '--execute']), \
             patch.object(w, 'read_json', return_value=CONFIG), \
             patch.object(w, 'inspect_inputs', return_value=(PLAN, BINDING, {})), \
             patch.object(w, 'execute', side_effect=late_failure), \
             patch.object(w.signal, 'signal'), patch.object(w.signal, 'setitimer'), \
             patch('sys.stdout', new=output):
            code = w.main()
        result = json.loads(output.getvalue())
        self.assertEqual(code, 1)
        self.assertTrue(result['native_started'])
        self.assertFalse(result['qualification'])
        self.assertEqual(result['kind'], 'PARENT_FAILED')
        self.assertEqual(result['driver_exit_code'], 1)
        self.assertEqual(result['evidence'], '/mock/private-evidence')

