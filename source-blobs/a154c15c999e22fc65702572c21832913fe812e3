	ForeignWorkspaceID string   `json:"foreign_workspace_id,omitempty"`
	RawWindow          window   `json:"raw_window"`
	RollupWindow       window   `json:"rollup_window"`
	RetentionWindow    *window  `json:"retention_window,omitempty"`
	RequiredCommands   []string `json:"required_commands"`
