const stateFormat = "ownsolid-installed-history-v1"
const maximumReply = 1 << 20
const counterMetric = "vm_http_requests_total{path=\"/api/v1/query_range\"}"

var uuidPattern = regexp.MustCompile("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
var scopePattern = regexp.MustCompile("^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$")
var shaPattern = regexp.MustCompile("^[0-9a-f]{40}$")
var codePattern = regexp.MustCompile("^[A-Z][A-Z0-9_]{0,119}$")

type endpoint struct {
	Origin         string `json:"origin"`
	CAFile         string `json:"ca_file"`
	DialAddress    string `json:"dial_address,omitempty"`
	DialUnixSocket string `json:"dial_unix_socket,omitempty"`
}
