	Cells               []cellExpectation `json:"cells"`
	RequireSparse       bool              `json:"require_sparse"`
	RequireZero         bool              `json:"require_zero"`
	SyntheticNinetyDays bool              `json:"synthetic_ninety_days,omitempty"`
}
