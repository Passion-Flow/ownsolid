  "ModelCatalog": {
   "type": "object",
   "required": [
    "repository",
    "revision",
    "license",
    "schema_version",
    "model_key",
    "format",
    "architecture",
    "model_type",
    "max_context",
    "files"
   ],
   "properties": {
    "repository": {
     "type": "string",
     "const": "Qwen/Qwen3-0.6B"
    },
    "revision": {
     "type": "string",
     "const": "c1899de289a04d12100db370d81485cdf75e47ca"
    },
    "license": {
     "type": "string",
     "const": "Apache-2.0"
    },
    "schema_version": {
     "type": "integer",
     "const": 1
    },
    "model_key": {
     "type": "string",
     "const": "qwen3-0.6b"
    },
    "format": {
     "type": "string",
     "const": "safetensors"
    },
    "architecture": {
     "type": "string",
     "const": "Qwen3ForCausalLM"
    },
    "model_type": {
     "type": "string",
     "const": "qwen3"
    },
    "max_context": {
     "type": "integer",
     "const": 2048
    },
    "files": {
     "type": "array",
     "maxItems": 9,
     "items": {
      "$ref": "ModelFile"
     }
    }
   }
  },
  "ModelFile": {
   "type": "object",
   "required": [
    "path",
    "size_bytes",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "enum": [
      "LICENSE",
      "README.md",
      "config.json",
      "generation_config.json",
      "merges.txt",
      "model.safetensors",
      "tokenizer.json",
      "tokenizer_config.json",
      "vocab.json"
     ]
    },
    "size_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483648
    },
    "sha256": {
     "type": "string"
    }
   }
  },
  "ModelList": {
   "type": "object",
   "required": [
    "items"
   ],
   "properties": {
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "ModelVersion"
     }
    }
   }
  },
  "ModelListResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "ModelList"
    }
   }
  },
  "ModelVersion": {
   "type": "object",
   "required": [
    "id",
    "workspace_id",
    "name",
    "model_key",
    "catalog_digest",
    "kind",
    "manifest",
    "state",
    "created_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "workspace_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "model_key": {
     "type": "string",
     "const": "qwen3-0.6b"
    },
    "catalog_digest": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "approved_base",
      "merged_lora"
     ]
    },
    "manifest": {
     "anyOf": [
      {
       "$ref": "ModelCatalog"
      },
      {
       "$ref": "DerivedModelCatalog"
      }
     ]
    },
    "state": {
     "type": "string",
     "const": "ready"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    }
   },
   "allOf": [
    {},
    {}
   ]
  },
  "ModelVersionResponse": {
   "type": "object",
   "required": [
    "data"
   ],
   "properties": {
    "data": {
     "$ref": "ModelVersion"
    }
   }
  }
 }
}
