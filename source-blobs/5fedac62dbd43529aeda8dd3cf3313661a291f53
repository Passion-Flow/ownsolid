+def bounded_first_flock(fd, seconds):
+    """Make one blocking flock call with a signal-bounded first-lock wait."""
+    def expired(signum, frame):
+        raise BlockingIOError('First host lease wait expired')
+    if seconds <= 0:
+        raise BlockingIOError('No first-lock wait budget remains')
+    assert signal.getitimer(signal.ITIMER_REAL) == (0.0, 0.0)
+    previous = signal.signal(signal.SIGALRM, expired)
+    try:
+        signal.setitimer(signal.ITIMER_REAL, seconds)
+        fcntl.flock(fd, fcntl.LOCK_EX)
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        signal.signal(signal.SIGALRM, previous)
 
