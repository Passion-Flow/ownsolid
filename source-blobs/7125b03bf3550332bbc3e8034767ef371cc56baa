#!/usr/bin/env bash
# Runs both stores hardened inside the zero-egress host and measures them.
set -uo pipefail
n=lane-c-obs-eval; e=/root/lane-c/e2e; d=/root/lane-c/obs
docker rm -f $n >/dev/null 2>&1
docker run -d --name $n --privileged --network none --cpus 8 --memory 16g -e DOCKER_TLS_CERTDIR= -v $d:/obs:ro -v $e:/bundle:ro docker:29.1.3-dind >/dev/null
for _ in $(seq 1 60); do docker exec $n docker info >/dev/null 2>&1 && break; sleep 1; done
docker exec -d $n /bundle/egress-recorder -interface egress0 -log /var/log/egress.jsonl
sleep 1
docker exec $n sh -euc "ip link set egress0 up; ip addr add 198.18.0.1/32 dev egress0; ip -6 addr add 2001:db8:e9e5::1/128 dev egress0; ip route add default dev egress0; ip -6 route add default dev egress0"
docker exec $n docker load -q -i /obs/vm-images.tar
hard="--read-only --cap-drop ALL --security-opt no-new-privileges:true --user 10001:10001 --pull never --cpus 4 --memory 6g"
docker exec $n sh -c "mkdir -p /srv/vm /srv/vl && chown 10001:10001 /srv/vm /srv/vl"
docker exec $n docker run -d --name vm $hard -p 127.0.0.1:8428:8428 -v /srv/vm:/data victoriametrics/victoria-metrics:v1.155.0 -storageDataPath=/data -retentionPeriod=30d -search.maxUniqueTimeseries=0
docker exec $n docker run -d --name vl $hard -p 127.0.0.1:9428:9428 -v /srv/vl:/data victoriametrics/victoria-logs:v1.53.0 -storageDataPath=/data -retentionPeriod=30d
sleep 5
echo "== idle 60s for any background phone-home"; sleep 60
docker exec $n sh -c 'wc -l /var/log/egress.jsonl; docker ps --format "{{.Names}} {{.Status}}"'
echo "== load"
docker exec $n /obs/obsgen -series 2000000 -rounds 3 -lines 2000000
sleep 20
echo "== results"
docker exec $n sh -c '
wget -q -O- http://127.0.0.1:8428/metrics | grep -E "^vm_cache_entries\{type=\"storage/hour_metric_ids\"|^process_resident_memory_bytes|^vm_rows\{type=\"storage/(small|big)\"|^vm_rows_inserted_total\{type=\"promremotewrite|^vm_rows_inserted_total\{type=\"prometheus"
wget -q -O- http://127.0.0.1:9428/metrics | grep -E "^process_resident_memory_bytes|^vl_rows_ingested_total|^vl_storage_rows"
du -sh /srv/vm /srv/vl
t0=$(date +%s%N); wget -q -O- "http://127.0.0.1:8428/api/v1/query?query=count(gpu_metric)"; echo; t1=$(date +%s%N); echo "count_ms=$(( (t1-t0)/1000000 ))"
t0=$(date +%s%N); wget -q -O- "http://127.0.0.1:8428/api/v1/query?query=sum(gpu_metric%7Bnode%3D%22n42%22%7D)"; echo; t1=$(date +%s%N); echo "node_ms=$(( (t1-t0)/1000000 ))"
t0=$(date +%s%N); wget -q -O- --post-data "query=node:n42 status | stats count() rows" http://127.0.0.1:9428/select/logsql/query; t1=$(date +%s%N); echo "logs_ms=$(( (t1-t0)/1000000 ))"
'
echo "== restart durability"
docker exec $n sh -c 'docker restart vm vl >/dev/null; sleep 8; wget -q -O- "http://127.0.0.1:8428/api/v1/query?query=count(gpu_metric)"; echo; wget -q -O- --post-data "query=* | stats count() rows" http://127.0.0.1:9428/select/logsql/query'
echo "== egress"
docker exec $n sh -c 'wc -l < /var/log/egress.jsonl; cut -c1-160 /var/log/egress.jsonl | head -10; docker logs vm 2>&1 | grep -ciE "panic|FATAL"; docker logs vl 2>&1 | grep -ciE "panic|FATAL"'
docker rm -f $n >/dev/null
