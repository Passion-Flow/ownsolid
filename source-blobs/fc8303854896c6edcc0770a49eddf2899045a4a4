+	for path, content := range map[string][]byte{
+		ca:     pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}),
+		secret: []byte(password), filepath.Join(dir, "config.json"): config,
