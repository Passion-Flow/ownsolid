+func TestMonitoringHistoryArgumentsBeforeIO(t *testing.T) {
+	t.Setenv("OWNSOLID_CONFIG_DIR", "unusable")
+	for _, pair := range [][2]string{
+		{"", "2026-11-01T01:00:00Z"},
