+		t.Fatal(err)
+	}
+	history(recent, false, "AUTH_SESSION_EXPIRED", "-o", "json")
+	run(true, "", "login", "--email", "admin@example.invalid", "--password-file", secret)
+	history(recent, true, "raw", "-o", "json")
+}
