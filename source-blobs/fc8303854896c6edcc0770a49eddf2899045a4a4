+	history(old, true, "rollup", "-o", "json")
+	sessionPath := filepath.Join(dir, fmt.Sprintf("session-%x", sha256.Sum256([]byte(server.URL))))
+	retained, err := os.ReadFile(sessionPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	run(true, "", "logout")
