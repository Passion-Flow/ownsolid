# Variables consumed by compose.yaml. `ownsolid-install apply` writes the real file to
# <install_root>/compose.env from install.yaml; edit install.yaml, not that file.
# No value here is a secret: secrets are referenced by file path only.

# Compose project name.
OWNSOLID_PROJECT=ownsolid
# Images, already loaded on this host. Tag or digest; `latest` is refused.
OWNSOLID_CONTROL_IMAGE=ownsolid/control:0.0.0-example
OWNSOLID_POSTGRES_IMAGE=pgvector/pgvector@sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47
# Numeric owner of the configuration directories and the control process.
OWNSOLID_RUNTIME_UID=10001
OWNSOLID_RUNTIME_GID=10001
# Host address and port of the HTTPS listener.
OWNSOLID_BIND_ADDRESS=127.0.0.1
OWNSOLID_HTTPS_PORT=8443
# Directories created by the installer under install_root.
OWNSOLID_CONFIG_DIR=/srv/ownsolid/config
OWNSOLID_OPERATOR_DIR=/srv/ownsolid/operator
OWNSOLID_POSTGRES_DATA=/srv/ownsolid/data/postgres
OWNSOLID_POSTGRES_PASSWORD_FILE=/srv/ownsolid/secrets/postgres-password
# Resource limits.
OWNSOLID_CONTROL_MEMORY=1g
OWNSOLID_CONTROL_CPUS=2
OWNSOLID_POSTGRES_MEMORY=2g
OWNSOLID_POSTGRES_CPUS=2
OWNSOLID_POSTGRES_MAX_CONNECTIONS=50
